[worldserver]

# mod-leeroy configuration.
# Leeroy.Bridge.Host and Leeroy.Bridge.Port need a worldserver restart;
# every other key applies on `.reload config`.

# Master switch for the module (1 = on, 0 = off).
Leeroy.Enable = 1

# Optional persona play styles: outdoor quiet cast only; reloadable. RaidHabits win.
Leeroy.PlayStyle.Enable = 0

# The raid lead (mind [raidlead]): his orders to his own group's bots (bot_do "order", Bloodlust included)
# and the raid icon of the member he names to lead on his target (raid_lead). No assistant flag is set.
# 0 refuses all of it (raidlead_off) and lifts any hold at once. Reloadable with .reload config.
Leeroy.RaidLead.Enable = 0

# Guild id of the cast's guild.
Leeroy.GuildId = 21

# Low GUID of the human's character.
Leeroy.HumanGuid = 1

# Bridge address. Loopback only: any other host refuses to start.
Leeroy.Bridge.Host = "127.0.0.1"

# Bridge TCP port (1-65535).
Leeroy.Bridge.Port = 7878

# Exempt the cast from randomize, refresh, teleport and revive-teleport.
Leeroy.KeepCast = 1

# Rescue solo pinned cast members after three deaths in fifteen minutes, once alive
# and out of combat. Honors Realm/training ownership; at most once an hour per member.
# Reloadable with .reload config. Does not resurrect bots itself.
Leeroy.CastDeathLoop.Enable = 0

# Dead members of the owner's group. Out of combat (nobody in his group fighting within
# 100 yards), the nearest free paladin, priest, shaman or druid bot of the group within 57 yards
# and in sight gets off its mount (only on the ground) and rezzes, as players do; playerbots
# alone never casts from a mount, and his bots stay mounted while he is. A bot outside a
# dungeon or raid still dead after ReleaseSeconds of quiet releases and runs back from the
# graveyard (0 never releases; at most 600). Inside an instance it waits for a rez as before.
# Honors Realm and training ownership. Reloadable with .reload config.
Leeroy.GroupRez.Enable = 1
Leeroy.GroupRez.ReleaseSeconds = 60

# Ground hazards in the owner's group. Cast bots of his group with him as master get playerbots'
# avoid aoe out of combat as well (stock adds it to the combat engine only); with the local playerbots
# patch (PlayerbotHazardFilter) their follow spots also skip a hazard for the nearest safe spot, follow walks
# round a hazard in the way, and a bot standing in one steps out. A hazard is a hostile damaging area, trap or
# trigger npc up to Playerbots.MaxAoeAvoidRadius, plus a measured few larger ones a player walks out of (at most
# 35 yards).
# Random bots and anyone outside his group are never touched; Realm and training ownership is honoured.
# Reloadable with .reload config; 0 takes back the avoid aoe it added.
Leeroy.Hazards.Enable = 0

# The owner's strings in game, sent from the guild console by the mind (string_do): one pinned cast member comes
# to him (only while he is in a city or a rest area; one outside his group then stays there 10 minutes), joins the
# party he leads (never a raid; under his add command's own fences), follows him or stops (in his party), challenges
# him to a duel, emotes at him or sits near him. Each is his own ask and takes no Realm lease, but every Realm,
# training and offline-raid fence holds, and nothing is done in a fight (his or hers), in or onto an instance, in a
# battleground or a queue. Reloadable with .reload config; 0 refuses new strings and takes back the stays and seats
# it added.
Leeroy.Strings.Enable = 0

# Pin every cast member as an online random bot.
Leeroy.BringCastOnline = 1

# Stop mod-ollama-chat from voicing cast members.
Leeroy.ExcludeFromOllamaChat = 1

# Refuse random queues while a cast member is held or in the owner's instance group.
# Applies on .reload config; 0 disables both refusal and safe queue withdrawal.
Leeroy.QueueFence.Enable = 1

# Take pinned cast members out of rated arena teams the owner does not captain, so a
# bot team captain cannot pull them out of a group (logged with guid and team id).
# Applies on .reload config.
Leeroy.CastArenaTeams.Leave = 1

# Realm actors and cast protection stay off until separately accepted.
Leeroy.Realm.Enable = 0
Leeroy.CastGuard = 0
# Bounded world-thread body steps per tick, clamped to 1-20.
Leeroy.Realm.MaxActionsPerTick = 5
Leeroy.Realm.Announce = 1

# Optional world persona roster and speech. Both this and Realm.Enable must be on.
# Default off; .reload config applies the switch to subsequent commands.
Leeroy.World.Enable = 0

# Strict local CSV whitelists; missing/invalid files leave the respective list empty.
# A relative path resolves against the module config directory (configs/modules, where
# this file lives); an absolute path is used as written.
Leeroy.Realm.PlacesFile = "leeroy_places.csv"
Leeroy.Realm.ItemsFile = "leeroy_items.csv"
