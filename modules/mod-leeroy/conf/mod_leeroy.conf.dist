[worldserver]

# mod-leeroy configuration.
# Leeroy.Bridge.Host and Leeroy.Bridge.Port need a worldserver restart;
# every other key applies on `.reload config`.

# Master switch for the module (1 = on, 0 = off).
Leeroy.Enable = 1

# Guild id of the cast's guild.
Leeroy.GuildId = 21

# Low GUID of the human's character.
Leeroy.HumanGuid = 1

# Bridge address. Loopback only: any other host refuses to start.
Leeroy.Bridge.Host = "127.0.0.1"

# Bridge TCP port (1-65535).
Leeroy.Bridge.Port = 7878

# Exempt the cast from randomize, refresh, teleport and revive-teleport.
Leeroy.KeepCast = 1

# Pin every cast member as an online random bot.
Leeroy.BringCastOnline = 1

# Stop mod-ollama-chat from voicing cast members.
Leeroy.ExcludeFromOllamaChat = 1

# Refuse random queues while a cast member is held or in the owner's instance group.
# Applies on .reload config; 0 disables both refusal and safe queue withdrawal.
Leeroy.QueueFence.Enable = 1

# Take pinned cast members out of rated arena teams the owner does not captain, so a
# bot team captain cannot pull them out of a group (logged with guid and team id).
# Applies on .reload config.
Leeroy.CastArenaTeams.Leave = 1

# Realm actors and cast protection stay off until separately accepted.
Leeroy.Realm.Enable = 0
Leeroy.CastGuard = 0
# Bounded world-thread body steps per tick, clamped to 1-20.
Leeroy.Realm.MaxActionsPerTick = 5
Leeroy.Realm.Announce = 1
# Strict local CSV whitelists; missing/invalid files leave the respective list empty.
# A relative path resolves against the module config directory (configs/modules, where
# this file lives); an absolute path is used as written.
Leeroy.Realm.PlacesFile = "leeroy_places.csv"
Leeroy.Realm.ItemsFile = "leeroy_items.csv"
