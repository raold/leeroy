[worldserver]

# mod-leeroy configuration.
# Leeroy.Bridge.Host and Leeroy.Bridge.Port need a worldserver restart;
# every other key applies on `.reload config`.

# Master switch for the module (1 = on, 0 = off).
Leeroy.Enable = 1

# Optional persona play styles: outdoor quiet cast only; reloadable. RaidHabits win.
Leeroy.PlayStyle.Enable = 0

# The owner's .playerbots bot addN follows the raid lineup the guild posted (the mind's [decisions], guild_add_roster):
# within each role its members first, its bench only when nobody else free fits. 0 picks exactly as without one.
# The roster lives in memory until its raid night ends (at most 12 h); the mind sends it again on hello.
# Reloadable with .reload config.
Leeroy.GuildAdd.FollowRoster = 0
# Permit guild bank deliveries to cast members through mail_send.
Leeroy.Decisions.BankMail.Enable = 0
# Allow targeted weekly top-ups by a guild maker. Bootstrap stock is independent.
Leeroy.Decisions.BankRestock.Enable = 0

# The raid lead (mind [raidlead]): his orders to his own group's bots (bot_do "order", Bloodlust included)
# and the raid icon of the member he names to lead on his target (raid_lead). No assistant flag is set.
# 0 refuses all of it (raidlead_off) and lifts any hold at once. Reloadable with .reload config.
Leeroy.RaidLead.Enable = 0

# Guild id of the cast's guild.
Leeroy.GuildId = 21

# Low GUID of the human's character.
Leeroy.HumanGuid = 1

# Bridge address. Loopback only: any other host refuses to start.
Leeroy.Bridge.Host = "127.0.0.1"

# Bridge TCP port (1-65535).
Leeroy.Bridge.Port = 7878

# Exempt the cast from randomize, refresh, teleport and revive-teleport.
Leeroy.KeepCast = 1

# Rescue solo pinned cast members after three deaths in fifteen minutes, once alive
# and out of combat. Honors Realm/training ownership; at most once an hour per member.
# Reloadable with .reload config. Does not resurrect bots itself.
Leeroy.CastDeathLoop.Enable = 0

# Dead members of the owner's group. With no fight near the body (no member of his group
# engaged with a living enemy within 100 yards of it), the nearest free paladin, priest, shaman
# or druid bot of the group with the mana for its rez rezzes it, as players do: within its
# spell's range and in sight it gets off its mount (only on the ground) and casts; within
# 100 yards it is walked in first. One short of mana is asked to drink. A bot outside a dungeon
# or raid still dead after ReleaseSeconds of quiet releases and runs back from the graveyard
# (0 never releases; at most 600). Inside an instance it waits for a rez as before. Honors
# Realm and training ownership. Logs group_rez_blocked with a reason code once a minute while a
# body waits. Reloadable with .reload config.
Leeroy.GroupRez.Enable = 1
Leeroy.GroupRez.ReleaseSeconds = 60

# Ground hazards in the owner's group. Cast bots of his group with him as master get playerbots'
# avoid aoe out of combat as well (stock adds it to the combat engine only); with the local playerbots
# patch (PlayerbotHazardFilter) their follow spots also skip a hazard for the nearest safe spot, follow walks
# round a hazard in the way, and a bot standing in one steps out. A hazard is a hostile damaging area, trap or
# trigger npc up to Playerbots.MaxAoeAvoidRadius, plus a measured few larger ones a player walks out of (at most
# 35 yards).
# Random bots and anyone outside his group are never touched; Realm and training ownership is honoured.
# Reloadable with .reload config; 0 takes back the avoid aoe it added.
Leeroy.Hazards.Enable = 0

# Boss mechanics at cast start (the mind's [raidplay] respond sends each covered raid's table at hello). When a boss
# starts casting a spell the raid playbooks list and stock playerbots does not handle, the cast bots of the owner's
# group and of a running offline raid it binds leave its area, its frontal cone, stack, spread or run out with the
# debuff, to navmesh-checked spots clear of known ground hazards, until its hazard ends; ordinary moves into its area
# are refused meanwhile (never while a bot stands in a hazard). Needs the local playerbots patch
# (PlayerbotMechanicGuard). Random bots, anyone outside his group or the offline raid, bots held by stay or passive,
# bots a stock raid strategy moves with forced moves or the raid lead's orders move, and Realm and training
# ownership (but an offline raid's own) are left alone.
# Reloadable with .reload config; 0 moves nobody.
Leeroy.Mechanics.Enable = 0

# The owner's strings in game, sent from the guild console by the mind (string_do): one pinned cast member comes
# to him (only while he is in a city or a rest area; one outside his group then stays there 10 minutes), joins the
# party he leads (never a raid; under his add command's own fences), follows him or stops (in his party), challenges
# him to a duel, emotes at him or sits near him. Each is his own ask and takes no Realm lease, but every Realm,
# training and offline-raid fence holds, and nothing is done in a fight (hers, his or his group's), in or onto an
# instance, in a battleground or a queue. A come_to_me stay fences her (busy:string) from the Realm, training and
# offline raids for its 10 minutes. Reloadable with .reload config; 0 refuses new strings and takes back the stays
# and seats it added.
Leeroy.Strings.Enable = 0

# Allow five consenting members to run a level-80 heroic while their owner is away.
# .reload config applies the switch. Exact-start cleanup continues while starts are off.
Leeroy.MemberDungeon.Enable = 0

# The owner's invitations in game ("come to the inn", "meet me at the bank", "let's go fishing in Dalaran"), read by
# the mind ([talk] invites) and sent as string_do marked "via": "invite": come_to_me, join_group, follow and sit as
# above, plus go_to (to one of the meeting spots compiled into the module: Dalaran's fountain, Krasus' Landing, inns
# and banks of the Horde capitals and Dalaran, Booty Bay's docks; she then stays there 10 minutes, fenced as
# come_to_me's stay) and fish (playerbots' own master fishing, beside him or at a fishing spot, for at most 15 minutes
# or until he has come and gone again). Every fence of the strings holds. This key, not Leeroy.Strings.Enable, answers
# for an invitation. Reloadable with .reload config; 0 refuses new invitations and takes back the stays and fishing
# they added.
Leeroy.Invites.Enable = 0

# The owner's "you lead" in the open world ("take the lead", "take us questing", "go grind", "lead us to the inn"),
# read by the mind ([talk] lead) and sent as lead_do: one cast member of his group takes its lead and runs
# playerbots' own strategies for it (new rpg's questing, grind, or new rpg's walk to one of the meeting spots), the
# others of his group follow her instead of him, and he follows her himself. She waits whenever he is more than 40
# yards behind, never takes a flight or goes to outdoor PvP, and the lead ends after 60 minutes, when he takes it back,
# his group breaks, she dies or is teleported, either of them enters an instance (where dungeon-clear leads) or a
# battleground, he logs out or stays behind 10 minutes. Everything it changed is given back. Reloadable with
# .reload config; 0 refuses new leads and ends the one in force.
Leeroy.Lead.Enable = 0

# Pin every cast member as an online random bot.
Leeroy.BringCastOnline = 1

# Stop mod-ollama-chat from voicing cast members.
Leeroy.ExcludeFromOllamaChat = 1

# Refuse random queues while a cast member is held or in the owner's instance group.
# Applies on .reload config; 0 disables both refusal and safe queue withdrawal.
Leeroy.QueueFence.Enable = 1

# Take pinned cast members out of rated arena teams the owner does not captain, so a
# bot team captain cannot pull them out of a group (logged with guid and team id).
# Applies on .reload config.
Leeroy.CastArenaTeams.Leave = 1

# Realm actors and cast protection stay off until separately accepted.
Leeroy.Realm.Enable = 0
Leeroy.DayPlans.Enable = 0
Leeroy.CastGuard = 0
# Bounded world-thread body steps per tick, clamped to 1-20.
Leeroy.Realm.MaxActionsPerTick = 5
Leeroy.Realm.Announce = 1

# Optional world persona roster and speech. Both this and Realm.Enable must be on.
# Default off; .reload config applies the switch to subsequent commands.
Leeroy.World.Enable = 0

# Strict local CSV whitelists; missing/invalid files leave the respective list empty.
# A relative path resolves against the module config directory (configs/modules, where
# this file lives); an absolute path is used as written.
Leeroy.Realm.PlacesFile = "leeroy_places.csv"
Leeroy.Realm.ItemsFile = "leeroy_items.csv"
