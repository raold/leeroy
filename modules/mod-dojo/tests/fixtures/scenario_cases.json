{
  "about": "Edits to dojo/scenarios/frost_mirror_small_v1.json that the C++ parser (tests/TestManifest.cpp) and the Python validator (dojo/tests/test_scenario.py) must both accept or both refuse. 'set' replaces the value at 'path' (keys and array indexes), 'remove' deletes it, 'raw' replaces the whole document's text.",
  "cases": [
    {"name": "the frozen manifest", "ok": true},
    {"name": "an integer orientation", "set": ["actors", 0, "start", "o"], "value": 0, "ok": true},
    {"name": "six decimals", "set": ["arena", "bounds", "x"], "value": 4055.123456, "ok": true},
    {"name": "no glyphs", "set": ["loadout", "glyphs"], "value": [], "ok": true},
    {"name": "an unknown top-level key", "set": ["extra"], "value": 1, "ok": false, "error": "extra"},
    {"name": "a missing section", "remove": ["rules"], "ok": false, "error": "rules"},
    {"name": "another kind", "set": ["kind"], "value": "leeroy-dojo-other", "ok": false, "error": "kind"},
    {"name": "format 2", "set": ["format"], "value": 2, "ok": false, "error": "format"},
    {"name": "version 0", "set": ["version"], "value": 0, "ok": false, "error": "version"},
    {"name": "an id with capitals", "set": ["id"], "value": "Frost", "ok": false, "error": "id"},
    {"name": "a rated arena", "set": ["rules", "rated"], "value": true, "ok": false, "error": "rated"},
    {"name": "a numeric rated flag", "set": ["rules", "rated"], "value": 0, "ok": false, "error": "rated"},
    {"name": "a long preparation", "set": ["rules", "prep_seconds"], "value": 121, "ok": false, "error": "prep_seconds"},
    {"name": "arena type 4", "set": ["arena", "arena_type"], "value": 4, "ok": false, "error": "arena_type"},
    {"name": "a map id as text", "set": ["arena", "map_id"], "value": "559", "ok": false, "error": "map_id"},
    {"name": "a zero radius", "set": ["arena", "bounds", "radius"], "value": 0.0, "ok": false, "error": "bounds"},
    {"name": "seven decimals", "set": ["arena", "bounds", "x"], "value": 4055.1234567, "ok": false, "error": "decimals"},
    {"name": "a lower-case account", "set": ["fixture", "account"], "value": "dojofixture", "ok": false, "error": "account"},
    {"name": "a staging point without a map", "remove": ["fixture", "staging", "map_id"], "ok": false, "error": "map_id"},
    {"name": "three actors", "set": ["actors", 2], "value": {"slot": 2, "name": "Dojofrostc", "team": "horde", "start": {"x": 4085.45, "y": 2866.83, "z": 12.4005, "o": 0.0}}, "ok": false, "error": "actors"},
    {"name": "slots out of order", "set": ["actors", 0, "slot"], "value": 1, "ok": false, "error": "slot"},
    {"name": "the same name twice", "set": ["actors", 1, "name"], "value": "Dojofrosta", "ok": false, "error": "names"},
    {"name": "both on one side", "set": ["actors", 1, "team"], "value": "alliance", "ok": false, "error": "side"},
    {"name": "an unknown side", "set": ["actors", 1, "team"], "value": "green", "ok": false, "error": "team"},
    {"name": "a name with a digit", "set": ["actors", 0, "name"], "value": "Dojo2", "ok": false, "error": "name"},
    {"name": "a lower-case name", "set": ["actors", 0, "name"], "value": "dojofrosta", "ok": false, "error": "name"},
    {"name": "a start outside the bounds", "set": ["actors", 0, "start", "x"], "value": 4200.0, "ok": false, "error": "bounds"},
    {"name": "an orientation past 2 pi", "set": ["actors", 0, "start", "o"], "value": 7.0, "ok": false, "error": "orientation"},
    {"name": "level 81", "set": ["loadout", "level"], "value": 81, "ok": false, "error": "level"},
    {"name": "a negative level", "set": ["loadout", "level"], "value": -1, "ok": false, "error": "level"},
    {"name": "a level written as a float", "set": ["loadout", "level"], "value": 80.0, "ok": false, "error": "level"},
    {"name": "a gender written as a boolean", "set": ["loadout", "gender"], "value": true, "ok": false, "error": "gender"},
    {"name": "more talent points than the level has", "set": ["loadout", "level"], "value": 79, "ok": false, "error": "talents"},
    {"name": "a talent twice", "set": ["loadout", "talents", 1, "talent_id"], "value": 38, "ok": false, "error": "repeats a talent"},
    {"name": "talent rank 6", "set": ["loadout", "talents", 0, "rank"], "value": 6, "ok": false, "error": "rank"},
    {"name": "glyph slot 6", "set": ["loadout", "glyphs", 0, "slot"], "value": 6, "ok": false, "error": "slot"},
    {"name": "two glyphs in one slot", "set": ["loadout", "glyphs", 1, "slot"], "value": 0, "ok": false, "error": "glyph slot"},
    {"name": "two items in one slot", "set": ["loadout", "equipment", 1, "slot"], "value": 0, "ok": false, "error": "equipment slot"},
    {"name": "equipment slot 19", "set": ["loadout", "equipment", 0, "slot"], "value": 19, "ok": false, "error": "slot"},
    {"name": "an empty kit", "set": ["loadout", "kit"], "value": [], "ok": false, "error": "kit"},
    {"name": "a kit spell twice", "set": ["loadout", "kit", 1, "spell_id"], "value": 42842, "ok": false, "error": "kit spell"},
    {"name": "a spellbook without the kit", "set": ["loadout", "spellbook"], "value": [133, 168], "ok": false, "error": "lacks the kit spell"},
    {"name": "an unsorted spellbook", "set": ["loadout", "spellbook"], "value": [42917, 42842, 42914], "ok": false, "error": "sorted"},
    {"name": "no initial mana", "set": ["loadout", "initial", "max_mana"], "value": 0, "ok": false, "error": "max_mana"},
    {"name": "a non-ASCII description", "set": ["description"], "value": "café", "ok": false, "error": "description"},
    {"name": "an unknown loadout key", "set": ["loadout", "pet"], "value": 1, "ok": false, "error": "pet"},
    {"name": "not JSON", "raw": "{\"kind\": ", "ok": false, "error": "JSON"},
    {"name": "an array", "raw": "[]", "ok": false, "error": "object"}
  ]
}
