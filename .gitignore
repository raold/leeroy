# This repo lives in the install root, next to things it must never contain:
# the core source (its own git repo), the build tree, the WoW client, boost,
# DB dumps and Blizzard data archives. Ignore everything, then allow only what
# this repo owns.
/*
!/.gitignore
!/.gitattributes
!/.gitleaksignore
!/.github/
!/CLAUDE.md
!/README.md
!/LICENSE
!/references.bib
!/scripts/
!/modules/
!/config/
!/patches/
!/mind/
/mind/.venv/
/mind/.pytest_cache/
/mind/*.egg-info/
/mind/tests/console/e2e/node_modules/
!/voice/
/voice/.venv/
/voice/.pytest_cache/
/voice/*.egg-info/
/voice/build/
/voice/voice-data/
/voice/models/
/voice/cache/
/voice/hf-cache/
/voice/voice.toml
/voice/decision.toml
/voice/**/*.wav
/voice/**/*.onnx
/voice/**/*.bin
/voice/**/*.pt
/voice/**/*.safetensors
/voice/**/*.npy
/voice/**/*.flac
/voice/**/*.mp3
/voice/**/*.ogg
/voice/**/*.opus
/voice/**/*.m4a
/voice/**/*.gguf
/voice/**/*.pth
/voice/**/*.ckpt
/voice/.ruff_cache/
!/selfie/
/selfie/.venv/
/selfie/.pytest_cache/
/selfie/.ruff_cache/
/selfie/*.egg-info/
/selfie/build/
/selfie/**/*.safetensors
/selfie/**/*.jpg
/selfie/**/*.jpeg
/selfie/**/*.png
/selfie/**/*.webp
# The dojo: source only. Environments, recordings, checkpoints, models, local
# manifests and runtime configuration stay on this machine (dojo-runtime/ and
# dojo-data/ live next to the install root, outside this allowance).
!/dojo/
/dojo/.venv/
/dojo/.pytest_cache/
/dojo/*.egg-info/
/dojo/build/
/dojo/runs/
/dojo/data/
/dojo/manifests/
/dojo/checkpoints/
/dojo/models/
/dojo/.ruff_cache/
/dojo/**/*.pt
/dojo/**/*.pth
/dojo/**/*.ckpt
/dojo/**/*.safetensors
/dojo/**/*.onnx
/dojo/**/*.npy
/dojo/**/*.npz
/dojo/**/*.gguf
/dojo/**/provenance.json
/dojo/**/dojo.marker
# docs/ (design, research) and private/ are local dev docs for the owner and
# Claude only: deliberately not whitelisted, never pushed.

# ac-update.sh rollback state, local to this machine.
/scripts/.last-update
__pycache__/
