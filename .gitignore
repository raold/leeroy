# This repo lives in the install root, next to things it must never contain:
# the core source (its own git repo), the build tree, the WoW client, boost,
# DB dumps and Blizzard data archives. Ignore everything, then allow only what
# this repo owns.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/CLAUDE.md
!/README.md
!/LICENSE
!/scripts/
!/modules/
!/config/
!/patches/
!/mind/
/mind/.venv/
/mind/.pytest_cache/
/mind/*.egg-info/
!/voice/
/voice/.venv/
/voice/.pytest_cache/
/voice/*.egg-info/
/voice/build/
/voice/voice-data/
/voice/models/
/voice/cache/
/voice/hf-cache/
/voice/voice.toml
/voice/decision.toml
/voice/**/*.wav
/voice/**/*.onnx
/voice/**/*.bin
/voice/**/*.pt
/voice/**/*.safetensors
/voice/**/*.npy
/voice/**/*.flac
/voice/**/*.mp3
/voice/**/*.ogg
/voice/**/*.opus
/voice/**/*.m4a
/voice/**/*.gguf
/voice/**/*.pth
/voice/**/*.ckpt
/voice/.ruff_cache/
# docs/ (design, research) and private/ are local dev docs for the owner and
# Claude only: deliberately not whitelisted, never pushed.

# ac-update.sh rollback state, local to this machine.
/scripts/.last-update
__pycache__/
