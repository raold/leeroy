diff --git a/src/Ai/Dungeon/DungeonClear/Util/DcIcecrownPassDecision.h b/src/Ai/Dungeon/DungeonClear/Util/DcIcecrownPassDecision.h
new file mode 100644
index 0000000..ae08359
--- /dev/null
+++ b/src/Ai/Dungeon/DungeonClear/Util/DcIcecrownPassDecision.h
@@ -0,0 +1,34 @@
+#ifndef _PLAYERBOT_DCICECROWNPASSDECISION_H
+#define _PLAYERBOT_DCICECROWNPASSDECISION_H
+
+// ICC's script slots match its DBC encounter bits. This pass changes progression,
+// never the completed encounter mask. No reward is earned for the gunship.
+namespace DcIcecrownPass
+{
+    constexpr unsigned MapId = 631, Marrowgar = 0, Deathwhisper = 1, Gunship = 2, Saurfang = 3;
+    constexpr unsigned Hook = 70, Event = 1, CaptainData = 13;
+    constexpr unsigned RiseSpell = 70858;
+    constexpr float X = -549.073f, Y = 2211.29f, Z = 539.223f, O = 0.523333f;
+    inline bool IsArmory(unsigned entry)
+    {
+        switch (entry)
+        {
+            case 202178: case 202180: case 202177: case 202179:
+            case 201873: case 201874: case 201872: case 201875: return true;
+            default: return false;
+        }
+    }
+    inline bool Ready(unsigned marrowgar, unsigned deathwhisper, unsigned gunship,
+                      unsigned saurfang, bool botsOnly, bool ready)
+    {
+        return marrowgar == 3 && deathwhisper == 3 && (gunship == 0 || gunship == 2 || gunship == 3)
+            && (saurfang == 0 || saurfang == 2) && botsOnly && ready;
+    }
+    inline bool Outside(float x, float y, float z)
+    {
+        // The rise platform, not merely the upper floor: rampart bots also need
+        // the pass. Once Saurfang falls Ready stops all movement, in every wing.
+        return x < -600.0f || x > -450.0f || y < 2100.0f || y > 2300.0f || z < 530.0f || z > 560.0f;
+    }
+}
+#endif
