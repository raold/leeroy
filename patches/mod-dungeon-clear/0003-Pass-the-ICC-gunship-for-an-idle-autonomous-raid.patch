+
+namespace
+{
+    using namespace DcIcecrownPass;
+    struct RelockArmories
+    {
+        template<class T> void Visit(T&) {}
+        void Visit(std::unordered_map<ObjectGuid, GameObject*>& objects)
+        {
+            // Visit the already-loaded object store once. A radius scan here
+            // could load grids across the entire raid on the world thread.
+            for (auto const& item : objects)
+            {
+                GameObject* chest = item.second;
+                if (IsArmory(chest->GetEntry()))
+                    chest->SetGameObjectFlag(GO_FLAG_LOCKED | GO_FLAG_NOT_SELECTABLE | GO_FLAG_NODESPAWN);
+            }
+        }
+    };
+
+    bool Autonomous(Player* p)
+    {
+        if (!p || DcPlayerbotCompat::IsHumanControlled(p)) return false;
+        PlayerbotAI* ai = GET_PLAYERBOT_AI(p);
+        return ai && !DcPlayerbotCompat::IsRealPlayer(ai->GetMaster());
+    }
+
+    // A persisted instance-wide progression change is never made around a human,
+    // even one in another group. Require the whole raid to be present and idle;
+    // unknown/offline slots, another copy, a vehicle or a teleport all defer it.
+    bool Census(Player* bot, std::vector<Player*>& members)
+    {
+        if (!bot || bot->GetMapId() != MapId || !bot->GetGroup() || !bot->GetGroup()->isRaidGroup()) return false;
+        for (auto const& ref : bot->GetMap()->GetPlayers())
+            if (!Autonomous(ref.GetSource())) return false;
+        for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* m = ref->GetSource();
+            if (!Autonomous(m) || !m->IsInWorld() || m->GetMap() != bot->GetMap() || !m->IsAlive()
+                || m->IsInCombat() || m->IsBeingTeleported() || m->GetVehicle() || m->GetTransport()) return false;
+            members.push_back(m);
+        }
+        return !members.empty() && members.size() == bot->GetGroup()->GetMembersCount();
+    }
+
+    bool Eligible(Player* bot, std::vector<Player*>& members)
+    {
+        if (!Census(bot, members)) return false;
+        InstanceScript* inst = bot->GetInstanceScript();
+        return inst && !inst->IsEncounterInProgress() && Ready(inst->GetBossState(Marrowgar),
+            inst->GetBossState(Deathwhisper), inst->GetBossState(Gunship), inst->GetBossState(Saurfang), true, true);
+    }
+
+    bool LootPending(Player* bot, AiObjectContext* context)
+    {
+        return !context || context->GetValue<bool>(DcKey::Stock::HasAvailableLoot)->Get()
+            || context->GetValue<bool>(DcKey::Stock::CanLoot)->Get()
+            || DcPartyState::IsAnyPartyMemberLooting(bot);
+    }
+
+    bool PassDue(Player* bot, AiObjectContext* context)
+    {
+        std::vector<Player*> members;
+        if (!Eligible(bot, members) || LootPending(bot, context)) return false;
+        InstanceScript* inst = bot->GetInstanceScript();
+        if (inst->GetBossState(Gunship) != DONE) return true;
+        for (Player* m : members)
+            if (Outside(m->GetPositionX(), m->GetPositionY(), m->GetPositionZ())) return true;
+        Creature* captain = inst->GetCreature(CaptainData);
+        return captain && captain->IsAlive() && captain->IsVisible() && captain->HasNpcFlag(UNIT_NPC_FLAG_GOSSIP);
+    }
+
+    ObjectiveArriveResult Pass(Player* bot, AiObjectContext* context, DungeonBossInfo const&)
+    {
+        std::vector<Player*> members;
+        if (!context || !Eligible(bot, members) || LootPending(bot, context)) return ObjectiveArriveResult::Done;
+        InstanceScript* inst = bot->GetInstanceScript();
+        bool const opening = inst->GetBossState(Gunship) != DONE;
+        if (opening)
+        {
+            // Core CheckLowerSpire refuses Saurfang (and all later bosses) unless
+            // this slot is DONE. Do not call UpdateEncounterState, cast victory
+            // credit or kill a hull. SetBossState unlocks loaded armories, so put
+            // their original locks back synchronously, before any bot can loot.
+            if (!inst->SetBossState(Gunship, DONE) || inst->GetBossState(Gunship) != DONE)
+                return ObjectiveArriveResult::Done;
+            RelockArmories relock;
+            VisitorHelper(relock, bot->GetMap()->GetObjectsStore());
+            LOG_INFO("playerbots.dungeonclear", "dc_icc_gunship_pass instance={} earned=0", bot->GetInstanceId());
+        }
+        // The stock teleporter uses EFFECT_1, not EFFECT_0.
+        SpellTargetPosition const* target = sSpellMgr->GetSpellTargetPosition(RiseSpell, EFFECT_1);
+        float const x = target && target->target_mapId == MapId ? target->target_X : X;
+        float const y = target && target->target_mapId == MapId ? target->target_Y : Y;
+        float const z = target && target->target_mapId == MapId ? target->target_Z : Z;
+        float const o = target && target->target_mapId == MapId ? target->target_Orientation : O;
+        unsigned moved = 0;
+        for (Player* m : members)
+            if (Outside(m->GetPositionX(), m->GetPositionY(), m->GetPositionZ()))
+            {
+                m->GetMotionMaster()->Clear();
+                m->NearTeleportTo(x, y, z, o, false, false, true);
+                ++moved;
+            }
+        if (opening)
+            // Replay the script's normal saved-instance entry recovery. It restores
+            // hidden Saurfang actors when gunship is DONE, without running a
+            // ship victory, moving the transports, or awarding encounter credit.
+            inst->OnPlayerEnter(bot);
+        if (moved || opening) return ObjectiveArriveResult::Done;
+
+        Creature* captain = inst->GetCreature(CaptainData);
+        if (!captain || !captain->IsVisible() || !captain->HasNpcFlag(UNIT_NPC_FLAG_GOSSIP))
+            return ObjectiveArriveResult::Done;
+        DcRunState& st = DcRun::Of(context);
+        if (!st.Throttled(DcThrottle::IccIntro, 3000))
+        {
+            if (bot->GetDistance(captain) > 4.0f)
+                bot->GetMotionMaster()->MovePoint(0, captain->GetPositionX(), captain->GetPositionY(), captain->GetPositionZ());
+            else
+                DungeonEventExecutor::SelectGossip(bot, captain, 0);
+        }
+        return ObjectiveArriveResult::Running;
+    }
+}
+
+void RegisterIcecrownEvents(std::vector<DungeonEvent>& out)
+{
+    out.push_back(EventBuilder(DcIcecrownPass::MapId, DcIcecrownPass::Event, "Gunship pass and Saurfang intro")
+        .Conditional(&PassDue).Repeatable().Optional().StepsOwnMovement().Custom(DcIcecrownPass::Hook).Build());
+}
+
+void RegisterIcecrownHooks(ObjectiveHookRegistry::HookTable& out)
+{
+    ObjectiveHookRegistry::AddHook(out, DcIcecrownPass::Hook, &Pass);
+}
