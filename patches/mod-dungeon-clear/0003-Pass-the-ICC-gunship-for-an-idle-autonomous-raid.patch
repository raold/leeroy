diff --git a/t/TestIcecrown.cpp b/t/TestIcecrown.cpp
new file mode 100644
index 0000000..86d6b21
--- /dev/null
+++ b/t/TestIcecrown.cpp
@@ -0,0 +1,54 @@
+#include "gtest/gtest.h"
+#include "Ai/Dungeon/DungeonClear/Data/DungeonEventRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Overrides/ObjectiveHookRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcIcecrownPassDecision.h"
+using namespace DcIcecrownPass;
+TEST(Icecrown, RequiresBothRealPredecessorsAndAnIdleSaurfang)
+{
+    for (unsigned first = 0; first < 6; ++first)
+        for (unsigned second = 0; second < 6; ++second)
+            for (unsigned ship = 0; ship < 6; ++ship)
+                for (unsigned last = 0; last < 6; ++last)
+                    EXPECT_EQ(Ready(first, second, ship, last, true, true),
+                        first == 3 && second == 3 && (ship == 0 || ship == 2 || ship == 3) && (last == 0 || last == 2));
+}
+TEST(Icecrown, HumansMissingMembersAndBusyPartiesDefer)
+{
+    EXPECT_FALSE(Ready(3, 3, 0, 0, false, true));
+    EXPECT_FALSE(Ready(3, 3, 0, 0, true, false));
+}
+TEST(Icecrown, RecoveryMovesEntranceAndRampartsButNotTheRise)
+{
+    EXPECT_TRUE(Outside(-17, 2211, 30));
+    EXPECT_TRUE(Outside(-615, 2211, 199));
+    EXPECT_TRUE(Outside(-435, 2400, 539));
+    EXPECT_FALSE(Outside(X, Y, Z));
+    EXPECT_FALSE(Outside(-522, 2248, 539));
+    EXPECT_FALSE(Ready(3, 3, 3, 3, true, true));
+}
+
+TEST(Icecrown, PassIsRegisteredAndRearmsAfterWipes)
+{
+    auto const* event = DungeonEventRegistry::Find(MapId, Event);
+    ASSERT_NE(event, nullptr);
+    EXPECT_TRUE(event->repeatable);
+    EXPECT_FALSE(event->required);
+    ASSERT_TRUE(event->condition);
+    EXPECT_FALSE(event->condition(nullptr, nullptr));
+    EXPECT_EQ(event->activation, EventActivation::Conditional);
+    EXPECT_FALSE(event->encounterActive);
+    EXPECT_FALSE(event->drivesInCombat);
+    EXPECT_TRUE(ObjectiveHookRegistry::Has(Hook));
+    EXPECT_TRUE(event->stepsOwnMovement);
+    ASSERT_EQ(event->steps.size(), 1u);
+    EXPECT_EQ(event->steps[0].kind, EventStepKind::Custom);
+    EXPECT_EQ(event->steps[0].hookId, Hook);
+}
+
+TEST(Icecrown, RelocksBothFactionsAndAllSizesWithoutTouchingOtherLoot)
+{
+    for (unsigned entry : {202178u,202180u,202177u,202179u,201873u,201874u,201872u,201875u})
+        EXPECT_TRUE(IsArmory(entry));
+    EXPECT_FALSE(IsArmory(202239)); // Saurfang cache
+    EXPECT_FALSE(IsArmory(195046)); // Kologarn cache
+}
