+// --- Trial of the Crusader (map 649) -----------------------------------------
+//
+// Every boss is SUMMONED by the instance script (instance_trial_of_the_crusader.cpp)
+// and every stage is started by one NPC: Barrett Ramsey, whom the script summons
+// at the south end of the arena whenever the next stage may start — when the
+// instance is created, a few seconds after each kill, and after every wipe's
+// InstanceCleanup (then with his "another shot" text and option). His gossip is
+// SmartAI (2026_10_16_00.sql): his menu's first visible option opens the stage's
+// action menu, whose first visible option sets instance data
+// TYPE_ANNOUNCER_GOSSIP_SELECT; he then drops his gossip flag, walks to the exit
+// and despawns. So "Barrett offers his gossip" is the one live signal that the
+// raid may start the next stage, and it needs no latch: the script offers it again
+// after every wipe. BossSpawnIndex derives an EMPTY roster here (no boss has a
+// creature row), which is why `dc on` used to refuse the map.
+//
+// THE SHAPE: five anchored holds in the arena (one per stage, each done when the
+// script's own boss slot reads DONE, the fifth also once the floor is down), a
+// boss row for Anub'arak in the chamber below, and two conditional drivers: the
+// Barrett driver (hook 67: click him, and pull the champions and the twins, which
+// do not come on their own) and the descent (hook 68: put the bots into
+// Anub'arak's chamber — the floor collapses under a player and he falls, but a
+// clientless bot never falls).
+//
+// PATHFINDING IS OFF ON THIS MAP (DisableMgr::IsPathfindingEnabled, 649 like
+// 650): every move is a straight line. Nothing here leaves the arena bowl or the
+// chamber below it, and the one way between them is the descent's teleport.
+namespace DcTrialOfTheCrusader
+{
+    constexpr uint32 MAP_ID = 649;
+
+    // --- instance data (trial_of_the_crusader.h) -------------------------------
+    //
+    // Boss slots match DungeonEncounter.dbc's encounter indexes (the header says
+    // so), so the slot and the DBC bit are the same number here.
+    constexpr uint32 BOSS_NORTHREND_BEASTS  = 0;
+    constexpr uint32 BOSS_JARAXXUS          = 1;
+    constexpr uint32 BOSS_FACTION_CHAMPIONS = 2;
+    constexpr uint32 BOSS_TWIN_VALKYR       = 3;
+    constexpr uint32 BOSS_ANUBARAK          = 4;
+    constexpr uint32 BOSS_COUNT             = 5;
+
+    // GetData answers only TYPE_INSTANCE_PROGRESS; GetGuidData(DATA_BARRETT)
+    // resolves whichever Barrett entry is up (ObjectData creatureData).
+    constexpr uint32 TYPE_INSTANCE_PROGRESS = 1;
+    constexpr uint32 DATA_BARRETT           = 0;
+
+    // --- TYPE_INSTANCE_PROGRESS (enum Progress) ---------------------------------
+    //
+    // It only ever moves forward (InstanceCleanup despawns and fails the stage, it
+    // never lowers this counter), and Barrett's gossip at each value starts that
+    // stage or its retry.
+    constexpr uint32 PROGRESS_INITIAL             = 0;
+    constexpr uint32 PROGRESS_INTRO_DONE          = 1;  // the beasts' retry point
+    constexpr uint32 PROGRESS_BEASTS_DEAD         = 2;
+    constexpr uint32 PROGRESS_JARAXXUS_INTRO_DONE = 3;  // Jaraxxus' retry point
+    constexpr uint32 PROGRESS_JARAXXUS_DEAD       = 4;
+    constexpr uint32 PROGRESS_CHAMPIONS_DEAD      = 6;
+    constexpr uint32 PROGRESS_VALKYR_DEAD         = 8;  // the Lich King's Barrett
+    constexpr uint32 PROGRESS_ANUB_ARAK           = 9;  // the floor is down, he is up
+    constexpr uint32 PROGRESS_DONE                = 10;
+
+    // --- creatures ---------------------------------------------------------------
+    //
+    // Barrett is a different entry per stage (GetBarrettEntry); the driver never
+    // looks him up by entry, only through GetGuidData(DATA_BARRETT). The entries
+    // are here for the record and the registry pins.
+    constexpr uint32 NPC_BARRETT_BEASTS            = 34816;
+    constexpr uint32 NPC_BARRETT_BEASTS_HC         = 35909;
+    constexpr uint32 NPC_BARRETT_JARAXXUS          = 35035;
+    constexpr uint32 NPC_BARRETT_FACTION_CHAMPIONS = 35766;
+    constexpr uint32 NPC_BARRETT_VALKYR            = 35770;
+    constexpr uint32 NPC_BARRETT_LICH_KING         = 35771;
+
+    constexpr uint32 NPC_ICEHOWL   = 34797;  // the beasts' kill credit (bit 0)
+    constexpr uint32 NPC_JARAXXUS  = 34780;
+    constexpr uint32 NPC_LIGHTBANE = 34497;
+    constexpr uint32 NPC_DARKBANE  = 34496;  // the twins' kill credit (bit 3)
+    constexpr uint32 NPC_ANUBARAK  = 34564;
+
+    // The faction champions: Horde ones for an Alliance raid and the other way
+    // round. They are summoned on a balcony, jump down to the west (Alliance raid)
+    // or east floor and are released REACT_AGGRESSIVE and attackable — 30-45yd
