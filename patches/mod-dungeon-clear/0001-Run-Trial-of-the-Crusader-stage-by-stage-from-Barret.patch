+TEST(TrialOfTheCrusader, VerdictStateAndActionAgree)
+{
+    std::vector<DcTocRaid::Inputs> cases;
+    for (bool combat : { false, true })
+        for (bool inProgress : { false, true })
+            for (uint32 idle : { 0u, 3u })
+                for (bool engaged : { false, true })
+                    for (bool flagged : { false, true })
+                        for (float dist : { -1.0f, 2.0f, 30.0f })
+                            for (bool muster : { false, true })
+                                for (bool loot : { false, true })
+                                {
+                                    DcTocRaid::Inputs in = AtClick();
+                                    in.partyInCombat = combat;
+                                    in.encounterInProgress = inProgress;
+                                    in.idleTargets = idle;
+                                    in.targetsEngaged = engaged;
+                                    in.barrettFlagged = flagged;
+                                    in.barrettDist = dist;
+                                    in.musterHolds = muster;
+                                    in.lootPending = loot;
+                                    cases.push_back(in);
+                                }
+
+    for (DcTocRaid::Inputs const& in : cases)
+    {
+        DcTocRaid::Verdict const v = DcTocRaid::Decide(in);
+        switch (v.state)
+        {
+            case State::Click:    EXPECT_EQ(v.action, Action::Gossip); break;
+            case State::Approach: EXPECT_EQ(v.action, Action::ApproachBarrett); break;
+            case State::Pulling:  EXPECT_EQ(v.action, Action::Engage); break;
+            case State::Holding:
+            case State::Muster:   EXPECT_EQ(v.action, Action::Hold); break;
+            default:              EXPECT_EQ(v.action, Action::Yield); break;
+        }
+        if (v.action == Action::Gossip)
+        {
+            EXPECT_FALSE(in.partyInCombat);
+            EXPECT_FALSE(in.encounterInProgress);
+            EXPECT_TRUE(in.barrettFlagged);
+            EXPECT_FALSE(in.musterHolds);
+        }
+        if (v.action == Action::Engage)
+        {
+            EXPECT_TRUE(in.encounterInProgress);
+            EXPECT_FALSE(in.targetsEngaged);
+            EXPECT_GT(in.idleTargets, 0u);
+        }
+    }
+}
