diff --git a/t/TestTrialOfTheCrusader.cpp b/t/TestTrialOfTheCrusader.cpp
new file mode 100644
index 0000000..f492631
--- /dev/null
+++ b/t/TestTrialOfTheCrusader.cpp
@@ -0,0 +1,601 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+// Trial of the Crusader (map 649).
+//
+// Two halves, the module's usual split:
+//
+//   1. THE KERNELS (DcTocRaid::Decide, DcTocRaid::DescentDue) — the whole of hook
+//      67's and hook 68's per-tick reasoning, exercised without a map: the click
+//      and what holds it, the pulls, the hold while a stage is in progress, the
+//      wipe retry, the descent.
+//
+//   2. THE AUTHORED DATA — five objectives and Anub'arak's row, the seven event
+//      rows and their flags, and the pins hand-copied out of
+//      trial_of_the_crusader.h.
+//
+// THE MOST IMPORTANT ASSERTIONS are the pins. Every hold on this map is a
+// comparison against a boss slot or TYPE_INSTANCE_PROGRESS, and a wrong value is
+// a silent permanent hold.
+
+#include "gtest/gtest.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+#include <set>
+#include <vector>
+
+#include "InstanceScript.h"
+
+#include "Ai/Dungeon/DungeonClear/Data/DungeonBossInfo.h"
+#include "Ai/Dungeon/DungeonClear/Data/DungeonEventRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Data/Events/DungeonEventTables.h"
+#include "Ai/Dungeon/DungeonClear/DcCapabilities.h"
+#include "Ai/Dungeon/DungeonClear/Overrides/BossRosterRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Overrides/ObjectiveHookRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcEncounterChests.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h"
+
+using namespace DcTrialOfTheCrusader;
+using DcTocRaid::Action;
+using DcTocRaid::State;
+
+namespace
+{
+    constexpr uint32 NOW = 1'000'000;
+
+    // Progress 2 (the beasts dead), Barrett up, offering and 3yd away, nobody in
+    // combat, no stage in progress, nothing to loot. Each test breaks one thing.
+    DcTocRaid::Inputs AtClick()
+    {
+        DcTocRaid::Inputs in;
+        in.progress = PROGRESS_BEASTS_DEAD;
+        in.alive = true;
+        in.barrettPresent = true;
+        in.barrettFlagged = true;
+        in.barrettDist = 3.0f;
+        in.nowMs = NOW;
+        return in;
+    }
+
+    // The champions' stage released: IN_PROGRESS, out of combat, Barrett gone.
+    DcTocRaid::Inputs ChampionsReleased()
+    {
+        DcTocRaid::Inputs in = AtClick();
+        in.progress = PROGRESS_JARAXXUS_DEAD;
+        in.encounterInProgress = true;
+        in.barrettPresent = false;
+        in.barrettFlagged = false;
+        in.barrettDist = -1.0f;
+        in.idleTargets = 6;
+        return in;
+    }
+
+    DungeonEvent const* Ev(uint32 id) { return DungeonEventRegistry::Find(MAP_ID, id); }
+
+    BossRosterPatch const* Patch()
+    {
+        for (BossRosterPatch const& p : BossRosterRegistry::AllPatches())
+            if (p.mapId == MAP_ID)
+                return &p;
+        return nullptr;
+    }
+
+    DungeonBossInfo const* Row(BossRosterPatch const& p, uint32 entry)
+    {
+        for (DungeonBossInfo const& b : p.add)
+            if (b.entry == entry)
+                return &b;
+        return nullptr;
+    }
+}
+
+// ===========================================================================
+//  1. THE PINS — hand-copied from trial_of_the_crusader.h
+// ===========================================================================
+
+TEST(TrialOfTheCrusader, InstanceDataAndProgressValuesMatchTheCore)
+{
+    // enum TrialOfTheCrusaderBossIds, "matching DungeonEncounter.dbc encounter indexes".
+    EXPECT_EQ(BOSS_NORTHREND_BEASTS, 0u);
+    EXPECT_EQ(BOSS_JARAXXUS, 1u);
+    EXPECT_EQ(BOSS_FACTION_CHAMPIONS, 2u);
