+// --- Trial of the Crusader (map 649) -----------------------------------------
+//
+// The constants, and the reasoning behind them, live in namespace
+// DcTrialOfTheCrusader in DungeonEventTables.h. This file is the authored shape:
+// five anchored holds in the arena, two conditional drivers, one roster patch.
+//
+// THE SHAPE IS TRIAL OF THE CHAMPION'S. Each stage is an objective whose event
+// walks the tank to the stage and holds there until the script's slot for that
+// stage reads DONE. The holds do nothing else — they do not talk to Barrett, pull
+// or muster. That is the Barrett driver's job, and it outranks them (EventDue 31 >
+// AtObjective 30) whenever it claims the tick.
+//
+// A WIPE NEEDS NOTHING FROM THE HOLDS. InstanceCleanup fails the stage, despawns
+// what it summoned and summons Barrett again with his "another shot" option; the
+// hold keeps holding (its slot never read DONE), and the driver clicks him again.
+
+namespace
+{
+    using namespace DcTrialOfTheCrusader;
+
+    // --- event 6's gate: the arena is ours until the floor goes ------------------
+    //
+    // DUE for the whole arena part of the run, as Trial of the Champion's driver
+    // is: every actor the driver deals with stands inside the bowl, and it owns its
+    // own movement.
+    bool TocRaidDriverDue(Player* bot, AiObjectContext* /*context*/)
+    {
+        if (!bot || bot->GetMapId() != MAP_ID)
+            return false;
+
+        InstanceScript* inst = DcTargeting::GetInstanceScript(bot);
+        return inst && inst->GetData(TYPE_INSTANCE_PROGRESS) < PROGRESS_ANUB_ARAK;
+    }
+
+    // --- event 7's gate: a bot left at arena level once the floor is down ----------
+    bool TocRaidDescentDue(Player* bot, AiObjectContext* /*context*/)
+    {
+        if (!bot || bot->GetMapId() != MAP_ID)
+            return false;
+
+        InstanceScript* inst = DcTargeting::GetInstanceScript(bot);
+        if (!inst)
+            return false;
+
+        uint32 above = 0;
+        auto const count = [&](Player* m)
+        {
+            if (m && m->IsInWorld() && m->IsAlive() && m->GetMapId() == bot->GetMapId() &&
+                GET_PLAYERBOT_AI(m) && !DcPlayerbotCompat::IsHumanControlled(m) && !m->GetVehicle() &&
+                DcTocRaid::AboveSplit(m->GetPositionZ()))
+                ++above;
+        };
+        if (Group* group = bot->GetGroup())
+        {
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                count(ref->GetSource());
+        }
+        else
+            count(bot);
+
+        return DcTocRaid::DescentDue(inst->GetData(TYPE_INSTANCE_PROGRESS), bot->IsAlive(), above);
+    }
+
+    // One arena hold: walk onto the stage, then garrison it until `slot` reads DONE.
+    // The leading MoveTo is the sticky-at-step-1 rule (a persistent anchored event
+    // only lets the tank leave its anchor once its front step is a MoveTo, and the
+    // fights range across the bowl). The garrison re-parks the tank after each
+    // fight and, once arrived, yields to NeedsRest when the raid is short.
+    DungeonEvent StageHold(uint32 eventId, char const* name, uint32 order, uint32 slot)
+    {
+        return EventBuilder(MAP_ID, eventId, name)
+            .Anchored(order)
+            .Persistent()
+            .MoveTo(STAGE_X, STAGE_Y, STAGE_Z, OBJ_ARRIVE)
+            .MoveToHoldUntilBossState(STAGE_X, STAGE_Y, STAGE_Z, HOLD_RADIUS, slot, DcBossStateBit(DONE))
+                .Timeout(STAGE_TIMEOUT_MS)
+            .Build();
+    }
+}
+
+std::vector<uint32> const& TocRaidPullEntries()
+{
+    static std::vector<uint32> const kEntries = []
+    {
+        std::vector<uint32> v(std::begin(NPC_CHAMPIONS), std::end(NPC_CHAMPIONS));
+        v.push_back(NPC_LIGHTBANE);
+        v.push_back(NPC_DARKBANE);
+        return v;
+    }();
+    return kEntries;
+}
+
+void RegisterTrialOfTheCrusaderEvents(std::vector<DungeonEvent>& out)
+{
+    // (1)-(4) THE ARENA STAGES — anchored on OBJ(1..4), each held until its slot
+    // reads DONE. Out of combat only; the driver claims every tick it needs above
+    // them.
+    out.push_back(StageHold(EVENT_BEASTS, "The Northrend Beasts", ORDER_BEASTS, BOSS_NORTHREND_BEASTS));
+    out.push_back(StageHold(EVENT_JARAXXUS, "Lord Jaraxxus", ORDER_JARAXXUS, BOSS_JARAXXUS));
+    out.push_back(StageHold(EVENT_CHAMPIONS, "The Faction Champions", ORDER_CHAMPIONS, BOSS_FACTION_CHAMPIONS));
+    out.push_back(StageHold(EVENT_VALKYR, "The Twin Val'kyr", ORDER_VALKYR, BOSS_TWIN_VALKYR));
+
+    // (5) THE LICH KING — the last arena hold. After the twins a fifth Barrett
+    // offers his gossip (the script also starts the scene by itself 60s later);
+    // the scene ends with the floor broken and progress 9, which is this hold's
+    // gate and its objective's done signal (doneInstanceData). From there the
+    // descent and Anub'arak's row take over.
+    out.push_back(
+        EventBuilder(MAP_ID, EVENT_LICH_KING, "The Lich King")
+            .Anchored(ORDER_LICH_KING)
+            .Persistent()
+            .MoveTo(STAGE_X, STAGE_Y, STAGE_Z, OBJ_ARRIVE)
+            .MoveToHoldUntilInstanceData(STAGE_X, STAGE_Y, STAGE_Z, HOLD_RADIUS,
+                                         TYPE_INSTANCE_PROGRESS, PROGRESS_ANUB_ARAK)
+                .Timeout(STAGE_TIMEOUT_MS)
+            .Build());
+
+    // (6) BARRETT RAMSEY — the conditional driver.
+    //
+    // ONE Custom step for the reason Trial of the Champion's driver is one: what
+    // the arena needs is a standing preference re-decided every tick from live
+    // state (is Barrett offering? is a stage in progress with nothing engaged?),
+    // not a sequence a wipe would leave half-run.
+    //
+    // ENCOUNTER ACTIVE so it still drives while the raid boss stand-down holds:
+    // a stage reads IN_PROGRESS from the moment its bosses are released, and the
+    // champions and twins wait out of combat in exactly that window. It never
+    // steers under fire (no DrivesInCombat): every fight is the stock engine's.
+    //
+    // STEPS OWN MOVEMENT because it walks the tank to Barrett itself, and because
+    // that is what makes a Done return YIELD the tick.
+    //
+    // OWNS THE PULL: the arena has no trash, only stages.
+    //
+    // REPEATABLE because it never completes — the predicate going false at
+    // progress 9 is what ends it — and so that its step timeout re-arms rather
+    // than skips. PERSISTENT so a combat gap cannot rewind it.
+    out.push_back(
+        EventBuilder(MAP_ID, EVENT_DRIVER, "Barrett Ramsey")
+            .Conditional(&TocRaidDriverDue)
+            .Repeatable()
+            .Persistent()
+            .Optional()
+            .OwnsThePull()
+            .EncounterActive()
+            .StepsOwnMovement()
+            .Custom(HOOK_TOCR_DRIVER)
+                .Timeout(DRIVER_TIMEOUT_MS)
+            .Build());
+
+    // (7) THE DESCENT — conditional: due while the floor is down and a bot of the
+    // party is still at arena level. ENCOUNTER ACTIVE so a straggler is brought
+    // down even while Anub'arak's fight holds the stand-down.
+    out.push_back(
+        EventBuilder(MAP_ID, EVENT_DESCENT, "Into Anub'arak's chamber")
+            .Conditional(&TocRaidDescentDue)
+            .Repeatable()
+            .Optional()
+            .EncounterActive()
+            .StepsOwnMovement()
+            .Custom(HOOK_TOCR_DESCENT)
+            .Build());
+}
+
+// --- the roster: five objectives and Anub'arak -------------------------------------
+//
+// The objectives' encounterIndex is an ordering hint only (objectives never read
+// the completed mask); the order is orderOverride, and each one is finished by the
+// script's own slot (doneBossStateIndex), read live, so a re-entered instance
+// skips the stages already won. The Lich King's is also finished while progress
+// reads 9 (doneInstanceData): from then on the arena is behind the raid.
+//
+// Anub'arak is the one real boss row: his kill credit (34564, bit 4) is a creature
+// kill, and he stands still in his chamber, so the ordinary approach, raid muster
+// and engage take him. He is NON_ATTACKABLE until a player comes within 80yd.
+void RegisterTrialOfTheCrusaderRoster(std::vector<BossRosterPatch>& t)
+{
+    using namespace DcRoster;
+
+    auto stage = [](uint32 eventId, char const* name, uint32 order, int32 slot)
+    {
+        DungeonBossInfo o = MakeObjective(OBJ(eventId), /*encounterIndex*/ 0, MAP_ID, name,
+                                          STAGE_X, STAGE_Y, STAGE_Z, OBJ_ARRIVE,
+                                          /*gateEntry*/ 0, /*hook*/ 0, eventId,
+                                          static_cast<int32>(order));
+        o.doneBossStateIndex = slot;
+        return o;
+    };
+
+    BossRosterPatch p;
+    p.mapId = MAP_ID;
+    p.add = {
+        stage(EVENT_BEASTS, "The Northrend Beasts", ORDER_BEASTS, BOSS_NORTHREND_BEASTS),
+        stage(EVENT_JARAXXUS, "Lord Jaraxxus", ORDER_JARAXXUS, BOSS_JARAXXUS),
+        stage(EVENT_CHAMPIONS, "The Faction Champions", ORDER_CHAMPIONS, BOSS_FACTION_CHAMPIONS),
+        stage(EVENT_VALKYR, "The Twin Val'kyr", ORDER_VALKYR, BOSS_TWIN_VALKYR),
+    };
+
+    DungeonBossInfo lichKing = stage(EVENT_LICH_KING, "The Lich King", ORDER_LICH_KING, BOSS_ANUBARAK);
+    lichKing.doneInstanceDataId = static_cast<int32>(TYPE_INSTANCE_PROGRESS);
+    lichKing.doneInstanceDataValue = PROGRESS_ANUB_ARAK;
+    p.add.push_back(lichKing);
+
+    p.add.push_back(MakeBossWithBit(NPC_ANUBARAK, MAP_ID, "Anub'arak", ANUB_X, ANUB_Y, ANUB_Z,
+                                    BOSS_ANUBARAK, static_cast<int32>(ORDER_ANUBARAK)));
+    t.push_back(std::move(p));
+}
