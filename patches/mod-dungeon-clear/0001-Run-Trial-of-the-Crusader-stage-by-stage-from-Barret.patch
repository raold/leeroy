diff --git a/src/Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h b/src/Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h
new file mode 100644
index 0000000..634e653
--- /dev/null
+++ b/src/Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h
@@ -0,0 +1,247 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef _PLAYERBOT_DCTOCRAIDDECISION_H
+#define _PLAYERBOT_DCTOCRAIDDECISION_H
+
+#include <cstdint>
+
+#include "Define.h"
+
+#include "Ai/Dungeon/DungeonClear/Data/Events/DungeonEventTables.h"
+
+// PURE kernels for the Trial of the Crusader (map 649): everything hook 67 (the
+// Barrett driver) and hook 68 (the descent) decide each tick, lifted out of the
+// world so they can be tested without a map. The glue (the censuses, the moves,
+// the click, the force-pull, the teleport and the telemetry) lives in
+// Overrides/TrialOfTheCrusaderDriver.cpp.
+//
+// WHAT THE DRIVER IS FOR. The five arena objectives only HOLD the raid at the
+// stage until the script's boss slot reads DONE. Nothing in the ordinary clear
+// can start a stage, because nothing in it is a boss until a stage has started.
+// Two things do, and they are this driver's whole job:
+//
+//   * THE CLICK. Barrett offers his gossip exactly when the script will start the
+//     next stage (or the failed one again): summoned a few seconds after each
+//     kill and after every wipe's cleanup. So the rule is a pure function of live
+//     state with no latch: he is up and offering, the raid is out of combat, the
+//     last kill's loot is taken (bounded), the raid muster is ready -> talk to him.
+//   * THE PULLS. The faction champions and the twins are released aggressive and
+//     attackable but 25-45yd from the stage, and nothing brings them in. While a
+//     stage is IN_PROGRESS and nothing of it is engaged, pull the nearest idle
+//     one; the first champion engaged brings the rest (TYPE_FACTION_CHAMPIONS_START)
+//     and either twin her sister.
+//
+// AND ONE THING IT MUST NOT DO: hand an IN_PROGRESS stage's out-of-combat ticks
+// to the ladder. The twins are released 3.25s after their slot goes IN_PROGRESS;
+// in that window the raid HOLDS where it stands.
+//
+// From progress 9 (the floor is down) the driver is done: the descent puts the
+// bots into the chamber below, and Anub'arak is an ordinary boss row.
+//
+// THE RETURN CONTRACT is the module's: Yield is "Done" (hand the tick back: the
+// anchored hold re-parks the tank at the stage and rests the raid), everything
+// else is "Running" (claim it). Blocked is never returned.
+namespace DcTocRaid
+{
+    enum class State : uint8
+    {
+        Complete = 0,  // progress 9+: the floor is down
+        Down,          // the leader is dead
+        Fighting,      // somebody in the party is engaged
+        Pulling,       // a stage is IN_PROGRESS and a champion / twin waits: pull it
+        Holding,       // a stage is IN_PROGRESS with nothing to pull yet: stand still
+        Looting,       // the last kill's loot is still being taken
+        AwaitBarrett,  // Barrett is not up, or not offering (an intro, an outro)
+        Approach,      // walking to Barrett
+        Muster,        // at Barrett, the raid muster holds the click
+        Click,         // talking to Barrett
+    };
+
+    inline char const* StateName(State s)
+    {
+        switch (s)
+        {
+            case State::Down:         return "leader down";
+            case State::Fighting:     return "fighting";
+            case State::Pulling:      return "pulling an idle champion / twin";
+            case State::Holding:      return "holding: the stage is in progress";
+            case State::Looting:      return "waiting for the loot";
+            case State::AwaitBarrett: return "waiting for Barrett Ramsey";
+            case State::Approach:     return "walking to Barrett Ramsey";
+            case State::Muster:       return "mustering the raid at Barrett Ramsey";
+            case State::Click:        return "talking to Barrett Ramsey";
+            case State::Complete:
+            default:                  return "complete";
+        }
+    }
+
+    enum class Action : uint8
+    {
+        Yield,            // Done: hand the tick back
+        Hold,             // Running: issue nothing
+        ApproachBarrett,  // point-move to GOSSIP_STANDOFF of Barrett
+        Gossip,           // SelectGossip(Barrett, option 0) — the drill-down does the rest
+        Engage,           // force-pull the nearest idle attackable champion / twin
+    };
+
+    struct Inputs
+    {
+        uint32 progress = 0;            // GetData(TYPE_INSTANCE_PROGRESS)
+        bool   alive = true;            // the leader itself
+        bool   partyInCombat = false;   // engagement, not the raw flag
+        bool   encounterInProgress = false;  // a stage's boss slot reads IN_PROGRESS
+
+        // --- the pulls (censused only while a stage is in progress) ---------------
+        uint32 idleTargets = 0;         // champions / twins alive, attackable, not in combat
+        bool   targetsEngaged = false;  // any of them in combat
+
+        // --- the click ---------------------------------------------------------------
+        bool   lootPending = false;     // the stock loot flags, or a member still looting
+        bool   barrettPresent = false;  // GetGuidData(DATA_BARRETT) resolves, alive
+        bool   barrettFlagged = false;  // UNIT_NPC_FLAG_GOSSIP
+        float  barrettDist = -1.0f;
+        // DC_HOOK_RAID_MUSTER says hold. The glue evaluates it only once the kernel
+        // has decided to click (it advances a phase machine), then decides again.
+        bool   musterHolds = false;
+
+        // --- clocks the kernel round-trips (getMSTime()) ----------------------------
+        uint32 nowMs = 0;
+        uint32 lootSinceMs = 0;   // loot pending since (0 = not pending)
+        uint32 clickSinceMs = 0;  // first click on this offer (0 = none)
+    };
+
+    struct Verdict
+    {
+        State  state = State::AwaitBarrett;
+        Action action = Action::Yield;
+        bool   complete = false;
+        uint32 lootSinceMs = 0;
+        uint32 clickSinceMs = 0;
+        // Barrett has kept offering CLICK_WARN_MS past the first click: the clicks
+        // are not landing (a heroic Barrett whose first option is the "I have not
+        // completed the Trial" dead end for a clicker without the achievement).
+        bool   clickStuck = false;
+    };
+
+    inline Verdict Decide(Inputs const& in)
+    {
+        using namespace DcTrialOfTheCrusader;
+
+        Verdict v;
+        v.lootSinceMs = in.lootSinceMs;
+        v.clickSinceMs = in.clickSinceMs;
+
+        if (in.progress >= PROGRESS_ANUB_ARAK)
+        {
+            v.state = State::Complete;
+            v.complete = true;
+            v.lootSinceMs = 0;
+            v.clickSinceMs = 0;
+            return v;
+        }
+
+        if (!in.alive)
+        {
+            v.state = State::Down;
+            return v;
+        }
+
+        // The click clock measures one offer: it stops the moment he is gone or
+        // stops offering (a click that landed does exactly that).
+        bool const offering = in.barrettPresent && in.barrettFlagged;
+        if (!offering)
+            v.clickSinceMs = 0;
+
+        if (in.partyInCombat)
+        {
+            v.state = State::Fighting;
+            v.lootSinceMs = 0;  // the loot after this fight is a fresh wait
+            return v;
+        }
+
+        if (in.encounterInProgress)
+        {
+            v.lootSinceMs = 0;
+            if (in.idleTargets > 0 && !in.targetsEngaged)
+            {
+                v.state = State::Pulling;
+                v.action = Action::Engage;
+                return v;
+            }
+            v.state = State::Holding;
+            v.action = Action::Hold;
+            return v;
+        }
+
+        if (in.lootPending)
+        {
+            if (!v.lootSinceMs)
+                v.lootSinceMs = in.nowMs ? in.nowMs : 1;
+            if (in.nowMs - v.lootSinceMs < LOOT_WAIT_MS)
+            {
+                v.state = State::Looting;
+                return v;
+            }
+            // Past the cap: the loot is not finishing (a roll nobody answers, full
+            // bags). Go on as if there were none; the clock stays expired.
+        }
+        else
+            v.lootSinceMs = 0;
+
+        if (!offering)
+        {
+            v.state = State::AwaitBarrett;
+            return v;
+        }
+
+        if (in.barrettDist < 0.0f || in.barrettDist > GOSSIP_REACH)
+        {
+            v.state = State::Approach;
+            v.action = Action::ApproachBarrett;
+            return v;
+        }
+
+        if (in.musterHolds)
+        {
+            v.state = State::Muster;
+            v.action = Action::Hold;
+            return v;
+        }
+
+        v.state = State::Click;
+        v.action = Action::Gossip;
+        if (!v.clickSinceMs)
+            v.clickSinceMs = in.nowMs ? in.nowMs : 1;
+        v.clickStuck = in.nowMs - v.clickSinceMs >= CLICK_WARN_MS;
+        return v;
+    }
+
+    // --- the descent (hook 68) ------------------------------------------------------
+    //
+    // At progress 9 the Lich King breaks the arena floor (GO 195527 DAMAGED) and
+    // knocks everyone up; a player falls into Anub'arak's chamber, 250yd below. A
+    // bot has no client to fall with: it stays where it stood, over a floor that is
+    // no longer there. So once the floor is down, every bot still at arena level is
+    // put on the chamber floor — the module's TeleportParty answer to a one-way drop
+    // a bot cannot make (the Azjol-Nerub and Gundrak pattern). A person in the party
+    // falls on their own and is never moved.
+    //
+    // Due while the floor is down and any bot of the party is still up there: that
+    // covers the descent itself and every later straggler (a member the offline
+    // raid's restart or recall puts back at the entrance).
+    inline bool DescentDue(uint32 progress, bool leaderAlive, uint32 botsAboveSplit)
+    {
+        return progress >= DcTrialOfTheCrusader::PROGRESS_ANUB_ARAK && leaderAlive && botsAboveSplit > 0;
+    }
+
+    // Is a member at z still at arena level?
+    inline bool AboveSplit(float z)
+    {
+        return z > DcTrialOfTheCrusader::SPLIT_Z;
+    }
+}
+
+#endif
