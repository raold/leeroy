+    // engaged (its JustEngagedWith sets TYPE_FACTION_CHAMPIONS_START) sends all of
+    // them. The twins are released the same way 37yd off, at the north corners.
+    constexpr uint32 NPC_CHAMPIONS[] = {
+        34461, 34460, 34469, 34467, 34468, 34465, 34471, 34466, 34473, 34472, 34463, 34470, 34474, 34475,
+        34458, 34451, 34459, 34448, 34449, 34445, 34456, 34447, 34441, 34454, 34455, 34444, 34450, 34453,
+    };
+
+    // --- places ----------------------------------------------------------------
+    //
+    // The bowl's centre is Locs[LOC_CENTER] (563.67, 139.57); the entrance is
+    // areatrigger 5503 at its south gate (563.61, 80.68, 395.2); Barrett is
+    // summoned at Locs[LOC_BARRETT]. The stage is 23.6yd south of the centre and
+    // 25yd north of Barrett: the beasts come in through the north gate, Jaraxxus is
+    // summoned at the centre and walks 10yd south (13.6yd short of the stage, so the
+    // raid does not wait out his minute of speeches standing in him), and the
+    // champions and the twins stop 30-60yd away on three sides of it.
+    constexpr float STAGE_X = 563.7f, STAGE_Y = 116.0f, STAGE_Z = 394.3f;
+    constexpr float BARRETT_X = 559.15f, BARRETT_Y = 90.56f, BARRETT_Z = 395.27f;
+    constexpr float OBJ_ARRIVE  = 10.0f;
+    constexpr float HOLD_RADIUS = 15.0f;
+
+    // Anub'arak (Locs[LOC_ANUB]) and the chamber below the arena. Everything above
+    // SPLIT_Z is the arena; the chamber's floor is at ~142. The landing is between
+    // the corpses the script moves down (x 604-635) and the Web Door (661.6, 144.7),
+    // which is open whenever he is not engaged.
+    constexpr float ANUB_X = 785.9f, ANUB_Y = 133.42f, ANUB_Z = 142.612f;
+    constexpr float LANDING_X = 650.0f, LANDING_Y = 139.0f, LANDING_Z = 142.0f;
+    constexpr float SPLIT_Z = 300.0f;
+
+    // --- the driver's tuning -----------------------------------------------------
+    //
+    // A census radius that covers the whole bowl from anywhere in it (its radius
+    // is ~60yd; the entrance is 59yd from the centre).
+    constexpr float ARENA_SCAN = 130.0f;
+    // The click. The core allows 5.5yd (INTERACTION_DISTANCE); the approach aims
+    // GOSSIP_STANDOFF short of him on the tank's own bearing.
+    constexpr float GOSSIP_REACH    = 4.5f;
+    constexpr float GOSSIP_STANDOFF = 3.0f;
+    constexpr uint32 MOVE_REISSUE_MS = 2000;
+    // A click that landed drops his gossip flag at once, so this only spaces out
+    // clicks that did not: a heroic Barrett whose first option asks for the Call of
+    // the Crusade achievement the clicker lacks, or a menu not ready yet.
+    constexpr uint32 CLICK_RETRY_MS  = 5000;
+    // Barrett's gossip still up this long after the first click: WARN (throttled).
+    constexpr uint32 CLICK_WARN_MS    = 60000;
+    constexpr uint32 WARN_THROTTLE_MS = 60000;
+    // Loot from the last kill is left to finish before the next click (the next
+    // stage's start moves the beasts', Jaraxxus' and the twins' corpses away), but
+    // never for longer than this.
+    constexpr uint32 LOOT_WAIT_MS = 45000;
+    constexpr uint32 TELEMETRY_MS = 15000;
+
+    // --- step timeouts ----------------------------------------------------------
+    constexpr uint32 STAGE_TIMEOUT_MS  = 1800000;  // 30 min a stage: intro, fight, retries
+    constexpr uint32 DRIVER_TIMEOUT_MS = 1800000;  // Repeatable + Optional: re-arms
+
+    // --- event / objective ids -----------------------------------------------------
+    constexpr uint32 EVENT_BEASTS    = 1;
+    constexpr uint32 EVENT_JARAXXUS  = 2;
+    constexpr uint32 EVENT_CHAMPIONS = 3;
+    constexpr uint32 EVENT_VALKYR    = 4;
+    constexpr uint32 EVENT_LICH_KING = 5;
+    constexpr uint32 EVENT_DRIVER    = 6;  // conditional: Barrett and the pulls
+    constexpr uint32 EVENT_DESCENT   = 7;  // conditional: into Anub'arak's chamber
+
+    constexpr uint32 ORDER_BEASTS    = 1;
+    constexpr uint32 ORDER_JARAXXUS  = 2;
+    constexpr uint32 ORDER_CHAMPIONS = 3;
+    constexpr uint32 ORDER_VALKYR    = 4;
+    constexpr uint32 ORDER_LICH_KING = 5;
+    constexpr uint32 ORDER_ANUBARAK  = 6;
+
+    // ObjectiveHookRegistry ids. One flat space; 66 was the last before these.
+    constexpr uint32 HOOK_TOCR_DRIVER  = 67;
+    constexpr uint32 HOOK_TOCR_DESCENT = 68;
+}
