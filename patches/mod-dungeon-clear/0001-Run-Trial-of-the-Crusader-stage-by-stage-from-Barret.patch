+TEST(TrialOfTheCrusader, EventFlagsAreAsAuthored)
+{
+    for (uint32 id = EVENT_BEASTS; id <= EVENT_DESCENT; ++id)
+        ASSERT_NE(Ev(id), nullptr) << "event " << id << " is missing";
+
+    struct Hold { uint32 id; uint32 slot; };
+    for (Hold const& h : { Hold{ EVENT_BEASTS, BOSS_NORTHREND_BEASTS }, Hold{ EVENT_JARAXXUS, BOSS_JARAXXUS },
+                           Hold{ EVENT_CHAMPIONS, BOSS_FACTION_CHAMPIONS }, Hold{ EVENT_VALKYR, BOSS_TWIN_VALKYR } })
+    {
+        DungeonEvent const* ev = Ev(h.id);
+        EXPECT_EQ(ev->activation, EventActivation::Anchored) << "event " << h.id;
+        EXPECT_TRUE(ev->persistent) << "event " << h.id << ": every stage spans fights";
+        EXPECT_TRUE(ev->required) << "event " << h.id;
+        EXPECT_FALSE(ev->repeatable);
+        EXPECT_FALSE(ev->drivesInCombat);
+        EXPECT_FALSE(ev->stepsOwnMovement);
+        EXPECT_FALSE(ev->encounterActive) << "event " << h.id << ": the stand-down owns the fight";
+        ASSERT_EQ(ev->steps.size(), 2u) << "event " << h.id;
+
+        EventStep const& lead = ev->steps[0];
+        EXPECT_EQ(lead.kind, EventStepKind::MoveTo) << "the sticky-at-step-1 rule";
+        EXPECT_LT(lead.bossStateId, 0) << "the lead is a plain MoveTo";
+
+        EventStep const& hold = ev->steps[1];
+        EXPECT_EQ(hold.kind, EventStepKind::MoveTo);
+        EXPECT_EQ(hold.bossStateId, static_cast<int32>(h.slot)) << "event " << h.id;
+        EXPECT_EQ(hold.bossStateClearMask, DcBossStateBit(DONE)) << "event " << h.id;
+        EXPECT_EQ(hold.restartOnBossStateMask, 0u)
+            << "event " << h.id << ": a wipe needs no rewind — Barrett is clicked again";
+        EXPECT_FLOAT_EQ(hold.radius, HOLD_RADIUS);
+        EXPECT_EQ(hold.timeoutMs, STAGE_TIMEOUT_MS);
+        EXPECT_FLOAT_EQ(hold.x, STAGE_X);
+    }
+
+    DungeonEvent const* lk = Ev(EVENT_LICH_KING);
+    EXPECT_EQ(lk->activation, EventActivation::Anchored);
+    EXPECT_TRUE(lk->persistent);
+    ASSERT_EQ(lk->steps.size(), 2u);
+    EXPECT_EQ(lk->steps[0].kind, EventStepKind::MoveTo);
+    EXPECT_EQ(lk->steps[1].instanceDataId, static_cast<int32>(TYPE_INSTANCE_PROGRESS));
+    EXPECT_EQ(lk->steps[1].instanceDataMin, PROGRESS_ANUB_ARAK);
+
+    DungeonEvent const* d = Ev(EVENT_DRIVER);
+    EXPECT_EQ(d->activation, EventActivation::Conditional);
+    EXPECT_TRUE(d->condition);
+    EXPECT_TRUE(d->repeatable);
+    EXPECT_TRUE(d->persistent);
+    EXPECT_FALSE(d->required);
+    EXPECT_TRUE(d->ownsThePull);
+    EXPECT_TRUE(d->encounterActive) << "the champions and twins wait out of combat in an IN_PROGRESS "
+                                       "stage, which is exactly when the stand-down holds";
+    EXPECT_FALSE(d->drivesInCombat) << "it never steers under fire";
+    EXPECT_TRUE(d->stepsOwnMovement);
+    ASSERT_EQ(d->steps.size(), 1u);
+    EXPECT_EQ(d->steps[0].kind, EventStepKind::Custom);
+    EXPECT_EQ(d->steps[0].hookId, HOOK_TOCR_DRIVER);
+    EXPECT_EQ(d->steps[0].timeoutMs, DRIVER_TIMEOUT_MS);
+
+    DungeonEvent const* down = Ev(EVENT_DESCENT);
+    EXPECT_EQ(down->activation, EventActivation::Conditional);
+    EXPECT_TRUE(down->condition);
+    EXPECT_TRUE(down->repeatable);
+    EXPECT_FALSE(down->required);
+    EXPECT_TRUE(down->encounterActive);
+    EXPECT_FALSE(down->drivesInCombat);
+    EXPECT_TRUE(down->stepsOwnMovement);
+    ASSERT_EQ(down->steps.size(), 1u);
+    EXPECT_EQ(down->steps[0].kind, EventStepKind::Custom);
+    EXPECT_EQ(down->steps[0].hookId, HOOK_TOCR_DESCENT);
+
+    for (uint32 hook : { HOOK_TOCR_DRIVER, HOOK_TOCR_DESCENT })
+        EXPECT_TRUE(ObjectiveHookRegistry::Has(hook)) << "hook " << hook << " is not registered";
+}
+
+TEST(TrialOfTheCrusader, PullListIsEveryChampionAndBothTwins)
+{
+    std::vector<uint32> const& v = TocRaidPullEntries();
+    std::set<uint32> const unique(v.begin(), v.end());
+    EXPECT_EQ(v.size(), 30u);
+    EXPECT_EQ(unique.size(), v.size()) << "an entry is listed twice";
+    EXPECT_EQ(std::size(NPC_CHAMPIONS), 28u) << "14 per faction (trial_of_the_crusader.h NPCs)";
+    EXPECT_TRUE(unique.count(NPC_LIGHTBANE));
+    EXPECT_TRUE(unique.count(NPC_DARKBANE));
+    // Barrett and the bosses that come on their own are not pulled.
+    for (uint32 entry : { NPC_BARRETT_BEASTS, NPC_BARRETT_LICH_KING, NPC_JARAXXUS, NPC_ICEHOWL, NPC_ANUBARAK })
+        EXPECT_FALSE(unique.count(entry)) << entry;
+}
+
+TEST(TrialOfTheCrusader, TheCrusadersRewardChestsAreLooted)
+{
+    for (uint32 cache : { 195631u, 195632u, 195633u, 195635u })
+        EXPECT_TRUE(DcEncounterChests::IsEncounterChest(cache)) << "Champions' Cache " << cache;
+    for (uint32 tribute = 195665; tribute <= 195672; ++tribute)
+        EXPECT_TRUE(DcEncounterChests::IsEncounterChest(tribute)) << "Tribute Chest " << tribute;
+}
