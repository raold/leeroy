index 0000000..f796cab
--- /dev/null
+++ b/src/Ai/Dungeon/DungeonClear/Overrides/TrialOfTheCrusaderDriver.cpp
@@ -0,0 +1,402 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#include "ObjectiveHookRegistry.h"
+
+#include <cmath>
+#include <list>
+#include <vector>
+
+#include "Creature.h"
+#include "Group.h"
+#include "InstanceScript.h"
+#include "Log.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "ServerFacade.h"
+#include "SharedDefines.h"
+#include "Timer.h"
+#include "Util/DcPlayerbotsConfig.h"
+
+#include "Ai/Dungeon/DungeonClear/Data/DungeonBossInfo.h"
+#include "Ai/Dungeon/DungeonClear/Data/Events/DungeonEventTables.h"
+#include "Ai/Dungeon/DungeonClear/DcValueKeys.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcCombatFlag.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcMovement.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcPartyState.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcPlayerbotCompat.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcRun.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcTargeting.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcThrottle.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h"
+#include "Ai/Dungeon/DungeonClear/Util/DungeonEventExecutor.h"
+
+// --- Trial of the Crusader (map 649) — the imperative half -------------------
+//
+// TWO hooks:
+//
+//   67  TocRaidDrive  — Barrett's clicks, and the pulls of the champions and twins
+//   68  TocRaidDescend — the bots into Anub'arak's chamber once the floor is down
+//
+// THE DECISIONS ARE NOT HERE. They are the pure kernels in
+// Util/DcTocRaidDecision.h, tested without a map in t/TestTrialOfTheCrusader.cpp;
+// this file is the censuses, the moves, the click, the force-pull, the teleport
+// and the telemetry. Trial of the Champion's driver (map 650) is the model: the
+// same announcer-click and force-pull halves, without the joust.
+//
+// THE RETURN CONTRACT is the module's:
+//
+//   Running => "I am steering." Claims the tick.
+//   Done    => "Nothing to steer." YIELDS the tick (the stepsOwnMovement branch in
+//              DcRunEventAction): to the combat engine, or out of combat to the
+//              anchored hold, which re-parks the tank at the stage and rests the raid.
+
+namespace
+{
+    using namespace DcTrialOfTheCrusader;
+
+    bool Attackable(Player* bot, Unit* u)
+    {
+        return bot && u && u->IsAlive() && bot->IsValidAttackTarget(u);
+    }
+
+    bool StageInProgress(InstanceScript* inst)
+    {
+        for (uint32 slot = 0; slot < BOSS_COUNT; ++slot)
+            if (inst->GetBossState(slot) == IN_PROGRESS)
+                return true;
+        return false;
+    }
+
+    Creature* Barrett(Player* bot, InstanceScript* inst)
+    {
+        ObjectGuid const guid = inst->GetGuidData(DATA_BARRETT);
+        if (guid.IsEmpty())
+            return nullptr;
+        Creature* c = ObjectAccessor::GetCreature(*bot, guid);
+        return c && c->IsAlive() ? c : nullptr;
+    }
+
+    // --- the census -------------------------------------------------------------
+
+    struct PullCensus
+    {
+        uint32    idle = 0;          // alive, attackable by this bot, out of combat
+        bool      engaged = false;   // any of them in combat
+        Creature* nearest = nullptr; // the nearest idle one
+    };
+
+    PullCensus CountPullTargets(Player* bot)
+    {
+        PullCensus c;
+        std::list<Creature*> found;
+        bot->GetCreatureListWithEntryInGrid(found, TocRaidPullEntries(), ARENA_SCAN);
+        float best = -1.0f;
+        for (Creature* cr : found)
+        {
+            if (!cr || !cr->IsAlive())
+                continue;
+            if (cr->IsInCombat())
+            {
+                c.engaged = true;
+                continue;
+            }
+            if (!Attackable(bot, cr))
+                continue;
+            ++c.idle;
+            float const d = bot->GetExactDist(cr);
+            if (best < 0.0f || d < best)
+            {
+                best = d;
+                c.nearest = cr;
+            }
+        }
+        return c;
+    }
+
+    bool LootPending(Player* bot, AiObjectContext* context)
+    {
+        return context->GetValue<bool>(DcKey::Stock::HasAvailableLoot)->Get() ||
+               context->GetValue<bool>(DcKey::Stock::CanLoot)->Get() ||
+               DcPartyState::IsAnyPartyMemberLooting(bot);
+    }
+
+    // --- the mover ---------------------------------------------------------------
+    //
+    // A point move for the tank. Pathfinding is off on this map, so this is a
+    // straight line whatever it is asked for; every leg in the bowl is under 70yd.
+    bool TocRaidMoveTo(Player* bot, PlayerbotAI* botAI, DcRunState& st, float x, float y, float z)
+    {
+        if (!DcMovement::DcMovementAllowed(botAI))
+            return false;
+        if (st.ThrottledIssue(DcThrottle::TocrMoveIssue, x, y, z, /*epsilon*/ 1.0f, MOVE_REISSUE_MS))
+            return true;
+
+        DcMovement::ResolveEscortConflict(bot);
+        MotionMaster* mm = bot->GetMotionMaster();
+        if (!mm)
+            return false;
+        mm->Clear();
+        mm->MovePoint(/*id*/ 0, x, y, z, FORCED_MOVEMENT_NONE, /*speed*/ 0.0f,
+                      /*orientation*/ 0.0f, /*generatePath*/ true, /*forceDestination*/ false);
+        return true;
+    }
+
+    // --- the pull ---------------------------------------------------------------
+    //
+    // Trial of the Champion's TocForcePull: make the creature attack the bot, then
+    // make the bot attack it and flip it onto the combat engine (engine transitions
+    // are action-driven, so a force-attacked bot left on the non-combat engine has
+    // no rotation to run).
+    void TocRaidForcePull(Player* bot, AiObjectContext* context, PlayerbotAI* botAI, Creature* c)
+    {
+        if (!c || !c->IsAlive())
+            return;
+
+        if (!c->IsInCombat())
+        {
+            if (c->IsInEvadeMode())
+                c->ClearUnitState(UNIT_STATE_EVADE);
+            c->EngageWithTarget(bot);
+            if (c->AI())
+                c->AI()->AttackStart(bot);
+        }
+
+        if (bot->GetVictim() != c)
+        {
+            bot->SetSelection(c->GetGUID());
+            if (!bot->HasInArc(CAST_ANGLE_IN_FRONT, c))
+                ServerFacade::instance().SetFacingTo(bot, c);
+            context->GetValue<Unit*>(DcKey::Stock::CurrentTarget)->Set(c);
+            bot->Attack(c, botAI->IsMelee(bot));
+        }
+
+        if (botAI->GetState() != BOT_STATE_COMBAT)
+        {
+            botAI->ChangeEngine(BOT_STATE_COMBAT);
+            botAI->SetNextCheckDelay(DC_PB_CONFIG(ReactDelay, reactDelay));
+        }
+    }
+
+    // --- telemetry ---------------------------------------------------------------
+    //
+    // `DcTocRaid progress=<n> barrett=<up|offering|gone> ...` on every progress
+    // change and every TELEMETRY_MS, at INFO so tools/dc_test_run.py sees it by
+    // default; plus one line per state change.
+    void TocRaidTelemetry(Player* bot, DcRunState& st, DcTocRaid::Inputs const& in,
+                          DcTocRaid::Verdict const& v)
+    {
+        bool const changed = in.progress != st.tocrLastProgress;
+        bool const due = !st.Throttled(DcThrottle::TocrLog, TELEMETRY_MS);
+        if (changed || due)
+        {
+            st.tocrLastProgress = in.progress;
+            LOG_INFO("playerbots.dungeonclear",
+                     "[DC:{}] DcTocRaid progress={} barrett={} dist={:.1f} encounter={} idle={}{} — {}{}",
+                     bot->GetName(), in.progress,
+                     !in.barrettPresent ? "gone" : in.barrettFlagged ? "offering" : "up",
+                     in.barrettDist, in.encounterInProgress ? 1 : 0, in.idleTargets,
+                     in.targetsEngaged ? " (engaged)" : "", DcTocRaid::StateName(v.state),
+                     in.partyInCombat ? " (in combat)" : "");
+        }
+
+        if (st.tocrState != static_cast<uint8>(v.state))
+        {
+            st.tocrState = static_cast<uint8>(v.state);
+            LOG_INFO("playerbots.dungeonclear", "[DC:{}] ToC raid — {} (progress {})",
+                     bot->GetName(), DcTocRaid::StateName(v.state), in.progress);
+        }
+    }
+
+    // --- hook 67: BARRETT RAMSEY ----------------------------------------------------
+    ObjectiveArriveResult TocRaidDrive(Player* bot, AiObjectContext* context, DungeonBossInfo const& info)
+    {
+        if (!bot || !context || bot->GetMapId() != MAP_ID)
+            return ObjectiveArriveResult::Done;
+
+        PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+        if (!botAI)
+            return ObjectiveArriveResult::Done;
+
+        InstanceScript* inst = DcTargeting::GetInstanceScript(bot);
+        if (!inst)
+            return ObjectiveArriveResult::Done;
+
+        DcRunState& st = DcRun::Of(context);
+        Creature* const barrett = Barrett(bot, inst);
+
+        DcTocRaid::Inputs in;
+        in.progress = inst->GetData(TYPE_INSTANCE_PROGRESS);
+        in.alive = bot->IsAlive();
+        in.partyInCombat = DcCombatFlag::AnyPartyEngagement(bot);
+        in.encounterInProgress = StageInProgress(inst);
+
+        PullCensus pulls;
+        if (in.encounterInProgress)
+            pulls = CountPullTargets(bot);
+        in.idleTargets = pulls.idle;
+        in.targetsEngaged = pulls.engaged;
+
+        in.lootPending = !in.partyInCombat && !in.encounterInProgress && LootPending(bot, context);
+        in.barrettPresent = barrett != nullptr;
+        in.barrettFlagged = barrett && barrett->HasNpcFlag(UNIT_NPC_FLAG_GOSSIP);
+        in.barrettDist = barrett ? bot->GetExactDist(barrett) : -1.0f;
+
+        in.nowMs = getMSTime();
+        in.lootSinceMs = st.tocrLootSinceMs;
+        in.clickSinceMs = st.tocrClickSinceMs;
+
+        DcTocRaid::Verdict v = DcTocRaid::Decide(in);
+        if (v.action == DcTocRaid::Action::Gossip)
+        {
+            // The raid muster (stage on the tank, top off, rebuff; bounded by its own
+            // ceiling) before every stage, as Karazhan's Opera runs it before Barnes.
+            in.musterHolds = ObjectiveHookRegistry::Run(DC_HOOK_RAID_MUSTER, bot, context, info) ==
+                             ObjectiveArriveResult::Running;
+            if (in.musterHolds)
+                v = DcTocRaid::Decide(in);
+        }
+
+        st.tocrLootSinceMs = v.lootSinceMs;
+        st.tocrClickSinceMs = v.clickSinceMs;
+
+        if (v.complete)
+        {
+            st.ClearTocRaid();
+            return ObjectiveArriveResult::Done;
+        }
+
+        TocRaidTelemetry(bot, st, in, v);
+
+        if (v.clickStuck && !st.Throttled(DcThrottle::TocrWarn, WARN_THROTTLE_MS))
+            LOG_WARN("playerbots.dungeonclear",
+                     "[DC:{}] ToC raid — Barrett Ramsey has kept offering his gossip for {}s of clicks "
+                     "(progress {}). On heroic his first option needs the Call of the Crusade "
+                     "achievement on the clicker; otherwise his menu is not answering.",
+                     bot->GetName(), (in.nowMs - v.clickSinceMs) / 1000, in.progress);
+
+        switch (v.action)
+        {
+            case DcTocRaid::Action::ApproachBarrett:
+            {
+                if (!barrett)
+                    return ObjectiveArriveResult::Done;
+                // GOSSIP_STANDOFF short of him on our own bearing, at his z.
+                float const ax = barrett->GetPositionX(), ay = barrett->GetPositionY();
+                float dx = bot->GetPositionX() - ax, dy = bot->GetPositionY() - ay;
+                float const d = std::hypot(dx, dy);
+                if (d > 0.1f)
+                {
+                    dx /= d;
+                    dy /= d;
+                }
+                else
+                {
+                    dx = 0.0f;
+                    dy = 1.0f;  // north, into the bowl
+                }
+                return TocRaidMoveTo(bot, botAI, st, ax + dx * GOSSIP_STANDOFF, ay + dy * GOSSIP_STANDOFF,
+                                     barrett->GetPositionZ())
+                           ? ObjectiveArriveResult::Running
+                           : ObjectiveArriveResult::Done;
+            }
+
+            case DcTocRaid::Action::Gossip:
+            {
+                if (!barrett)
+                    return ObjectiveArriveResult::Running;
+                if (st.Throttled(DcThrottle::TocrClick, CLICK_RETRY_MS))
+                    return ObjectiveArriveResult::Running;
+
+                // Option 0 of his menu opens the stage's action menu; SelectGossip's
+                // drill-down then takes its first visible option, the one his SmartAI
+                // answers. Both are the first VISIBLE option, which the boss-state
+                // conditions make "start" on a fresh stage and "another shot" on a
+                // failed one.
+                bool const sent = DungeonEventExecutor::SelectGossip(bot, barrett, /*option*/ 0);
+                LOG_INFO("playerbots.dungeonclear",
+                         "[DC:{}] ToC raid — progress {}: {} {} ({}) from {:.1f}yd",
+                         bot->GetName(), in.progress, sent ? "talked to" : "could not talk to",
+                         barrett->GetName(), barrett->GetEntry(), in.barrettDist);
+                return ObjectiveArriveResult::Running;
+            }
+
+            case DcTocRaid::Action::Engage:
+                if (!pulls.nearest)
+                    return ObjectiveArriveResult::Running;
+                LOG_INFO("playerbots.dungeonclear",
+                         "[DC:{}] ToC raid — {} idle and nobody engaged: pulling {} at {:.1f}yd",
+                         bot->GetName(), pulls.idle, pulls.nearest->GetName(),
+                         bot->GetExactDist(pulls.nearest));
+                TocRaidForcePull(bot, context, botAI, pulls.nearest);
+                return ObjectiveArriveResult::Running;
+
+            case DcTocRaid::Action::Hold:
+                return ObjectiveArriveResult::Running;
+
+            case DcTocRaid::Action::Yield:
+            default:
+                return ObjectiveArriveResult::Done;
+        }
+    }
+
+    // --- hook 68: THE DESCENT -------------------------------------------------------
+    //
+    // Every bot of the party still at arena level, alive and not riding anything,
+    // onto the chamber floor around the landing (fanned so they do not stack, as
+    // the module's other party teleports are). Synchronous, so always Done.
+    ObjectiveArriveResult TocRaidDescend(Player* bot, AiObjectContext* /*context*/,
+                                         DungeonBossInfo const& /*info*/)
+    {
+        if (!bot || bot->GetMapId() != MAP_ID)
+            return ObjectiveArriveResult::Done;
+
+        std::vector<Player*> members;
+        if (Group* group = bot->GetGroup())
+        {
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                if (Player* m = ref->GetSource())
+                    members.push_back(m);
+        }
+        else
+            members.push_back(bot);
+
+        uint32 idx = 0;
+        for (Player* m : members)
+        {
+            if (!m->IsInWorld() || !m->IsAlive() || m->GetMapId() != bot->GetMapId())
+                continue;
+            if (!GET_PLAYERBOT_AI(m) || DcPlayerbotCompat::IsHumanControlled(m))
+                continue;  // a person falls on their own
+            if (m->GetVehicle() || m->IsBeingTeleported() || !DcTocRaid::AboveSplit(m->GetPositionZ()))
+                continue;
+
+            float const angle = static_cast<float>(idx) * 0.7f;
+            float const off = 1.5f + 0.5f * static_cast<float>(idx);
+            m->GetMotionMaster()->Clear();
+            // Facing east, at Anub'arak.
+            m->NearTeleportTo(LANDING_X + std::cos(angle) * off, LANDING_Y + std::sin(angle) * off, LANDING_Z,
+                              /*orientation*/ 0.0f, /*casting*/ false, /*vehicle*/ false, /*withPet*/ true);
+            ++idx;
+        }
+
+        if (idx)
+            LOG_INFO("playerbots.dungeonclear",
+                     "[DC:{}] ToC raid — the floor is down: {} bot(s) put on Anub'arak's chamber floor "
+                     "(a bot has no client to fall with)",
+                     bot->GetName(), idx);
+        return ObjectiveArriveResult::Done;
+    }
+}
+
+// Ids 67 and 68 (one flat space across every dungeon; AddHook LOG_ERRORs a
+// collision rather than silently dropping one).
+void RegisterTrialOfTheCrusaderHooks(ObjectiveHookRegistry::HookTable& out)
+{
+    ObjectiveHookRegistry::AddHook(out, DcTrialOfTheCrusader::HOOK_TOCR_DRIVER, &TocRaidDrive);
+    ObjectiveHookRegistry::AddHook(out, DcTrialOfTheCrusader::HOOK_TOCR_DESCENT, &TocRaidDescend);
+}
