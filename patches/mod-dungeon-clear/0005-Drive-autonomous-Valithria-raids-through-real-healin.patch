+    ObjectiveArriveResult StartValithria(Player* bot, AiObjectContext* context, DungeonBossInfo const&)
+    {
+        namespace V = DcValithria;
+        if (!bot || !context || bot->GetMapId() != V::Map || !DcSettings::GetBool(bot, V::Setting))
+            return ObjectiveArriveResult::Running;
+        auto* inst = bot->GetInstanceScript();
+        auto* ai = GET_PLAYERBOT_AI(bot);
+        if (!inst || !ai) return ObjectiveArriveResult::Running;
+        if (inst->GetBossState(V::Slot) == IN_PROGRESS || inst->GetBossState(V::Slot) == DONE)
+            return ObjectiveArriveResult::Done;
+        if (inst->IsEncounterInProgress()) return ObjectiveArriveResult::Running;
+        std::vector<Player*> members;
+        bool const idle = Census(bot, members);
+        bool const together = idle && std::all_of(members.begin(), members.end(), [bot](Player* m)
+        {
+            return V::InRoom(m->GetPositionX(), m->GetPositionY(), m->GetPositionZ())
+                && m->GetExactDist(bot) <= 45.0f && bot->InSamePhase(m);
+        });
+        bool const healer = idle && std::any_of(members.begin(), members.end(), [ai](Player* m)
+        {
+            return ai->IsHeal(m);
+        });
+        if (!V::MayPull(true, inst->GetBossState(V::Slot), idle, together, healer, LootPending(bot, context)))
+            return ObjectiveArriveResult::Running;
+        // Core still enforces Lower Spire prerequisites; don't pull a raid into
+        // the script's reject-and-evade path when its saved progression is wrong.
+        if (!inst->CheckRequiredBosses(V::Slot, bot)) return ObjectiveArriveResult::Running;
+        Creature* dragon = bot->FindNearestCreature(V::Dragon, 45.0f, true);
+        if (!dragon || !V::InRoom(dragon->GetPositionX(), dragon->GetPositionY(), dragon->GetPositionZ()))
+            return ObjectiveArriveResult::Running;
+        if (DcRun::Of(context).Throttled(DcThrottle::IccValithria, 3000))
+            return ObjectiveArriveResult::Running;
+
+        std::list<Creature*> archmages;
+        bot->GetCreatureListWithEntryInGrid(archmages, V::Archmage, 40.0f);
+        // Stable nearest target with GUID tie-breaking; no discovery of unloaded
+        // grids or remote starts. Never target the friendly dragon as a kill.
+        archmages.sort([bot](Creature* a, Creature* b)
+        {
+            float const da = bot->GetExactDist(a), db = bot->GetExactDist(b);
+            return da == db ? a->GetGUID() < b->GetGUID() : da < db;
+        });
+        for (Creature* target : archmages)
+        {
+            if (!target->IsAlive() || target->IsInCombat() || target->IsInEvadeMode()
+                || !bot->IsValidAttackTarget(target) || !bot->IsWithinLOSInMap(target)
+                || !V::InRoom(target->GetPositionX(), target->GetPositionY(), target->GetPositionZ())) continue;
+            target->EngageWithTarget(bot);
+            if (target->AI()) target->AI()->AttackStart(bot);
+            bot->SetSelection(target->GetGUID());
+            context->GetValue<Unit*>(DcKey::Stock::CurrentTarget)->Set(target);
+            bot->Attack(target, ai->IsMelee(bot));
+            ai->ChangeEngine(BOT_STATE_COMBAT);
+            LOG_INFO("playerbots.dungeonclear", "dc_icc_valithria_start instance={} members={}",
+                bot->GetInstanceId(), members.size());
+            return ObjectiveArriveResult::Done;
+        }
+        // The hold alone finishes on core DONE. The actual playerbots ICC
+        // heal/portal strategy supplies every heal and the script awards credit.
+        return ObjectiveArriveResult::Running;
+    }
 }
 
 void RegisterIcecrownEvents(std::vector<DungeonEvent>& out)
 {
     out.push_back(EventBuilder(DcIcecrownPass::MapId, DcIcecrownPass::Event, "Gunship pass and Saurfang intro")
         .Conditional(&PassDue).Repeatable().Optional().StepsOwnMovement().Custom(DcIcecrownPass::Hook).Build());
+    namespace V = DcValithria;
+    out.push_back(EventBuilder(V::Map, V::Event, "Valithria: heal to full")
+        .Anchored(V::Order).Persistent()
+        .MoveTo(V::X, V::Y, V::Z, 6.0f)
+        .Custom(DC_HOOK_RAID_MUSTER).Timeout(240000)
+        .Custom(V::Hook).Timeout(240000)
+        .MoveToHoldUntilBossState(V::X, V::Y, V::Z, 12.0f, V::Slot, DcBossStateBit(DONE))
+            .RestartOnBossState(DcBossStateBit(NOT_STARTED) | DcBossStateBit(FAIL)).Timeout(1800000)
+        .Build());
 }
 
 void RegisterIcecrownHooks(ObjectiveHookRegistry::HookTable& out)
 {
     ObjectiveHookRegistry::AddHook(out, DcIcecrownPass::Hook, &Pass);
+    ObjectiveHookRegistry::AddHook(out, DcValithria::Hook, &StartValithria);
+}
+
+void RegisterIcecrownRoster(std::vector<BossRosterPatch>& out)
+{
+    namespace V = DcValithria;
+    BossRosterPatch patch;
+    patch.mapId = V::Map;
+    patch.enabledSetting = V::Setting;
+    patch.remove = {V::Dragon}; // also safe if upstream later adds spell-credit rows
+    auto objective = DcRoster::MakeObjective(DcRoster::OBJ(V::Event), V::Order, V::Map,
+        "Valithria: heal to full", V::X, V::Y, V::Z, 6.0f, 0, 0, V::Event);
+    objective.doneBossStateIndex = V::Slot;
+    patch.add.push_back(objective);
+    out.push_back(std::move(patch));
 }
