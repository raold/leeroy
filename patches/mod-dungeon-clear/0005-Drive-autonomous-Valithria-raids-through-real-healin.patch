+#ifndef DC_VALITHRIA_DECISION_H
+#define DC_VALITHRIA_DECISION_H
+
+#include <cmath>
+
+// Core ICC boss-state slot 10 is NOT her DBC encounter-order key (9).
+namespace DcValithria
+{
+    inline constexpr unsigned Map = 631, Slot = 10, Order = 9, Event = 2, Hook = 71;
+    inline constexpr unsigned Dragon = 36789, Archmage = 37868;
+    inline constexpr char Setting[] = "OfflineValithria";
+    inline constexpr float X = 4190.0f, Y = 2484.443f, Z = 364.956f;
+
+    inline bool InRoom(float x, float y, float z)
+    {
+        return std::isfinite(x) && std::isfinite(y) && std::isfinite(z)
+            && std::abs(z - Z) <= 8.0f && std::hypot(x - X, y - Y) <= 70.0f;
+    }
+
+    inline bool MayPull(bool enabled, unsigned state, bool idleAutonomousRaid,
+                        bool together, bool healer, bool lootPending)
+    {
+        // NOT_STARTED or FAIL only. Missing actors/reset timers simply defer.
+        return enabled && (state == 0 || state == 2) && idleAutonomousRaid
+            && together && healer && !lootPending;
+    }
+}
+#endif
