+TEST(Icecrown, ValithriaRequiresAnIdlePresentRaidAndHealer)
+{
+    for (unsigned bits = 0; bits < 32; ++bits)
+        for (unsigned state = 0; state < 6; ++state)
+            EXPECT_EQ(DcValithria::MayPull(bits & 1, state, bits & 2, bits & 4, bits & 8, bits & 16),
+                bits == 15 && (state == 0 || state == 2));
+    EXPECT_TRUE(DcValithria::InRoom(DcValithria::X, DcValithria::Y, DcValithria::Z));
+    EXPECT_FALSE(DcValithria::InRoom(DcValithria::X, DcValithria::Y, DcValithria::Z + 15));
+    EXPECT_FALSE(DcValithria::InRoom(DcValithria::X + 100, DcValithria::Y, DcValithria::Z));
+    EXPECT_FALSE(DcValithria::InRoom(std::numeric_limits<float>::quiet_NaN(), DcValithria::Y, DcValithria::Z));
+}
+
+TEST(Icecrown, ValithriaRosterIsOffByDefaultAndPrecedesSindragosa)
+{
+    namespace V = DcValithria;
+    for (unsigned difficulty = 0; difficulty < 4; ++difficulty)
+    {
+        auto const key = DcDiffKey::Raid(difficulty);
+        auto sindragosa = DcRoster::MakeBossWithBit(36853, V::Map, "Sindragosa", 0, 0, 0, 10);
+        auto lichKing = DcRoster::MakeBossWithBit(36597, V::Map, "The Lich King", 0, 0, 0, 11);
+        std::vector<DungeonBossInfo> base{sindragosa, lichKing};
+        auto off = BossRosterRegistry::Apply(V::Map, key, base);
+        ASSERT_EQ(off.size(), 2u);
+        EXPECT_EQ(off[0].entry, sindragosa.entry);
+        EXPECT_EQ(BossRosterRegistry::Apply(V::Map, key, base, [](char const*) { return false; }).size(), 2u);
+        auto on = BossRosterRegistry::Apply(V::Map, key, base,
+            [](char const* setting) { return std::string(setting) == V::Setting; });
+        ASSERT_EQ(on.size(), 3u);
+        EXPECT_EQ(on[0].kind, DungeonAnchorKind::Objective);
+        EXPECT_EQ(on[0].doneBossStateIndex, 10);
+        EXPECT_EQ(on[0].eventId, V::Event);
+        EXPECT_FALSE(on[0].skipByDesign);
+        EXPECT_EQ(on[1].entry, sindragosa.entry);
+        EXPECT_EQ(on[2].entry, lichKing.entry);
+        EXPECT_EQ(on[1].encounterIndex, 10u); // earned kill bits unchanged
+        EXPECT_EQ(on[2].encounterIndex, 11u);
+    }
+}
+
+TEST(Icecrown, ValithriaWaitsForRealCompletionAndRemustersAfterWipes)
+{
+    namespace V = DcValithria;
+    auto const* event = DungeonEventRegistry::Find(V::Map, V::Event);
+    ASSERT_NE(event, nullptr);
+    EXPECT_TRUE(event->persistent);
+    EXPECT_EQ(event->activation, EventActivation::Anchored);
+    EXPECT_FALSE(event->stepsOwnMovement);
+    EXPECT_FALSE(event->drivesInCombat);
+    ASSERT_EQ(event->steps.size(), 4u);
+    EXPECT_EQ(event->steps[0].kind, EventStepKind::MoveTo);
+    EXPECT_EQ(event->steps[1].hookId, DC_HOOK_RAID_MUSTER);
+    EXPECT_EQ(event->steps[2].hookId, V::Hook);
+    EXPECT_TRUE(ObjectiveHookRegistry::Has(V::Hook));
+    EXPECT_EQ(event->steps[3].bossStateId, 10);
+    EXPECT_EQ(event->steps[3].bossStateClearMask, DcBossStateBit(3));
+    EXPECT_EQ(event->steps[3].restartOnBossStateMask, DcBossStateBit(0) | DcBossStateBit(2));
+}
