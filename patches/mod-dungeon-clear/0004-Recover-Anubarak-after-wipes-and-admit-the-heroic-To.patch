     using namespace DcTrialOfTheCrusader;
 
+    bool RecoveryParty(Player* bot)
+    {
+        Group* group = bot->GetGroup();
+        if (!group || !group->isRaidGroup()) return false;
+        auto const safe = [&](Player* m)
+        {
+            PlayerbotAI* ai = m ? GET_PLAYERBOT_AI(m) : nullptr;
+            return ai && !DcPlayerbotCompat::IsHumanControlled(m)
+                && !DcPlayerbotCompat::IsRealPlayer(ai->GetMaster())
+                && m->IsInWorld() && m->GetMap() == bot->GetMap() && m->IsAlive()
+                && !m->IsInCombat() && !m->IsBeingTeleported() && !m->GetVehicle();
+        };
+        for (auto const& ref : bot->GetMap()->GetPlayers())
+            if (!safe(ref.GetSource())) return false;
+        uint32 count = 0;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            if (!safe(ref->GetSource())) return false;
+            ++count;
+        }
+        return count > 1 && count == group->GetMembersCount();
+    }
+
     bool Attackable(Player* bot, Unit* u)
     {
         return bot && u && u->IsAlive() && bot->IsValidAttackTarget(u);
@@ -227,6 +252,21 @@ namespace
             return ObjectiveArriveResult::Done;
 
         DcRunState& st = DcRun::Of(context);
+        // After a full wipe DC revives the raid in this same instance, so the
