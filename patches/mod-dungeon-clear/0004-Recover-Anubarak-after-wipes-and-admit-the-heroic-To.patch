diff --git a/src/Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h b/src/Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h
index 634e653..89f9706 100644
--- a/src/Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h
+++ b/src/Ai/Dungeon/DungeonClear/Util/DcTocRaidDecision.h
@@ -38,14 +38,27 @@
 // to the ladder. The twins are released 3.25s after their slot goes IN_PROGRESS;
 // in that window the raid HOLDS where it stands.
 //
-// From progress 9 (the floor is down) the driver is done: the descent puts the
-// bots into the chamber below, and Anub'arak is an ordinary boss row.
+// From progress 9 (the floor is down) the arena decisions are done: the descent
+// puts bots into the chamber and Anub'arak is an ordinary boss row. The same
+// hook retains its separate missing-boss recovery path after wipe cleanup.
 //
 // THE RETURN CONTRACT is the module's: Yield is "Done" (hand the tick back: the
 // anchored hold re-parks the tank at the stage and rests the raid), everything
 // else is "Running" (claim it). Blocked is never returned.
 namespace DcTocRaid
 {
+    // Recovery replays the instance's entry path, which owns the attempts limit
+    // and summons. Never invent another Anub or revive a completed encounter.
+    inline bool RecoveryDue(uint32 progress, uint32 state, bool present)
+    {
+        return progress == 9 && (state == 0 || state == 2) && !present;
+    }
+    inline uint32 ClickAchievement(uint32 difficulty, uint32 barrettEntry, bool botsOnly)
+    {
+        if (!botsOnly || barrettEntry != 35909) return 0;
+        return difficulty == 2 ? 3917 : difficulty == 3 ? 3916 : 0;
+    }
+
     enum class State : uint8
     {
         Complete = 0,  // progress 9+: the floor is down
diff --git a/t/TestTrialOfTheCrusader.cpp b/t/TestTrialOfTheCrusader.cpp
index f492631..2761ef3 100644
--- a/t/TestTrialOfTheCrusader.cpp
+++ b/t/TestTrialOfTheCrusader.cpp
@@ -599,3 +599,22 @@ TEST(TrialOfTheCrusader, TheCrusadersRewardChestsAreLooted)
     for (uint32 tribute = 195665; tribute <= 195672; ++tribute)
         EXPECT_TRUE(DcEncounterChests::IsEncounterChest(tribute)) << "Tribute Chest " << tribute;
 }
+
+TEST(TrialOfTheCrusader, RecoveryWaitsForCleanupAndNeverRevivesADoneOrEngagedBoss)
+{
+    for (uint32 progress = 0; progress <= 10; ++progress)
+        for (uint32 state = 0; state <= 5; ++state)
+        {
+            EXPECT_EQ(DcTocRaid::RecoveryDue(progress, state, false), progress == 9 && (state == 0 || state == 2));
+            EXPECT_FALSE(DcTocRaid::RecoveryDue(progress, state, true));
+        }
+}
+TEST(TrialOfTheCrusader, HeroicClickGateUsesOnlyTheMatchingSize)
+{
+    EXPECT_EQ(DcTocRaid::ClickAchievement(2, 35909, true), 3917u);
+    EXPECT_EQ(DcTocRaid::ClickAchievement(3, 35909, true), 3916u);
+    for (uint32 difficulty : {0u, 1u, 4u})
+        EXPECT_EQ(DcTocRaid::ClickAchievement(difficulty, 35909, true), 0u);
+    EXPECT_EQ(DcTocRaid::ClickAchievement(2, 34816, true), 0u);
+    EXPECT_EQ(DcTocRaid::ClickAchievement(3, 35909, false), 0u);
+}
