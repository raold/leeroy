+                && !st.Throttled(DcThrottle::TocrClick, 30000))
+            {
+                inst->OnPlayerEnter(bot);
+                LOG_INFO("playerbots.dungeonclear", "dc_toc_recovery instance={} present={}",
+                    bot->GetInstanceId(), inst->GetCreature(DATA_ANUBARAK) != nullptr);
+            }
+            return ObjectiveArriveResult::Done;
+        }
         Creature* const barrett = Barrett(bot, inst);
 
         DcTocRaid::Inputs in;
@@ -317,6 +357,21 @@ namespace
                 // answers. Both are the first VISIBLE option, which the boss-state
