+        // including zero-attempt refusal and Tirion ownership, not a raw summon.
+        if (inst->GetData(TYPE_INSTANCE_PROGRESS) == PROGRESS_ANUB_ARAK)
+        {
+            if (DcTocRaid::RecoveryDue(PROGRESS_ANUB_ARAK, inst->GetBossState(BOSS_ANUBARAK),
