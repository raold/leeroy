+// --- Ulduar (map 603) --------------------------------------------------------
+//
+// The ruling and the reasons live in namespace DcUlduar in DungeonEventTables.h.
+// This file is the authored shape: the Leviathan's row skipped by design, the
+// conditional pass that takes a raid of bots past his gate, and Razorscale's
+// commander in front of her re-anchored row. Every other boss is the derived
+// roster as it was.
+
+namespace
+{
+    using namespace DcUlduar;
+
+    // --- event 1's gate: a party of bots, some of it outside the Leviathan's gate
+    bool UlduarLeviathanPassDue(Player* bot, AiObjectContext* /*context*/)
+    {
+        if (!bot || bot->GetMapId() != MAP_ID)
+            return false;
+
+        InstanceScript* inst = DcTargeting::GetInstanceScript(bot);
+        if (!inst)
+            return false;
+
+        bool person = false;
+        uint32 outside = 0;
+        auto const look = [&](Player* m)
+        {
+            if (!m)
+                return;
+            if (DcPlayerbotCompat::IsHumanControlled(m))
+            {
+                person = true;
+                return;
+            }
+            if (m->IsInWorld() && m->IsAlive() && m->GetMapId() == bot->GetMapId() &&
+                DcUlduarPass::Outside(m->GetPositionX()))
+                ++outside;
+        };
+        if (Group* group = bot->GetGroup())
+        {
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                look(ref->GetSource());
+        }
+        else
+            look(bot);
+
+        return DcUlduarPass::Due(static_cast<uint32>(inst->GetBossState(BOSS_LEVIATHAN)), bot->IsAlive(),
+                                 person, outside);
+    }
+}
+
+void RegisterUlduarEvents(std::vector<DungeonEvent>& out)
+{
+    // (1) FLAME LEVIATHAN: THE ULDUAR TELEPORTER — conditional.
+    //
+    // Due whenever the predicate above is: at the start of a run (the raid lands
+    // at the entrance, west of everything), after a restart or recall that puts
+    // members back there, and on a re-entered instance. Its one Custom step moves
+    // every eligible bot to the Colossal Forge teleporter's destination and is
+    // done the same tick, so it never holds a tick it does not use (StepsOwnMovement
+    // makes that Done a yield). REPEATABLE because the same signal must re-fire for
+    // every straggler; OPTIONAL so a timeout re-arms it.
+    out.push_back(
+        EventBuilder(MAP_ID, EVENT_LEVIATHAN_PASS, "Flame Leviathan: the Ulduar Teleporter")
+            .Conditional(&UlduarLeviathanPassDue)
+            .Repeatable()
+            .Optional()
+            .StepsOwnMovement()
+            .Custom(HOOK_ULD_PASS)
+            .Build());
+
+    // (2) RAZORSCALE: THE EXPEDITION COMMANDER — anchored on OBJ(1), just before
+    // her row. She hovers over the runway out of reach until a player tells the
+    // commander they are ready (npc_expedition_commander::sGossipSelect, menu 10314
+    // option 0): she then flies in and engages, and the fight is mod-playerbots'
+    // `ulduar` strategy's (harpoons, ground phases). So: the raid muster at the
+    // commander, the click, and a hold on the runway until her slot reads
+    // IN_PROGRESS (or DONE), so the objective cannot finish on a click that did not
+    // start her. PERSISTENT: her adds can start a fight before her slot moves.
+    out.push_back(
+        EventBuilder(MAP_ID, EVENT_RAZORSCALE, "Razorscale: the Expedition Commander")
+            .Anchored(ORDER_RAZORSCALE)
+            .Persistent()
+            .Custom(DC_HOOK_RAID_MUSTER)
+                .Timeout(240000)
+            .Gossip(NPC_EXPEDITION_COMMANDER, /*option*/ 0, /*searchRadius*/ 30.0f)
+            .MoveToHoldUntilBossState(RUNWAY_X, RUNWAY_Y, RUNWAY_Z, /*radius*/ 20.0f, BOSS_RAZORSCALE,
+                                      DcBossStateBit(IN_PROGRESS) | DcBossStateBit(DONE))
+                .Timeout(COMMANDER_TIMEOUT_MS)
+            .Build());
+}
+
+// --- the roster ----------------------------------------------------------------------
+//
+// FLAME LEVIATHAN stays in the roster, skipped by design (the vehicle-piloted boss
+// skipByDesign exists for), so the panel shows why the clear passes him.
+//
+// RAZORSCALE's spawn hovers at z 490 over her runway, out of every mesh; her row is
+// re-added on the runway floor with her real bit 2 (an explicit bit, so it does not
+// depend on the derived row being present to inherit from), behind the commander's
+// objective. The objective ties her order key and so sorts first; its own
+// encounterIndex is only that ordering hint, and it is finished by her slot reading
+// DONE (doneBossStateIndex), so a re-entered instance does not talk to him again.
+void RegisterUlduarRoster(std::vector<BossRosterPatch>& t)
+{
+    using namespace DcRoster;
+
+    BossRosterPatch p;
+    p.mapId = MAP_ID;
+    p.skipByDesign = { NPC_LEVIATHAN };
+    p.remove = { NPC_RAZORSCALE };
+
+    DungeonBossInfo commander = MakeObjective(OBJ(EVENT_RAZORSCALE), /*encounterIndex*/ ORDER_RAZORSCALE, MAP_ID,
+                                              "Razorscale: the Expedition Commander",
+                                              COMMANDER_X, COMMANDER_Y, COMMANDER_Z, /*arriveRadius*/ 8.0f,
+                                              /*gateEntry*/ 0, /*hook*/ 0, EVENT_RAZORSCALE);
+    commander.doneBossStateIndex = static_cast<int32>(BOSS_RAZORSCALE);
+    p.add.push_back(commander);
+    p.add.push_back(MakeBossWithBit(NPC_RAZORSCALE, MAP_ID, "Razorscale", RUNWAY_X, RUNWAY_Y, RUNWAY_Z,
+                                    BOSS_RAZORSCALE));
+    t.push_back(std::move(p));
+}
