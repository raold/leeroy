diff --git a/src/Ai/Dungeon/DungeonClear/Util/DcUlduarPassDecision.h b/src/Ai/Dungeon/DungeonClear/Util/DcUlduarPassDecision.h
new file mode 100644
index 0000000..6b3a6f4
--- /dev/null
+++ b/src/Ai/Dungeon/DungeonClear/Util/DcUlduarPassDecision.h
@@ -0,0 +1,50 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+#ifndef _PLAYERBOT_DCULDUARPASSDECISION_H
+#define _PLAYERBOT_DCULDUARPASSDECISION_H
+
+#include <cstdint>
+
+#include "Define.h"
+
+#include "Ai/Dungeon/DungeonClear/Data/Events/DungeonEventTables.h"
+
+// PURE kernel for Ulduar's Flame Leviathan pass (map 603, hook 69). The ruling and
+// the reasons are in DungeonEventTables.h (namespace DcUlduar); the glue is
+// Overrides/UlduarDriver.cpp.
+//
+// The pass is a pure function of live state, with no latch: it is due whenever
+// the Leviathan is not DONE, the party is bots only, and some bot of it stands
+// outside his gate. That makes it right at the start of a run, after a restart
+// or a recall that puts members back at the entrance, and on a re-entered
+// instance, and it can never move anyone once the gate is open (he is DONE) or a
+// person is in the group.
+namespace DcUlduarPass
+{
+    constexpr uint32 ENCOUNTER_DONE = 3;
+
+    // West of the Leviathan Door: the entrance, the base camp and the Formation
+    // Grounds. Everything after him is east of the Lightning Wall.
+    inline bool Outside(float x)
+    {
+        return x < DcUlduar::OUTSIDE_MAX_X;
+    }
+
+    inline bool Due(uint32 leviathanState, bool leaderAlive, bool personInGroup, uint32 botsOutside)
+    {
+        return leviathanState != ENCOUNTER_DONE && leaderAlive && !personInGroup && botsOutside > 0;
+    }
+
+    // One member: moved only when it is a bot nobody controls, alive, out of combat
+    // (the teleporter's own spell script refuses a target in combat), not riding
+    // anything, and outside the gate.
+    inline bool Moves(bool alive, bool isBot, bool personControlled, bool inCombat, bool onVehicle, float x)
+    {
+        return alive && isBot && !personControlled && !inCombat && !onVehicle && Outside(x);
+    }
+}
+
+#endif
