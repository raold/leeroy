diff --git a/t/TestUlduar.cpp b/t/TestUlduar.cpp
new file mode 100644
index 0000000..c8e7233
--- /dev/null
+++ b/t/TestUlduar.cpp
@@ -0,0 +1,240 @@
+/*
+ * Copyright (C) 2016+ AzerothCore <www.azerothcore.org>, released under GNU AGPL v3 license, you may redistribute it
+ * and/or modify it under version 3 of the License, or (at your option), any later version.
+ */
+
+// Ulduar (map 603).
+//
+//   1. THE PASS KERNEL (DcUlduarPass) — who is moved past Flame Leviathan's gate,
+//      and when: a raid of bots only, the Leviathan not DONE, outside the gate.
+//
+//   2. THE AUTHORED DATA — the Leviathan kept but skipped by design, Razorscale
+//      re-anchored onto her runway behind the Expedition Commander, the two event
+//      rows, and the ruling's geometry (the base camp teleporter outside the gate,
+//      its Colossal Forge destination beyond it).
+
+#include "gtest/gtest.h"
+
+#include <cmath>
+#include <vector>
+
+#include "InstanceScript.h"
+
+#include "Ai/Dungeon/DungeonClear/Data/DungeonBossInfo.h"
+#include "Ai/Dungeon/DungeonClear/Data/DungeonEventRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Data/Events/DungeonEventTables.h"
+#include "Ai/Dungeon/DungeonClear/DcCapabilities.h"
+#include "Ai/Dungeon/DungeonClear/Overrides/BossRosterRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Overrides/ObjectiveHookRegistry.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcEncounterChests.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcUlduarPassDecision.h"
+
+using namespace DcUlduar;
+
+namespace
+{
+    DungeonEvent const* Ev(uint32 id) { return DungeonEventRegistry::Find(MAP_ID, id); }
+
+    BossRosterPatch const* Patch()
+    {
+        for (BossRosterPatch const& p : BossRosterRegistry::AllPatches())
+            if (p.mapId == MAP_ID)
+                return &p;
+        return nullptr;
+    }
+
+    DungeonBossInfo Derived(uint32 entry, uint32 bit, char const* name, float x, float y, float z)
+    {
+        DungeonBossInfo b;
+        b.entry = entry;
+        b.encounterIndex = bit;
+        b.name = name;
+        b.mapId = MAP_ID;
+        b.x = x;
+        b.y = y;
+        b.z = z;
+        return b;
+    }
+
+    // What BossSpawnIndex derives for Ulduar: the kill-credit encounters with a
+    // creature row (instance_encounters 744-770 and creature.sql), in DBC order.
+    // Assembly, Hodir, Thorim, Freya and Algalon are spell credits; Yogg-Saron has
+    // no creature row (Sara has).
+    std::vector<DungeonBossInfo> DerivedRoster()
+    {
+        return {
+            Derived(NPC_LEVIATHAN, 0, "Flame Leviathan", 420.728f, -15.3721f, 409.804f),
+            Derived(33118, 1, "Ignis the Furnace Master", 586.542f, 378.798f, 360.923f),
+            Derived(NPC_RAZORSCALE, 2, "Razorscale", 588.0f, -178.0f, 490.0f),
+            Derived(33293, 3, "XT-002 Deconstructor", 886.275f, -12.0545f, 409.602f),
+            Derived(32930, 5, "Kologarn", 1797.15f, -24.4027f, 448.741f),
+            Derived(33515, 6, "Auriaya", 1956.2f, 49.3155f, 411.358f),
+            Derived(33432, 10, "Mimiron", 2744.65f, 2569.46f, 364.397f),
+            Derived(33271, 11, "General Vezax", 1852.78f, 81.3856f, 342.461f),
+        };
+    }
+}
+
+// ===========================================================================
+//  1. THE PASS KERNEL
+// ===========================================================================
+
+TEST(Ulduar, CapabilityIsAdvertised)
+{
+    EXPECT_EQ(DC_CAPABILITY_RAID_ULDUAR_LEVIATHAN_PASS, 1);
+}
+
+TEST(Ulduar, OutsideIsWestOfTheLeviathansGate)
+{
+    EXPECT_TRUE(DcUlduarPass::Outside(-914.041f)) << "the entrance (areatrigger 5379)";
+    EXPECT_TRUE(DcUlduarPass::Outside(-706.122f)) << "the base camp's Ulduar Teleporter";
+    EXPECT_TRUE(DcUlduarPass::Outside(131.248f)) << "the Formation Grounds teleporter";
+    EXPECT_TRUE(DcUlduarPass::Outside(367.031f)) << "the Colossi at his door";
+    EXPECT_FALSE(DcUlduarPass::Outside(395.062f)) << "the Leviathan Door itself";
+    EXPECT_FALSE(DcUlduarPass::Outside(401.308f)) << "the Lightning Wall";
+    EXPECT_FALSE(DcUlduarPass::Outside(FORGE_X)) << "the Colossal Forge landing";
+    for (DungeonBossInfo const& b : DerivedRoster())
+        if (b.entry != NPC_LEVIATHAN)
+            EXPECT_FALSE(DcUlduarPass::Outside(b.x)) << b.name << " is past the gate";
+}
+
+TEST(Ulduar, PassIsDueOnlyForBotsOutsideWhileHeLives)
+{
+    constexpr uint32 NOT_STARTED = 0, SPECIAL = 4;
+    EXPECT_TRUE(DcUlduarPass::Due(NOT_STARTED, true, false, 25));
+    EXPECT_TRUE(DcUlduarPass::Due(SPECIAL, true, false, 1)) << "engaged once and evaded: still in the way";
+    EXPECT_FALSE(DcUlduarPass::Due(DcUlduarPass::ENCOUNTER_DONE, true, false, 25))
+        << "the gate is open; the raid walks, as a player's would";
+    EXPECT_FALSE(DcUlduarPass::Due(NOT_STARTED, true, true, 25))
+        << "THE RULING: a group a person is in keeps the gate exactly as before";
+    EXPECT_FALSE(DcUlduarPass::Due(NOT_STARTED, false, false, 25));
+    EXPECT_FALSE(DcUlduarPass::Due(NOT_STARTED, true, false, 0)) << "everyone is past already";
+}
+
+TEST(Ulduar, OnlyAFreeBotOutsideIsMoved)
+{
+    float const camp = -706.0f;
+    EXPECT_TRUE(DcUlduarPass::Moves(true, true, false, false, false, camp));
+    EXPECT_FALSE(DcUlduarPass::Moves(false, true, false, false, false, camp)) << "dead";
+    EXPECT_FALSE(DcUlduarPass::Moves(true, false, false, false, false, camp)) << "no bot AI: a person";
+    EXPECT_FALSE(DcUlduarPass::Moves(true, true, true, false, false, camp)) << "a self-bot is a person";
+    EXPECT_FALSE(DcUlduarPass::Moves(true, true, false, true, false, camp))
+        << "in combat: the teleporter's own spell script refuses that";
+    EXPECT_FALSE(DcUlduarPass::Moves(true, true, false, false, true, camp)) << "riding a vehicle";
+    EXPECT_FALSE(DcUlduarPass::Moves(true, true, false, false, false, FORGE_X)) << "already past";
+}
+
+// ===========================================================================
+//  2. THE AUTHORED DATA
+// ===========================================================================
+
+TEST(Ulduar, TheRulingsGeometry)
+{
+    EXPECT_EQ(MAP_ID, 603u);
+    EXPECT_EQ(BOSS_LEVIATHAN, 0u);
+    EXPECT_EQ(BOSS_RAZORSCALE, 2u);
+    EXPECT_EQ(SPELL_COLOSSAL_FORGE_TELEPORT, 64028u) << "the teleporter's gossip option 2 (menu 10389)";
+    EXPECT_EQ(GO_ULDUAR_TELEPORTER, 194569u);
+    // spell_target_position 64028.
+    EXPECT_NEAR(FORGE_X, 553.233f, 0.01f);
+    EXPECT_NEAR(FORGE_Y, -12.324f, 0.01f);
+    EXPECT_NEAR(FORGE_Z, 410.07f, 0.01f);
+    // The boundary sits between his door and the wall behind him.
+    EXPECT_LE(OUTSIDE_MAX_X, 395.062f);
+    EXPECT_GT(OUTSIDE_MAX_X, 368.768f) << "the eastern Colossus at his door is outside";
+}
+
+TEST(Ulduar, LeviathanIsSkippedByDesignAndRazorscaleIsReanchored)
+{
+    BossRosterPatch const* p = Patch();
+    ASSERT_NE(p, nullptr);
+    EXPECT_EQ(p->gate, DcDifficultyGate::Any);
+    ASSERT_EQ(p->skipByDesign.size(), 1u);
+    EXPECT_EQ(p->skipByDesign[0], NPC_LEVIATHAN) << "the vehicle-piloted boss skipByDesign exists for";
+    ASSERT_EQ(p->remove.size(), 1u);
+    EXPECT_EQ(p->remove[0], NPC_RAZORSCALE);
+
+    std::vector<DungeonBossInfo> const roster = BossRosterRegistry::ApplyPatch(*p, DerivedRoster());
+
+    // The Leviathan is still listed — the panel shows why the clear passes him —
+    // and is never a candidate.
+    DungeonBossInfo const* levi = nullptr;
+    for (DungeonBossInfo const& b : roster)
+        if (b.entry == NPC_LEVIATHAN)
+            levi = &b;
+    ASSERT_NE(levi, nullptr);
+    EXPECT_TRUE(levi->skipByDesign);
+    EXPECT_EQ(levi->encounterIndex, 0u) << "his bit is untouched: nothing here credits him";
+
+    // Clear order: the Leviathan, Ignis, the commander, Razorscale, XT-002...
+    std::vector<uint32> order;
+    for (DungeonBossInfo const& b : roster)
+        order.push_back(b.entry);
+    std::vector<uint32> const expect = {
+        NPC_LEVIATHAN, 33118, BossRosterRegistry::ObjectiveEntry(EVENT_RAZORSCALE), NPC_RAZORSCALE,
+        33293, 32930, 33515, 33432, 33271,
+    };
+    EXPECT_EQ(order, expect);
+
+    for (DungeonBossInfo const& b : roster)
+    {
+        if (b.entry == NPC_RAZORSCALE)
+        {
+            EXPECT_EQ(b.kind, DungeonAnchorKind::Boss);
+            EXPECT_EQ(b.encounterIndex, BOSS_RAZORSCALE) << "her real kill bit, explicitly";
+            EXPECT_LT(b.z, 400.0f) << "on the runway floor, not at her hover 100yd up";
+            EXPECT_LT(std::hypot(b.x - COMMANDER_X, b.y - COMMANDER_Y), 30.0f);
+        }
+        if (b.entry == BossRosterRegistry::ObjectiveEntry(EVENT_RAZORSCALE))
+        {
+            EXPECT_EQ(b.kind, DungeonAnchorKind::Objective);
+            EXPECT_EQ(b.eventId, EVENT_RAZORSCALE);
+            EXPECT_EQ(b.doneBossStateIndex, static_cast<int32>(BOSS_RAZORSCALE))
+                << "a re-entered instance does not talk to him again";
+            EXPECT_NEAR(b.x, COMMANDER_X, 0.01f);
+        }
+    }
+}
+
+TEST(Ulduar, EventFlagsAreAsAuthored)
+{
+    DungeonEvent const* pass = Ev(EVENT_LEVIATHAN_PASS);
+    ASSERT_NE(pass, nullptr);
+    EXPECT_EQ(pass->activation, EventActivation::Conditional);
+    EXPECT_TRUE(pass->condition);
+    EXPECT_TRUE(pass->repeatable) << "every straggler re-fires it";
+    EXPECT_FALSE(pass->required);
+    EXPECT_TRUE(pass->stepsOwnMovement);
+    EXPECT_FALSE(pass->drivesInCombat);
+    EXPECT_FALSE(pass->ownsThePull);
+    EXPECT_FALSE(pass->encounterActive);
+    ASSERT_EQ(pass->steps.size(), 1u);
+    EXPECT_EQ(pass->steps[0].kind, EventStepKind::Custom);
+    EXPECT_EQ(pass->steps[0].hookId, HOOK_ULD_PASS);
+    EXPECT_TRUE(ObjectiveHookRegistry::Has(HOOK_ULD_PASS)) << "hook 69 is not registered";
+
+    DungeonEvent const* rz = Ev(EVENT_RAZORSCALE);
+    ASSERT_NE(rz, nullptr);
+    EXPECT_EQ(rz->activation, EventActivation::Anchored);
+    EXPECT_TRUE(rz->persistent);
+    EXPECT_TRUE(rz->required);
+    EXPECT_FALSE(rz->stepsOwnMovement);
+    ASSERT_EQ(rz->steps.size(), 3u);
+    EXPECT_EQ(rz->steps[0].kind, EventStepKind::Custom);
+    EXPECT_EQ(rz->steps[0].hookId, DC_HOOK_RAID_MUSTER) << "the raid musters before her fight";
+    EXPECT_EQ(rz->steps[1].kind, EventStepKind::Gossip);
+    EXPECT_EQ(rz->steps[1].creatureEntry, NPC_EXPEDITION_COMMANDER);
+    EXPECT_EQ(rz->steps[1].gossipOption, 0) << "menu 10314 has one option, 'We are ready to help!'";
+    EXPECT_EQ(rz->steps[2].kind, EventStepKind::MoveTo);
+    EXPECT_EQ(rz->steps[2].bossStateId, static_cast<int32>(BOSS_RAZORSCALE));
+    EXPECT_EQ(rz->steps[2].bossStateClearMask, DcBossStateBit(IN_PROGRESS) | DcBossStateBit(DONE))
+        << "the objective must not finish on a click that did not start her";
+    EXPECT_EQ(rz->steps[2].restartOnBossStateMask, 0u)
+        << "she reads NOT_STARTED for the seconds she flies in after the click";
+}
+
+TEST(Ulduar, KologarnsCacheIsLooted)
+{
+    EXPECT_TRUE(DcEncounterChests::IsEncounterChest(195046));
+    EXPECT_TRUE(DcEncounterChests::IsEncounterChest(195047));
+}
