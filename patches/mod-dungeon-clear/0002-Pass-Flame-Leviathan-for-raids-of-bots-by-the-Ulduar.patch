+// --- Ulduar (map 603) — the imperative half ------------------------------------
+//
+// ONE hook:
+//
+//   69  UlduarPassLeviathan — every eligible bot of the party to the Colossal Forge
+//
+// The ruling (why this is a pass and not a fight, and who it is for) is in
+// DungeonEventTables.h, namespace DcUlduar; the decisions are the pure kernel
+// Util/DcUlduarPassDecision.h, tested in t/TestUlduar.cpp. The destination is read
+// from the teleporter spell's own spell_target_position row, so the raid lands
+// exactly where the Ulduar Teleporter puts a player who picks the Colossal Forge.
+
+namespace
+{
+    using namespace DcUlduar;
+
+    struct Destination
+    {
+        float x, y, z, o;
+    };
+
+    Destination ColossalForge()
+    {
+        if (SpellTargetPosition const* pos =
+                sSpellMgr->GetSpellTargetPosition(SPELL_COLOSSAL_FORGE_TELEPORT, EFFECT_0))
+            if (pos->target_mapId == MAP_ID)
+                return {pos->target_X, pos->target_Y, pos->target_Z, pos->target_Orientation};
+        return {FORGE_X, FORGE_Y, FORGE_Z, FORGE_O};
+    }
+
+    // --- hook 69: THE LEVIATHAN PASS --------------------------------------------------
+    //
+    // Synchronous, like the module's TeleportParty step: one call moves everyone it
+    // can and returns Done, which (StepsOwnMovement) yields the tick. A member it
+    // cannot move this tick (in combat, riding, mid-teleport) is moved by the next
+    // firing: the predicate stays due while any bot is outside.
+    ObjectiveArriveResult UlduarPassLeviathan(Player* bot, AiObjectContext* context,
+                                              DungeonBossInfo const& /*info*/)
+    {
+        if (!bot || !context || bot->GetMapId() != MAP_ID)
+            return ObjectiveArriveResult::Done;
+
+        InstanceScript* inst = DcTargeting::GetInstanceScript(bot);
+        if (!inst || inst->GetBossState(BOSS_LEVIATHAN) == DONE)
+            return ObjectiveArriveResult::Done;  // the gate is open: walk
+
+        std::vector<Player*> members;
+        if (Group* group = bot->GetGroup())
+        {
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                if (Player* m = ref->GetSource())
+                    members.push_back(m);
+        }
+        else
+            members.push_back(bot);
+
+        // The ruling's other half, re-checked here so no path into this hook can
+        // move anyone while a person is in the group.
+        for (Player* m : members)
+            if (DcPlayerbotCompat::IsHumanControlled(m))
+                return ObjectiveArriveResult::Done;
+
+        Destination const to = ColossalForge();
+        uint32 moved = 0, waiting = 0;
+        for (Player* m : members)
+        {
+            if (!m->IsInWorld() || m->GetMapId() != bot->GetMapId() || m->IsBeingTeleported())
+                continue;
+            bool const outside = DcUlduarPass::Outside(m->GetPositionX());
+            if (!DcUlduarPass::Moves(m->IsAlive(), GET_PLAYERBOT_AI(m) != nullptr, /*personControlled*/ false,
+                                     m->IsInCombat(), m->GetVehicle() != nullptr, m->GetPositionX()))
+            {
+                if (outside && m->IsAlive())
+                    ++waiting;
+                continue;
+            }
+
+            float const angle = static_cast<float>(moved) * 0.7f;
+            float const off = moved ? 1.5f + 0.5f * static_cast<float>(moved) : 0.0f;
+            m->GetMotionMaster()->Clear();
+            m->NearTeleportTo(to.x + std::cos(angle) * off, to.y + std::sin(angle) * off, to.z, to.o,
+                              /*casting*/ false, /*vehicle*/ false, /*withPet*/ true);
+            ++moved;
+        }
+
+        DcRunState& st = DcRun::Of(context);
+        if ((moved || waiting) && !st.Throttled(DcThrottle::UldPassLog, PASS_LOG_THROTTLE_MS))
+            LOG_INFO("playerbots.dungeonclear",
+                     "[DC:{}] Ulduar — Flame Leviathan (state {}) is passed, not fought: {} bot(s) taken to "
+                     "the Colossal Forge by the Ulduar Teleporter's destination ({:.1f}, {:.1f}, {:.1f}); "
+                     "{} outside still waiting (combat, a vehicle)",
+                     bot->GetName(), static_cast<uint32>(inst->GetBossState(BOSS_LEVIATHAN)), moved, to.x, to.y,
+                     to.z, waiting);
+        return ObjectiveArriveResult::Done;
+    }
+}
+
+// Id 69 (one flat space across every dungeon).
+void RegisterUlduarHooks(ObjectiveHookRegistry::HookTable& out)
+{
+    ObjectiveHookRegistry::AddHook(out, DcUlduar::HOOK_ULD_PASS, &UlduarPassLeviathan);
+}
