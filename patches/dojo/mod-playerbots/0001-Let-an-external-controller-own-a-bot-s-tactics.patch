diff --git a/src/Bot/PlayerbotAI.h b/src/Bot/PlayerbotAI.h
index d8d7c978..399bbde3 100644
--- a/src/Bot/PlayerbotAI.h
+++ b/src/Bot/PlayerbotAI.h
@@ -357,6 +357,8 @@ public:
     void AddHandler(uint16 opcode, std::string const handler);
     void Handle(ExternalEventHelper& helper);
     void AddPacket(WorldPacket const& packet);
+    bool HasHandler(uint16 opcode) const { return handlers.find(opcode) != handlers.end(); }
+    void Clear() { queue = std::stack<WorldPacket>(); }
 
 private:
     std::map<uint16, std::string> handlers;
@@ -407,6 +409,20 @@ public:
     void UpdateAI(uint32 elapsed, bool minimal = false) override;
     void UpdateAIInternal(uint32 elapsed, bool minimal = false) override;
     bool UpdateAIReaction(uint32 elapsed, bool minimal, bool canControlSelf);
+
+    // Exclusive external control of this bot's tactics, for a training controller such as mod-dojo. World thread
+    // only. While owned, UpdateAI keeps its state checks and fall information and skips everything else: reactions,
+    // the engines, cast cancellation and facing, transport and group-master updates. Chat commands, queued packets
+    // and cast, action or interrupt requests are refused; root, knockback and dismount emulation still run, and
+    // teleport acks and session packets stay in PlayerbotHolder. An epoch is never reused, so a stale owner cannot
+    // release a newer one, and ownership ends with this PlayerbotAI. Release resets the AI as a far teleport does.
+    uint64 AcquireExternalControl(std::string const& owner);
+    bool ReleaseExternalControl(uint64 epoch);
+    bool IsExternallyControlled() const { return _externalControlEpoch != 0; }
+    uint64 GetExternalControlEpoch() const { return _externalControlEpoch; }
+    std::string const& GetExternalControlOwner() const { return _externalControlOwner; }
+    uint32 GetExternalControlSkippedUpdates() const { return _externalControlSkippedUpdates; }
+    uint32 GetExternalControlRefusedInputs() const { return _externalControlRefusedInputs; }
     Engine* GetCurrentEngine() const { return currentEngine; }
     void SetActionDuration(Action const* action);
     using PlayerbotAIBase::SetActionDuration;
@@ -688,6 +704,14 @@ protected:
     Position jumpDestination = Position();
     uint32 nextTransportCheck = 0;
     bool spellInterruptRequested = false;
+
+private:
+    bool RefuseWhileExternallyControlled();
+
+    uint64 _externalControlEpoch = 0;
+    std::string _externalControlOwner;
+    uint32 _externalControlSkippedUpdates = 0;
+    uint32 _externalControlRefusedInputs = 0;
 };
 
