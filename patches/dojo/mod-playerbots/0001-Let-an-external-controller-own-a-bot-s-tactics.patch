 constexpr uint32 VEHICLE_FLAG_FIXED_POSITION = 0x00200000;
+
+// Epochs of external control are unique for the process lifetime, across every bot.
+std::atomic<uint64> lastExternalControlEpoch{0};
 }
 
 std::vector<std::string> PlayerbotAI::dispel_whitelist = {
@@ -268,6 +272,12 @@ void PlayerbotAI::UpdateAI(uint32 elapsed, bool minimal)
     if (!bot->Unit::IsFalling())
         bot->SetFallInformation(0, bot->GetPositionZ());
 
+    if (IsExternallyControlled())
+    {
+        ++_externalControlSkippedUpdates;
+        return;
+    }
+
     // Handle cheat options (set bot health and power if cheats are enabled)
     if (bot->IsAlive() &&
         (static_cast<uint32>(GetCheat()) > 0 || static_cast<uint32>(sPlayerbotAIConfig.BotCheatMask) > 0))
@@ -486,6 +496,54 @@ void PlayerbotAI::SetActionDuration(Action const* action)
         PlayerbotAIBase::SetActionDuration(action->GetDuration());
 }
 
+uint64 PlayerbotAI::AcquireExternalControl(std::string const& owner)
+{
+    if (!bot || owner.empty() || IsExternallyControlled() || IsSelfBot(bot) || HasGameClientMaster())
+        return 0;
+
+    _externalControlEpoch = ++lastExternalControlEpoch;
+    _externalControlOwner = owner;
+    _externalControlSkippedUpdates = 0;
+    _externalControlRefusedInputs = 0;
+
+    // Work queued for stock behaviour before the acquisition is stock's; the owner starts without it.
+    if (reactionEngine)
+        reactionEngine->ResetReactions();
+    chatCommands.clear();
+    chatReplies.clear();
+    botOutgoingPacketHandlers.Clear();
+    masterIncomingPacketHandlers.Clear();
+    masterOutgoingPacketHandlers.Clear();
+    spellInterruptRequested = false;
+
+    LOG_INFO("playerbots", "Bot {} is externally controlled by {} (epoch {})", bot->GetName(), owner,
+             _externalControlEpoch);
+    return _externalControlEpoch;
+}
+
+bool PlayerbotAI::ReleaseExternalControl(uint64 epoch)
+{
+    if (!epoch || epoch != _externalControlEpoch)
+        return false;
+
+    LOG_INFO("playerbots", "Bot {} is released by {} (epoch {}; {} updates skipped, {} inputs refused)",
+             bot->GetName(), _externalControlOwner, epoch, _externalControlSkippedUpdates,
+             _externalControlRefusedInputs);
+    _externalControlEpoch = 0;
+    _externalControlOwner.clear();
+    Reset(true);
+    return true;
+}
+
+bool PlayerbotAI::RefuseWhileExternallyControlled()
+{
+    if (!IsExternallyControlled())
+        return false;
+
+    ++_externalControlRefusedInputs;
+    return true;
+}
+
