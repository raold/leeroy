From bc7120cf38dbc5f4959f8212ca38f6e768a8beca Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 4 Nov 2026 13:53:07 -0500
Subject: [PATCH] Let an external controller own a bot's tactics

AcquireExternalControl gives a caller (a training controller such as
mod-dojo) exclusive control of one bot under an epoch that is never
reused; ReleaseExternalControl takes only the current epoch and resets
the AI as a far teleport does, so stock behaviour resumes from a clean
state. Ownership lives in the PlayerbotAI and ends with it.

While owned, UpdateAI keeps its state checks and fall information and
returns before the cheat refill, the reaction engine, the preparing-cast
handling, the transport and group-master updates and UpdateAIInternal.
Chat commands and replies, the master's packets, DoSpecificAction,
DoNextAction, CastSpell, CastVehicleSpell and RequestSpellInterrupt are
refused and counted; the bot's own packets are dropped except root,
unroot, knockback and dismount. Teleport acks and session packets in
PlayerbotHolder are untouched. Inert until a caller acquires a bot.
---
 src/Bot/PlayerbotAI.cpp | 104 +++++++++++++++++++++++++++++++++++++---
 src/Bot/PlayerbotAI.h   |  24 ++++++++++
 2 files changed, 122 insertions(+), 6 deletions(-)

diff --git a/src/Bot/PlayerbotAI.cpp b/src/Bot/PlayerbotAI.cpp
index 5bd3437f..3ed5de81 100644
--- a/src/Bot/PlayerbotAI.cpp
+++ b/src/Bot/PlayerbotAI.cpp
@@ -58,2 +58,3 @@
 #include "WsgRouteState.h"
+#include <atomic>
 #include <algorithm>
@@ -72,2 +73,5 @@ constexpr uint32 SPELL_GRAVITY_LAPSE_MGT = 44226;
 constexpr uint32 VEHICLE_FLAG_FIXED_POSITION = 0x00200000;
+
+// Epochs of external control are unique for the process lifetime, across every bot.
+std::atomic<uint64> lastExternalControlEpoch{0};
 }
@@ -270,2 +274,8 @@ void PlayerbotAI::UpdateAI(uint32 elapsed, bool minimal)
 
+    if (IsExternallyControlled())
+    {
+        ++_externalControlSkippedUpdates;
+        return;
+    }
+
     // Handle cheat options (set bot health and power if cheats are enabled)
@@ -488,2 +498,50 @@ void PlayerbotAI::SetActionDuration(Action const* action)
 
+uint64 PlayerbotAI::AcquireExternalControl(std::string const& owner)
+{
+    if (!bot || owner.empty() || IsExternallyControlled() || IsSelfBot(bot) || HasGameClientMaster())
+        return 0;
+
+    _externalControlEpoch = ++lastExternalControlEpoch;
+    _externalControlOwner = owner;
+    _externalControlSkippedUpdates = 0;
+    _externalControlRefusedInputs = 0;
+
+    // Work queued for stock behaviour before the acquisition is stock's; the owner starts without it.
+    if (reactionEngine)
+        reactionEngine->ResetReactions();
+    chatCommands.clear();
+    chatReplies.clear();
+    botOutgoingPacketHandlers.Clear();
+    masterIncomingPacketHandlers.Clear();
+    masterOutgoingPacketHandlers.Clear();
+    spellInterruptRequested = false;
+
+    LOG_INFO("playerbots", "Bot {} is externally controlled by {} (epoch {})", bot->GetName(), owner,
+             _externalControlEpoch);
+    return _externalControlEpoch;
+}
+
+bool PlayerbotAI::ReleaseExternalControl(uint64 epoch)
+{
+    if (!epoch || epoch != _externalControlEpoch)
+        return false;
+
+    LOG_INFO("playerbots", "Bot {} is released by {} (epoch {}; {} updates skipped, {} inputs refused)",
+             bot->GetName(), _externalControlOwner, epoch, _externalControlSkippedUpdates,
+             _externalControlRefusedInputs);
+    _externalControlEpoch = 0;
+    _externalControlOwner.clear();
+    Reset(true);
+    return true;
+}
+
+bool PlayerbotAI::RefuseWhileExternallyControlled()
+{
+    if (!IsExternallyControlled())
+        return false;
+
+    ++_externalControlRefusedInputs;
+    return true;
+}
+
 // Helper function for UpdateAI to check group membership and handle removal if necessary
@@ -687,3 +745,3 @@ void PlayerbotAI::HandleCommand(uint32 type, std::string const& text, Player& fr
 {
-    if (!bot)
+    if (!bot || RefuseWhileExternallyControlled())
         return;
@@ -1046,2 +1104,5 @@ void PlayerbotAI::HandleCommand(uint32 type, std::string const text, Player* fro
 {
+    if (RefuseWhileExternallyControlled())
+        return;
+
     if (!GetSecurity()->CheckLevelFor(PLAYERBOT_SECURITY_INVITE, type != CHAT_MSG_WHISPER, fromPlayer))
@@ -1227,3 +1288,13 @@ void PlayerbotAI::HandleBotOutgoingPacket(WorldPacket const& packet)
 
-    switch (packet.GetOpcode())
+    // An external owner decides; only the client's root, knockback and dismount handling below still runs.
+    uint16 const opcode = packet.GetOpcode();
+    if (IsExternallyControlled() && opcode != SMSG_FORCE_MOVE_ROOT && opcode != SMSG_FORCE_MOVE_UNROOT &&
+        opcode != SMSG_MOVE_KNOCK_BACK && opcode != SMSG_DISMOUNT)
+    {
+        if (botOutgoingPacketHandlers.HasHandler(opcode))
+            ++_externalControlRefusedInputs;
+        return;
+    }
+
+    switch (opcode)
     {
@@ -1527,2 +1598,5 @@ void PlayerbotAI::HandleMasterIncomingPacket(WorldPacket const& packet)
 {
+    if (masterIncomingPacketHandlers.HasHandler(packet.GetOpcode()) && RefuseWhileExternallyControlled())
+        return;
+
     masterIncomingPacketHandlers.AddPacket(packet);
@@ -1532,2 +1606,5 @@ void PlayerbotAI::HandleMasterOutgoingPacket(WorldPacket const& packet)
 {
+    if (masterOutgoingPacketHandlers.HasHandler(packet.GetOpcode()) && RefuseWhileExternallyControlled())
+        return;
+
     masterOutgoingPacketHandlers.AddPacket(packet);
@@ -1587,2 +1664,5 @@ void PlayerbotAI::DoNextAction(bool min)
 {
+    if (IsExternallyControlled())
+        return;
+
     if (!bot->IsInWorld() || bot->IsBeingTeleported() || (GetMaster() && GetMaster()->IsBeingTeleported()))
@@ -1916,2 +1996,5 @@ bool PlayerbotAI::DoSpecificAction(std::string const name, Event event, bool sil
 {
+    if (RefuseWhileExternallyControlled())
+        return false;
+
     std::ostringstream out;
@@ -3697,3 +3780,3 @@ bool PlayerbotAI::CastSpell(uint32 spellId, Unit* target, Item* itemTarget)
 {
-    if (!spellId)
+    if (!spellId || RefuseWhileExternallyControlled())
         return false;
@@ -3999,3 +4082,3 @@ bool PlayerbotAI::CastSpell(uint32 spellId, float x, float y, float z, Item* ite
 {
-    if (!spellId)
+    if (!spellId || RefuseWhileExternallyControlled())
         return false;
@@ -4238,3 +4321,3 @@ bool PlayerbotAI::CastVehicleSpell(uint32 spellId, Unit* target)
 {
-    if (!spellId)
+    if (!spellId || RefuseWhileExternallyControlled())
         return false;
@@ -4440,2 +4523,5 @@ void PlayerbotAI::RequestSpellInterrupt()
 {
+    if (RefuseWhileExternallyControlled())
+        return;
+
     Spell* currentSpell = bot->GetCurrentSpell(CURRENT_GENERIC_SPELL);
@@ -6295,3 +6381,9 @@ bool PlayerbotAI::IsInRealGuild()
 
-void PlayerbotAI::QueueChatResponse(const ChatQueuedReply chatReply) { chatReplies.push_back(std::move(chatReply)); }
+void PlayerbotAI::QueueChatResponse(const ChatQueuedReply chatReply)
+{
+    if (RefuseWhileExternallyControlled())
+        return;
+
+    chatReplies.push_back(std::move(chatReply));
+}
 
diff --git a/src/Bot/PlayerbotAI.h b/src/Bot/PlayerbotAI.h
index d8d7c978..399bbde3 100644
--- a/src/Bot/PlayerbotAI.h
+++ b/src/Bot/PlayerbotAI.h
@@ -359,2 +359,4 @@ public:
     void AddPacket(WorldPacket const& packet);
+    bool HasHandler(uint16 opcode) const { return handlers.find(opcode) != handlers.end(); }
+    void Clear() { queue = std::stack<WorldPacket>(); }
 
@@ -409,2 +411,16 @@ public:
     bool UpdateAIReaction(uint32 elapsed, bool minimal, bool canControlSelf);
+
+    // Exclusive external control of this bot's tactics, for a training controller such as mod-dojo. World thread
+    // only. While owned, UpdateAI keeps its state checks and fall information and skips everything else: reactions,
+    // the engines, cast cancellation and facing, transport and group-master updates. Chat commands, queued packets
+    // and cast, action or interrupt requests are refused; root, knockback and dismount emulation still run, and
+    // teleport acks and session packets stay in PlayerbotHolder. An epoch is never reused, so a stale owner cannot
+    // release a newer one, and ownership ends with this PlayerbotAI. Release resets the AI as a far teleport does.
+    uint64 AcquireExternalControl(std::string const& owner);
+    bool ReleaseExternalControl(uint64 epoch);
+    bool IsExternallyControlled() const { return _externalControlEpoch != 0; }
+    uint64 GetExternalControlEpoch() const { return _externalControlEpoch; }
+    std::string const& GetExternalControlOwner() const { return _externalControlOwner; }
+    uint32 GetExternalControlSkippedUpdates() const { return _externalControlSkippedUpdates; }
+    uint32 GetExternalControlRefusedInputs() const { return _externalControlRefusedInputs; }
     Engine* GetCurrentEngine() const { return currentEngine; }
@@ -690,2 +706,10 @@ protected:
     bool spellInterruptRequested = false;
+
+private:
+    bool RefuseWhileExternallyControlled();
+
+    uint64 _externalControlEpoch = 0;
+    std::string _externalControlOwner;
+    uint32 _externalControlSkippedUpdates = 0;
+    uint32 _externalControlRefusedInputs = 0;
 };
