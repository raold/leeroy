     if (!bot->IsInWorld() || bot->IsBeingTeleported() || (GetMaster() && GetMaster()->IsBeingTeleported()))
     {
         SetNextCheckDelay(sPlayerbotAIConfig.GlobalCoolDown);
@@ -1911,6 +1991,9 @@ bool PlayerbotAI::HasTargetExclusions() const
 
