@@ -1225,7 +1286,17 @@ void PlayerbotAI::HandleBotOutgoingPacket(WorldPacket const& packet)
     if (!bot || !bot->IsInWorld() || bot->IsDuringRemoveFromWorld())
         return;
 
-    switch (packet.GetOpcode())
+    // An external owner decides; only the client's root, knockback and dismount handling below still runs.
+    uint16 const opcode = packet.GetOpcode();
+    if (IsExternallyControlled() && opcode != SMSG_FORCE_MOVE_ROOT && opcode != SMSG_FORCE_MOVE_UNROOT &&
+        opcode != SMSG_MOVE_KNOCK_BACK && opcode != SMSG_DISMOUNT)
+    {
+        if (botOutgoingPacketHandlers.HasHandler(opcode))
+            ++_externalControlRefusedInputs;
+        return;
+    }
+
+    switch (opcode)
     {
         case SMSG_SPELL_FAILURE:
         {
@@ -1525,11 +1596,17 @@ int32 PlayerbotAI::CalculateGlobalCooldown(uint32 spellid)
 
 void PlayerbotAI::HandleMasterIncomingPacket(WorldPacket const& packet)
 {
+    if (masterIncomingPacketHandlers.HasHandler(packet.GetOpcode()) && RefuseWhileExternallyControlled())
