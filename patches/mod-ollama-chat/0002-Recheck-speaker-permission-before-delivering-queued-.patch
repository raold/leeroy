From 80bd8c9ec5fd747defade69f9ec848dd74d903ce Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:38:16 -0500
Subject: [PATCH 2/2] Recheck speaker permission before delivering queued
 replies

---
 src/mod-ollama-chat_dispatch.cpp | 25 +++++++++++++++++++------
 src/mod-ollama-chat_dispatch.h   |  8 ++++++--
 2 files changed, 25 insertions(+), 8 deletions(-)

diff --git a/src/mod-ollama-chat_dispatch.cpp b/src/mod-ollama-chat_dispatch.cpp
index dc5d5db..7b9c2fd 100644
--- a/src/mod-ollama-chat_dispatch.cpp
+++ b/src/mod-ollama-chat_dispatch.cpp
@@ -91,6 +91,18 @@ namespace
     std::mutex          g_speakerFilterMutex;
     OllamaSpeakerFilter g_speakerFilter;
 
+    bool SpeakerAllowed(uint64_t botGuid)
+    {
+        OllamaSpeakerFilter filter;
+        {
+            std::lock_guard<std::mutex> lock(g_speakerFilterMutex);
+            filter = g_speakerFilter;
+        }
+        // The callback may consult another module or replace the filter. Never
+        // hold our registry mutex while invoking it.
+        return !filter || filter(botGuid);
+    }
+
     void RecordError(const std::string& what)
     {
         ++g_totalFailed;
@@ -329,6 +341,12 @@ namespace
 
     void Deliver(const Completion& c, const OllamaWorldSnapshot& world)
     {
+        // A bot can become muted while generation or the typing delay is in
+        // progress. Recheck before any routing, governor, history or expression
+        // side effect, including replies to a direct address.
+        if (!SpeakerAllowed(c.request.botGuid))
+            return;
+
         Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(c.request.botGuid));
         if (!bot || !bot->IsInWorld())
             return;
@@ -497,12 +515,7 @@ bool OllamaDispatch_Submit(OllamaChatRequest request)
     if (request.prompt.empty() || request.botGuid == 0)
         return false;
 
-    OllamaSpeakerFilter speakerFilter;
-    {
-        std::lock_guard<std::mutex> lock(g_speakerFilterMutex);
-        speakerFilter = g_speakerFilter;
-    }
-    if (speakerFilter && !speakerFilter(request.botGuid))
+    if (!SpeakerAllowed(request.botGuid))
     {
         if (g_DebugEnabled)
             LOG_INFO("module.ollamachat",
diff --git a/src/mod-ollama-chat_dispatch.h b/src/mod-ollama-chat_dispatch.h
index 2c7a23c..7777cb3 100644
--- a/src/mod-ollama-chat_dispatch.h
+++ b/src/mod-ollama-chat_dispatch.h
@@ -92,8 +92,12 @@ struct OllamaChatRequest
 // case the caller should simply skip this bot rather than pile up backlog.
 bool OllamaDispatch_Submit(OllamaChatRequest request);
 
-// Return false to keep that bot silent: Submit() then drops the request and returns false.
-// Set once at startup; called on the submitting thread, so it must be thread-safe.
+// Return false to keep that bot silent: Submit() drops the request and returns false,
+// and delivery rechecks the current filter before any speech or other side effects.
+// This also drops replies queued before a bot became muted. The callback runs
+// outside the registry mutex and must be safe to call from any submitting thread.
+#define OLLAMA_SPEAKER_FILTER_AT_DELIVERY 1
+// Install at startup; invoked on submitting threads and the world delivery thread.
 using OllamaSpeakerFilter = std::function<bool(uint64_t botGuid)>;   // raw 64-bit GUID, as request.botGuid
 void OllamaDispatch_SetSpeakerFilter(OllamaSpeakerFilter filter);
 
