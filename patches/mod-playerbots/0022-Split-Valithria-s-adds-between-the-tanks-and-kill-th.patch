+        return nullptr;
+    std::list<Creature*> archmages;
+    bot->GetCreatureListWithEntryInGrid(archmages, NPC_RISEN_ARCHMAGE, 30.0f);
+    Creature* best = nullptr;
+    float bestDistance = FLT_MAX;
+    for (Creature* archmage : archmages)
+    {
+        if (!archmage || !archmage->IsAlive())
+            continue;
+        Spell* spell = archmage->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+        if (!spell || !RaidInteractions::VdwTakesInterrupt(spell->GetSpellInfo()->Id, spell->GetCastTimeRemaining()))
