+struct VdwTarget
+{
+    VdwAdd add = VdwAdd::Other;
+    float distance = 0.0f;       // from the reference point (the current mark, or her)
+    std::uint32_t crowd = 0;     // other adds of its kind within area-of-effect reach (worms, suppressers)
+};
+
+// Worms pile on a tank and suppressers on her: those are marked where the most of them stand, so area spells
+// hit the pile.
+inline bool VdwCrowds(VdwAdd add)
+{
+    return add == VdwAdd::Worm || add == VdwAdd::Suppresser;
+}
+
+// The add to mark: the best kill rank; within a rank the one with the most of its kind around it (only worms and
+// suppressers count any), then the nearest. -1 when none can be killed by this role.
+inline int VdwPickTarget(std::vector<VdwTarget> const& adds, bool melee)
+{
+    std::size_t abominations = 0;
+    for (VdwTarget const& target : adds)
+        abominations += target.add == VdwAdd::Abomination;
+    int best = -1;
+    for (std::size_t i = 0; i < adds.size(); ++i)
+    {
+        int const rank = VdwKillRank(adds[i].add, melee, abominations);
+        if (rank < 0)
+            continue;
+        if (best < 0)
+        {
+            best = static_cast<int>(i);
+            continue;
+        }
+        VdwTarget const& chosen = adds[static_cast<std::size_t>(best)];
+        int const bestRank = VdwKillRank(chosen.add, melee, abominations);
+        if (rank != bestRank)
+        {
+            if (rank < bestRank)
+                best = static_cast<int>(i);
+            continue;
+        }
+        if (adds[i].crowd != chosen.crowd)
+        {
+            if (adds[i].crowd > chosen.crowd)
+                best = static_cast<int>(i);
+            continue;
+        }
+        if (adds[i].distance < chosen.distance)
+            best = static_cast<int>(i);
+    }
+    return best;
+}
+
+// Whether a mark should move from the current add to the picked one: only to a strictly better kill rank, so
+// a mark stays on its add until it dies, the add leaves reach or a more urgent kind arrives.
+inline bool VdwRemark(VdwAdd current, bool currentValid, VdwAdd picked, bool melee, std::size_t abominations = 1)
+{
+    if (!currentValid)
+        return true;
+    int const currentRank = VdwKillRank(current, melee, abominations);
+    int const pickedRank = VdwKillRank(picked, melee, abominations);
+    return currentRank < 0 || (pickedRank >= 0 && pickedRank < currentRank);
+}
