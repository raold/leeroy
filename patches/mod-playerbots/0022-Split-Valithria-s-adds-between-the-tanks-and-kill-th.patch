+// Playerbots.ValithriaAdds: at Valithria a tank's own target leaves out what it does not hold
+// (RaidInteractions::VdwTankHolds) unless that add is on it, and every suppresser, so neither the skull nor the
+// stock pick drags a tank off its own adds. Off, nothing is excluded.
+void RaidIccStrategy::AppendTargetExclusions(GuidSet& exclusions, TargetValueExclusionType type)
+{
+    if (!sPlayerbotAIConfig.ValithriaAdds || type != TargetValueExclusionType::TankTarget)
+        return;
+    Player* bot = botAI->GetBot();
+    if (bot->GetMapId() != 631 || !PlayerbotAI::IsTank(bot) ||
+        !bot->FindNearestCreature(NPC_VALITHRIA_DREAMWALKER, 100.0f))
+        return;
+    std::vector<Player*> const tanks = IccValithriaTanks(bot);
+    int const rank = IccValithriaTankRank(tanks, bot);
+    if (rank < 0)
+        return;
+    AiObjectContext* context = botAI->GetAiObjectContext();
+    for (ObjectGuid const& guid : AI_VALUE(GuidVector, "possible targets"))
+    {
+        Unit* unit = botAI->GetUnit(guid);
+        if (!unit)
+            continue;
+        RaidInteractions::VdwAdd const add = RaidInteractions::VdwAddOf(unit->GetEntry());
+        if (add == RaidInteractions::VdwAdd::Other)
+            continue;
+        bool const onMe = unit->GetVictim() == bot;
+        if (add == RaidInteractions::VdwAdd::Suppresser ||
+            (!onMe && !RaidInteractions::VdwTankHolds(add, static_cast<std::size_t>(rank), tanks.size())))
+            exclusions.insert(guid);
+    }
+}
