+bool IccValithriaPortalTurn(Player* bot)
+{
+    if (!IccValithriaCanUsePortal(bot))
+        return false;
+    Group* group = bot->GetGroup();
+    if (!IccValithriaTurnsApply(bot) || !group)
+        return true;
+    IcecrownHelpers::IccInstanceState& state = IcecrownHelpers::IccState(bot->GetMap()->GetInstanceId());
+    uint32 const now = getMSTime();
+    std::vector<RaidInteractions::PortalTaker> takers;
+    std::size_t staying = 0;
+    bool otherDreaming = false;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || !member->IsAlive() || !member->IsInWorld() || member->GetMap() != bot->GetMap())
+            continue;
+        bool const dreaming = member->HasAura(SPELL_DREAM_STATE);
+        // Anyone else in the dream holds it, a human or the raid healer included: the reserve role can move onto
+        // a healer while it is there.
+        if (dreaming && member != bot)
+            otherDreaming = true;
+        if (IsSelfBot(member) || !PlayerbotAI::IsHeal(member) || !IccValithriaCanUsePortal(member))
+            continue;
+        // A human healer records no trips, so only bots are ranked; a human on her still counts toward the floor.
+        if (!GET_PLAYERBOT_AI(member))
+        {
+            if (!dreaming)
+                ++staying;
+            continue;
+        }
+        RaidInteractions::PortalTaker taker;
+        taker.guid = member->GetGUID().GetRawValue();
+        auto const trip = state.vtDreamTrips.find(member->GetGUID());
+        if (trip != state.vtDreamTrips.end())
+        {
+            taker.trips = trip->second.trips;
+            taker.sinceLastMs = getMSTimeDiff(trip->second.lastMs, now);
+        }
+        else
+            taker.sinceLastMs = UINT32_MAX;
+        // A claim counts while its portal is still there: a used portal despawns, and its claim must not block
+        // the next healer's turn.
+        auto const claim = state.vtPortalClaim.find(member->GetGUID());
+        Creature* const claimed = claim == state.vtPortalClaim.end() ? nullptr
+                                                                     : ObjectAccessor::GetCreature(*bot, claim->second);
+        taker.busy = dreaming || (claimed && claimed->IsAlive() && claimed->IsInWorld());
+        // A healer a zombie or worm chases, or below half health, does not go now: the turn passes on.
+        taker.available = !member->HealthBelowPct(50);
+        for (Unit* attacker : member->getAttackers())
+            if (attacker && (attacker->GetEntry() == NPC_BLISTERING_ZOMBIE || attacker->GetEntry() == NPC_ROT_WORM))
+                taker.available = false;
+        takers.push_back(taker);
+    }
+    return RaidInteractions::TakesPortalTurn(bot->GetGUID().GetRawValue(), takers, ValithriaHealers(bot).size(),
+                                             staying, otherDreaming);
+}
