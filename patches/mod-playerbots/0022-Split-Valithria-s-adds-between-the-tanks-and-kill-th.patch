+bool IccValithriaInterruptAction::Execute(Event /*event*/)
+{
+    Creature* archmage = IccValithriaVolleyToInterrupt(bot);
+    if (!archmage)
+        return false;
+    for (char const* spell : IccValithriaInterrupts(bot))
