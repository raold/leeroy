+// records no trips, so ranking him would hold the turn forever. `staying` counts the other healers on her who will
+// not go (humans out of the dream); `otherDreaming` is true while anyone else in the group is in the dream (a human,
+// or a healer whose reserve role moved onto it while it was there). `healers` is all her healers.
+inline bool TakesPortalTurn(std::uint64_t guid, std::vector<PortalTaker> const& takers, std::size_t healers,
+                            std::size_t staying = 0, bool otherDreaming = false)
+{
+    auto const mine =
+        std::find_if(takers.begin(), takers.end(), [guid](PortalTaker const& taker) { return taker.guid == guid; });
+    if (mine == takers.end())
+        return false;
+    if (mine->busy)
+        return true;
+    if (otherDreaming || !mine->available ||
+        std::any_of(takers.begin(), takers.end(), [](PortalTaker const& taker) { return taker.busy; }))
+        return false;
+    if (takers.size() - 1 + staying < PortalFloor(healers))
+        return false;
+    // The turn goes to the free taker with the fewest trips, then the oldest trip, then the lowest guid; a taker
+    // that cannot go now (chased, or low) is passed over instead of stalling the wave.
+    auto better = [](PortalTaker const& left, PortalTaker const& right)
+    {
+        if (left.trips != right.trips)
+            return left.trips < right.trips;
+        if (left.sinceLastMs != right.sinceLastMs)
+            return left.sinceLastMs > right.sinceLastMs;
+        return left.guid < right.guid;
+    };
+    for (PortalTaker const& taker : takers)
+        if (taker.available && taker.guid != guid && better(taker, *mine))
+            return false;
