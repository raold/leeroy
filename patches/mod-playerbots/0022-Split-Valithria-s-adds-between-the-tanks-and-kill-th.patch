+inline constexpr float VdwTankReach = 80.0f;
+
+struct VdwTankCandidate
+{
+    std::uint64_t guid = 0;
+    bool bot = false;
+    bool alive = false;
+    float distanceToHer = 0.0f;
+};
+
+inline std::vector<std::uint64_t> VdwRankTanks(std::vector<VdwTankCandidate> const& candidates)
+{
+    std::vector<std::uint64_t> ranked;
+    for (VdwTankCandidate const& candidate : candidates)
+        if (candidate.bot && candidate.alive && candidate.distanceToHer <= VdwTankReach)
+            ranked.push_back(candidate.guid);
+    std::sort(ranked.begin(), ranked.end());
+    return ranked;
