+// ValithriaAdds: taunt the nearest add this tank holds that is not on its holder (in reach), or close in on it. An
+// add on a tank outside the ranking (a human, a self-bot, a bot out of reach) stays with that tank.
+// The raid cheat's taunt fixes the add on the tank (IccCastClassTaunt). Stray worms go to the tank holding fewer.
+// Only adds already within the marking radius count: her adds walk in from the doors 80 yd away, and a tank that
+// went out to meet them held a skeleton, a zombie and archmages 60-65 yd from her, where no skull reaches, while
+// the skeleton's Lay Waste burned the room for 50 s.
+bool IccValithriaGroupAction::TankAdds()
+{
+    constexpr float ADD_TAUNT_RANGE = 30.0f;
+    constexpr float CHASE_STEP = 10.0f;
+    constexpr float MARK_RADIUS = 45.0f;
+    std::vector<Player*> const tanks = IccValithriaTanks(bot);
+    int const rank = IccValithriaTankRank(tanks, bot);
+    if (rank < 0)
+        return false;
+
+    GuidVector const candidates = AI_VALUE(GuidVector, "possible targets");
+    std::vector<std::size_t> worms(tanks.size(), 0);
+    for (ObjectGuid const& guid : candidates)
+        if (Unit* unit = botAI->GetUnit(guid))
+            if (unit->IsAlive() && RaidInteractions::VdwAddOf(unit->GetEntry()) == RaidInteractions::VdwAdd::Worm)
+                if (int const on = IccValithriaTankRank(tanks, unit->GetVictim()); on >= 0)
+                    ++worms[static_cast<std::size_t>(on)];
+    std::size_t fewest = SIZE_MAX;
+    for (std::size_t i = 0; i < tanks.size(); ++i)
+        if (static_cast<int>(i) != rank)
+            fewest = std::min(fewest, worms[i]);
+    bool const takesWorms = RaidInteractions::VdwTakesWorm(worms[static_cast<std::size_t>(rank)], fewest);
+
+    Unit* stray = nullptr;
+    float bestDist = FLT_MAX;
+    for (ObjectGuid const& guid : candidates)
+    {
+        Unit* unit = botAI->GetUnit(guid);
+        if (!unit || !unit->IsAlive() ||
+            unit->GetExactDist2d(ICC_VDW_HEAL_POSITION.GetPositionX(), ICC_VDW_HEAL_POSITION.GetPositionY()) >
+                MARK_RADIUS)
+            continue;
+        RaidInteractions::VdwAdd const add = RaidInteractions::VdwAddOf(unit->GetEntry());
+        Unit* const victim = unit->GetVictim();
+        int const victimRank = IccValithriaTankRank(tanks, victim);
+        bool const otherTank =
+            victimRank < 0 && victim && victim->ToPlayer() && PlayerbotAI::IsTank(victim->ToPlayer());
+        if (!RaidInteractions::VdwTankPicksUp(add, static_cast<std::size_t>(rank), tanks.size(), victimRank,
+                                              otherTank) ||
+            (add == RaidInteractions::VdwAdd::Worm && !takesWorms))
+            continue;
+        float const d = bot->GetExactDist2d(unit);
+        if (d < bestDist)
+        {
+            bestDist = d;
+            stray = unit;
+        }
+    }
+    if (!stray)
+        return false;
+    if (bestDist <= ADD_TAUNT_RANGE)
+    {
+        IccCastClassTaunt(bot, botAI, stray);
+        return false;
+    }
+    float dx = stray->GetPositionX() - bot->GetPositionX();
+    float dy = stray->GetPositionY() - bot->GetPositionY();
+    float const len = std::sqrt(dx * dx + dy * dy);
+    if (len <= 0.001f)
+        return false;
+    dx /= len;
+    dy /= len;
+    float const step = std::min(CHASE_STEP, bestDist - ADD_TAUNT_RANGE + 5.0f);
+    MoveTo(bot->GetMapId(), bot->GetPositionX() + dx * step, bot->GetPositionY() + dy * step, bot->GetPositionZ(),
+           false, false, false, false, MovementPriority::MOVEMENT_COMBAT);
+    return true;
+}
