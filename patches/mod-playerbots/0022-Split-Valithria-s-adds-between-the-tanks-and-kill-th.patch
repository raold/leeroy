+// Worms are shared: a tank taunts another stray worm only while it holds no more worms than the tank holding the
+// fewest, so eight worms split four and four instead of stacking Flesh Rot on the abomination tank.
+inline bool VdwTakesWorm(std::size_t mine, std::size_t fewestOnAnotherTank)
+{
+    return mine <= fewestOnAnotherTank;
+}
+
+// Whether this tank should pick up an add that is not on it: one it holds whose victim is not a tank that also
+// holds it. `victimTankRank` is the victim's rank among the ranked tanks (VdwRankTanks), or -1 when it is none of
+// them; `victimOtherTank` is true when that victim is still a tank outside the ranking (a human, a self-bot, a bot
+// out of reach). Such a tank holds what it has, as 0021 left every add on a tank: taunting it off with the raid
+// cheat's fixate every half second would fight him for it.
+inline bool VdwTankPicksUp(VdwAdd add, std::size_t rank, std::size_t tanks, int victimTankRank,
+                           bool victimOtherTank = false)
+{
+    if (!VdwTankHolds(add, rank, tanks) || victimTankRank == static_cast<int>(rank))
+        return false;
+    if (victimTankRank < 0)
+        return !victimOtherTank;
+    return !VdwTankHolds(add, static_cast<std::size_t>(victimTankRank), tanks);
+}
+
+// The damage dealers' kill order, lowest first. The skeleton first: its Lay Waste reaches the whole room (356k
+// raid damage in a 10-heroic pull while it waited behind zombies and worms). Then a zombie: it hits hardest,
+// whoever holds it. Then the rot worms, which come eight at once from a dead abomination and pile on the
+// tanks; the suppressers (each one cuts her healing); the archmages, which a tank holds; a lone abomination
+// last, since its death brings the worms. Once a second abomination is up one of them goes right after the
+// worms: last in line, the first one lived 122 s and two sat on the abomination tank for 60 s before he died.
+// Melee never takes a zombie: its acid burst lands on everyone near it.
+inline int VdwKillRank(VdwAdd add, bool melee, std::size_t abominations = 1)
+{
+    switch (add)
+    {
+        case VdwAdd::Skeleton:
+            return 0;
+        case VdwAdd::Zombie:
+            return melee ? -1 : 1;
+        case VdwAdd::Worm:
+            return 2;
+        case VdwAdd::Abomination:
+            return abominations >= 2 ? 3 : 6;
+        case VdwAdd::Suppresser:
+            return 4;
+        case VdwAdd::Archmage:
+            return 5;
+        default:
+            return -1;
+    }
+}
