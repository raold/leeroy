+Creature* IccValithriaVolleyToInterrupt(Player* bot)
+{
+    // Cheapest checks first: the trigger asks every tick for every bot in the instance, so nothing is allocated or
+    // searched unless her encounter is on (the watch). Healers keep healing.
+    if (!sPlayerbotAIConfig.ValithriaAdds || bot->GetMapId() != 631 || !bot->IsAlive() || PlayerbotAI::IsHeal(bot) ||
+        bot->HasAura(SPELL_DREAM_STATE) || !IcecrownHelpers::IccState(bot->GetMap()->GetInstanceId()).vtWatch.engaged ||
