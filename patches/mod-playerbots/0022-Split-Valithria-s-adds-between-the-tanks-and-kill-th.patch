+    if (std::any_of(takers.begin(), takers.end(), [](PortalTaker const& taker) { return taker.busy; }))
+        return false;
+    if (takers.size() < PortalFloor(healers) + 1)
+        return false;
+    auto const first = std::min_element(takers.begin(), takers.end(),
