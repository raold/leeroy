+    CHECK(VdwPickTarget({{VdwAdd::Skeleton, 40.0f, 0}, {VdwAdd::Worm, 1.0f, 7}}, false) == 0);
+
+    // Picking: best rank first, then the worm with the most worms around it, then the nearest.
+    CHECK(VdwPickTarget({}, false) == -1);
+    CHECK(VdwPickTarget({{VdwAdd::Other, 1.0f, 0}}, false) == -1);
+    CHECK(VdwPickTarget({{VdwAdd::Zombie, 1.0f, 0}}, true) == -1);
+    CHECK(VdwPickTarget({{VdwAdd::Archmage, 1.0f, 0}, {VdwAdd::Zombie, 30.0f, 0}}, false) == 1);
+    CHECK(VdwPickTarget({{VdwAdd::Archmage, 1.0f, 0}, {VdwAdd::Zombie, 30.0f, 0}}, true) == 0);
+    CHECK(VdwPickTarget({{VdwAdd::Abomination, 1.0f, 0}, {VdwAdd::Worm, 20.0f, 0}, {VdwAdd::Worm, 10.0f, 0}},
+                        false) == 2);
+    CHECK(VdwPickTarget({{VdwAdd::Worm, 1.0f, 1}, {VdwAdd::Worm, 20.0f, 6}, {VdwAdd::Worm, 10.0f, 6}}, true) == 2);
+    CHECK(VdwPickTarget({{VdwAdd::Suppresser, 5.0f, 0}, {VdwAdd::Skeleton, 40.0f, 0}, {VdwAdd::Archmage, 1.0f, 0}},
+                        false) == 1);
+    // Every order of a mixed set picks the same add.
+    {
+        std::vector<VdwTarget> const mixed = {{VdwAdd::Abomination, 3.0f, 0}, {VdwAdd::Worm, 9.0f, 2},
+                                              {VdwAdd::Worm, 4.0f, 5},        {VdwAdd::Worm, 2.0f, 5},
+                                              {VdwAdd::Archmage, 1.0f, 0},    {VdwAdd::Suppresser, 1.5f, 0}};
+        std::vector<std::size_t> index = {0, 1, 2, 3, 4, 5};
+        do
+        {
+            std::vector<VdwTarget> shuffled;
+            for (std::size_t i : index)
+                shuffled.push_back(mixed[i]);
+            int const pick = VdwPickTarget(shuffled, false);
+            CHECK(pick >= 0 && shuffled[static_cast<std::size_t>(pick)].add == VdwAdd::Worm &&
+                  shuffled[static_cast<std::size_t>(pick)].crowd == 5 &&
+                  shuffled[static_cast<std::size_t>(pick)].distance == 2.0f);
+        } while (std::next_permutation(index.begin(), index.end()));
+    }
+
+    // A mark moves only to a strictly more urgent kind, or off an add that is gone or out of reach.
+    for (VdwAdd current : kinds)
+        for (VdwAdd picked : kinds)
+            for (bool melee : {false, true})
+            {
+                CHECK(VdwRemark(current, false, picked, melee));
+                int const currentRank = VdwKillRank(current, melee);
+                int const pickedRank = VdwKillRank(picked, melee);
+                CHECK(VdwRemark(current, true, picked, melee) ==
+                      (currentRank < 0 || (pickedRank >= 0 && pickedRank < currentRank)));
+            }
+    CHECK(!VdwRemark(VdwAdd::Worm, true, VdwAdd::Worm, false));    // a marked worm stays until it dies
+    CHECK(VdwRemark(VdwAdd::Archmage, true, VdwAdd::Worm, false));  // worms out-rank an archmage
+    CHECK(!VdwRemark(VdwAdd::Zombie, true, VdwAdd::Worm, false));   // a zombie keeps the mark
+    CHECK(VdwRemark(VdwAdd::Zombie, true, VdwAdd::Worm, true));     // melee never stays on a zombie
+
+    // Tank cooldowns: the cheapest whose threshold the tank's health is under, and only what `ready` accepts.
+    auto all = [](char const*) { return true; };
+    auto none = [](char const*) { return false; };
+    CHECK(VdwTankCooldowns(VdwTankClass::Other).empty());
+    CHECK(VdwPickTankCooldown(VdwTankClass::Other, 1.0f, all) == nullptr);
+    for (VdwTankClass tank : {VdwTankClass::Warrior, VdwTankClass::Paladin, VdwTankClass::DeathKnight,
+                              VdwTankClass::Druid})
+    {
+        std::vector<VdwDefensive> const cooldowns = VdwTankCooldowns(tank);
+        CHECK(!cooldowns.empty());
+        for (std::size_t i = 0; i < cooldowns.size(); ++i)
+        {
+            CHECK(cooldowns[i].spell && *cooldowns[i].spell && cooldowns[i].belowPct <= 75.0f);
+            if (i)
+                CHECK(cooldowns[i].belowPct < cooldowns[i - 1].belowPct);  // cheapest (highest threshold) first
+        }
+        CHECK(VdwPickTankCooldown(tank, 100.0f, all) == nullptr);
+        CHECK(VdwPickTankCooldown(tank, cooldowns.front().belowPct, all) == nullptr);
+        CHECK(VdwPickTankCooldown(tank, 1.0f, none) == nullptr);
+        CHECK(std::string_view(VdwPickTankCooldown(tank, 1.0f, all)) == cooldowns.front().spell);
+        // With the first one spent, the next below its threshold.
+        char const* first = cooldowns.front().spell;
+        auto spent = [first](char const* spell) { return std::string_view(spell) != first; };
+        if (cooldowns.size() > 1)
+            CHECK(std::string_view(VdwPickTankCooldown(tank, 1.0f, spent)) == cooldowns[1].spell);
+    }
+    CHECK(std::string_view(VdwPickTankCooldown(VdwTankClass::Warrior, 50.0f, all)) == "shield block");
+    CHECK(VdwPickTankCooldown(VdwTankClass::Paladin, 50.0f, all) == nullptr);
+    CHECK(std::string_view(VdwPickTankCooldown(VdwTankClass::Paladin, 39.0f, all)) == "divine protection");
+
+    // Frostbolt Volley interrupts: every difficulty's volley, only while enough of the cast is left.
+    for (std::uint32_t volley : FrostboltVolley)
+    {
+        CHECK(IsFrostboltVolley(volley));
+        CHECK(VdwTakesInterrupt(volley, 2000));
+        CHECK(VdwTakesInterrupt(volley, VdwInterruptMinLeftMs + 1));
+        CHECK(!VdwTakesInterrupt(volley, VdwInterruptMinLeftMs));
+        CHECK(!VdwTakesInterrupt(volley, 0));
+        CHECK(!VdwTakesInterrupt(volley, -1));
+    }
+    for (std::uint32_t other : {0u, 70754u, 72023u, 70704u, 71179u, 70588u})  // fireball, column, void, suppression
+    {
+        CHECK(!IsFrostboltVolley(other));
+        CHECK(!VdwTakesInterrupt(other, 2000));
+    }
+    CHECK(VdwInterruptSpells(VdwInterrupter::None).empty());
+    for (VdwInterrupter who : {VdwInterrupter::Warrior, VdwInterrupter::Rogue, VdwInterrupter::Mage,
+                               VdwInterrupter::Shaman, VdwInterrupter::Hunter, VdwInterrupter::DeathKnight})
+    {
+        std::vector<char const*> const spells = VdwInterruptSpells(who);
+        CHECK(!spells.empty());
+        for (char const* spell : spells)
+            CHECK(spell && *spell);
+    }
+    CHECK(std::string_view(VdwInterruptSpells(VdwInterrupter::Mage).front()) == "counterspell");
+    CHECK(VdwInterruptSpells(VdwInterrupter::Warrior).size() == 2);  // pummel, then the prot warrior's shield bash
+
     std::cout << checks - failures << " checks passed, " << failures << " failed\n";
     return failures ? 1 : 0;
 }
