+// ValithriaAdds (10-player): one skull for the raid in RaidInteractions::VdwKillRank order, a pile of rot worms
+// or suppressers marked at its centre so area spells hit them all. Tanks hold their own adds (TankAdds; their
+// targets leave out the rest, RaidIccStrategy::AppendTargetExclusions); a melee damage dealer whose mark is a
+// zombie fights the best melee target instead of standing idle.
+bool IccValithriaGroupAction::MarkAdds()
+{
+    static constexpr uint8 SKULL = RtiTargetValue::skullIndex;
+    constexpr float MARK_RADIUS = 45.0f;
+    constexpr float CROWD_RADIUS = 8.0f;
+
+    Group* group = bot->GetGroup();
+    bool const tank = PlayerbotAI::IsTank(bot);
+    bool const healer = PlayerbotAI::IsHeal(bot);
+    context->GetValue<std::string>("rti")->Set("skull");
+
+    auto inMarkRange = [](Unit* unit)
+    {
+        return unit->GetExactDist2d(ICC_VDW_HEAL_POSITION.GetPositionX(), ICC_VDW_HEAL_POSITION.GetPositionY()) <=
+               MARK_RADIUS;
+    };
+
+    Unit* current = botAI->GetUnit(group->GetTargetIcon(SKULL));
+    RaidInteractions::VdwAdd const currentAdd =
+        current ? RaidInteractions::VdwAddOf(current->GetEntry()) : RaidInteractions::VdwAdd::Other;
+    bool const currentValid = current && current->IsAlive() && currentAdd != RaidInteractions::VdwAdd::Other &&
+                              !current->HasUnitFlag(UNIT_FLAG_NOT_SELECTABLE) && inMarkRange(current);
+    Position const ref = current ? current->GetPosition() : ICC_VDW_HEAL_POSITION;
+
+    std::vector<Unit*> units;
+    std::vector<RaidInteractions::VdwTarget> targets;
+    for (ObjectGuid const& guid : AI_VALUE(GuidVector, "possible targets"))
+    {
+        Unit* unit = botAI->GetUnit(guid);
+        if (!unit || !unit->IsAlive() || unit->HasUnitFlag(UNIT_FLAG_NOT_SELECTABLE) || !inMarkRange(unit))
+            continue;
+        RaidInteractions::VdwAdd const add = RaidInteractions::VdwAddOf(unit->GetEntry());
+        if (add == RaidInteractions::VdwAdd::Other)
+            continue;
+        units.push_back(unit);
+        targets.push_back({add, unit->GetExactDist2d(ref.GetPositionX(), ref.GetPositionY()), 0});
+    }
+    for (std::size_t i = 0; i < units.size(); ++i)
+        if (RaidInteractions::VdwCrowds(targets[i].add))
+            for (std::size_t j = 0; j < units.size(); ++j)
+                if (j != i && targets[j].add == targets[i].add && units[i]->GetExactDist2d(units[j]) <= CROWD_RADIUS)
+                    ++targets[i].crowd;
+
+    std::size_t abominations = 0;
+    for (RaidInteractions::VdwTarget const& target : targets)
+        abominations += target.add == RaidInteractions::VdwAdd::Abomination;
+    Unit* mark = currentValid ? current : nullptr;
+    int const pick = RaidInteractions::VdwPickTarget(targets, false);
+    if (pick >= 0 && RaidInteractions::VdwRemark(currentAdd, currentValid, targets[static_cast<std::size_t>(pick)].add,
+                                                 false, abominations))
+    {
+        mark = units[static_cast<std::size_t>(pick)];
+        if (mark != current)
+            group->SetTargetIcon(SKULL, bot->GetGUID(), mark->GetGUID());
+    }
+    else if (pick < 0 && current && !currentValid)
+        group->SetTargetIcon(SKULL, bot->GetGUID(), ObjectGuid::Empty);
+
+    if (tank || healer || !mark)
+        return false;
+    if (PlayerbotAI::IsMelee(bot) && RaidInteractions::VdwAddOf(mark->GetEntry()) == RaidInteractions::VdwAdd::Zombie)
+    {
+        // Nearest to this bot, not to the mark: picked by the distance from the zombie, the melee walked to the
+        // add beside it and the 15-yard zombie rule above turned it back. Adds that close to a zombie are left out.
+        constexpr float ZOMBIE_CLEARANCE = 15.0f;
+        std::vector<Unit*> ownUnits;
+        std::vector<RaidInteractions::VdwTarget> ownTargets;
+        for (std::size_t i = 0; i < units.size(); ++i)
+        {
+            bool nearZombie = false;
+            for (std::size_t j = 0; j < units.size() && !nearZombie; ++j)
+                nearZombie = targets[j].add == RaidInteractions::VdwAdd::Zombie && j != i &&
+                             units[i]->GetExactDist2d(units[j]) < ZOMBIE_CLEARANCE;
+            if (nearZombie)
+                continue;
+            ownUnits.push_back(units[i]);
+            ownTargets.push_back({targets[i].add, bot->GetExactDist2d(units[i]), targets[i].crowd});
+        }
+        int const own = RaidInteractions::VdwPickTarget(ownTargets, true);
+        if (own >= 0 && bot->GetVictim() != ownUnits[static_cast<std::size_t>(own)])
+            Attack(ownUnits[static_cast<std::size_t>(own)]);
+        return false;
+    }
+    if (bot->GetVictim() != mark)
+        botAI->DoSpecificAction("attack rti target");
+    return false;
+}
