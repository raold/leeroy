+    if (rank < 0)
+        return;
+    AiObjectContext* context = botAI->GetAiObjectContext();
+    for (ObjectGuid const& guid : AI_VALUE(GuidVector, "possible targets"))
+    {
+        Unit* unit = botAI->GetUnit(guid);
+        if (!unit)
+            continue;
+        RaidInteractions::VdwAdd const add = RaidInteractions::VdwAddOf(unit->GetEntry());
+        if (add == RaidInteractions::VdwAdd::Other)
+            continue;
+        bool const onMe = unit->GetVictim() == bot;
+        if (add == RaidInteractions::VdwAdd::Suppresser ||
+            (!onMe && !RaidInteractions::VdwTankHolds(add, static_cast<std::size_t>(rank), tanks.size())))
+            exclusions.insert(guid);
+    }
+}
