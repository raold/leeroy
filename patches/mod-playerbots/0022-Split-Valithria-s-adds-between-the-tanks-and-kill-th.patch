+std::vector<Player*> IccValithriaTanks(Player* bot)
+{
+    std::vector<Player*> tanks;
+    Group* group = bot->GetGroup();
+    if (!group)
+        return tanks;
+    std::vector<RaidInteractions::VdwTankCandidate> candidates;
+    std::map<std::uint64_t, Player*> players;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || !member->IsInWorld() || member->GetMap() != bot->GetMap() || !PlayerbotAI::IsTank(member))
+            continue;
+        RaidInteractions::VdwTankCandidate candidate;
+        candidate.guid = member->GetGUID().GetRawValue();
+        candidate.bot = GET_PLAYERBOT_AI(member) && !IsSelfBot(member);
+        candidate.alive = member->IsAlive();
+        candidate.distanceToHer = member->GetExactDist2d(ICC_VDW_HEAL_POSITION);
+        candidates.push_back(candidate);
+        players[candidate.guid] = member;
+    }
+    for (std::uint64_t const guid : RaidInteractions::VdwRankTanks(candidates))
+        tanks.push_back(players[guid]);
+    return tanks;
+}
