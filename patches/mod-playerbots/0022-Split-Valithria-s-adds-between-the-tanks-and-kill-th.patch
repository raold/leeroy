+void RaidIccStrategy::AppendTargetExclusions(GuidSet& exclusions, TargetValueExclusionType type)
+{
+    if (!sPlayerbotAIConfig.ValithriaAdds || type != TargetValueExclusionType::TankTarget)
+        return;
+    Player* bot = botAI->GetBot();
+    if (bot->GetMapId() != 631 || !PlayerbotAI::IsTank(bot) ||
+        !bot->FindNearestCreature(NPC_VALITHRIA_DREAMWALKER, 100.0f))
+        return;
