+std::vector<Player*> IccValithriaTanks(Player* bot)
+{
+    std::vector<Player*> tanks;
+    if (Group* group = bot->GetGroup())
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (member && member->IsAlive() && member->IsInWorld() && member->GetMap() == bot->GetMap() &&
+                PlayerbotAI::IsTank(member))
+                tanks.push_back(member);
+        }
+    std::sort(tanks.begin(), tanks.end(), [](Player const* a, Player const* b) { return a->GetGUID() < b->GetGUID(); });
+    return tanks;
+}
+
+int IccValithriaTankRank(std::vector<Player*> const& tanks, Unit const* unit)
+{
+    for (std::size_t i = 0; i < tanks.size(); ++i)
+        if (tanks[i] == unit)
+            return static_cast<int>(i);
+    return -1;
+}
+
+std::vector<char const*> IccValithriaInterrupts(Player* bot)
+{
+    RaidInteractions::VdwInterrupter who = RaidInteractions::VdwInterrupter::None;
+    switch (bot->getClass())
+    {
+        case CLASS_WARRIOR:
+            who = RaidInteractions::VdwInterrupter::Warrior;
+            break;
+        case CLASS_ROGUE:
+            who = RaidInteractions::VdwInterrupter::Rogue;
+            break;
+        case CLASS_MAGE:
+            who = RaidInteractions::VdwInterrupter::Mage;
+            break;
+        case CLASS_SHAMAN:
+            who = RaidInteractions::VdwInterrupter::Shaman;
+            break;
+        case CLASS_HUNTER:
+            who = RaidInteractions::VdwInterrupter::Hunter;
+            break;
+        case CLASS_DEATH_KNIGHT:
+            who = RaidInteractions::VdwInterrupter::DeathKnight;
+            break;
+        default:
+            break;
+    }
+    return RaidInteractions::VdwInterruptSpells(who);
+}
+
+char const* IccValithriaTankCooldown(Player* bot, PlayerbotAI* botAI)
+{
+    // Cheapest checks first: the trigger asks every tick.
+    if (!sPlayerbotAIConfig.ValithriaAdds || bot->GetMapId() != 631 || !bot->IsAlive() ||
+        bot->GetHealthPct() >= 75.0f || !PlayerbotAI::IsTank(bot) || !bot->IsInCombat() ||
+        !bot->FindNearestCreature(NPC_VALITHRIA_DREAMWALKER, 100.0f))
+        return nullptr;
+    RaidInteractions::VdwTankClass tank = RaidInteractions::VdwTankClass::Other;
+    switch (bot->getClass())
+    {
+        case CLASS_WARRIOR:
+            tank = RaidInteractions::VdwTankClass::Warrior;
+            break;
+        case CLASS_PALADIN:
+            tank = RaidInteractions::VdwTankClass::Paladin;
+            break;
+        case CLASS_DEATH_KNIGHT:
+            tank = RaidInteractions::VdwTankClass::DeathKnight;
+            break;
+        case CLASS_DRUID:
+            tank = RaidInteractions::VdwTankClass::Druid;
+            break;
+        default:
+            return nullptr;
+    }
+    return RaidInteractions::VdwPickTankCooldown(
+        tank, bot->GetHealthPct(),
+        [&](char const* spell) { return !botAI->HasAura(spell, bot) && botAI->CanCastSpell(spell, bot); });
+}
