+};
+
+inline std::vector<VdwDefensive> VdwTankCooldowns(VdwTankClass tank)
+{
+    switch (tank)
+    {
+        case VdwTankClass::Warrior:
+            return {{"shield block", 75.0f}, {"shield wall", 40.0f}, {"last stand", 30.0f}};
+        case VdwTankClass::Paladin:
+            return {{"divine protection", 40.0f}, {"lay on hands", 20.0f}};
+        case VdwTankClass::DeathKnight:
+            return {{"vampiric blood", 50.0f}, {"icebound fortitude", 40.0f}};
+        case VdwTankClass::Druid:
+            return {{"barkskin", 60.0f}, {"survival instincts", 35.0f}};
+        default:
+            return {};
+    }
+}
+
+// The first of this tank's cooldowns whose threshold its health is under and that `ready` accepts, or null.
+template <class Ready>
+char const* VdwPickTankCooldown(VdwTankClass tank, float healthPct, Ready ready)
+{
+    for (VdwDefensive const& cooldown : VdwTankCooldowns(tank))
+        if (healthPct < cooldown.belowPct && ready(cooldown.spell))
+            return cooldown.spell;
+    return nullptr;
+}
+
+// Her archmages' Frostbolt Volley: a 2 s cast hitting everyone near the archmage with Frost and, on heroic, draining
+// mana. In a 10-heroic dojo pull 13 of 21 casts landed for 202k raid damage. A bot with an interrupt takes the
+// nearest volley in reach while enough of the cast is left for an instant interrupt to land.
+inline constexpr std::array<std::uint32_t, 4> FrostboltVolley = {70759, 71889, 72015, 72016};
+inline constexpr std::int32_t VdwInterruptMinLeftMs = 150;
+
+inline bool IsFrostboltVolley(std::uint32_t spell)
+{
+    return std::find(FrostboltVolley.begin(), FrostboltVolley.end(), spell) != FrostboltVolley.end();
+}
+
+enum class VdwInterrupter
+{
+    None,
+    Warrior,
+    Rogue,
+    Mage,
+    Shaman,
+    Hunter,
+    DeathKnight
+};
+
+// The interrupts a class tries, in order (the bot's own spell book and range decide which one is castable).
+inline std::vector<char const*> VdwInterruptSpells(VdwInterrupter who)
+{
+    switch (who)
+    {
+        case VdwInterrupter::Warrior:
+            return {"pummel", "shield bash"};
+        case VdwInterrupter::Rogue:
+            return {"kick"};
+        case VdwInterrupter::Mage:
+            return {"counterspell"};
+        case VdwInterrupter::Shaman:
+            return {"wind shear"};
+        case VdwInterrupter::Hunter:
+            return {"silencing shot"};
+        case VdwInterrupter::DeathKnight:
+            return {"mind freeze"};
+        default:
+            return {};
+    }
+}
+
+// Whether a cast is one to interrupt: a volley with time left for the interrupt to land.
+inline bool VdwTakesInterrupt(std::uint32_t spell, std::int32_t castLeftMs)
+{
+    return IsFrostboltVolley(spell) && castLeftMs > VdwInterruptMinLeftMs;
+}
