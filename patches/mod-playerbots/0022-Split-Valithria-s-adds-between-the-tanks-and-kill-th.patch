 }
+
+// Valithria's adds (Playerbots.ValithriaAdds). A heroic add keeps its base (10-normal) entry.
+enum class VdwAdd
+{
+    Other,
+    Abomination,
+    Zombie,
+    Worm,
+    Archmage,
+    Skeleton,
+    Suppresser
+};
+
+inline VdwAdd VdwAddOf(std::uint32_t entry)
+{
+    switch (entry)
+    {
+        case 37886:
+            return VdwAdd::Abomination;
+        case 37934:
+            return VdwAdd::Zombie;
+        case 37907:
+            return VdwAdd::Worm;
+        case 37868:
+            return VdwAdd::Archmage;
+        case 36791:
+            return VdwAdd::Skeleton;
+        case 37863:
+            return VdwAdd::Suppresser;
+        default:
+            return VdwAdd::Other;
+    }
+}
+
+// Which living tank holds an add. `rank` is this tank's place among the living tanks by guid. The first holds
+// the abominations (whose Gut Spray it faces away); the second the archmages, skeletons and blistering zombies,
+// none of which may sit on the abomination tank as well; both share the rot worms a dead abomination leaves; a
+// lone tank holds them all. A heroic zombie's swing one-shot a kiting damage dealer (33-36k on 25-28k health),
+// so a tank holds it while it dies. No tank holds a suppresser: it channels on her.
+inline bool VdwTankHolds(VdwAdd add, std::size_t rank, std::size_t tanks)
+{
+    switch (add)
+    {
+        case VdwAdd::Worm:
+            return true;
+        case VdwAdd::Abomination:
+            return rank == 0 || tanks < 2;
+        case VdwAdd::Archmage:
+        case VdwAdd::Skeleton:
+        case VdwAdd::Zombie:
+            return rank >= 1 || tanks < 2;
+        default:
+            return false;
+    }
+}
+
+// Worms are shared: a tank taunts another stray worm only while it holds no more worms than the tank holding the
+// fewest, so eight worms split four and four instead of stacking Flesh Rot on the abomination tank.
+inline bool VdwTakesWorm(std::size_t mine, std::size_t fewestOnAnotherTank)
+{
+    return mine <= fewestOnAnotherTank;
+}
+
+// Whether this tank should pick up an add that is not on it: one it holds whose victim is not a tank that also
+// holds it. `victimTankRank` is the victim's rank among the living tanks, or -1 when the victim is no tank.
+inline bool VdwTankPicksUp(VdwAdd add, std::size_t rank, std::size_t tanks, int victimTankRank)
+{
+    if (!VdwTankHolds(add, rank, tanks) || victimTankRank == static_cast<int>(rank))
+        return false;
+    if (victimTankRank < 0)
+        return true;
+    return !VdwTankHolds(add, static_cast<std::size_t>(victimTankRank), tanks);
+}
+
+// The damage dealers' kill order, lowest first. The skeleton first: its Lay Waste reaches the whole room (356k
+// raid damage in a 10-heroic pull while it waited behind zombies and worms). Then a zombie: it hits hardest,
+// whoever holds it. Then the rot worms, which come eight at once from a dead
+// abomination and pile on the tanks; the suppressers (each one cuts her healing); the archmages, which a tank
+// holds; the abomination last, since its death brings the worms. Melee never takes a zombie: its acid burst
+// lands on everyone near it.
+inline int VdwKillRank(VdwAdd add, bool melee)
+{
+    switch (add)
+    {
+        case VdwAdd::Skeleton:
+            return 0;
+        case VdwAdd::Zombie:
+            return melee ? -1 : 1;
+        case VdwAdd::Worm:
+            return 2;
+        case VdwAdd::Suppresser:
+            return 3;
+        case VdwAdd::Archmage:
+            return 4;
+        case VdwAdd::Abomination:
+            return 5;
+        default:
+            return -1;
+    }
+}
+
+struct VdwTarget
+{
+    VdwAdd add = VdwAdd::Other;
+    float distance = 0.0f;       // from the reference point (the current mark, or her)
+    std::uint32_t crowd = 0;     // other adds of its kind within area-of-effect reach (worms, suppressers)
+};
+
+// Worms pile on a tank and suppressers on her: those are marked where the most of them stand, so area spells
+// hit the pile.
+inline bool VdwCrowds(VdwAdd add)
+{
+    return add == VdwAdd::Worm || add == VdwAdd::Suppresser;
+}
+
+// The add to mark: the best kill rank; within a rank the one with the most of its kind around it (only worms and
+// suppressers count any), then the nearest. -1 when none can be killed by this role.
+inline int VdwPickTarget(std::vector<VdwTarget> const& adds, bool melee)
+{
+    int best = -1;
+    for (std::size_t i = 0; i < adds.size(); ++i)
+    {
+        int const rank = VdwKillRank(adds[i].add, melee);
+        if (rank < 0)
+            continue;
+        if (best < 0)
+        {
+            best = static_cast<int>(i);
+            continue;
+        }
+        VdwTarget const& chosen = adds[static_cast<std::size_t>(best)];
+        int const bestRank = VdwKillRank(chosen.add, melee);
+        if (rank != bestRank)
+        {
+            if (rank < bestRank)
+                best = static_cast<int>(i);
+            continue;
+        }
+        if (adds[i].crowd != chosen.crowd)
+        {
+            if (adds[i].crowd > chosen.crowd)
+                best = static_cast<int>(i);
+            continue;
+        }
+        if (adds[i].distance < chosen.distance)
+            best = static_cast<int>(i);
+    }
+    return best;
+}
+
+// Whether a mark should move from the current add to the picked one: only to a strictly better kill rank, so
+// a mark stays on its add until it dies, the add leaves reach or a more urgent kind arrives.
+inline bool VdwRemark(VdwAdd current, bool currentValid, VdwAdd picked, bool melee)
+{
+    if (!currentValid)
+        return true;
+    int const currentRank = VdwKillRank(current, melee);
+    int const pickedRank = VdwKillRank(picked, melee);
+    return currentRank < 0 || (pickedRank >= 0 && pickedRank < currentRank);
+}
+// A tank's own defensive cooldowns under her adds. The stock triggers put Shield Wall at ACTION_MEDIUM_HEAL, below
+// the rotation, so in a 10-heroic pull neither tank used one (no Shield Wall, Last Stand or Divine Protection in
+// 296 s) while both died under abominations and worms. Each fires once the tank's health is below its threshold,
+// cheapest first.
+enum class VdwTankClass
+{
+    Other,
+    Warrior,
+    Paladin,
+    DeathKnight,
+    Druid
+};
+
+struct VdwDefensive
+{
+    char const* spell;
+    float belowPct;
+};
+
+inline std::vector<VdwDefensive> VdwTankCooldowns(VdwTankClass tank)
+{
+    switch (tank)
+    {
+        case VdwTankClass::Warrior:
+            return {{"shield block", 75.0f}, {"shield wall", 40.0f}, {"last stand", 30.0f}};
+        case VdwTankClass::Paladin:
+            return {{"divine protection", 40.0f}, {"lay on hands", 20.0f}};
+        case VdwTankClass::DeathKnight:
+            return {{"vampiric blood", 50.0f}, {"icebound fortitude", 40.0f}};
+        case VdwTankClass::Druid:
+            return {{"barkskin", 60.0f}, {"survival instincts", 35.0f}};
+        default:
+            return {};
+    }
+}
+
+// The first of this tank's cooldowns whose threshold its health is under and that `ready` accepts, or null.
+template <class Ready>
+char const* VdwPickTankCooldown(VdwTankClass tank, float healthPct, Ready ready)
+{
+    for (VdwDefensive const& cooldown : VdwTankCooldowns(tank))
+        if (healthPct < cooldown.belowPct && ready(cooldown.spell))
+            return cooldown.spell;
+    return nullptr;
+}
+
+// Her archmages' Frostbolt Volley: a 2 s cast hitting everyone near the archmage with Frost and, on heroic, draining
+// mana. In a 10-heroic dojo pull 13 of 21 casts landed for 202k raid damage. A bot with an interrupt takes the
+// nearest volley in reach while enough of the cast is left for an instant interrupt to land.
+inline constexpr std::array<std::uint32_t, 4> FrostboltVolley = {70759, 71889, 72015, 72016};
+inline constexpr std::int32_t VdwInterruptMinLeftMs = 150;
+
+inline bool IsFrostboltVolley(std::uint32_t spell)
+{
+    return std::find(FrostboltVolley.begin(), FrostboltVolley.end(), spell) != FrostboltVolley.end();
+}
+
+enum class VdwInterrupter
+{
+    None,
+    Warrior,
+    Rogue,
+    Mage,
+    Shaman,
+    Hunter,
+    DeathKnight
+};
+
+// The interrupts a class tries, in order (the bot's own spell book and range decide which one is castable).
+inline std::vector<char const*> VdwInterruptSpells(VdwInterrupter who)
+{
+    switch (who)
+    {
+        case VdwInterrupter::Warrior:
+            return {"pummel", "shield bash"};
+        case VdwInterrupter::Rogue:
+            return {"kick"};
+        case VdwInterrupter::Mage:
+            return {"counterspell"};
+        case VdwInterrupter::Shaman:
+            return {"wind shear"};
+        case VdwInterrupter::Hunter:
+            return {"silencing shot"};
+        case VdwInterrupter::DeathKnight:
+            return {"mind freeze"};
+        default:
+            return {};
+    }
+}
+
+// Whether a cast is one to interrupt: a volley with time left for the interrupt to land.
+inline bool VdwTakesInterrupt(std::uint32_t spell, std::int32_t castLeftMs)
+{
+    return IsFrostboltVolley(spell) && castLeftMs > VdwInterruptMinLeftMs;
+}
 }  // namespace RaidInteractions
 
 #endif
