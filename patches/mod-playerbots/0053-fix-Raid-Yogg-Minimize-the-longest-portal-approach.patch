diff --git a/tests/yogg_brain_test.cpp b/tests/yogg_brain_test.cpp
index ca9a6079..eaeb87f1 100644
--- a/tests/yogg_brain_test.cpp
+++ b/tests/yogg_brain_test.cpp
@@ -25,6 +25,68 @@ int main()
     CHECK(!InBrainArea(0, 0, 240));
     CHECK(!InBrainArea(1980, 500, 240));
     CHECK(Team({}, false).empty());
+    CHECK(AssignPortals({}).empty());
+    CHECK(AssignPortals({{}}).empty());
+    CHECK(AssignPortals({{1.0f}, {2.0f}}).empty());
+    CHECK(AssignPortals({{1.0f, 2.0f}, {3.0f}}).empty());
+    CHECK(AssignPortals({{-1.0f}}).empty());
+    CHECK(AssignPortals({{std::numeric_limits<float>::infinity()}}).empty());
+    CHECK(AssignPortals({{std::numeric_limits<float>::quiet_NaN()}}).empty());
+    CHECK(AssignPortals(std::vector<std::vector<float>>(11, std::vector<float>(11, 1.0f))).empty());
+    // Actual Dragon-wave positions: GUID assignment sent the delayed warrior
+    // 74 yards; a one-to-one assignment keeps all four approaches below 39.
+    std::vector<std::pair<float, float>> locations{{1980.3306f, -43.7764f}, {1958.8120f, -60.7764f},
+                                                 {1964.3016f, -76.7460f}, {2012.3925f, -36.5226f}};
+    std::vector<std::pair<float, float>> portals{{1964.60f, -42.71f}, {1986.94f, -46.21f},
+                                               {1989.50f, -6.70f}, {1965.52f, -8.09f}};
+    std::vector<std::vector<float>> distances;
+    for (auto const& member : locations)
+    {
+        std::vector<float> row;
+        for (auto const& portal : portals)
+            row.push_back(std::hypot(member.first - portal.first, member.second - portal.second));
+        distances.push_back(std::move(row));
+    }
+    auto assignment = AssignPortals(distances);
+    CHECK(assignment.size() == 4);
+    for (unsigned i = 0; i < assignment.size(); ++i)
+        CHECK(distances[i][assignment[i]] < 39.0f);
+    // Compare with every injective assignment, including spare portals and
+    // ties, rather than copying the dynamic program into the test oracle.
+    for (unsigned seed = 0; seed < 32; ++seed)
+        for (unsigned count = 1; count <= 4; ++count)
+        {
+            distances.assign(count, std::vector<float>(4));
+            for (unsigned i = 0; i < count; ++i)
+                for (unsigned j = 0; j < 4; ++j)
+                    distances[i][j] = float((seed * 13 + i * 7 + j * 11 + i * j * 17) % 41);
+            assignment = AssignPortals(distances);
+            CHECK(assignment.size() == count);
+            CHECK(assignment == AssignPortals(distances));
+            float worst = 0.0f;
+            unsigned used = 0;
+            for (unsigned i = 0; i < assignment.size(); ++i)
+            {
+                CHECK(assignment[i] < 4 && !(used & (1u << assignment[i])));
+                used |= 1u << assignment[i];
+                worst = std::max(worst, distances[i][assignment[i]]);
+            }
+            std::vector<unsigned> permutation{0, 1, 2, 3};
+            do
+            {
+                float alternative = 0.0f;
+                for (unsigned i = 0; i < count; ++i)
+                    alternative = std::max(alternative, distances[i][permutation[i]]);
+                CHECK(worst <= alternative);
+            } while (std::next_permutation(permutation.begin(), permutation.end()));
+        }
+    distances.assign(10, std::vector<float>(10, 100.0f));
+    for (unsigned i = 0; i < 10; ++i)
+        distances[i][9 - i] = 1.0f;
+    assignment = AssignPortals(distances);
+    CHECK(assignment.size() == 10);
+    for (unsigned i = 0; i < assignment.size(); ++i)
+        CHECK(assignment[i] == 9 - i);
     CHECK(CanReservePortal(false, 0));
     CHECK(CanReservePortal(true, 33983));
     CHECK(!CanReservePortal(true, 0));
