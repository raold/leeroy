+// One assignment per wave, at most ten portals. Minimize the longest approach
+// so GUID order cannot spend one member's entire admission window walking.
+inline std::vector<unsigned> AssignPortals(std::vector<std::vector<float>> const& distances)
+{
+    unsigned const members = distances.size();
+    if (!members || members > 10)
+        return {};
+    unsigned const portals = distances.front().size();
+    if (portals < members || portals > 10)
+        return {};
+    for (auto const& row : distances)
+    {
+        if (row.size() != portals)
+            return {};
+        for (float distance : row)
+            if (!std::isfinite(distance) || distance < 0.0f)
+                return {};
+    }
+    std::array<float, 1024> longest;
+    longest.fill(std::numeric_limits<float>::infinity());
+    std::array<unsigned, 1024> selected{};
+    longest[0] = 0.0f;
+    unsigned best = 0;
+    for (unsigned mask = 0; mask < (1u << portals); ++mask)
+    {
+        unsigned const member = std::popcount(mask);
+        if (member == members)
+        {
+            if (!best || longest[mask] < longest[best])
+                best = mask;
+            continue;
+        }
+        if (member > members)
+            continue;
+        for (unsigned portal = 0; portal < portals; ++portal)
+        {
+            if (mask & (1u << portal))
+                continue;
+            unsigned const next = mask | (1u << portal);
+            float const distance = std::max(longest[mask], distances[member][portal]);
+            if (distance < longest[next])
+            {
+                longest[next] = distance;
+                selected[next] = portal;
+            }
+        }
+    }
+    std::vector<unsigned> result(members);
+    for (unsigned member = members; member > 0; --member)
+    {
+        result[member - 1] = selected[best];
+        best &= ~(1u << selected[best]);
+    }
+    return result;
+}
