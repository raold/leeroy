         }
@@ -288,6 +291,21 @@ bool AttackPoint(Player* bot, Unit* target, unsigned illusion, Position& best, b
 }
 
 enum class Mode { None, Portal, Exit, Route, Fight, Face, Wait };
+
+Position ThroughDoorway(Player* bot, Position const& destination, unsigned illusion)
+{
+    if (illusion < 1 || illusion > 3)
+        return destination;
+    Position const& entrance = illusion == 1   ? ULDUAR_YOGG_SARON_CHAMBER_OF_ASPECTS_ENTRANCE
+                               : illusion == 2 ? ULDUAR_YOGG_SARON_ICECROWN_CITADEL_ENTRANCE
+                                               : ULDUAR_YOGG_SARON_STORMWIND_KEEPER_ENTRANCE;
+    return YoggBrain::ViaDoorway(bot->GetExactDist2d(ULDUAR_YOGG_SARON_BRAIN_ROOM_MIDDLE),
+                                 bot->GetExactDist2d(entrance), bot->GetExactDist2d(destination),
+                                 entrance.GetExactDist2d(destination))
+               ? entrance
+               : destination;
+}
+
 struct Plan
 {
     Mode mode = Mode::None;
@@ -337,6 +355,7 @@ Plan Decide(PlayerbotAI* ai)
     Spell* cast = brain ? brain->GetCurrentSpell(CURRENT_GENERIC_SPELL) : nullptr;
     bool const inducing = cast && cast->GetSpellInfo()->Id == 64059;
     unsigned const remaining = inducing ? std::max(0, cast->GetCastTimeRemaining()) : 0;
+    unsigned const illusion = brain && brain->IsAIEnabled ? brain->AI()->GetData(2) : 0;
     // Walking closer reduces the calculated budget; it must not cancel an exit already begun.
     bool const exitRequired =
         !brain || !brain->IsAlive() ||
@@ -346,9 +365,10 @@ Plan Decide(PlayerbotAI* ai)
     {
         ClaimInfluence(bot, nullptr);
         plan.mode = Mode::Exit;
+        if (plan.exit)
+            plan.destination = ThroughDoorway(bot, plan.exit->GetPosition(), illusion);
         return plan;
     }
-    unsigned const illusion = brain->IsAIEnabled ? brain->AI()->GetData(2) : 0;
     GameObject* door = illusion >= 1 && illusion <= 3 ? bot->FindNearestGameObject(194634 + illusion, 250.0f) : nullptr;
     if (YoggBrain::BrainAllowed(illusion, door && door->GetGoState() == GO_STATE_ACTIVE, inducing, remaining, brain->GetHealthPct()))
     {
@@ -632,7 +652,7 @@ bool YoggBrainAction::Execute(Event /*event*/)
     {
         if (!plan.exit || !plan.exit->isSpawned()) return false;
         if (!plan.exit->IsWithinDistInMap(bot, plan.exit->GetInteractionDistance()))
-            return Walk(plan.exit->GetPosition());
+            return Walk(plan.destination);
         // Match the real client's range/ownership/use checks. The portal model
         // can occlude its own origin even when the bot is standing at it; that
