diff --git a/src/Ai/Raid/Uld/YoggBrainPolicy.h b/src/Ai/Raid/Uld/YoggBrainPolicy.h
index 23ee7a41..c98b2a17 100644
--- a/src/Ai/Raid/Uld/YoggBrainPolicy.h
+++ b/src/Ai/Raid/Uld/YoggBrainPolicy.h
@@ -25,6 +25,18 @@ struct Member
     unsigned sanity;
 };
 
+inline bool CanReservePortal(bool riding, std::uint32_t vehicleEntry)
+{
+    // A Constrictor releases its passenger when killed. Reserve that member's
+    // place, but keep normal vehicle/movement guards on actual portal use.
+    return !riding || vehicleEntry == 33983;
+}
+
+inline bool ViaDoorway(float brainDistance, float entranceDistance, float goalDistance, float entranceToGoal)
+{
+    return brainDistance > 42.0f && entranceDistance > 8.0f && goalDistance > entranceToGoal;
+}
+
 // Freeze this selection for a portal wave. Humans choose for themselves; reserve
 // their slots without issuing them commands. Keep at least 1/2 healers upstairs.
 inline std::vector<std::uint64_t> Team(std::vector<Member> members, bool large)
