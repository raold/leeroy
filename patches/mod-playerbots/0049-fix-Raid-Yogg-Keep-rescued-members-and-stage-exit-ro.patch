+                yogg && member->IsWithinDistInMap(yogg, 150.0f) && member->GetPositionZ() > 300.0f &&
+                YoggBrain::CanReservePortal(member->GetVehicle() != nullptr, vehicle ? vehicle->GetEntry() : 0) &&
+                !member->IsBeingTeleported() && !member->IsCharmed() && !PortalLinkBlocked(member) &&
+                !member->HasAura(63830) &&
+                (!controlled || (!memberAI->HasStrategy("stay", BOT_STATE_COMBAT) &&
