--- a/conf/playerbots.conf.dist
+++ b/conf/playerbots.conf.dist
@@ -762,6 +762,20 @@ Playerbots.RandomBotJoinLfg = 1
 # Default: 1 (enabled)
 Playerbots.RandomBotJoinLfgOutleveledExpansion = 1
 
+# List idle randombots in the Raid Browser for raids of their level and expansion, so players can browse
+# and invite them. Requires the raid browser bit (2) in the core's DungeonFinder.OptionsMask.
+# A listed bot cannot join the Dungeon Finder or a battleground queue until its listing ends.
+# Default: 0 (disabled)
+Playerbots.RandomBotJoinRaidBrowser = 0
+
+# How many randombots per faction to keep listed in the Raid Browser
+# Default: 20
+Playerbots.RandomBotRaidBrowserListings = 20
+
+# How long one randombot stays listed in the Raid Browser, in seconds; each listing lasts 50-150% of this
+# Default: 1800 (30 minutes)
+Playerbots.RandomBotRaidBrowserListTime = 1800
+
 # Enable/Disable periodic online - offline of randombots to mimic the real-world scenario where not all players are online simultaneously
 # When enabled, randombots are randomly selected to go online or offline periodically from a larger set
 # Default: 0 (disabled, the set of online bots remains fixed)
