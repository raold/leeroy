+namespace
+{
+constexpr uint8 RAID_BROWSER_CLASSIC_MAX_LEVEL = 60;
+constexpr uint8 RAID_BROWSER_TBC_MAX_LEVEL = 70;
+constexpr size_t RAID_BROWSER_MAX_RAIDS_PER_BOT = 3;
+
+uint32 ExpansionForLevel(uint8 level)
+{
+    if (level <= RAID_BROWSER_CLASSIC_MAX_LEVEL)
+        return EXPANSION_CLASSIC;
+
+    if (level <= RAID_BROWSER_TBC_MAX_LEVEL)
+        return EXPANSION_THE_BURNING_CRUSADE;
+
+    return EXPANSION_WRATH_OF_THE_LICH_KING;
+}
+}  // namespace
+
+// Keeps a rotating set of idle randombots listed in the Raid Browser. Bots only ever copy queues real
+// players are in, and the raid browser is not a queue, so without this it stays empty.
+void RandomPlayerbotMgr::CheckRaidBrowser()
+{
+    time_t const now = time(nullptr);
+    RaidBrowserCheckTimer = now;
+
+    if (!sLFGMgr->isOptionEnabled(lfg::LFG_OPTION_ENABLE_RAID_BROWSER))
+        return;
+
+    std::array<uint32, PVP_TEAMS_COUNT> listed = {};
+    for (auto itr = RaidBrowserListings.begin(); itr != RaidBrowserListings.end();)
+    {
+        auto const botItr = playerBots.find(itr->first);
+        Player* bot = botItr != playerBots.end() ? botItr->second : nullptr;
+        if (!bot || !bot->IsInWorld() || sLFGMgr->GetState(itr->first) != lfg::LFG_STATE_RAIDBROWSER)
+        {
+            itr = RaidBrowserListings.erase(itr);
+            continue;
+        }
+
+        // A bot that got invited has been recruited; drop the listing along with expired ones.
+        if (now >= itr->second || bot->GetGroup())
+        {
+            bot->GetSession()->QueuePacket(new WorldPacket(CMSG_LFG_LEAVE));
+            itr = RaidBrowserListings.erase(itr);
+            continue;
+        }
+
+        ++listed[bot->GetTeamId()];
+        ++itr;
+    }
+
+    uint32 const target = sPlayerbotAIConfig.RandomBotRaidBrowserListings;
+    if (listed[TEAM_ALLIANCE] >= target && listed[TEAM_HORDE] >= target)
+        return;
+
+    std::unordered_map<uint8, std::vector<uint32>> raidsByLevel;
+    auto const raidsForLevel = [&raidsByLevel](uint8 level) -> std::vector<uint32> const&
+    {
+        auto [itr, inserted] = raidsByLevel.try_emplace(level);
+        if (!inserted)
+            return itr->second;
+
+        uint32 const expansion = ExpansionForLevel(level);
+        for (LFGDungeonEntry const* dungeon : sLFGDungeonStore)
+        {
+            if (dungeon->TypeID != lfg::LFG_TYPE_RAID || dungeon->ExpansionLevel != expansion)
+                continue;
+
+            if (dungeon->MinLevel && (level < dungeon->MinLevel || level > dungeon->MaxLevel))
+                continue;
+
+            itr->second.push_back(dungeon->ID);
+        }
+
+        return itr->second;
+    };
+
+    std::vector<Player*> candidates;
+    for (auto const& [guid, bot] : playerBots)
+    {
+        if (!bot || !bot->IsInWorld() || listed[bot->GetTeamId()] >= target)
+            continue;
+
+        if (!bot->IsAlive() || bot->IsInCombat() || bot->GetGroup() || bot->IsBeingTeleported() ||
+            bot->InBattleground() || bot->InBattlegroundQueue())
+            continue;
+
+        Map* map = bot->GetMap();
+        if (!map || map->Instanceable())
+            continue;
+
+        if (sLFGMgr->GetState(guid) != lfg::LFG_STATE_NONE || raidsForLevel(bot->GetLevel()).empty())
+            continue;
+
+        candidates.push_back(bot);
+    }
+
+    Acore::Containers::RandomShuffle(candidates);
+
+    uint32 const listTime = sPlayerbotAIConfig.RandomBotRaidBrowserListTime;
+    for (Player* bot : candidates)
+    {
+        TeamId const team = bot->GetTeamId();
+        if (listed[team] >= target)
+            continue;
+
+        PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+        if (!botAI || !IsRandomBot(bot))
+            continue;
+
+        std::vector<uint32> raids = raidsForLevel(bot->GetLevel());
+        Acore::Containers::RandomShuffle(raids);
+        if (raids.size() > RAID_BROWSER_MAX_RAIDS_PER_BOT)
+            raids.resize(RAID_BROWSER_MAX_RAIDS_PER_BOT);
+
+        uint8 roles = lfg::PLAYER_ROLE_DAMAGE;
+        if (PlayerbotAI::IsTank(bot))
+            roles = lfg::PLAYER_ROLE_TANK;
+        else if (PlayerbotAI::IsHeal(bot))
+            roles = lfg::PLAYER_ROLE_HEALER;
+
+        // Same packet the client sends; the core keeps only the raids this bot is not locked out of.
+        WorldPacket* data = new WorldPacket(CMSG_LFG_JOIN);
+        *data << uint32(roles);
+        *data << bool(false) << bool(false);
+        *data << uint8(raids.size());
+        for (uint32 raid : raids)
+            *data << uint32(raid);
+        *data << uint8(3) << uint8(0) << uint8(0) << uint8(0);
+        *data << std::to_string(botAI->GetEquipGearScore(bot));
+        bot->GetSession()->QueuePacket(data);
+
+        RaidBrowserListings[bot->GetGUID()] = now + urand(listTime / 2, listTime * 3 / 2);
+        ++listed[team];
+
+        LOG_INFO("playerbots", "Bot {} {}:{} <{}>: lists in the raid browser for {} raid(s)",
+                 bot->GetGUID().ToString().c_str(), team == TEAM_ALLIANCE ? "A" : "H", bot->GetLevel(),
+                 bot->GetName().c_str(), raids.size());
+    }
+}
