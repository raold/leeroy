diff --git a/tests/raid_vehicle_trace_test.cpp b/tests/raid_vehicle_trace_test.cpp
new file mode 100644
index 00000000..3a38aa9e
--- /dev/null
+++ b/tests/raid_vehicle_trace_test.cpp
@@ -0,0 +1,110 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#include <iostream>
+#include <vector>
+
+#include "../src/Ai/Raid/RaidVehicleTracePolicy.h"
+
+namespace
+{
+int checks = 0, failures = 0;
+void Check(bool value, int line)
+{
+    ++checks;
+    if (!value) { ++failures; std::cerr << "Failed at line " << line << '\n'; }
+}
+}
+#define CHECK(expr) Check(static_cast<bool>(expr), __LINE__)
+int main()
+{
+    using namespace RaidVehicleTrace;
+    CHECK(Supported(616, 30161));
+    CHECK(!Supported(603, 30161));
+    CHECK(!Supported(616, 33113));
+    CHECK(!Supported(0, 33060));
+    for (auto entry : {33060u, 33109u, 33062u, 33067u, 33167u}) CHECK(Supported(603, entry));
+    Counts counts;
+    for (auto spell : Spells)
+    {
+        counts.Add(spell, false);
+        counts.Add(spell, false);
+        counts.Add(spell, true);
+    }
+    counts.Add(12345, false);
+    for (std::size_t i = 0; i < Spells.size(); ++i)
+    {
+        CHECK(counts.cast[i] == 2);
+        CHECK(counts.cancel[i] == 1);
+    }
+    counts.cast[0] = std::numeric_limits<std::uint32_t>::max();
+    counts.Add(Spells[0], false);
+    CHECK(counts.cast[0] == std::numeric_limits<std::uint32_t>::max());
+    CHECK(!Due(5999, 1000, FlushMs));
+    CHECK(Due(6000, 1000, FlushMs));
+    CHECK(Due(10, std::numeric_limits<std::uint32_t>::max() - 20, 30)); // Clock rollover.
+    CHECK(!Due(10, std::numeric_limits<std::uint32_t>::max() - 20, 32));
+    LogBudget budget;
+    for (unsigned i = 0; i < LogBudget::Limit; ++i) CHECK(budget.Take(100));
+    CHECK(!budget.Take(100));
+    CHECK(!budget.Take(4999));
+    CHECK(budget.suppressed == 2);
+    CHECK(budget.Take(5000));
+    CHECK(budget.used == 1);
+    CHECK(budget.suppressed == 2); // The next emitted record must report the gap.
+
+    // Both transition logs are throttled, and another rider reports the global gap first.
+    struct TestRecord
+    {
+        unsigned view;
+        Counts counts;
+        std::uint32_t flushed;
+    };
+    struct Emission
+    {
+        TestRecord record;
+        std::uint32_t window, suppressed;
+    };
+    std::vector<Emission> emitted;
+    LogBudget exhausted{1000, LogBudget::Limit, 0};
+    auto emit = [&exhausted, &emitted](TestRecord& record, std::uint32_t now, char const*)
+    {
+        if (!exhausted.Take(now))
+            return;
+        emitted.push_back({record, now - record.flushed, exhausted.suppressed});
+        exhausted.suppressed = 0;
+        record.counts = {};
+        record.flushed = now;
+    };
+    TestRecord rider{1, {}, 1000};
+    rider.counts.Add(Spells[0], false);
+    rider.counts.Add(Spells[0], true);
+    ChangeSeat(rider, 2u, 2000, emit);
+    CHECK(emitted.empty());
+    CHECK(exhausted.suppressed == 2);
+    CHECK(rider.view == 2);
+    CHECK(rider.flushed == 2000);
+    rider.counts.Add(Spells[1], false);
+    rider.counts.Add(Spells[1], true);
+    TestRecord other{3, {}, 1000};
+    emit(other, 6000, "sample");
+    CHECK(emitted.size() == 1);
+    CHECK(emitted.back().record.view == 3);
+    CHECK(emitted.back().suppressed == 2);
+    CHECK(exhausted.suppressed == 0);
+    emit(rider, 7000, "sample");
+    CHECK(emitted.size() == 2);
+    CHECK(emitted.back().record.view == 2);
+    CHECK(emitted.back().window == 5000);
+    CHECK(emitted.back().suppressed == 0);
+    for (std::size_t i = 0; i < Spells.size(); ++i)
+    {
+        CHECK(emitted.back().record.counts.cast[i] == (i == 1 ? 1u : 0u));
+        CHECK(emitted.back().record.counts.cancel[i] == (i == 1 ? 1u : 0u));
+    }
+    CHECK(MaxRiders == 256);
+    std::cout << checks << " checks, " << failures << " failures\n";
+    return failures ? 1 : 0;
+}
