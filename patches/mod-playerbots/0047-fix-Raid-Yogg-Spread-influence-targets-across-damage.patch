                             (illusion >= 1 && illusion <= 3 && door && cast && remaining > 12000 && health > 30));
     for (unsigned entry : {33943u,33716u,33717u,33718u,33719u,33720u,33567u,33433u}) CHECK(Influence(entry));
     for (unsigned entry : {0u,33990u,33890u,33288u,33535u,33441u}) CHECK(!Influence(entry));
+    InfluenceClaims claims;
+    // Equally placed damage dealers spread over available targets, retain their
+    // own assignment, and can assist a claimed target once none is unclaimed.
+    auto choose = [&](std::uint64_t bot, std::vector<std::uint64_t> targets)
+    {
+        auto chosen =
+            std::find_if(targets.begin(), targets.end(), [&](auto target) { return !claims.Taken(target, bot); });
+        auto target = chosen == targets.end() ? targets.front() : *chosen;
+        claims.Assign(bot, target);
+        return target;
+    };
+    CHECK(choose(20, {100, 101, 102}) == 100);
+    CHECK(choose(23, {100, 101, 102}) == 101);
+    CHECK(choose(24, {100, 101, 102}) == 102);
+    CHECK(choose(23, {100, 101, 102}) == 101);
+    claims.Assign(20, 0);  // exiting/dead/unavailable planner releases its target
+    CHECK(choose(24, {100, 101}) == 100);
+    CHECK(!claims.Taken(102, 23));    // changing targets releases the old one
+    CHECK(choose(23, {100}) == 100);  // soft preference never stalls the last kill
+    CHECK(!claims.Taken(0, 20));
     CHECK(ExitBudget(0, 7) == 12000);
