 #define PLAYERBOTS_YOGGBRAINPOLICY_H
 
 #include <algorithm>
+#include <array>
 #include <cmath>
 #include <cstdint>
+#include <utility>
 #include <vector>
 
 namespace YoggBrain
@@ -64,6 +66,43 @@ inline bool Influence(std::uint32_t entry)
 {
     return entry == 33943 || (entry >= 33716 && entry <= 33720) || entry == 33567 || entry == 33433;
 }
+
+// A portal wave has at most ten bots. Claims are preferences, never permission
+// to attack: callers still check the creature, gaze, path and exit deadline.
+class InfluenceClaims
+{
+public:
+    bool Taken(std::uint64_t target, std::uint64_t bot) const
+    {
+        for (auto const& claim : _claims)
+            if (target && claim.second == target && claim.first != bot)
+                return true;
+        return false;
+    }
+
+    void Assign(std::uint64_t bot, std::uint64_t target)
+    {
+        if (!bot)
+            return;
+        for (auto& claim : _claims)
+            if (claim.first == bot)
+            {
+                claim = target ? std::make_pair(bot, target) : std::pair<std::uint64_t, std::uint64_t>{};
+                return;
+            }
+        if (target)
+            for (auto& claim : _claims)
+                if (!claim.first)
+                {
+                    claim = {bot, target};
+                    return;
+                }
+    }
+
+private:
+    std::array<std::pair<std::uint64_t, std::uint64_t>, 10> _claims{};
+};
+
 inline bool BrainAllowed(unsigned illusion, bool doorOpen, bool casting, unsigned remaining, float health)
 {
     return illusion >= 1 && illusion <= 3 && doorOpen && casting && remaining > 12000 && health > 30.0f;
