@@ -104,6 +105,33 @@ struct Wave
 std::mutex waveMutex;
 std::map<std::pair<uint32, uint64>, Wave> waves;
 
+YoggBrain::InfluenceClaims ReadInfluenceClaims(Player* bot)
+{
+    if (!bot->GetGroup())
+        return {};
+    auto const key = std::make_pair(bot->GetInstanceId(), bot->GetGroup()->GetGUID().GetRawValue());
+    std::lock_guard<std::mutex> lock(waveMutex);
+    auto const wave = waves.find(key);
+    return wave != waves.end() && wave->second.expires > Clock::now() ? wave->second.influence
+                                                                      : YoggBrain::InfluenceClaims{};
+}
+
+void ClaimInfluence(Player* bot, Unit* target)
+{
+    if (!bot->IsInWorld() || bot->GetMapId() != 603 || !bot->GetGroup())
+        return;
+    auto const key = std::make_pair(bot->GetInstanceId(), bot->GetGroup()->GetGUID().GetRawValue());
+    std::lock_guard<std::mutex> lock(waveMutex);
+    auto const wave = waves.find(key);
+    if (wave == waves.end() || wave->second.expires <= Clock::now() ||
+        !wave->second.portals.contains(bot->GetGUID().GetRawValue()))
+        return;
+    wave->second.influence.Assign(bot->GetGUID().GetRawValue(),
+                                  target && !PlayerbotAI::IsHeal(bot) && YoggBrain::Influence(target->GetEntry())
+                                      ? target->GetGUID().GetRawValue()
+                                      : 0);
+}
