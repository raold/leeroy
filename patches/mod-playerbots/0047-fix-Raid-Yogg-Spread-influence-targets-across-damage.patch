 src/Ai/Raid/Uld/YoggBrainPolicy.h    | 39 ++++++++++++++++++++++++
 tests/yogg_brain_test.cpp            | 20 +++++++++++++
 3 files changed, 102 insertions(+), 2 deletions(-)

