From 82ebf42915c621e3c42c44e6fa4091a42de5e3d1 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Tue, 24 Nov 2026 23:42:30 -0500
Subject: [PATCH 28/46] fix(Raid/Ulduar): Recognize active Leviathan SPECIAL
 state

The native boss remains SPECIAL while fighting. Require a living boss in
combat as well as its active encounter state, so existing drivers can
continue after the human dies without treating the idle gauntlet state
as an active encounter.
---
 src/Ai/Raid/RaidVehicleActions.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/Ai/Raid/RaidVehicleActions.cpp b/src/Ai/Raid/RaidVehicleActions.cpp
index baf18dbd..8d674f0c 100644
--- a/src/Ai/Raid/RaidVehicleActions.cpp
+++ b/src/Ai/Raid/RaidVehicleActions.cpp
@@ -191,7 +191,12 @@ bool LeviathanRaid(PlayerbotAI* ai, bool boarding)
         return false;
     Player* bot = ai->GetBot();
     InstanceScript* instance = bot->GetInstanceScript();
-    bool const encounterActive = instance && instance->GetBossState(0) == IN_PROGRESS; // BOSS_LEVIATHAN
+    // The core keeps Leviathan in SPECIAL during combat as well as after
+    // the gauntlet. Require the actual boss to be fighting before allowing
+    // drivers to continue without a living human rider.
+    Creature* boss = instance ? instance->GetCreature(0) : nullptr;  // BOSS_LEVIATHAN
+    bool const encounterActive = boss && boss->IsAlive() && boss->IsInCombat() &&
+                                 (instance->GetBossState(0) == IN_PROGRESS || instance->GetBossState(0) == SPECIAL);
     for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
     {
         Player* member = ref->GetSource();
