@@ -613,7 +613,7 @@ void YoggBrainAction::Note(unsigned mode, Unit* target)
         bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), mode, target ? target->GetEntry() : 0, Sanity(bot));
 }
 
-bool YoggBrainAction::Walk(Position const& destination)
+bool YoggBrainAction::Walk(Position const& destination, Position const* avoid, float clearance)
 {
     // Reject pathfinding fallbacks through closed illusion doors or the floor.
     // No teleport and no unpathed straight line when the local mmap is missing.
@@ -634,10 +634,63 @@ bool YoggBrainAction::Walk(Position const& destination)
         }
         return false;
     }
+    if (avoid)
+    {
+        YoggBrain::PortalPoint previous{bot->GetPositionX() - avoid->GetPositionX(),
+                                       bot->GetPositionY() - avoid->GetPositionY()};
+        for (auto const& point : path.GetPath())
+        {
+            YoggBrain::PortalPoint const next{point.x - avoid->GetPositionX(), point.y - avoid->GetPositionY()};
+            // The first navmesh point can be the unchanged actor position.
+            if (previous.x == next.x && previous.y == next.y)
+                continue;
+            if (!YoggBrain::PortalSegmentSafe(previous, next, clearance))
+            {
+                if (!lastPathLog || GetMSTimeDiffToNow(lastPathLog) >= 10000)
+                {
+                    lastPathLog = getMSTime();
+                    LOG_WARN("playerbots", "yogg_brain portal_route_refused instance={} bot={} clearance={}",
+                             bot->GetInstanceId(), bot->GetGUID().GetCounter(), clearance);
+                }
+                return false;
+            }
+            previous = next;
+        }
+    }
     return MoveTo(bot->GetMapId(), destination.GetPositionX(), destination.GetPositionY(), destination.GetPositionZ(),
         false, false, true, true, MovementPriority::MOVEMENT_FORCED);
 }
 
+bool YoggBrainAction::WalkToPortal(Unit* portal)
+{
+    Creature* yogg = bot->GetInstanceScript()->GetCreature(12);
+    constexpr uint32 knockAwayAura = 64022, knockAwayPulse = 64020;
+    if (!yogg || !yogg->IsAlive() || !yogg->HasAura(knockAwayAura))
+        return Walk(portal->GetPosition());
+    SpellInfo const* pulse = sSpellMgr->GetSpellInfo(knockAwayPulse);
+    if (!pulse)
+        return false;
+    float radius = 0.0f;
+    for (auto const& effect : pulse->Effects)
+        radius = std::max(radius, effect.CalcRadius(yogg));
+    if (radius <= 0.0f)
+        return false;
+    // The core's periodic spell reaches 14 yards. Include the player's body
+    // and a one-yard buffer in every segment of the ordinary movement route.
+    float const clearance = radius + bot->GetObjectSize() + 1.0f;
+    auto const waypoint = YoggBrain::PortalWaypoint(
+        {bot->GetPositionX() - yogg->GetPositionX(), bot->GetPositionY() - yogg->GetPositionY()},
+        {portal->GetPositionX() - yogg->GetPositionX(), portal->GetPositionY() - yogg->GetPositionY()}, clearance);
+    if (!waypoint)
+        return false;
+    Position point(yogg->GetPositionX() + waypoint->x, yogg->GetPositionY() + waypoint->y, bot->GetPositionZ());
+    bot->UpdateAllowedPositionZ(point.m_positionX, point.m_positionY, point.m_positionZ);
+    if (std::abs(point.GetPositionZ() - bot->GetPositionZ()) > 8.0f)
+        return false;
+    Position const center = yogg->GetPosition();
+    return Walk(point, &center, clearance);
+}
+
 bool YoggBrainAction::Execute(Event /*event*/)
 {
     Plan const plan = Decide(botAI);
@@ -686,7 +739,7 @@ bool YoggBrainAction::Execute(Event /*event*/)
     if (plan.mode == Mode::Portal)
     {
         if (bot->GetExactDist(plan.target) > 3.0f || !bot->IsWithinLOSInMap(plan.target))
-            return Walk(plan.target->GetPosition());
+            return WalkToPortal(plan.target);
         bool const used = plan.target->ToCreature()->HandleSpellClick(bot);
         if (used) LOG_INFO("playerbots", "yogg_brain enter instance={} bot={} sanity={}", bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), Sanity(bot));
         return used;
