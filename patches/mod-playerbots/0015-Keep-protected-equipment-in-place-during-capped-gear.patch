@@ -0,0 +1,57 @@
+/*
+ * This file is part of the Playerbots Project. See AUTHORS file for Copyright information.
+ * This program is free software licensed under GPL version 2.
+ * See LICENSE file for more information.
+ */
+#include <iostream>
+
+#include "../src/Bot/Factory/PlayerbotEquipmentProtection.h"
+
+namespace
+{
+int checks = 0;
+int failures = 0;
+void Check(bool success, int line)
+{
+    ++checks;
+    if (!success)
+    {
+        ++failures;
+        std::cerr << "Failed at line " << line << '\n';
+    }
+}
+}
+
+#define CHECK(expression) Check(static_cast<bool>(expression), __LINE__)
+
+int main()
+{
+    using namespace playerbots::equipment;
+    // With no mask the other callers keep their current equipment and finisher behavior.
+    for (std::uint8_t slot = 0; slot < 19; ++slot)
+    {
+        CHECK(!Protected(0, slot));
+        CHECK(MayReplace(0, slot, false));
+        CHECK(MayReplace(0, slot, true));
+        auto mask = std::uint32_t(1) << slot;
+        CHECK(Protected(mask, slot));
+        CHECK(!MayReplace(mask, slot, false));
+        CHECK(!MayReplace(mask, slot, true));
+    }
+
+    auto offhand = std::uint32_t(1) << OffHand;
+    CHECK(!MayReplace(offhand, MainHand, true)); // No inventory or mail recovery can be needed.
+    CHECK(MayReplace(offhand, MainHand, false)); // A compatible one-hander can still upgrade.
+    CHECK(!MayReplace(offhand, OffHand, false));
+    CHECK(MayReplace(offhand, 4, false)); // Unrelated equipment can still upgrade.
+    auto bothHands = offhand | (std::uint32_t(1) << MainHand);
+    CHECK(!MayReplace(bothHands, MainHand, false));
+    CHECK(!MayReplace(bothHands, MainHand, true));
+    CHECK(!MayReplace(bothHands, OffHand, false));
+    CHECK(Protected(0x80000000u, 31));
+    CHECK(!Protected(0xffffffffu, 32));
+    CHECK(!Protected(0xffffffffu, 255));
+
+    std::cout << checks << " equipment protection checks, " << failures << " failures\n";
+    return failures ? 1 : 0;
+}
