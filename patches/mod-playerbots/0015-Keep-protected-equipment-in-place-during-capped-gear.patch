+#ifndef _PLAYERBOT_EQUIPMENT_PROTECTION_H
+#define _PLAYERBOT_EQUIPMENT_PROTECTION_H
+
+#include <cstdint>
+
+namespace playerbots::equipment
+{
+// EquipmentSlots, asserted against the core in PlayerbotFactory.cpp.
+inline constexpr std::uint8_t MainHand = 15;
+inline constexpr std::uint8_t OffHand = 16;
+
+inline constexpr bool Protected(std::uint32_t slots, std::uint8_t slot)
+{
+    return slot < 32 && (slots & (std::uint32_t(1) << slot)) != 0;
+}
+
+inline constexpr bool MayReplace(std::uint32_t slots, std::uint8_t slot, bool twoHanded)
+{
+    // Prevention matters with full bags: AutoUnequipOffhandIfNeed can mail the old offhand,
+    // after which the caller cannot find it by item GUID in the player's inventory.
+    return !Protected(slots, slot) &&
+           !(slot == MainHand && twoHanded && Protected(slots, OffHand));
+}
+}
+
+#endif
