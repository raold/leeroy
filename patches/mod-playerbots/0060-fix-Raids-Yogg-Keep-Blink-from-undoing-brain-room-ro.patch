From b0dae87f8646a3791fd7dcaf6cb0ddbe85c18683 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Thu, 26 Nov 2026 21:59:49 -0500
Subject: [PATCH 60/60] fix(Raids/Yogg): Keep Blink from undoing brain-room
 routes

---
 src/Ai/Raid/Uld/YoggBrainActions.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/Ai/Raid/Uld/YoggBrainActions.cpp b/src/Ai/Raid/Uld/YoggBrainActions.cpp
index 3c0c1d77..286bf79b 100644
--- a/src/Ai/Raid/Uld/YoggBrainActions.cpp
+++ b/src/Ai/Raid/Uld/YoggBrainActions.cpp
@@ -929,6 +929,10 @@ float YoggBrainMultiplier::GetValue(Action* action)
             else if (!YoggBrain::Influence(target->GetEntry())) return 0.0f;
         }
         uint32 const id = context->GetValue<uint32>("spell id", spell->getSpell())->Get();
+        // Blink back is a spell action, so the movement filter above misses it.
+        // Keep the checked brain-room firing positions and exit routes in control.
+        if (id == 1953)
+            return 0.0f;
         SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
         if (info && info->IsTargetingArea()) return 0.0f;
         unsigned const cost = info ? info->CalcCastTime(bot) + (info->IsChanneled() ? std::max(0, info->GetDuration()) : 0) : 0;
