diff --git a/src/Ai/Raid/RaidVehicleActions.cpp b/src/Ai/Raid/RaidVehicleActions.cpp
new file mode 100644
index 00000000..baf18dbd
--- /dev/null
+++ b/src/Ai/Raid/RaidVehicleActions.cpp
@@ -0,0 +1,229 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#include "RaidVehicleActions.h"
+#include "RaidVehiclePolicy.h"
+#include "Creature.h"
+#include "CreatureAI.h"
+#include "Group.h"
+#include "InstanceScript.h"
+#include "MotionMaster.h"
+#include "Playerbots.h"
+#include "SpellAuraEffects.h"
+#include "Vehicle.h"
+
+#include <list>
+
+namespace RaidVehicles
+{
+namespace
+{
+bool BotReady(PlayerbotAI* ai, uint32 map)
+{
+    Player* bot = ai->GetBot();
+    return sPlayerbotAIConfig.RaidVehicleSupport && bot->IsInWorld() && bot->GetMapId() == map && bot->IsAlive() &&
+        !IsRealPlayer(bot) && !IsSelfBot(bot) && !bot->IsBeingTeleported() && bot->GetGroup() &&
+        bot->GetGroup()->isRaidGroup() && !ai->HasStrategy("stay", BOT_STATE_COMBAT) &&
+        !ai->HasStrategy("stay", BOT_STATE_NON_COMBAT) && !ai->HasStrategy("passive", BOT_STATE_COMBAT);
+}
+
+bool VehicleSpell(PlayerbotAI* ai, uint32 spell, Unit* target)
+{
+    Unit* vehicle = ai->GetBot()->GetVehicleBase();
+    if (!vehicle || !vehicle->IsAlive() || !vehicle->HasSpell(spell) || vehicle->HasUnitState(UNIT_STATE_CASTING) ||
+        !target || !target->IsInWorld() || !target->IsAlive() || target->GetMap() != vehicle->GetMap())
+        return false;
+    if (target != vehicle)
+        vehicle->SetFacingToObject(target);
+    if (!ai->CanCastVehicleSpell(spell, target) || !ai->CastVehicleSpell(spell, target))
+        return false;
+    // Spell::prepare validates the cast, but creature spells need their normal
+    // DBC/category recovery installed by the caller (as the vehicle opcode does).
+    vehicle->AddSpellCooldown(spell, 0, 0);
+    ai->SetNextCheckDelay(1000);
+    return true;
+}
+
+Creature* Malygos(PlayerbotAI* ai)
+{
+    InstanceScript* instance = ai->GetBot()->GetInstanceScript();
+    // DATA_MALYGOS = 0 in eye_of_eternity.h. Avoid a grid search for every
+    // multiplier evaluation, and keep the exact encounter's instance identity.
+    Creature* boss = instance ? instance->GetCreature(0) : nullptr;
+    return boss && boss->IsAlive() && boss->IsAIEnabled && boss->IsInCombat() ? boss : nullptr;
+}
+
+Point At(Unit const* unit) { return {unit->GetPositionX(), unit->GetPositionY(), unit->GetPositionZ()}; }
+}
+
+bool MalygosDrake(PlayerbotAI* ai)
+{
+    if (!BotReady(ai, 616))
+        return false;
+    Player* bot = ai->GetBot();
+    Unit* base = bot->GetVehicleBase();
+    Vehicle* vehicle = bot->GetVehicle();
+    auto const* seat = vehicle ? vehicle->GetSeatForPassenger(bot) : nullptr;
+    return base && base->IsAlive() && base->GetEntry() == 30161 && seat && seat->CanControl() && Malygos(ai);
+}
+
+bool MoveDrake(PlayerbotAI* ai)
+{
+    if (!MalygosDrake(ai))
+        return false;
+    Player* bot = ai->GetBot();
+    Unit* drake = bot->GetVehicleBase();
+    Creature* boss = Malygos(ai);
+    if (!boss)
+        return false;
+    std::list<Creature*> nearby;
+    bot->GetCreatureListWithEntryInGrid(nearby, 30592, 200.0f);
+    std::vector<Point> fields;
+    for (Creature* field : nearby)
+        if (field && field->IsInWorld())
+            fields.push_back(At(field));
+    Point const centre = At(boss);
+    Point destination = centre;
+    bool found = false;
+    // Follow the human's drake when it is in a safe, castable part of the ring.
+    // Without a human master (offline raid), every bot computes the same anchor.
+    for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || !member->IsInWorld() || member->GetMap() != bot->GetMap() || !IsRealPlayer(member))
+            continue;
+        Unit* anchor = member->GetVehicleBase();
+        if (anchor && anchor->IsAlive() && anchor->GetEntry() == 30161 && SafeDrakePoint(At(anchor), centre, fields))
+        {
+            destination = At(anchor);
+            found = true;
+            break;
+        }
+    }
+    for (unsigned i = 0; !found && i < 24; ++i)
+    {
+        float const angle = static_cast<float>(i) * 6.2831853f / 24.0f;
+        destination = {centre.x + 45.0f * std::cos(angle), centre.y + 45.0f * std::sin(angle), centre.z};
+        found = SafeDrakePoint(destination, centre, fields);
+    }
+    if (!found || drake->GetExactDist(destination.x, destination.y, destination.z) <= 3.0f)
+        return false;
+    float x = 0, y = 0, z = 0;
+    auto* motion = drake->GetMotionMaster();
+    if (drake->isMoving() && motion->GetDestination(x, y, z) &&
+        std::hypot(x - destination.x, y - destination.y) < 2.0f && std::abs(z - destination.z) < 2.0f)
+        return false;
+    drake->SetCanFly(true);
+    motion->MovePoint(0, destination.x, destination.y, destination.z, FORCED_MOVEMENT_RUN, 0.0f, 0.0f,
+                      false, true, MOTION_SLOT_ACTIVE, AnimTier::Fly);
+    drake->SendMovementFlagUpdate();
+    return true;
+}
+
+bool CastDrake(PlayerbotAI* ai)
+{
+    if (!MalygosDrake(ai))
+        return false;
+    Player* bot = ai->GetBot();
+    Unit* drake = bot->GetVehicleBase();
+    Creature* boss = Malygos(ai);
+    if (!boss || boss->HasUnitFlag(UNIT_FLAG_NON_ATTACKABLE))
+        return false;
+    std::vector<Rider> riders;
+    for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || !member->IsInWorld() || !member->IsAlive() || member->GetMap() != bot->GetMap() ||
+            IsRealPlayer(member) || IsSelfBot(member))
+            continue;
+        PlayerbotAI* memberAI = GET_PLAYERBOT_AI(member);
+        if (!memberAI || !BotReady(memberAI, 616))
+            continue;
+        Unit* mount = member->GetVehicleBase();
+        if (mount && mount->IsAlive() && mount->GetEntry() == 30161)
+            riders.push_back({member->GetGUID().GetRawValue(), PlayerbotAI::IsHeal(member)});
+    }
+    DrakeFacts facts;
+    facts.healer = DrakeHealer(bot->GetGUID().GetRawValue(), riders);
+    // DATA_FIRST_SURGE_TARGET_GUID in boss_malygos.cpp: the actual three-second
+    // warning targets, including all three targets in 25-player mode.
+    for (int slot = 14; slot < 17; ++slot)
+        facts.surge = facts.surge || boss->AI()->GetGUID(slot) == drake->GetGUID();
+    facts.surgeActive = drake->HasAura(57407) || drake->HasAura(60936);
+    facts.surge = facts.surge || facts.surgeActive;
+    facts.shieldReady = !drake->HasSpellCooldown(57108);
+    facts.shielded = drake->HasAura(57108);
+    facts.energy = drake->GetPower(POWER_ENERGY);
+    facts.points = drake->GetComboPoints();
+    facts.targetPoints = drake->GetComboPoints(boss);
+    facts.selfPoints = drake->GetComboPoints(drake);
+    facts.health = static_cast<unsigned>(drake->GetHealthPct());
+    if (Aura* dot = boss->GetAura(56092, drake->GetGUID()))
+        facts.dotMs = dot->GetDuration();
+    if (Aura* hot = drake->GetAura(57090, drake->GetGUID()))
+        facts.hotMs = hot->GetDuration();
+    DrakeSpell const pick = NextDrakeSpell(facts);
+    if (pick == DrakeSpell::None)
+        return false;
+    Unit* target = DrakeTarget(pick, static_cast<Unit*>(boss), drake, drake->GetComboTarget());
+    return VehicleSpell(ai, static_cast<uint32>(pick), target);
+}
+
+bool DriveDrake(PlayerbotAI* ai)
+{
+    // Updating a moving human anchor and attacking share one high-priority
+    // action, so movement cannot consume every action tick and starve spells.
+    bool casted = false;
+    return VehicleTick([&] { return casted = CastDrake(ai); }, [&]
+    {
+        bool const moved = MoveDrake(ai);
+        if (moved && !casted)
+            VehicleSpell(ai, 57092, ai->GetBot()->GetVehicleBase());
+        return moved;
+    });
+}
+
+bool LeviathanRaid(PlayerbotAI* ai, bool boarding)
+{
+    if (!BotReady(ai, 603))
+        return false;
+    Player* bot = ai->GetBot();
+    InstanceScript* instance = bot->GetInstanceScript();
+    bool const encounterActive = instance && instance->GetBossState(0) == IN_PROGRESS; // BOSS_LEVIATHAN
+    for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || !member->IsInWorld() || member->GetMap() != bot->GetMap() || !IsRealPlayer(member))
+            continue;
+        Unit* base = member->GetVehicleBase();
+        bool const riding = member->IsAlive() && base && base->IsAlive() && bot->GetExactDist(base) <= 300.0f &&
+            (base->GetEntry() == 33060 || base->GetEntry() == 33109 || base->GetEntry() == 33062 ||
+             base->GetEntry() == 33067 || base->GetEntry() == 33167);
+        // A dead human still in this raid/instance must not stop every driver
+        // mid-pull. The stricter "human boarded first" cue is for boarding only.
+        if (LeviathanPresence(boarding, true, riding, encounterActive))
+            return true;
+    }
+    return false;
+}
+
+int BoardingRank(PlayerbotAI* ai, Unit* base)
+{
+    if (!LeviathanRaid(ai, true) || !base || !base->IsInWorld() || !base->IsAlive() || base->GetMap() != ai->GetBot()->GetMap() ||
+        base->HasUnitFlag(UNIT_FLAG_NOT_SELECTABLE) || ai->GetBot()->GetExactDist(base) > 200.0f)
+        return -1;
+    Vehicle* kit = base->GetVehicleKit();
+    if (!kit)
+        return -1;
+    Unit* driver = kit->GetPassenger(0);
+    Player* player = driver ? driver->ToPlayer() : nullptr;
+    bool const groupDriver = player && player->GetGroup() == ai->GetBot()->GetGroup();
+    Unit* turret = kit->GetPassenger(base->GetEntry() == 33060 ? 7 : 1);
+    bool const gunnerFree = turret && turret->IsAlive() &&
+        turret->GetEntry() == (base->GetEntry() == 33060 ? 33067u : 33167u) &&
+        turret->GetVehicleKit() && !turret->GetVehicleKit()->GetPassenger(0);
+    return BoardingPriority(base->GetEntry(), !driver, groupDriver, gunnerFree, PlayerbotAI::IsMelee(ai->GetBot()));
+}
+}
