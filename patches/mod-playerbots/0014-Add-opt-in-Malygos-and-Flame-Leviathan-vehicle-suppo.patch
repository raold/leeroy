diff --git a/src/Ai/Raid/RaidVehiclePolicy.h b/src/Ai/Raid/RaidVehiclePolicy.h
new file mode 100644
index 00000000..1ce15bab
--- /dev/null
+++ b/src/Ai/Raid/RaidVehiclePolicy.h
@@ -0,0 +1,149 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#ifndef PLAYERBOTS_RAIDVEHICLEPOLICY_H
+#define PLAYERBOTS_RAIDVEHICLEPOLICY_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace RaidVehicles
+{
+struct Rider
+{
+    std::uint64_t guid;
+    bool healer;
+};
+
+inline bool DrakeHealer(std::uint64_t guid, std::vector<Rider> riders)
+{
+    if (riders.size() < 2)
+        return false;
+    std::sort(riders.begin(), riders.end(), [](Rider const& a, Rider const& b)
+              { return a.healer != b.healer ? a.healer : a.guid < b.guid; });
+    std::size_t const healers = std::min(riders.size() - 1, (riders.size() + 4) / 5);
+    return std::any_of(riders.begin(), riders.begin() + healers,
+                       [guid](Rider const& rider) { return rider.guid == guid; });
+}
+
+enum class DrakeSpell : std::uint32_t
+{
+    None = 0,
+    Spike = 56091,
+    Engulf = 56092,
+    Revivify = 57090,
+    Burst = 57143,
+    Shield = 57108
+};
+
+struct DrakeFacts
+{
+    bool healer = false;
+    bool surge = false;
+    bool surgeActive = false;
+    bool shieldReady = false;
+    bool shielded = false;
+    unsigned energy = 0;
+    unsigned points = 0;
+    unsigned targetPoints = 0;
+    unsigned selfPoints = 0;
+    unsigned health = 100;
+    int dotMs = 0;
+    int hotMs = 0;
+};
+
+inline DrakeSpell NextDrakeSpell(DrakeFacts const& f)
+{
+    // The boss retains warning GUIDs until its next selection. Reserve points
+    // and energy for that target, but shield only the actual damage aura: a
+    // short shield on the warning can expire before the damage even starts.
+    if ((f.surge || f.surgeActive) && f.shieldReady && !f.shielded)
+    {
+        if (f.points && f.energy >= 25 && f.surgeActive)
+            return DrakeSpell::Shield;
+        if (f.points < 5 && f.energy >= 35)
+            return f.healer ? DrakeSpell::Revivify : DrakeSpell::Spike;
+        return DrakeSpell::None;
+    }
+    if (f.healer)
+    {
+        if (f.selfPoints >= 5 && (f.energy >= 75 || (f.health < 60 && f.energy >= 50)))
+            return DrakeSpell::Burst;
+        if (f.energy >= 10 && (f.selfPoints < 5 || f.hotMs <= 3000))
+            return DrakeSpell::Revivify;
+        return DrakeSpell::None;
+    }
+    if (f.targetPoints >= 2 && (f.energy >= 75 || (f.dotMs <= 4000 && f.energy >= 50)))
+        return DrakeSpell::Engulf;
+    if (f.energy >= 10 && (f.targetPoints < 2 || (f.targetPoints < 5 && f.energy >= 85)))
+        return DrakeSpell::Spike;
+    return DrakeSpell::None;
+}
+
+// Flame Shield (57108) applies its shield to the implicit caster, but its
+// second effect is dummy TARGET_UNIT_TARGET_ANY. Spell::CheckCast therefore
+// requires points on the explicit target: boss for damage, self for healing.
+template <typename UnitType>
+inline UnitType* DrakeTarget(DrakeSpell spell, UnitType* boss, UnitType* self, UnitType* combo)
+{
+    if (spell == DrakeSpell::Shield)
+        return combo;
+    if (spell == DrakeSpell::Spike || spell == DrakeSpell::Engulf)
+        return boss;
+    if (spell == DrakeSpell::Revivify || spell == DrakeSpell::Burst)
+        return self;
+    return nullptr;
+}
+
+// A continually moving anchor must not starve instant vehicle spells. Invoke
+// both callbacks every tick; do not use the short-circuit `cast() || move()`.
+template <typename Cast, typename Move>
+inline bool VehicleTick(Cast cast, Move move)
+{
+    bool const casted = cast();
+    bool const moved = move();
+    return casted || moved;
+}
+
+inline bool LeviathanPresence(bool boarding, bool humanPresent, bool humanRiding, bool encounterActive)
+{
+    return humanPresent && (humanRiding || (!boarding && encounterActive));
+}
+
+struct Point { float x, y, z; };
+
+inline bool SafeDrakePoint(Point const& point, Point const& boss, std::vector<Point> const& fields)
+{
+    float const distance = std::hypot(point.x - boss.x, point.y - boss.y);
+    if (!std::isfinite(distance) || !std::isfinite(point.z) || !std::isfinite(boss.z) || distance < 38.0f || distance > 55.0f ||
+        std::abs(point.z - boss.z) > 10.0f)
+        return false;
+    return std::none_of(fields.begin(), fields.end(), [&point](Point const& field)
+    {
+        return std::abs(point.z - field.z) < 20.0f && std::hypot(point.x - field.x, point.y - field.y) < 16.0f;
+    });
+}
+
+inline int BoardingPriority(std::uint32_t entry, bool emptyDriver, bool groupDriver, bool gunnerFree,
+                            bool melee)
+{
+    if (entry != 33060 && entry != 33109 && entry != 33062)
+        return -1;
+    if (emptyDriver)
+    {
+        if (entry == 33062)
+            return 4;
+        // Prefer roles, but never leave a main driver empty because the roster
+        // has no more melee or ranged characters.
+        return (entry == 33060) == melee ? 0 : 1;
+    }
+    if (groupDriver && gunnerFree && entry != 33062)
+        return 2;
+    return -1;
+}
+}
+#endif
