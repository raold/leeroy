@@ -0,0 +1,171 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#include "../src/Ai/Raid/RaidVehiclePolicy.h"
+#include <iostream>
+#include <limits>
+
+namespace
+{
+int checks = 0, failures = 0;
+void Check(bool value, int line)
+{
+    ++checks;
+    if (!value)
+    {
+        ++failures;
+        std::cerr << "Failed at line " << line << '\n';
+    }
+}
+}
+#define CHECK(expr) Check(static_cast<bool>(expr), __LINE__)
+
+int main()
+{
+    using namespace RaidVehicles;
+    CHECK(!DrakeHealer(101, {}));
+    CHECK(!DrakeHealer(101, {{101, true}}));
+    std::vector<Rider> riders = {{101, false}, {102, false}, {103, true}, {104, false}, {105, false}};
+    CHECK(DrakeHealer(103, riders));
+    CHECK(!DrakeHealer(101, riders));
+    std::reverse(riders.begin(), riders.end());
+    CHECK(DrakeHealer(103, riders));
+    for (unsigned size = 2; size <= 25; ++size)
+    {
+        riders.clear();
+        for (unsigned i = 0; i < size; ++i)
+            riders.push_back({101 + i, i % 5 == 3});
+        unsigned count = 0;
+        for (auto const& rider : riders)
+            count += DrakeHealer(rider.guid, riders) ? 1u : 0u;
+        CHECK(count == (size + 4) / 5);
+        CHECK(count < size);
+    }
+
+    DrakeFacts f;
+    f.energy = 100;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Spike);
+    f.targetPoints = 2;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Engulf);
+    f.energy = 74;
+    f.dotMs = 8000;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::None); // reserve energy instead of starving shield
+    f.dotMs = 3000;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Engulf); // preserve the stacking DoT
+    f.energy = 49;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::None);
+    f.surge = f.shieldReady = true;
+    f.points = 2;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Spike); // short shield would expire before damage
+    f.surgeActive = true;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Shield);
+    f.energy = 24;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::None);
+    f.points = 0;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::None); // do not spend the shield reserve
+    f.energy = 35;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Spike);
+    f.healer = true;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Revivify);
+    f.energy = 9;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::None);
+    f.surgeActive = false;
+    f.points = 5;
+    f.energy = 25;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::None); // retained warning GUID must not spend a shield
+    f.surgeActive = true;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Shield);
+    f.surgeActive = false;
+    f.surge = false;
+    f.energy = 50;
+    f.selfPoints = 5;
+    f.hotMs = 6000;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::None);
+    f.health = 50;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Burst);
+    f.health = 100;
+    f.energy = 75;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Burst);
+    f.selfPoints = 0;
+    f.targetPoints = 5;
+    CHECK(NextDrakeSpell(f) == DrakeSpell::Revivify); // points on boss cannot fund targeted heal
+
+    // Across every affordable energy/point boundary, never pick a spell whose
+    // base cost or combo-point requirement cannot be paid.
+    for (unsigned energy = 0; energy <= 100; ++energy)
+        for (unsigned points = 0; points <= 5; ++points)
+            for (bool heal : {false, true})
+                for (bool surge : {false, true})
+                    for (bool active : {false, true})
+                {
+                    DrakeFacts facts;
+                    facts.energy = energy;
+                    facts.points = facts.targetPoints = facts.selfPoints = points;
+                    facts.healer = heal;
+                    facts.surge = surge;
+                    facts.surgeActive = active;
+                    facts.shieldReady = true;
+                    auto spell = NextDrakeSpell(facts);
+                    CHECK(spell != DrakeSpell::Shield || (energy >= 25 && points > 0));
+                    CHECK(spell != DrakeSpell::Engulf || (energy >= 50 && points >= 2));
+                    CHECK(spell != DrakeSpell::Burst || (energy >= 50 && points >= 5));
+                    CHECK((spell != DrakeSpell::Spike && spell != DrakeSpell::Revivify) || energy >= 10);
+                }
+
+    int bossTarget = 1, selfTarget = 2;
+    for (bool healer : {false, true})
+    {
+        DrakeFacts shield;
+        shield.healer = healer;
+        shield.surgeActive = shield.shieldReady = true;
+        shield.energy = 25;
+        shield.points = 2;
+        int* combo = healer ? &selfTarget : &bossTarget;
+        DrakeSpell spell = NextDrakeSpell(shield);
+        CHECK(spell == DrakeSpell::Shield);
+        CHECK(DrakeTarget(spell, &bossTarget, &selfTarget, combo) == combo);
+        CHECK(DrakeTarget(spell, &bossTarget, &selfTarget, static_cast<int*>(nullptr)) == nullptr);
+        shield.points = 0;
+        CHECK(NextDrakeSpell(shield) == DrakeSpell::None);
+    }
+    CHECK(DrakeTarget(DrakeSpell::Spike, &bossTarget, &selfTarget, &selfTarget) == &bossTarget);
+    CHECK(DrakeTarget(DrakeSpell::Engulf, &bossTarget, &selfTarget, &selfTarget) == &bossTarget);
+    CHECK(DrakeTarget(DrakeSpell::Revivify, &bossTarget, &selfTarget, &bossTarget) == &selfTarget);
+    CHECK(DrakeTarget(DrakeSpell::Burst, &bossTarget, &selfTarget, &selfTarget) == &selfTarget);
+    CHECK(DrakeTarget(DrakeSpell::None, &bossTarget, &selfTarget, &bossTarget) == nullptr);
+
+    // A human orbiting every tick (or a pursued driver) cannot suppress weapon
+    // decisions, and a successful instant cast cannot suppress movement.
+    unsigned casts = 0, moves = 0;
+    for (unsigned tick = 0; tick < 60; ++tick)
+        CHECK(VehicleTick([&] { ++casts; return tick % 2 == 0; }, [&] { ++moves; return true; }));
+    CHECK(casts == 60 && moves == 60);
+    CHECK(!VehicleTick([] { return false; }, [] { return false; }));
+    CHECK(LeviathanPresence(true, true, true, false));
+    CHECK(!LeviathanPresence(true, true, false, true)); // owner must board before new seats fill
+    CHECK(LeviathanPresence(false, true, false, true)); // dead owner's raid keeps fighting
+    CHECK(!LeviathanPresence(false, false, false, true)); // bots-only bypass stays separate
+    CHECK(!LeviathanPresence(false, true, false, false)); // do not drive after a wipe
+
+    Point const boss{0, 0, 10};
+    CHECK(SafeDrakePoint({45, 0, 10}, boss, {}));
+    CHECK(!SafeDrakePoint({30, 0, 10}, boss, {}));
+    CHECK(!SafeDrakePoint({60, 0, 10}, boss, {}));
+    CHECK(!SafeDrakePoint({45, 0, 40}, boss, {}));
+    CHECK(!SafeDrakePoint({45, 0, 10}, boss, {{40, 0, 10}}));
+    CHECK(SafeDrakePoint({0, 45, 10}, boss, {{40, 0, 10}}));
+    CHECK(!SafeDrakePoint({std::numeric_limits<float>::quiet_NaN(), 0, 10}, boss, {}));
+    CHECK(!SafeDrakePoint({45, 0, 10}, {0, 0, std::numeric_limits<float>::quiet_NaN()}, {}));
+    CHECK(BoardingPriority(33060, true, false, false, true) == 0);
+    CHECK(BoardingPriority(33109, true, false, false, false) == 0);
+    CHECK(BoardingPriority(33109, true, false, false, true) < BoardingPriority(33060, false, true, true, true));
+    CHECK(BoardingPriority(33060, false, false, true, true) == -1); // foreign driver
+    CHECK(BoardingPriority(33060, false, true, false, true) == -1); // occupied turret
+    CHECK(BoardingPriority(33062, false, true, true, true) == -1); // useless chopper passenger
+    CHECK(BoardingPriority(33062, true, false, false, true) == 4);
+    CHECK(BoardingPriority(30161, true, false, false, true) == -1);
+    std::cout << checks << " checks, " << failures << " failures\n";
+    return failures ? 1 : 0;
+}
