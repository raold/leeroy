From 2b12311423687a9f2c09b65c8a1badcbf7349f92 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 17:28:44 -0500
Subject: [PATCH 36/63] fix(Raid/EoE): Reserve energy until injured drakes can
 recover

---
 src/Ai/Raid/RaidVehiclePolicy.h |  4 ++--
 tests/raid_vehicles_test.cpp    | 10 ++++++++++
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/Ai/Raid/RaidVehiclePolicy.h b/src/Ai/Raid/RaidVehiclePolicy.h
index 0ab19fa7..e1fbf97f 100644
--- a/src/Ai/Raid/RaidVehiclePolicy.h
+++ b/src/Ai/Raid/RaidVehiclePolicy.h
@@ -73,8 +73,8 @@ inline DrakeSpell NextDrakeSpell(DrakeFacts const& f)
             return f.healer || recover ? DrakeSpell::Revivify : DrakeSpell::Spike;
         return DrakeSpell::None;
     }
-    if (recover && f.energy >= 35)
-        return DrakeSpell::Revivify;
+    if (recover)
+        return f.energy >= 35 ? DrakeSpell::Revivify : DrakeSpell::None;
     if (f.healer)
     {
         if (f.selfPoints >= 5 && (f.energy >= 75 || (f.health < 60 && f.energy >= 50)))
diff --git a/tests/raid_vehicles_test.cpp b/tests/raid_vehicles_test.cpp
index 7051dc73..e4660b8b 100644
--- a/tests/raid_vehicles_test.cpp
+++ b/tests/raid_vehicles_test.cpp
@@ -96,6 +96,16 @@ int main()
     recovery.health = 30;
     recovery.energy = 35;
     CHECK(NextDrakeSpell(recovery) == DrakeSpell::Revivify);
+    // A hurt drake must accumulate enough energy for its HoT. Falling through
+    // to Spike consumes each regeneration tick and never reaches the reserve.
+    for (unsigned energy : {10u, 20u, 30u})
+    {
+        recovery.energy = energy;
+        CHECK(NextDrakeSpell(recovery) == DrakeSpell::None);
+    }
+    recovery.energy = 40;
+    CHECK(NextDrakeSpell(recovery) == DrakeSpell::Revivify);
+    recovery.energy = 35;
     for (unsigned stacks = 0; stacks < 5; ++stacks)
     {
         recovery.hotStacks = stacks;
