From 65b49fa00b611d2a6400c71f66557ef08d677be9 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 23:01:48 -0500
Subject: [PATCH 44/63] fix(Raid/TOC): Retain frost spheres through the first
 cast

---
 src/Ai/Raid/TOC/TocStrategy.cpp | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/Ai/Raid/TOC/TocStrategy.cpp b/src/Ai/Raid/TOC/TocStrategy.cpp
index 9ab6ae7c..a1d736aa 100644
--- a/src/Ai/Raid/TOC/TocStrategy.cpp
+++ b/src/Ai/Raid/TOC/TocStrategy.cpp
@@ -215,9 +215,17 @@ public:
         if (escape && escape->Escaping())
             return 0.0f;
         Unit* target = context->GetValue<Unit*>("current target")->Get();
-        if (target && target->GetEntry() == NPC_FROST_SPHERE && bot->IsValidAttackTarget(target) &&
-            dynamic_cast<MovementAction*>(action) && !dynamic_cast<TocFrostSphereAction*>(action))
-            return 0.0f;
+        if (target && target->GetEntry() == NPC_FROST_SPHERE && target->IsInWorld() && target->IsVisible() &&
+            target->GetMap() == bot->GetMap() && target->InSamePhase(bot) && bot->CanSeeOrDetect(target) &&
+            bot->IsValidAttackTarget(target) && !target->IsPolymorphed() && !target->HasFearAura() &&
+            !target->HasUnitState(UNIT_STATE_ISOLATED))
+        {
+            // Spheres are non-combat critters until hit. The stock invalid-target
+            // check otherwise drops them before the first cast and restarts the pull wait.
+            if (action->getName() == "drop target" ||
+                (dynamic_cast<MovementAction*>(action) && !dynamic_cast<TocFrostSphereAction*>(action)))
+                return 0.0f;
+        }
         return 1.0f;
     }
 };
