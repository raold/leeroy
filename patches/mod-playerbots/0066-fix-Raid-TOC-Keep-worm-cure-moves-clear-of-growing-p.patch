 namespace TocWorms
 {
+struct Point
+{
+    float x = 0, y = 0;
+};
+struct Pool
+{
+    Point center;
+    float radius = 0;
+};
+
+inline bool Held(bool combat, bool combatStay, bool idleStay, bool passive)
+{
+    return combatStay || (!combat && idleStay) || passive;
+}
+
+// SpellAuraEffects.cpp, periodic aura 66882. Include the next two ticks
+// and a further two yards so waiting for the cure does not stop at the edge.
+inline float PoolClearance(float baseRadius, std::uint32_t tick, float reach)
+{
+    float const scale = ((float(tick) + 2.0f) / 60.0f * 0.9f + 0.1f) * 2.0f / 3.0f;
+    return baseRadius * scale + reach + 2.0f;
+}
+
+inline bool Clear(Point p, std::vector<Pool> const& pools)
+{
+    return std::all_of(pools.begin(), pools.end(), [&](Pool const& pool)
+                       { return std::hypot(p.x - pool.center.x, p.y - pool.center.y) > pool.radius; });
+}
+
+inline bool ClearLeg(Point from, Point to, std::vector<Pool> const& pools)
+{
+    float const dx = to.x - from.x, dy = to.y - from.y;
+    float const lengthSq = dx * dx + dy * dy;
+    for (Pool const& pool : pools)
+    {
+        float const sx = from.x - pool.center.x, sy = from.y - pool.center.y;
+        float const startSq = sx * sx + sy * sy;
+        float const outward = sx * dx + sy * dy;
+        if (startSq <= pool.radius * pool.radius)
+        {
+            // An actor already inside the safety margin may leave it, never
+            // walk farther inward or end a cure route inside it.
+            if (outward < 0.0f || lengthSq <= 0.0f)
+                return false;
+        }
+        else
+        {
+            float const t = lengthSq > 0 ? std::clamp(-outward / lengthSq, 0.0f, 1.0f) : 0.0f;
+            if (std::hypot(sx + t * dx, sy + t * dy) <= pool.radius)
+                return false;
+        }
+    }
+    return true;
+}
+
+inline std::array<Point, 8> ContactPoints(Point self, Point target, float radius = 8.0f)
+{
+    float const angle = std::atan2(self.y - target.y, self.x - target.x);
+    constexpr float quarter = 0.7853981633974483f;
+    std::array<Point, 8> points{};
+    std::array<int, 8> const offsets{0, 1, -1, 2, -2, 3, -3, 4};
+    for (unsigned i = 0; i < points.size(); ++i)
+        points[i] = {target.x + radius * std::cos(angle + offsets[i] * quarter),
+                     target.y + radius * std::sin(angle + offsets[i] * quarter)};
+    return points;
+}
+
 struct Member
 {
     std::uint64_t guid = 0;
