+std::vector<TocWorms::Pool> WormPools(Player* bot)
+{
+    std::list<Creature*> creatures;
+    bot->GetCreatureListWithEntryInGrid(creatures, NPC_SLIME_POOL, 250.0f);
+    std::vector<TocWorms::Pool> pools;
+    for (Creature* pool : creatures)
+    {
+        if (!pool->IsAlive() || !pool->InSamePhase(bot))
+            continue;
+        float baseRadius = 0.0f;
+        if (SpellInfo const* pulse =
+                sSpellMgr->GetSpellInfo(sSpellMgr->GetSpellIdForDifficulty(SPELL_SLIME_POOL_DAMAGE, pool)))
+            for (SpellEffectInfo const& effect : pulse->Effects)
+                if (effect.IsTargetingArea())
+                    baseRadius = std::max(baseRadius, effect.CalcRadius(pool));
+        float radius = std::max(baseRadius, 30.0f) + bot->GetCombatReach() + 2.0f;
+        // A just-created pool without its aura/data yet is conservatively full-sized.
+        for (uint8 i = 0; i < MAX_SPELL_EFFECTS; ++i)
+            if (AuraEffect const* aura = pool->GetAuraEffect(SPELL_SLIME_POOL_AURA, i);
+                aura && aura->IsPeriodic() && baseRadius > 0.0f)
+                radius = TocWorms::PoolClearance(baseRadius, aura->GetTickNumber(), bot->GetCombatReach());
+        pools.push_back({{pool->GetPositionX(), pool->GetPositionY()}, radius});
+    }
+    return pools;
+}
+
+bool WormRoute(Player* bot, Position const& point, std::vector<TocWorms::Pool> const& pools,
+               Movement::PointsArray& route)
+{
+    if (!TocWorms::Clear({point.GetPositionX(), point.GetPositionY()}, pools))
+        return false;
+    if (auto* guard = PlayerbotMechanicGuard::Get();
+        guard && guard->Active() &&
+        guard->MechanicRefuses(bot, point.GetPositionX(), point.GetPositionY(), point.GetPositionZ()))
+        return false;
+    if (DisableMgr::IsPathfindingEnabled(bot->GetMap()))
+    {
+        PathGenerator path(bot);
+        path.SetPathLengthLimit(160.0f);
+        if (!path.CalculatePath(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ()) ||
+            path.GetPathType() != PATHFIND_NORMAL)
+            return false;
+        route = path.GetPath();
+    }
+    else
+    {
+        // With mmap disabled this is a straight collision route; reject a pool
+        // crossing before doing its per-yard terrain checks.
+        if (!TocWorms::ClearLeg({bot->GetPositionX(), bot->GetPositionY()},
+                                {point.GetPositionX(), point.GetPositionY()}, pools) ||
+            !TocCollisionRoute(bot, point, route, nullptr, BOSS_BEASTS, 390.0f, 410.0f))
+            return false;
+    }
+    if (route.size() < 2 ||
+        (route.back() - G3D::Vector3(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ())).length() > 0.5f)
+        return false;
+    for (std::size_t i = 1; i < route.size(); ++i)
+    {
+        auto const& p = route[i];
+        auto const& previous = route[i - 1];
+        if (!TocWorms::ClearLeg({previous.x, previous.y}, {p.x, p.y}, pools))
+            return false;
+    }
+    // Commit only half a second of this checked route. Recheck growing pools
+    // before the next leg, including when no mod-leeroy responder is installed.
+    float remaining = std::clamp(bot->GetSpeed(MOVE_RUN) * 0.5f, 0.1f, 3.0f);
+    for (std::size_t i = 1; i < route.size(); ++i)
+    {
+        float const length = (route[i] - route[i - 1]).length();
+        if (length > remaining)
+        {
+            route[i] = route[i - 1] + (route[i] - route[i - 1]) * (remaining / length);
+            route.resize(i + 1);
+            break;
+        }
+        remaining -= length;
+    }
+    return true;
+}
