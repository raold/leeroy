+bool WormRoute(Player* bot, std::array<TocWorms::Point, 8> const& contacts, float contactZ,
+               std::vector<TocWorms::Pool> const& pools, Movement::PointsArray& route, bool& detour)
+{
+    auto* guard = PlayerbotMechanicGuard::Get();
+    auto const refused = [&](float x, float y, float z)
+    { return guard && guard->Active() && guard->MechanicRefuses(bot, x, y, z); };
+    std::vector<TocWorms::Point> goals;
+    for (auto const& p : contacts)
+        if (TocWorms::Clear(p, pools) && !refused(p.x, p.y, contactZ))
+            goals.push_back(p);
+    std::vector<TocWorms::Leg> rejected;
+    bool proved = false;
+    for (unsigned attempt = 0; attempt < 12 && !proved; ++attempt)
+    {
+        auto const plan = TocWorms::Detour({bot->GetPositionX(), bot->GetPositionY()}, goals, pools, rejected);
+        if (plan.size() < 2)
+            return false;
+        detour = plan.size() > 2;
+        route.clear();
+        route.emplace_back(bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ());
+        float length = 0.0f;
+        proved = true;
+        for (std::size_t i = 1; i < plan.size(); ++i)
+        {
+            auto const& previous = route.back();
+            Position const origin(previous.x, previous.y, previous.z);
+            float z = i + 1 == plan.size() ? contactZ : previous.z;
+            if (i + 1 != plan.size())
+                bot->UpdateAllowedPositionZ(plan[i].x, plan[i].y, z);
+            Position const point(plan[i].x, plan[i].y, z);
+            Movement::PointsArray leg;
+            bool clear = std::isfinite(z) && z >= 390.0f && z <= 410.0f;
+            if (clear && DisableMgr::IsPathfindingEnabled(bot->GetMap()))
+            {
+                PathGenerator path(bot);
+                path.SetPathLengthLimit(160.0f);
+                clear = path.CalculatePath(previous.x, previous.y, previous.z, point.GetPositionX(),
+                                           point.GetPositionY(), point.GetPositionZ(), false) &&
+                        path.GetPathType() == PATHFIND_NORMAL;
+                leg = path.GetPath();
+            }
+            else if (clear)
+                clear = TocCollisionRoute(bot, point, leg, nullptr, BOSS_BEASTS, 390.0f, 410.0f, &origin);
+            clear = clear && leg.size() >= 2 && (leg.front() - previous).length() <= 0.1f &&
+                    std::hypot(leg.back().x - point.GetPositionX(), leg.back().y - point.GetPositionY()) <= 0.1f &&
+                    std::abs(leg.back().z - z) <= 0.5f;
+            // Check the actual ground/navmesh polyline, not just graph vertices.
+            for (std::size_t j = 1; clear && j < leg.size(); ++j)
+            {
+                auto const& p = leg[j];
+                auto const& a = leg[j - 1];
+                length += (p - a).length();
+                clear =
+                    length <= 160.0f && TocWorms::ClearLeg({a.x, a.y}, {p.x, p.y}, pools) && !refused(p.x, p.y, p.z);
+            }
+            if (!clear)
+            {
+                rejected.push_back({plan[i - 1], plan[i]});
+                proved = false;
+                break;
+            }
+            route.insert(route.end(), leg.begin() + 1, leg.end());
+        }
+    }
+    if (!proved)
+        return false;
+    // Commit only half a second of this checked route. Recheck growing pools
+    // before the next leg, including when no mod-leeroy responder is installed.
+    float remaining = std::clamp(bot->GetSpeed(MOVE_RUN) * 0.5f, 0.1f, 3.0f);
+    for (std::size_t i = 1; i < route.size(); ++i)
+    {
+        float const length = (route[i] - route[i - 1]).length();
+        if (length > remaining)
+        {
+            route[i] = route[i - 1] + (route[i] - route[i - 1]) * (remaining / length);
+            route.resize(i + 1);
+            break;
+        }
+        remaining -= length;
+    }
+    // EscortMovementGenerator recalculates a two-point path with MoveTo.
+    // Keep the proved segment explicit, including a heavily slowed victim.
+    if (route.size() == 2)
+        route.insert(route.begin() + 1, (route.front() + route.back()) * 0.5f);
+    return true;
+}
