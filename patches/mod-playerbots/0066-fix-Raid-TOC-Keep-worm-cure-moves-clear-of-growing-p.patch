--- a/src/Ai/Raid/TOC/TocWormPolicy.h
+++ b/src/Ai/Raid/TOC/TocWormPolicy.h
@@ -7,13 +7,171 @@
 #define PLAYERBOTS_TOCWORMPOLICY_H
 
 #include <algorithm>
+#include <array>
 #include <cmath>
 #include <cstdint>
+#include <limits>
 #include <tuple>
 #include <vector>
 
 namespace TocWorms
 {
+struct Point
+{
+    float x = 0, y = 0;
+};
+struct Pool
+{
+    Point center;
+    float radius = 0;
+};
+
+inline bool Held(bool combat, bool combatStay, bool idleStay, bool passive)
+{
+    return combatStay || (!combat && idleStay) || passive;
+}
+
+// SpellAuraEffects.cpp, periodic aura 66882. Include the next two ticks
+// and a further two yards so waiting for the cure does not stop at the edge.
+inline float PoolClearance(float baseRadius, std::uint32_t tick, float reach)
+{
+    float const scale = ((float(tick) + 2.0f) / 60.0f * 0.9f + 0.1f) * 2.0f / 3.0f;
+    return baseRadius * scale + reach + 2.0f;
+}
+
+inline bool Clear(Point p, std::vector<Pool> const& pools)
+{
+    return std::all_of(pools.begin(), pools.end(), [&](Pool const& pool)
+                       { return std::hypot(p.x - pool.center.x, p.y - pool.center.y) > pool.radius; });
+}
+
+inline bool ClearLeg(Point from, Point to, std::vector<Pool> const& pools)
+{
+    float const dx = to.x - from.x, dy = to.y - from.y;
+    float const lengthSq = dx * dx + dy * dy;
+    for (Pool const& pool : pools)
+    {
+        float const sx = from.x - pool.center.x, sy = from.y - pool.center.y;
+        float const startSq = sx * sx + sy * sy;
+        float const outward = sx * dx + sy * dy;
+        if (startSq <= pool.radius * pool.radius)
+        {
+            // An actor already inside the safety margin may leave it, never
+            // walk farther inward or end a cure route inside it.
+            if (outward < 0.0f || lengthSq <= 0.0f)
+                return false;
+        }
+        else
+        {
+            float const t = lengthSq > 0 ? std::clamp(-outward / lengthSq, 0.0f, 1.0f) : 0.0f;
+            if (std::hypot(sx + t * dx, sy + t * dy) <= pool.radius)
+                return false;
+        }
+    }
+    return true;
+}
+
+inline std::array<Point, 8> ContactPoints(Point self, Point target, float radius = 8.0f)
+{
+    float const angle = std::atan2(self.y - target.y, self.x - target.x);
+    constexpr float quarter = 0.7853981633974483f;
+    std::array<Point, 8> points{};
+    std::array<int, 8> const offsets{0, 1, -1, 2, -2, 3, -3, 4};
+    for (unsigned i = 0; i < points.size(); ++i)
+        points[i] = {target.x + radius * std::cos(angle + offsets[i] * quarter),
+                     target.y + radius * std::sin(angle + offsets[i] * quarter)};
+    return points;
+}
+
+struct Leg
+{
+    Point from, to;
+};
+
+// Small visibility graph outside circumscribed pool polygons. Ground/navmesh
+// validation may reject an edge; callers can then ask for another route.
+inline std::vector<Point> Detour(Point from, std::vector<Point> const& goals, std::vector<Pool> const& pools,
+                                 std::vector<Leg> const& rejected = {})
+{
+    constexpr unsigned maxPools = 12, sides = 12;
+    constexpr float maxLength = 160.0f, pi = 3.14159265358979323846f;
+    auto const finite = [](Point p) { return std::isfinite(p.x) && std::isfinite(p.y); };
+    if (!finite(from) || goals.empty() || goals.size() > 8 || pools.size() > maxPools || rejected.size() > 12 ||
+        std::any_of(goals.begin(), goals.end(), [&](Point p) { return !finite(p); }) ||
+        std::any_of(pools.begin(), pools.end(), [&](Pool const& pool)
+                    { return !finite(pool.center) || !std::isfinite(pool.radius) || pool.radius <= 0.0f; }))
+        return {};
+    std::vector<Point> nodes{from};
+    for (Point goal : goals)
+        if (Clear(goal, pools) && std::hypot(goal.x - from.x, goal.y - from.y) <= maxLength)
+            nodes.push_back(goal);
+    std::size_t const goalEnd = nodes.size();
+    if (goalEnd == 1)
+        return {};
+    auto const allowed = [&](Point a, Point b)
+    {
+        return ClearLeg(a, b, pools) &&
+               std::none_of(rejected.begin(), rejected.end(), [&](Leg const& leg)
+                            { return a.x == leg.from.x && a.y == leg.from.y && b.x == leg.to.x && b.y == leg.to.y; });
+    };
+    // The nearest clear direct contact is already the shortest possible route.
+    std::size_t closest = 1;
+    for (std::size_t i = 2; i < goalEnd; ++i)
+        if (std::hypot(nodes[i].x - from.x, nodes[i].y - from.y) <
+            std::hypot(nodes[closest].x - from.x, nodes[closest].y - from.y))
+            closest = i;
+    if (allowed(from, nodes[closest]))
+        return {from, nodes[closest]};
+    for (Pool const& pool : pools)
+    {
+        // Chords between neighbours stay at least half a yard beyond the
+        // already expanded clearance radius, including overlapping pools.
+        float const radius = (pool.radius + 0.5f) / std::cos(pi / float(sides));
+        for (unsigned i = 0; i < sides; ++i)
+        {
+            float const angle = 2.0f * pi * float(i) / float(sides);
+            Point const point{pool.center.x + radius * std::cos(angle), pool.center.y + radius * std::sin(angle)};
+            if (Clear(point, pools) && std::hypot(point.x - from.x, point.y - from.y) <= maxLength)
+                nodes.push_back(point);
+        }
+    }
+    std::vector<float> distance(nodes.size(), std::numeric_limits<float>::infinity());
+    std::vector<std::size_t> parent(nodes.size(), nodes.size());
+    std::vector<bool> visited(nodes.size(), false);
+    distance[0] = 0.0f;
+    for (std::size_t step = 0; step < nodes.size(); ++step)
+    {
+        std::size_t current = nodes.size();
+        for (std::size_t i = 0; i < nodes.size(); ++i)
+            if (!visited[i] && distance[i] <= maxLength && (current == nodes.size() || distance[i] < distance[current]))
+                current = i;
+        if (current == nodes.size())
+            return {};
+        if (current > 0 && current < goalEnd)
+        {
+            std::vector<Point> route;
+            for (std::size_t i = current; i != nodes.size(); i = parent[i])
+                route.push_back(nodes[i]);
+            std::reverse(route.begin(), route.end());
+            return route;
+        }
+        visited[current] = true;
+        for (std::size_t next = 1; next < nodes.size(); ++next)
+        {
+            if (visited[next])
+                continue;
+            float const candidate =
+                distance[current] + std::hypot(nodes[next].x - nodes[current].x, nodes[next].y - nodes[current].y);
+            if (candidate <= maxLength && candidate < distance[next] && allowed(nodes[current], nodes[next]))
+            {
+                distance[next] = candidate;
+                parent[next] = current;
+            }
+        }
+    }
+    return {};
+}
