+              bot->movespline->GetId(), kind, detour, spline.last() - spline.first() + 1, pools.size());
+    for (int32 i = spline.first(); i <= spline.last(); ++i)
+    {
+        auto const& p = spline.getPoint(i);
+        LOG_DEBUG("playerbots.toc_worm", "worm_point guid={} move={} i={} x={} y={} z={}", bot->GetGUID().GetCounter(),
+                  move, i - spline.first(), p.x, p.y, p.z);
+    }
+    for (std::size_t i = 0; i < pools.size(); ++i)
+        LOG_DEBUG("playerbots.toc_worm", "worm_pool guid={} move={} i={} x={} y={} radius={}",
+                  bot->GetGUID().GetCounter(), move, i, pools[i].center.x, pools[i].center.y, pools[i].radius);
+}
