From fc48fdf5a62816ed235f7ff1cae78e321eae5715 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Thu, 26 Nov 2026 19:12:05 -0500
Subject: [PATCH 55/55] fix(AI/Movement): Preserve mechanic escapes during
 pursuit

---
 src/Ai/Base/Actions/MovementActions.cpp | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/Ai/Base/Actions/MovementActions.cpp b/src/Ai/Base/Actions/MovementActions.cpp
index fb759365..c3d3011d 100644
--- a/src/Ai/Base/Actions/MovementActions.cpp
+++ b/src/Ai/Base/Actions/MovementActions.cpp
@@ -41,6 +41,19 @@
 #include <iomanip>
 #include <string>
 
+namespace
+{
+bool MechanicEscapePending(Player* bot)
+{
+    PlayerbotMechanicGuard* guard = PlayerbotMechanicGuard::Get();
+    // Follow and chase install generators directly, bypassing MoveTo's guard.
+    // Keeping the current unsafe position is already forbidden by that guard:
+    // let its escape finish before ordinary pursuit replaces the movement.
+    return guard && guard->Active() &&
+           guard->MechanicRefuses(bot, bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ());
+}
+}
+
 MovementAction::MovementAction(PlayerbotAI* botAI, std::string const name) : Action(botAI, name)
 {
     bot = botAI->GetBot();
@@ -1098,7 +1111,7 @@ bool MovementAction::Follow(Unit* target, float distance, float angle)
 {
     UpdateMovementState();
 
-    if (!target)
+    if (!target || MechanicEscapePending(bot))
         return false;
 
     if (!bot->InBattleground() && ServerFacade::instance().IsDistanceLessOrEqualThan(ServerFacade::instance().GetDistance2d(bot, target),
@@ -1268,7 +1281,7 @@ bool MovementAction::Follow(Unit* target, float distance, float angle)
 
 bool MovementAction::ChaseTo(WorldObject* obj, float distance)
 {
-    if (!IsMovingAllowed())
+    if (!IsMovingAllowed() || MechanicEscapePending(bot))
     {
         return false;
     }
