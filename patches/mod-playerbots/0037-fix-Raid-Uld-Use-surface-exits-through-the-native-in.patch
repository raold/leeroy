From a10f0e8ff44ed5e5128491fb21f8ca9033211719 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 20:31:13 -0500
Subject: [PATCH 37/46] fix(Raid/Uld): Use surface exits through the native
 interaction handler

---
 src/Ai/Raid/Uld/YoggBrainActions.cpp | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/src/Ai/Raid/Uld/YoggBrainActions.cpp b/src/Ai/Raid/Uld/YoggBrainActions.cpp
index 62b5b785..75c90b5b 100644
--- a/src/Ai/Raid/Uld/YoggBrainActions.cpp
+++ b/src/Ai/Raid/Uld/YoggBrainActions.cpp
@@ -20,6 +20,7 @@
 #include "Spell.h"
 #include "Timer.h"
 #include "UldBossHelper.h"
+#include "WorldSession.h"
 #include "YoggBrainPolicy.h"
 
 namespace
@@ -510,12 +511,16 @@ bool YoggBrainAction::Execute(Event /*event*/)
     }
     if (plan.mode == Mode::Exit)
     {
-        if (!plan.exit) return false;
-        if (!bot->IsWithinDistInMap(plan.exit, INTERACTION_DISTANCE) || !bot->IsWithinLOSInMap(plan.exit))
+        if (!plan.exit || !plan.exit->isSpawned()) return false;
+        if (!plan.exit->IsWithinDistInMap(bot, plan.exit->GetInteractionDistance()))
             return Walk(plan.exit->GetPosition());
-        // Same use path as a real player. No cast, aura removal or teleport shortcut.
-        plan.exit->Use(bot);
-        LOG_INFO("playerbots", "yogg_brain exit instance={} bot={} sanity={}", bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), Sanity(bot));
+        // Match the real client's range/ownership/use checks. The portal model
+        // can occlude its own origin even when the bot is standing at it; that
+        // extra LOS test kept walking to the same spot until Induce Madness.
+        WorldPacket use(CMSG_GAMEOBJ_USE, 8);
+        use << plan.exit->GetGUID();
+        bot->GetSession()->HandleGameObjectUseOpcode(use);
+        LOG_INFO("playerbots", "yogg_brain exit_use instance={} bot={} sanity={}", bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), Sanity(bot));
         return true;
     }
     if (plan.mode == Mode::Route)
