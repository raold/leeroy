diff --git a/src/Ai/Raid/Uld/YoggBrainActions.cpp b/src/Ai/Raid/Uld/YoggBrainActions.cpp
new file mode 100644
index 00000000..361b6f0a
--- /dev/null
+++ b/src/Ai/Raid/Uld/YoggBrainActions.cpp
@@ -0,0 +1,447 @@
+/* GPL-2.0-or-later; part of mod-playerbots. */
+#include "YoggBrainActions.h"
+#include "YoggBrainPolicy.h"
+#include "CreatureAI.h"
+#include "GameObject.h"
+#include "GenericSpellActions.h"
+#include "Group.h"
+#include "InstanceScript.h"
+#include "Log.h"
+#include "MotionMaster.h"
+#include "PathGenerator.h"
+#include "Pet.h"
+#include "Playerbots.h"
+#include "Spell.h"
+#include "Timer.h"
+#include "UldBossHelper.h"
+#include <chrono>
+#include <map>
+#include <mutex>
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+bool Enabled(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    if (!sPlayerbotAIConfig.YoggBrainSupport || !bot->IsInWorld() || bot->GetMapId() != 603 ||
+        !bot->IsAlive() || IsRealPlayer(bot) || IsSelfBot(bot) || bot->IsBeingTeleported() || bot->IsCharmed() ||
+        !bot->GetGroup() || !bot->GetGroup()->isRaidGroup() || bot->GetVehicle() ||
+        ai->HasStrategy("stay", BOT_STATE_COMBAT) || ai->HasStrategy("stay", BOT_STATE_NON_COMBAT) ||
+        ai->HasStrategy("passive", BOT_STATE_COMBAT))
+        return false;
+    InstanceScript* instance = bot->GetInstanceScript();
+    // Exact encounter and instance, including bots out of upstairs grid visibility.
+    return instance && instance->GetBossState(12) == IN_PROGRESS;
+}
+unsigned Sanity(Player* bot)
+{
+    Aura* aura = bot->GetAura(63050);
+    return aura ? aura->GetStackAmount() : 0;
+}
+bool Below(Player* bot) { return YoggBrain::InBrainArea(bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ()); }
+
+struct Wave
+{
+    Clock::time_point expires;
+    std::map<uint64, ObjectGuid> portals;
+};
+// Only GUIDs cross calls; no Creature/Player pointers survive a map update.
+// Map updates can run on different workers. Freeze the roster until the 25s
+// portal window is over rather than admitting replacements when sanity falls.
+std::mutex waveMutex;
+std::map<std::pair<uint32, uint64>, Wave> waves;
+
+Creature* AssignedPortal(PlayerbotAI* ai, Creature* brain)
+{
+    Player* bot = ai->GetBot();
+    if (Below(bot) || Sanity(bot) < YoggBrain::EnterSanity || bot->HasAura(63802) || bot->HasAura(63830))
+        return nullptr;
+    Spell* cast = brain ? brain->GetCurrentSpell(CURRENT_GENERIC_SPELL) : nullptr;
+    if (!cast || cast->GetSpellInfo()->Id != 64059 || cast->GetCastTimeRemaining() < 35000)
+        return nullptr;
+    std::list<Creature*> nearby;
+    bot->GetCreatureListWithEntryInGrid(nearby, 34072, 150.0f);
+    nearby.remove_if([](Creature* portal) { return !portal->IsAlive() || !portal->HasNpcFlag(UNIT_NPC_FLAG_SPELLCLICK); });
+    if (nearby.empty())
+        return nullptr;
+    auto const now = Clock::now();
+    auto const key = std::make_pair(bot->GetMap()->GetInstanceId(), bot->GetGroup()->GetGUID().GetRawValue());
+    std::lock_guard<std::mutex> lock(waveMutex);
+    for (auto it = waves.begin(); it != waves.end();)
+        if (it->second.expires <= now) it = waves.erase(it); else ++it;
+    auto it = waves.find(key);
+    if (it == waves.end())
+    {
+        if (waves.size() >= 128) return nullptr;
+        std::vector<YoggBrain::Member> members;
+        Creature* yogg = bot->GetInstanceScript()->GetCreature(12);
+        for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || !member->IsInWorld() || member->GetMap() != bot->GetMap() || !member->IsAlive())
+                continue;
+            PlayerbotAI* memberAI = GET_PLAYERBOT_AI(member);
+            bool const controlled = memberAI && !IsRealPlayer(member) && !IsSelfBot(member);
+            bool const available = yogg && member->IsWithinDistInMap(yogg, 150.0f) && member->GetPositionZ() > 300.0f &&
+                !member->GetVehicle() && !member->IsBeingTeleported() && !member->IsCharmed() &&
+                !member->HasAura(63802) && !member->HasAura(63830) &&
+                (!controlled || (!memberAI->HasStrategy("stay", BOT_STATE_COMBAT) &&
+                    !memberAI->HasStrategy("stay", BOT_STATE_NON_COMBAT) && !memberAI->HasStrategy("passive", BOT_STATE_COMBAT)));
+            members.push_back({member->GetGUID().GetRawValue(), controlled, PlayerbotAI::IsTank(member),
+                PlayerbotAI::IsHeal(member), PlayerbotAI::IsMelee(member), available, Sanity(member)});
+        }
+        auto const team = YoggBrain::Team(members, bot->GetMap()->Is25ManRaid());
+        nearby.sort([](Creature* a, Creature* b) { return a->GetGUID() < b->GetGUID(); });
+        Wave wave{now + std::chrono::seconds(60), {}};
+        auto portal = nearby.begin();
+        for (uint64 guid : team)
+        {
+            if (portal == nearby.end()) break;
+            wave.portals.emplace(guid, (*portal++)->GetGUID());
+        }
+        it = waves.emplace(key, std::move(wave)).first;
+        LOG_INFO("playerbots", "yogg_brain wave instance={} team={} portals={}", key.first, it->second.portals.size(), nearby.size());
+    }
+    auto const assignment = it->second.portals.find(bot->GetGUID().GetRawValue());
+    if (assignment == it->second.portals.end()) return nullptr;
+    for (Creature* portal : nearby)
+        if (portal->GetGUID() == assignment->second) return portal;
+    return nullptr; // A human may have used this portal. Never steal a teammate's.
+}
+
+struct GazeSource { Creature* unit; float radius; bool ignoreLos; };
+std::vector<GazeSource> Sources(Player* bot, bool below)
+{
+    std::vector<GazeSource> result;
+    std::list<Creature*> sources;
+    if (below)
+        bot->GetCreatureListWithEntryInGrid(sources, 33990, 150.0f);
+    else if (Creature* boss = bot->GetInstanceScript()->GetCreature(12))
+        sources.push_back(boss);
+    SpellInfo const* pulse = sSpellMgr->GetSpellInfo(below ? 64168 : 64164);
+    for (Creature* source : sources)
+    {
+        bool active = source->HasAura(below ? 64167 : 64163);
+        for (CurrentSpellTypes type : {CURRENT_GENERIC_SPELL, CURRENT_CHANNELED_SPELL})
+            if (Spell* cast = source->GetCurrentSpell(type))
+                active |= cast->GetSpellInfo()->Id == (below ? 64167u : 64163u);
+        if (!active || !source->IsAlive()) continue;
+        float radius = 0;
+        if (pulse)
+            for (auto const& effect : pulse->Effects) radius = std::max(radius, effect.CalcRadius(source));
+        result.push_back({source, (radius > 0 ? radius : 100.0f) + bot->GetObjectSize() + source->GetObjectSize(),
+            pulse && pulse->HasAttribute(SPELL_ATTR2_IGNORE_LINE_OF_SIGHT)});
+    }
+    return result;
+}
+std::vector<float> GazesAt(Player* bot, std::vector<GazeSource> const& sources, Position const& point)
+{
+    std::vector<float> angles;
+    for (auto const& source : sources)
+    {
+        if (point.GetExactDist(source.unit) > source.radius) continue;
+        Position eye(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ() + bot->GetCollisionHeight());
+        Position const from = source.unit->GetHitSpherePointFor(eye);
+        // Match boss_yoggsaron's actual FilterTargets, including IGNORE_LOS and M2.
+        if (!source.ignoreLos && !bot->GetMap()->isInLineOfSight(from.GetPositionX(), from.GetPositionY(), from.GetPositionZ(),
+                eye.GetPositionX(), eye.GetPositionY(), eye.GetPositionZ(), bot->GetPhaseMask(),
+                LINEOFSIGHT_ALL_CHECKS, VMAP::ModelIgnoreFlags::M2)) continue;
+        angles.push_back(point.GetAngle(source.unit));
+    }
+    return angles;
+}
+std::vector<float> Gazes(Player* bot, bool below) { return GazesAt(bot, Sources(bot, below), bot->GetPosition()); }
+
+bool AttackPoint(Player* bot, Unit* target, unsigned illusion, Position& best)
+{
+    if (illusion < 1 || illusion > 3) return false;
+    auto const sources = Sources(bot, true);
+    Position const center = illusion == 1 ? ULDUAR_YOGG_SARON_CHAMBER_OF_ASPECTS_MIDDLE :
+        illusion == 2 ? ULDUAR_YOGG_SARON_ICECROWN_CITADEL_MIDDLE : ULDUAR_YOGG_SARON_STORMWIND_KEEPER_MIDDLE;
+    float distance = 100000.0f;
+    bool found = false;
+    for (float radius : {3.0f, PlayerbotAI::IsMelee(bot) ? 3.0f : 20.0f})
+        for (unsigned i = 0; i < 24; ++i)
+        {
+            float const angle = i * 2 * YoggBrain::Pi / 24;
+            Position point(target->GetPositionX() + radius * std::cos(angle),
+                target->GetPositionY() + radius * std::sin(angle), bot->GetPositionZ());
+            bot->UpdateAllowedPositionZ(point.m_positionX, point.m_positionY, point.m_positionZ);
+            float const travel = bot->GetExactDist2d(point);
+            if (travel >= distance || point.GetExactDist2d(center) > 75.0f ||
+                std::abs(point.GetPositionZ() - bot->GetPositionZ()) > 8.0f ||
+                !bot->IsWithinLOS(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ()) ||
+                !target->IsWithinLOS(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ()) ||
+                !YoggBrain::CombatFacing(point.GetAngle(target), GazesAt(bot, sources, point))) continue;
+            best = point;
+            distance = travel;
+            found = true;
+        }
+    return found;
+}
+
+enum class Mode { None, Portal, Exit, Route, Fight, Face, Wait };
+struct Plan
+{
+    Mode mode = Mode::None;
+    Unit* target = nullptr;
+    GameObject* exit = nullptr;
+    Position destination;
+    float facing = 0;
+    bool below = false;
+    bool needsAction = false;
+};
+Plan Decide(PlayerbotAI* ai)
+{
+    Plan plan;
+    if (!Enabled(ai)) return plan;
+    Player* bot = ai->GetBot();
+    plan.below = Below(bot);
+    Creature* brain = bot->GetInstanceScript()->GetCreature(761);
+    auto const gazes = Gazes(bot, plan.below);
+    plan.facing = YoggBrain::SafeFacing(bot->GetOrientation(), gazes);
+    if (!plan.below)
+    {
+        if (!gazes.empty())
+        {
+            plan.mode = Mode::Face;
+            plan.needsAction = YoggBrain::Exposure(bot->GetOrientation(), gazes) != 0 || bot->GetVictim() ||
+                bot->IsNonMeleeSpellCast(false) || bot->isMoving();
+        }
+        else if (Creature* portal = AssignedPortal(ai, brain))
+        {
+            plan.mode = Mode::Portal;
+            plan.target = portal;
+            plan.needsAction = true;
+        }
+        return plan;
+    }
+    plan.needsAction = true;
+    plan.exit = bot->FindNearestGameObject(194625, 250.0f);
+    Spell* cast = brain ? brain->GetCurrentSpell(CURRENT_GENERIC_SPELL) : nullptr;
+    bool const inducing = cast && cast->GetSpellInfo()->Id == 64059;
+    unsigned const remaining = inducing ? std::max(0, cast->GetCastTimeRemaining()) : 0;
+    if (!brain || !brain->IsAlive() || YoggBrain::MustExit(inducing, remaining, Sanity(bot), brain->GetHealthPct(),
+        plan.exit ? bot->GetExactDist(plan.exit) : 1000.0f, bot->GetSpeed(MOVE_RUN)))
+    {
+        plan.mode = Mode::Exit;
+        return plan;
+    }
+    unsigned const illusion = brain->IsAIEnabled ? brain->AI()->GetData(2) : 0;
+    GameObject* door = illusion >= 1 && illusion <= 3 ? bot->FindNearestGameObject(194634 + illusion, 250.0f) : nullptr;
+    if (YoggBrain::BrainAllowed(illusion, door && door->GetGoState() == GO_STATE_ACTIVE, inducing, remaining, brain->GetHealthPct()))
+    {
+        // Do not aim MoveTo at the floating Brain's Z=265. Walk through the
+        // correct doorway onto the room's actual floor, then use normal attacks.
+        Position const entrance = illusion == 1 ? ULDUAR_YOGG_SARON_CHAMBER_OF_ASPECTS_ENTRANCE :
+            illusion == 2 ? ULDUAR_YOGG_SARON_ICECROWN_CITADEL_ENTRANCE : ULDUAR_YOGG_SARON_STORMWIND_KEEPER_ENTRANCE;
+        if (bot->GetExactDist2d(ULDUAR_YOGG_SARON_BRAIN_ROOM_MIDDLE) > 42.0f)
+        {
+            plan.mode = Mode::Route;
+            plan.destination = bot->GetExactDist2d(entrance) > 8.0f && bot->GetExactDist2d(brain) > entrance.GetExactDist2d(brain) ?
+                entrance : ULDUAR_YOGG_SARON_BRAIN_ROOM_MIDDLE;
+            return plan;
+        }
+        plan.target = brain;
+    }
+    else
+    {
+        // Only actual influence tentacles or their disguises. Never skulls,
+        // friendly cinematic actors, or the Brain behind an unproved door.
+        std::list<Creature*> adds;
+        for (uint32 entry : {33943u, 33716u, 33717u, 33718u, 33719u, 33720u, 33567u, 33433u})
+            bot->GetCreatureListWithEntryInGrid(adds, entry, 180.0f);
+        float best = 100000.0f;
+        for (Creature* add : adds)
+        {
+            if (!add->IsAlive() || add->GetPositionZ() >= 300.0f || !bot->IsValidAttackTarget(add)) continue;
+            float const score = 50.0f * YoggBrain::Exposure(bot->GetAngle(add), gazes) + bot->GetExactDist2d(add);
+            if (score < best) { best = score; plan.target = add; }
+        }
+    }
+    if (!plan.target)
+    {
+        plan.mode = Mode::Wait;
+        plan.needsAction = bot->GetVictim() || bot->IsNonMeleeSpellCast(false) ||
+            YoggBrain::AngleDistance(bot->GetOrientation(), plan.facing) > 0.1f;
+        return plan;
+    }
+    if (!YoggBrain::CombatFacing(bot->GetAngle(plan.target), gazes))
+    {
+        // Never spend the entire rotation facing a skull merely because that add
+        // scored best. Reposition for a safe attack angle; if none exists, turn
+        // away and wait, preserving sanity rather than inventing a restoration.
+        if (AttackPoint(bot, plan.target, illusion, plan.destination))
+            plan.mode = Mode::Route;
+        else
+        {
+            plan.mode = Mode::Face;
+            plan.needsAction = bot->GetVictim() || bot->IsNonMeleeSpellCast(false) || bot->isMoving() ||
+                YoggBrain::AngleDistance(bot->GetOrientation(), plan.facing) > 0.1f;
+        }
+        return plan;
+    }
+    plan.mode = Mode::Fight;
+    float const range = PlayerbotAI::IsMelee(bot) ? 3.0f : 25.0f;
+    plan.needsAction = ai->GetAiObjectContext()->GetValue<Unit*>("current target")->Get() != plan.target ||
+        bot->GetVictim() != plan.target ||
+        !bot->IsWithinLOSInMap(plan.target) || bot->GetDistance(plan.target) > range ||
+        !bot->HasInArc(1.0f, plan.target);
+    return plan;
+}
+void Stop(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    bot->AttackStop();
+    bot->InterruptNonMeleeSpells(false);
+    if (Pet* pet = bot->GetPet())
+    {
+        pet->AttackStop();
+        pet->InterruptNonMeleeSpells(false);
+    }
+    ai->GetAiObjectContext()->GetValue<Unit*>("current target")->Set(nullptr);
+}
+}
+
+bool YoggBrainTrigger::IsActive() { return Decide(botAI).needsAction; }
+bool YoggBrainEmergencyTrigger::IsActive()
+{
+    Plan const plan = Decide(botAI);
+    return plan.needsAction && (plan.mode == Mode::Exit || plan.mode == Mode::Face ||
+        (plan.below && (bot->GetVictim() || bot->IsNonMeleeSpellCast(false)) &&
+            !YoggBrain::CombatFacing(bot->GetOrientation(), Gazes(bot, true))));
+}
+
+void YoggBrainAction::Note(unsigned mode, Unit* target)
+{
+    ObjectGuid const guid = target ? target->GetGUID() : ObjectGuid::Empty;
+    if (mode == lastMode && guid == lastTarget) return;
+    lastMode = mode;
+    lastTarget = guid;
+    LOG_INFO("playerbots", "yogg_brain transition instance={} bot={} mode={} target={} sanity={}",
+        bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), mode, target ? target->GetEntry() : 0, Sanity(bot));
+}
+
+bool YoggBrainAction::Walk(Position const& destination)
+{
+    // Reject pathfinding fallbacks through closed illusion doors or the floor.
+    // No teleport and no unpathed straight line when the local mmap is missing.
+    PathGenerator path(bot);
+    path.SetPathLengthLimit(250.0f);
+    if (!path.CalculatePath(destination.GetPositionX(), destination.GetPositionY(), destination.GetPositionZ()) ||
+        path.GetPathType() != PATHFIND_NORMAL)
+    {
+        if (!lastPathLog || GetMSTimeDiffToNow(lastPathLog) >= 10000)
+        {
+            lastPathLog = getMSTime();
+            LOG_WARN("playerbots", "yogg_brain path_blocked instance={} bot={} mode={} path={}",
+                bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), lastMode, unsigned(path.GetPathType()));
+        }
+        return false;
+    }
+    return MoveTo(bot->GetMapId(), destination.GetPositionX(), destination.GetPositionY(), destination.GetPositionZ(),
+        false, false, true, true, MovementPriority::MOVEMENT_FORCED);
+}
+
+bool YoggBrainAction::Execute(Event /*event*/)
+{
+    Plan const plan = Decide(botAI);
+    if (plan.mode == Mode::None) return false;
+    Note(static_cast<unsigned>(plan.mode), plan.target);
+    if (plan.mode == Mode::Fight)
+    {
+        if (!bot->IsWithinLOSInMap(plan.target) || bot->GetDistance(plan.target) > (PlayerbotAI::IsMelee(bot) ? 3.0f : 25.0f))
+        {
+            if (plan.target->GetEntry() == 33890)
+                return Walk(ULDUAR_YOGG_SARON_BRAIN_ROOM_MIDDLE);
+            Position point = plan.target->GetPosition();
+            float const angle = plan.target->GetAngle(bot);
+            point.m_positionX += 2.0f * std::cos(angle);
+            point.m_positionY += 2.0f * std::sin(angle);
+            bot->UpdateAllowedPositionZ(point.m_positionX, point.m_positionY, point.m_positionZ);
+            return Walk(point);
+        }
+        bot->SetFacingToObject(plan.target);
+        return Attack(plan.target);
+    }
+    Stop(botAI);
+    if (plan.mode == Mode::Portal)
+    {
+        if (bot->GetExactDist(plan.target) > 3.0f || !bot->IsWithinLOSInMap(plan.target))
+            return Walk(plan.target->GetPosition());
+        bool const used = plan.target->ToCreature()->HandleSpellClick(bot);
+        if (used) LOG_INFO("playerbots", "yogg_brain enter instance={} bot={} sanity={}", bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), Sanity(bot));
+        return used;
+    }
+    if (plan.mode == Mode::Exit)
+    {
+        if (!plan.exit) return false;
+        if (!bot->IsWithinDistInMap(plan.exit, INTERACTION_DISTANCE) || !bot->IsWithinLOSInMap(plan.exit))
+            return Walk(plan.exit->GetPosition());
+        // Same use path as a real player. No cast, aura removal or teleport shortcut.
+        plan.exit->Use(bot);
+        LOG_INFO("playerbots", "yogg_brain exit instance={} bot={} sanity={}", bot->GetMap()->GetInstanceId(), bot->GetGUID().GetCounter(), Sanity(bot));
+        return true;
+    }
+    if (plan.mode == Mode::Route)
+        return Walk(plan.destination);
+    bot->StopMoving();
+    bot->SetFacingTo(plan.facing);
+    return true;
+}
+
+float YoggBrainMultiplier::GetValue(Action* action)
+{
+    if (!action || dynamic_cast<YoggBrainAction*>(action) || !Enabled(botAI)) return 1.0f;
+    bool const below = Below(bot);
+    if (!below)
+    {
+        // Do not repeat room/roster grid searches for each rotation candidate.
+        if (!Gazes(bot, false).empty()) return 0.0f;
+        auto const key = std::make_pair(bot->GetMap()->GetInstanceId(), bot->GetGroup()->GetGUID().GetRawValue());
+        std::lock_guard<std::mutex> lock(waveMutex);
+        auto const wave = waves.find(key);
+        if (wave == waves.end() || wave->second.expires <= Clock::now()) return 1.0f;
+        auto const assigned = wave->second.portals.find(bot->GetGUID().GetRawValue());
+        if (assigned == wave->second.portals.end()) return 1.0f;
+        Creature* portal = bot->GetMap()->GetCreature(assigned->second);
+        return portal && portal->HasNpcFlag(UNIT_NPC_FLAG_SPELLCLICK) &&
+            Sanity(bot) >= YoggBrain::EnterSanity && !bot->HasAura(63802) && !bot->HasAura(63830) ? 0.0f : 1.0f;
+    }
+    // A portal/exit/deadline/gaze move must not be undone by follow, charge,
+    // assist, a legacy raid action, or a cast that automatically turns us back.
+    if (dynamic_cast<MovementAction*>(action)) return 0.0f;
+    if (action->getName().find("yogg-saron") == 0) return 0.0f;
+    Unit* actionTarget = action->GetTarget();
+    if (actionTarget && actionTarget != bot &&
+        !YoggBrain::CombatFacing(bot->GetAngle(actionTarget), Gazes(bot, true))) return 0.0f;
+    if (auto* spell = dynamic_cast<CastSpellAction*>(action))
+    {
+        Creature* brain = bot->GetInstanceScript()->GetCreature(761);
+        Spell* cast = brain ? brain->GetCurrentSpell(CURRENT_GENERIC_SPELL) : nullptr;
+        bool const inducing = cast && cast->GetSpellInfo()->Id == 64059;
+        unsigned const remaining = inducing ? std::max(0, cast->GetCastTimeRemaining()) : 0;
+        GameObject* exit = bot->FindNearestGameObject(194625, 250.0f);
+        if (!brain || YoggBrain::MustExit(inducing, remaining, Sanity(bot), brain->GetHealthPct(),
+            exit ? bot->GetExactDist(exit) : 1000.0f, bot->GetSpeed(MOVE_RUN))) return 0.0f;
+        Unit* target = spell->GetTarget();
+        if (target && bot->IsHostileTo(target))
+        {
+            if (target == brain)
+            {
+                unsigned const illusion = brain->IsAIEnabled ? brain->AI()->GetData(2) : 0;
+                GameObject* door = illusion >= 1 && illusion <= 3 ? bot->FindNearestGameObject(194634 + illusion, 250.0f) : nullptr;
+                if (!YoggBrain::BrainAllowed(illusion, door && door->GetGoState() == GO_STATE_ACTIVE, inducing, remaining, brain->GetHealthPct())) return 0.0f;
+            }
+            else if (!YoggBrain::Influence(target->GetEntry())) return 0.0f;
+        }
+        uint32 const id = context->GetValue<uint32>("spell id", spell->getSpell())->Get();
+        SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
+        if (info && info->IsTargetingArea()) return 0.0f;
+        unsigned const cost = info ? info->CalcCastTime(bot) + (info->IsChanneled() ? std::max(0, info->GetDuration()) : 0) : 0;
+        if (!YoggBrain::CastFits(remaining, YoggBrain::ExitBudget(exit ? bot->GetExactDist(exit) : 1000.0f,
+            bot->GetSpeed(MOVE_RUN)), cost)) return 0.0f;
+    }
+    return 1.0f;
+}
