diff --git a/src/Ai/Raid/Uld/YoggBrainPolicy.h b/src/Ai/Raid/Uld/YoggBrainPolicy.h
new file mode 100644
index 00000000..7d6c8e2f
--- /dev/null
+++ b/src/Ai/Raid/Uld/YoggBrainPolicy.h
@@ -0,0 +1,114 @@
+/* GPL-2.0-or-later; part of mod-playerbots. */
+#ifndef PLAYERBOTS_YOGGBRAINPOLICY_H
+#define PLAYERBOTS_YOGGBRAINPOLICY_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace YoggBrain
+{
+constexpr unsigned EnterSanity = 40;
+constexpr unsigned LeaveSanity = 25;
+constexpr float Pi = 3.141592654f;
+inline bool InBrainArea(float x, float y, float z)
+{
+    return x > 1830.0f && x < 2160.0f && y > -190.0f && y < 125.0f && z > 225.0f && z < 285.0f;
+}
+struct Member
+{
+    std::uint64_t guid;
+    bool bot, tank, healer, melee, available;
+    unsigned sanity;
+};
+
+// Freeze this selection for a portal wave. Humans choose for themselves; reserve
+// their slots without issuing them commands. Keep at least 1/2 healers upstairs.
+inline std::vector<std::uint64_t> Team(std::vector<Member> members, bool large)
+{
+    unsigned slots = large ? 10 : 4;
+    unsigned healers = 0;
+    for (auto const& member : members)
+    {
+        if (!member.available)
+            continue;
+        // Conservatively assume a human healer uses the slot reserved for them.
+        healers += member.healer && member.bot;
+        if (!member.bot && !member.tank && slots)
+            --slots;
+    }
+    std::sort(members.begin(), members.end(), [](Member const& a, Member const& b)
+    {
+        // One portal healer first, then melee before ranged, deterministic GUID ties.
+        if (a.healer != b.healer) return a.healer;
+        if (a.melee != b.melee) return a.melee;
+        return a.guid < b.guid;
+    });
+    std::vector<std::uint64_t> result;
+    bool haveHealer = false;
+    for (auto const& member : members)
+    {
+        if (!slots || !member.bot || !member.available || member.tank || member.sanity < EnterSanity)
+            continue;
+        if (member.healer && (haveHealer || healers <= (large ? 2u : 1u)))
+            continue;
+        haveHealer |= member.healer;
+        result.push_back(member.guid);
+        --slots;
+    }
+    return result;
+}
+
+inline bool Influence(std::uint32_t entry)
+{
+    return entry == 33943 || (entry >= 33716 && entry <= 33720) || entry == 33567 || entry == 33433;
+}
+inline bool BrainAllowed(unsigned illusion, bool doorOpen, bool casting, unsigned remaining, float health)
+{
+    return illusion >= 1 && illusion <= 3 && doorOpen && casting && remaining > 12000 && health > 30.0f;
+}
+inline unsigned ExitBudget(float distance, float speed)
+{
+    // Straight-line distance understates the door route. Budget a detour and the
+    // click/cast delay, never the old fixed eight seconds from a far illusion room.
+    if (!std::isfinite(distance) || !std::isfinite(speed) || distance < 0 || speed <= 0)
+        return 60000;
+    return static_cast<unsigned>(std::min(60000.0f, std::max(12000.0f, 5000.0f + distance * 1500.0f / speed)));
+}
+inline bool MustExit(bool casting, unsigned remaining, unsigned sanity, float health, float distance, float speed)
+{
+    return !casting || remaining <= ExitBudget(distance, speed) || sanity <= LeaveSanity || health <= 30.0f;
+}
+inline bool CastFits(unsigned remaining, unsigned exitBudget, unsigned castTime)
+{
+    return remaining > exitBudget && remaining - exitBudget > std::uint64_t(castTime) + 1000;
+}
+inline float AngleDistance(float a, float b) { return std::abs(std::remainder(a - b, 2.0f * Pi)); }
+inline unsigned Exposure(float facing, std::vector<float> const& gazes)
+{
+    unsigned result = 0;
+    for (float gaze : gazes)
+        // Keep a margin from the core's HasInArc(M_PI) boundary.
+        result += AngleDistance(facing, gaze) <= Pi / 2.0f + 0.05f;
+    return result;
+}
+inline bool CombatFacing(float facing, std::vector<float> const& gazes) { return Exposure(facing, gazes) == 0; }
+inline float SafeFacing(float current, std::vector<float> const& gazes)
+{
+    float best = current;
+    unsigned count = Exposure(current, gazes);
+    for (unsigned i = 0; i < 64; ++i)
+    {
+        float const candidate = i * 2.0f * Pi / 64.0f;
+        unsigned const exposed = Exposure(candidate, gazes);
+        if (exposed < count || (exposed == count && AngleDistance(candidate, current) < AngleDistance(best, current)))
+        {
+            best = candidate;
+            count = exposed;
+        }
+    }
+    return best;
+}
+}
+#endif
