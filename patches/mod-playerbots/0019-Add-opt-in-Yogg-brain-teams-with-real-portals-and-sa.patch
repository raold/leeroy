+/* GPL-2.0-or-later; part of mod-playerbots. */
+#include "../src/Ai/Raid/Uld/YoggBrainPolicy.h"
+#include <iostream>
+#include <limits>
+#include <numeric>
+
+namespace
+{
+unsigned checks = 0, failures = 0;
+void Check(bool ok, int line)
+{
+    ++checks;
+    if (!ok) { ++failures; std::cerr << "failed line " << line << '\n'; }
+}
+}
+#define CHECK(x) Check(bool(x), __LINE__)
+int main()
+{
+    using namespace YoggBrain;
+    CHECK(InBrainArea(1980, -25, 236));
+    CHECK(InBrainArea(2104, -25, 242));
+    CHECK(InBrainArea(1925, -121, 240));
+    CHECK(InBrainArea(1927, 68, 242));
+    CHECK(!InBrainArea(1980, -25, 329));
+    CHECK(!InBrainArea(0, 0, 240));
+    CHECK(!InBrainArea(1980, 500, 240));
+    CHECK(Team({}, false).empty());
+    for (bool large : {false, true})
+        for (unsigned humans = 0; humans < 4; ++humans)
+            for (unsigned healers = 0; healers < 7; ++healers)
+            {
+                std::vector<Member> roster;
+                for (unsigned i = 0; i < (large ? 25u : 10u); ++i)
+                    roster.push_back({100 + i, i >= humans, i >= 8 && i < 10, i < healers,
+                        i % 2 == 0, true, 100});
+                auto selected = Team(roster, large);
+                CHECK(selected.size() <= (large ? 10 : 4) - humans);
+                unsigned portalHealers = 0;
+                for (auto guid : selected)
+                {
+                    auto const member = roster.at(guid - 100);
+                    CHECK(member.bot && !member.tank && member.available && member.sanity >= EnterSanity);
+                    portalHealers += member.healer;
+                }
+                CHECK(portalHealers <= 1);
+                unsigned const botHealers = healers > humans ? healers - humans : 0;
+                CHECK(!portalHealers || botHealers - portalHealers >= (large ? 2u : 1u));
+                std::reverse(roster.begin(), roster.end());
+                CHECK(Team(roster, large) == selected);
+                // Admission facts must not accidentally admit dead/stay/low-sanity bots.
+                for (auto& member : roster) member.available = false;
+                CHECK(Team(roster, large).empty());
+            }
+    std::vector<Member> roster{{1,true,false,false,true,true,39}, {2,true,false,false,true,true,40},
+        {3,true,false,false,false,true,100}, {4,true,true,false,true,true,100}};
+    CHECK((Team(roster, false) == std::vector<std::uint64_t>{2,3}));
+    for (unsigned illusion = 0; illusion < 5; ++illusion)
+        for (bool door : {false, true})
+            for (bool cast : {false, true})
+                for (unsigned remaining : {0u, 10000u, 12000u, 12001u, 60000u})
+                    for (float health : {0.0f, 29.0f, 30.0f, 31.0f, 100.0f})
+                        CHECK(BrainAllowed(illusion, door, cast, remaining, health) ==
+                            (illusion >= 1 && illusion <= 3 && door && cast && remaining > 12000 && health > 30));
+    for (unsigned entry : {33943u,33716u,33717u,33718u,33719u,33720u,33567u,33433u}) CHECK(Influence(entry));
+    for (unsigned entry : {0u,33990u,33890u,33288u,33535u,33441u}) CHECK(!Influence(entry));
+    CHECK(ExitBudget(0, 7) == 12000);
+    CHECK(ExitBudget(140, 7) == 35000);
+    CHECK(ExitBudget(140, 3.5f) > ExitBudget(140, 7));
+    CHECK(ExitBudget(1, 0) == 60000);
+    CHECK(ExitBudget(std::numeric_limits<float>::quiet_NaN(), 7) == 60000);
+    CHECK(ExitBudget(0, std::numeric_limits<float>::infinity()) == 60000);
+    CHECK(MustExit(true, 34999, 100, 100, 140, 7));
+    CHECK(!MustExit(true, 35001, 100, 100, 140, 7));
+    CHECK(MustExit(false, 60000, 100, 100, 1, 7));
+    CHECK(MustExit(true, 60000, 25, 100, 1, 7));
+    CHECK(!MustExit(true, 60000, 26, 100, 1, 7));
+    CHECK(MustExit(true, 60000, 100, 30, 1, 7));
+    CHECK(CastFits(20000, 12000, 6000));
+    CHECK(!CastFits(20000, 12000, 7000));
+    CHECK(!CastFits(20000, 12000, 10000));
+    CHECK(!CastFits(12000, 12000, 0));
+    CHECK(!CastFits(1, 12000, 0));
+    CHECK(!CastFits(60000, 12000, std::numeric_limits<unsigned>::max()));
+    for (unsigned step = 0; step < 64; ++step)
+    {
+        float const current = step * 2 * Pi / 64;
+        CHECK(SafeFacing(current, {}) == current);
+        for (unsigned source = 0; source < 64; ++source)
+        {
+            float const gaze = source * 2 * Pi / 64;
+            CHECK(Exposure(SafeFacing(current, {gaze}), {gaze}) == 0);
+            CHECK(CombatFacing(SafeFacing(current, {gaze}), {gaze}));
+            CHECK(!CombatFacing(gaze, {gaze})); // Attack/cast facing cannot undo avoidance.
+            std::vector<float> const skulls{gaze, gaze + Pi};
+            CHECK(Exposure(SafeFacing(current, skulls), skulls) <= Exposure(current, skulls));
+        }
+    }
+    std::cout << checks << " checks, " << failures << " failures\n";
+    return failures ? 1 : 0;
+}
