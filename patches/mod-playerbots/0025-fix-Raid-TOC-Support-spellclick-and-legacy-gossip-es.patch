From 22cd0b8d013d88da156b01ac2d091e0a8cd7970c Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 13:19:43 -0500
Subject: [PATCH 25/63] fix(Raid/TOC): Support spellclick and legacy gossip
 essences

---
 src/Ai/Raid/TOC/TocStrategy.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/Ai/Raid/TOC/TocStrategy.cpp b/src/Ai/Raid/TOC/TocStrategy.cpp
index 7cf85c37..1149e5ad 100644
--- a/src/Ai/Raid/TOC/TocStrategy.cpp
+++ b/src/Ai/Raid/TOC/TocStrategy.cpp
@@ -197,7 +197,10 @@ bool TocEssenceAction::Execute(Event /*event*/)
         return false;
     Creature* essence =
         bot->FindNearestCreature(wanted == Colour::Light ? NPC_LIGHT_ESSENCE : NPC_DARK_ESSENCE, ESSENCE_SEARCH_RANGE);
-    if (!essence || !essence->HasNpcFlag(UNIT_NPC_FLAG_GOSSIP) || !essence->InSamePhase(bot))
+    if (!essence || !essence->InSamePhase(bot))
+        return false;
+    bool const spellClick = essence->HasNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+    if (!spellClick && !essence->HasNpcFlag(UNIT_NPC_FLAG_GOSSIP))
         return false;
     if (!bot->IsWithinDistInMap(essence, ESSENCE_CLICK_RANGE) || !bot->IsWithinLOSInMap(essence))
     {
@@ -210,6 +213,9 @@ bool TocEssenceAction::Execute(Event /*event*/)
     bot->InterruptNonMeleeSpells(false);
     bot->StopMoving();
     bot->SetFacingToObject(essence);
+    if (spellClick)
+        return essence->HandleSpellClick(bot);
+    // Older cores expose the same essence through gossip instead.
     WorldPacket hello(CMSG_GOSSIP_HELLO);
     hello << essence->GetGUID();
     bot->GetSession()->HandleGossipHelloOpcode(hello);
