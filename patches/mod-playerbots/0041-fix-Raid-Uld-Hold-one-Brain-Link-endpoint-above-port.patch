From 51d88c7e99015962699041b841e8caad3202068f Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 22:11:07 -0500
Subject: [PATCH 41/46] fix(Raid/Uld): Hold one Brain Link endpoint above
 portals

---
 src/Ai/Raid/Uld/YoggBrainActions.cpp | 39 ++++++++++++++++++++++++----
 1 file changed, 34 insertions(+), 5 deletions(-)

diff --git a/src/Ai/Raid/Uld/YoggBrainActions.cpp b/src/Ai/Raid/Uld/YoggBrainActions.cpp
index a82e8d64..5826ec55 100644
--- a/src/Ai/Raid/Uld/YoggBrainActions.cpp
+++ b/src/Ai/Raid/Uld/YoggBrainActions.cpp
@@ -44,6 +44,35 @@ void PruneBrainLinks(Clock::time_point now)
             ++it;
 }
 
+bool PortalLinkBlocked(Player* player)
+{
+    auto const now = Clock::now();
+    for (GroupReference* ref = player->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* owner = ref->GetSource();
+        if (!owner || !owner->IsInWorld() || !owner->IsAlive() || owner->GetMap() != player->GetMap() ||
+            !owner->HasAura(63802))
+            continue;
+        BrainLink link;
+        {
+            std::lock_guard<std::mutex> lock(brainLinkMutex);
+            auto const found = brainLinks.find(owner->GetGUID().GetRawValue());
+            // Wait for the native periodic spell to identify the partner before
+            // freezing a roster. The aura alone names only its owner.
+            if (found == brainLinks.end() || found->second.expires <= now ||
+                found->second.owner != owner->GetGUID() || found->second.instance != player->GetInstanceId())
+                return true;
+            link = found->second;
+        }
+        // Keep this endpoint upstairs until the core removes the owner's aura,
+        // including the tick after the owner enters. If both enter together the
+        // native floor check can miss the transition and retain the link below.
+        if (link.partner == player->GetGUID())
+            return true;
+    }
+    return false;
+}
+
 bool Enabled(PlayerbotAI* ai)
 {
     Player* bot = ai->GetBot();
@@ -78,9 +107,9 @@ std::map<std::pair<uint32, uint64>, Wave> waves;
 Creature* AssignedPortal(PlayerbotAI* ai, Creature* brain)
 {
     Player* bot = ai->GetBot();
-    // The native Brain Link aura ends when its endpoints change floors. A linked
-    // member can use a portal safely; excluding both endpoints freezes short teams.
-    if (Below(bot) || Sanity(bot) < YoggBrain::EnterSanity || bot->HasAura(63830))
+    // Permit the Brain Link owner, keeping its partner above for the native
+    // floor check. Excluding both endpoints freezes unnecessarily short teams.
+    if (Below(bot) || Sanity(bot) < YoggBrain::EnterSanity || PortalLinkBlocked(bot) || bot->HasAura(63830))
         return nullptr;
     Spell* cast = brain ? brain->GetCurrentSpell(CURRENT_GENERIC_SPELL) : nullptr;
     if (!cast || cast->GetSpellInfo()->Id != 64059 || cast->GetCastTimeRemaining() < 35000)
@@ -110,7 +139,7 @@ Creature* AssignedPortal(PlayerbotAI* ai, Creature* brain)
             bool const controlled = memberAI && !IsRealPlayer(member) && !IsSelfBot(member);
             bool const available = yogg && member->IsWithinDistInMap(yogg, 150.0f) && member->GetPositionZ() > 300.0f &&
                                    !member->GetVehicle() && !member->IsBeingTeleported() && !member->IsCharmed() &&
-                                   !member->HasAura(63830) &&
+                                   !PortalLinkBlocked(member) && !member->HasAura(63830) &&
                                    (!controlled || (!memberAI->HasStrategy("stay", BOT_STATE_COMBAT) &&
                                                     !memberAI->HasStrategy("stay", BOT_STATE_NON_COMBAT) &&
                                                     !memberAI->HasStrategy("passive", BOT_STATE_COMBAT)));
@@ -579,7 +608,7 @@ float YoggBrainMultiplier::GetValue(Action* action)
         if (assigned == wave->second.portals.end()) return 1.0f;
         Creature* portal = bot->GetMap()->GetCreature(assigned->second);
         return portal && portal->HasNpcFlag(UNIT_NPC_FLAG_SPELLCLICK) && Sanity(bot) >= YoggBrain::EnterSanity &&
-                       !bot->HasAura(63830)
+                       !PortalLinkBlocked(bot) && !bot->HasAura(63830)
                    ? 0.0f
                    : 1.0f;
     }
