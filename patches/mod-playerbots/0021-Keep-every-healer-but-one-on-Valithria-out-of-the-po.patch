+uint32 IccValithriaManaCooldown(Player* bot, PlayerbotAI* botAI, Unit*& target)
+{
+    target = nullptr;
+    // Cheapest checks first: the trigger asks every tick, and most bots are not low-mana healers.
+    if (!sPlayerbotAIConfig.ValithriaHealerFocus || bot->GetMapId() != 631 || !bot->IsAlive() ||
+        bot->getPowerType() != POWER_MANA || bot->GetPowerPct(POWER_MANA) >= 65.0f || !PlayerbotAI::IsHeal(bot) ||
+        bot->HasAura(SPELL_DREAM_STATE) || bot->IsNonMeleeSpellCast(false) ||
+        !bot->FindNearestCreature(NPC_VALITHRIA_DREAMWALKER, 100.0f))
+        return 0;
+    return RaidInteractions::PickManaCooldown(
+        ValithriaHealerKind(bot->getClass()), bot->GetPowerPct(POWER_MANA),
+        [&](uint32 spell)
+        {
+            if (!bot->HasSpell(spell) || bot->HasSpellCooldown(spell) || bot->HasAura(spell))
+                return false;
+            Unit* const candidate = spell == RaidInteractions::Shadowfiend ? ValithriaFiendTarget(bot, botAI) : bot;
+            if (!candidate || !botAI->CanCastSpell(spell, candidate, true))
+                return false;
+            target = candidate;
+            return true;
+        });
+}
