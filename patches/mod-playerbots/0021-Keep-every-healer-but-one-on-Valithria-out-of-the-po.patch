+// A Valithria healer's own mana cooldown, spent before it runs dry. Her heal outranks the stock class
+// triggers for these (Divine Plea at ACTION_HIGH, Mana Tide and Innervate at ACTION_HIGH + 5), so
+// without this they never fire while she is hurt. Each fires at the mana its payoff suits: Divine Plea
+// halves the paladin's heals for 15 s and returns 25% mana on a 1-minute cooldown, so early and often;
+// Hymn of Hope channels for 8 s, so last. Highest WotLK ranks.
+enum class HealerClass
+{
+    Other,
+    Paladin,
+    Priest,
+    Shaman,
+    Druid
+};
+
+inline constexpr std::uint32_t DivinePlea = 54428;
+inline constexpr std::uint32_t ManaTideTotem = 16190;
+inline constexpr std::uint32_t Innervate = 29166;
+inline constexpr std::uint32_t Shadowfiend = 34433;
+inline constexpr std::uint32_t HymnOfHope = 64901;
+
+struct ManaCooldown
+{
+    std::uint32_t spell;
+    float belowPct;
+};
+
+inline std::vector<ManaCooldown> ManaCooldowns(HealerClass healer)
+{
+    switch (healer)
+    {
+        case HealerClass::Paladin:
+            return {{DivinePlea, 65.0f}};
+        case HealerClass::Priest:
+            return {{Shadowfiend, 60.0f}, {HymnOfHope, 25.0f}};
+        case HealerClass::Shaman:
+            return {{ManaTideTotem, 50.0f}};
+        case HealerClass::Druid:
+            return {{Innervate, 50.0f}};
+        default:
+            return {};
+    }
+}
+
+// The first of this class's cooldowns whose mana threshold is crossed and that `ready` accepts, or 0.
+template <class Ready>
+std::uint32_t PickManaCooldown(HealerClass healer, float manaPct, Ready ready)
+{
+    for (ManaCooldown const& cooldown : ManaCooldowns(healer))
+        if (manaPct < cooldown.belowPct && ready(cooldown.spell))
+            return cooldown.spell;
+    return 0;
+}
