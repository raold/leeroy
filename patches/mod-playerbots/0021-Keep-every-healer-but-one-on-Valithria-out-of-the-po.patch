+    for (std::uint64_t count = 1; count <= 10; ++count)
+        for (std::uint32_t druids : {0u, 1u, 2u, (1u << count) - 1})
+        {
+            std::vector<Healer> roster;
+            for (std::uint64_t index = 0; index < count; ++index)
+                roster.push_back({201 + index, (druids & (1u << index)) != 0});
