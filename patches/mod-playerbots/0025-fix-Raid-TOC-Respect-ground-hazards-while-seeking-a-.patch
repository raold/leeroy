From 94973f556b6746ab75d679a4c313063351409b03 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 08:43:37 -0500
Subject: [PATCH 25/27] fix(Raid/TOC): Respect ground hazards while seeking a
 toxin cure

---
 src/Ai/Raid/TOC/TocStrategy.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/Ai/Raid/TOC/TocStrategy.cpp b/src/Ai/Raid/TOC/TocStrategy.cpp
index 1149e5ad..79552949 100644
--- a/src/Ai/Raid/TOC/TocStrategy.cpp
+++ b/src/Ai/Raid/TOC/TocStrategy.cpp
@@ -175,8 +175,10 @@ bool TocToxinCureAction::Execute(Event /*event*/)
     float const y =
         target->GetPositionY() + (bot->GetPositionY() - target->GetPositionY()) * BILE_CONTACT_RANGE / distance;
     bot->InterruptNonMeleeSpells(false);
+    // A cure must still respect Slime Pools. Forced movement bypasses the mechanic guard
+    // and makes its escape action yield, leaving a poisoned bot standing in another hazard.
     return MoveTo(bot->GetMapId(), x, y, target->GetPositionZ(), false, false, false, false,
-                  MovementPriority::MOVEMENT_FORCED, true);
+                  MovementPriority::MOVEMENT_COMBAT, true);
 }
 
 bool TocBileSpacingAction::Execute(Event /*event*/)
