From 84903cfb1a5da1f74623d47efe07bfc54bc19b95 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Thu, 26 Nov 2026 00:31:09 -0500
Subject: [PATCH 27/46] fix(Raid/TOC): Enable cured-worm support when shipped

---
 conf/playerbots.conf.dist | 4 ++--
 src/PlayerbotAIConfig.cpp | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/conf/playerbots.conf.dist b/conf/playerbots.conf.dist
index 4ab1d583..b120a645 100644
--- a/conf/playerbots.conf.dist
+++ b/conf/playerbots.conf.dist
@@ -504,9 +504,9 @@ Playerbots.ValithriaHealerFocus = 1
 Playerbots.ValithriaPortals = 1
 
 # Meet a Burning Bile carrier before Paralytic Toxin roots the victim, rescue
-# paralysed victims and separate carriers after the cure. Opt in after a dojo gate.
+# paralysed victims and separate carriers after the cure. Default: 1 (enabled).
 # Uses ordinary movement and the core's Bile effect; never removes an aura itself.
-Playerbots.TocWormSupport = 0
+Playerbots.TocWormSupport = 1
 
 # Opt-in Malygos drake positioning/rotation and human-led Flame Leviathan vehicles.
 # Uses normal boarding and spell costs; never moves the human or skips a boss.
diff --git a/src/PlayerbotAIConfig.cpp b/src/PlayerbotAIConfig.cpp
index f27a89da..88819e5a 100644
--- a/src/PlayerbotAIConfig.cpp
+++ b/src/PlayerbotAIConfig.cpp
@@ -314,7 +314,7 @@ bool PlayerbotAIConfig::Initialize()
     TwinValkyrInteractions = sConfigMgr->GetOption<bool>("Playerbots.TwinValkyrInteractions", false);
     ValithriaHealerFocus = sConfigMgr->GetOption<bool>("Playerbots.ValithriaHealerFocus", true);
     ValithriaPortals = sConfigMgr->GetOption<bool>("Playerbots.ValithriaPortals", true);
-    TocWormSupport = sConfigMgr->GetOption<bool>("Playerbots.TocWormSupport", false);
+    TocWormSupport = sConfigMgr->GetOption<bool>("Playerbots.TocWormSupport", true);
     RaidVehicleSupport = sConfigMgr->GetOption<bool>("Playerbots.RaidVehicleSupport", false);
     LichKingMechanics = sConfigMgr->GetOption<bool>("Playerbots.LichKingMechanics", false);
 
