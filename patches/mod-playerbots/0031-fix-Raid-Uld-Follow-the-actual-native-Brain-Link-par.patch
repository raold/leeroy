 using Clock = std::chrono::steady_clock;
+struct BrainLink
+{
+    ObjectGuid owner, partner;
+    uint32 instance;
+    Clock::time_point expires;
+};
+std::mutex brainLinkMutex;
+std::unordered_map<uint64, BrainLink> brainLinks;
+
+void PruneBrainLinks(Clock::time_point now)
+{
+    for (auto it = brainLinks.begin(); it != brainLinks.end();)
+        if (it->second.expires <= now)
+            it = brainLinks.erase(it);
+        else
+            ++it;
+}
