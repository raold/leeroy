+void ObserveYoggBrainLink(Player* owner, Spell* spell)
+{
+    if (!sPlayerbotAIConfig.YoggBrainSupport || !spell)
+        return;
+    uint32 const id = spell->GetSpellInfo()->Id;
+    if (id != 63803 && id != 63804)
+        return;
+    if (!owner || !owner->IsInWorld() || owner->GetMapId() != 603 || !owner->IsAlive() || !owner->HasAura(63802) ||
+        !owner->GetGroup())
+        return;
+    Unit* target = spell->m_targets.GetUnitTarget();
+    Player* partner = target ? target->ToPlayer() : nullptr;
+    auto* instance = owner->GetInstanceScript();
+    if (!partner || partner == owner || !partner->IsInWorld() || !partner->IsAlive() ||
+        partner->GetMap() != owner->GetMap() || partner->GetGroup() != owner->GetGroup() || !instance ||
+        instance->GetBossState(12) != IN_PROGRESS || Below(owner) || Below(partner))
+        return;
+    auto const now = Clock::now();
+    auto const ownerKey = owner->GetGUID().GetRawValue();
+    auto const partnerKey = partner->GetGUID().GetRawValue();
+    bool changed = false;
+    {
+        std::lock_guard<std::mutex> lock(brainLinkMutex);
+        PruneBrainLinks(now);
+        auto const it = brainLinks.find(ownerKey);
+        auto const missing = (it == brainLinks.end() ? 1 : 0) + (brainLinks.contains(partnerKey) ? 0 : 1);
+        if (brainLinks.size() + missing > 256)
+            return;
+        changed = it == brainLinks.end() || it->second.partner != partner->GetGUID();
+        BrainLink const link{owner->GetGUID(), partner->GetGUID(), owner->GetInstanceId(),
+                             now + std::chrono::seconds(3)};
+        brainLinks[ownerKey] = link;
+        brainLinks[partnerKey] = link;
+    }
+    if (changed)
+        LOG_INFO("playerbots", "yogg_brain link instance={} owner={} partner={} spell={}", owner->GetInstanceId(),
+                 owner->GetGUID().GetCounter(), partner->GetGUID().GetCounter(), id);
+}
+
+Player* YoggBrainLinkedPartner(Player* player)
+{
+    if (!sPlayerbotAIConfig.YoggBrainSupport || !player || !player->IsInWorld() || !player->IsAlive() ||
+        player->GetMapId() != 603 || !player->GetGroup() || player->GetVehicle() || player->IsBeingTeleported() ||
+        player->IsCharmed() || Below(player))
+        return nullptr;
+    auto* instance = player->GetInstanceScript();
+    if (!instance || instance->GetBossState(12) != IN_PROGRESS)
+        return nullptr;
+    BrainLink link;
+    {
+        std::lock_guard<std::mutex> lock(brainLinkMutex);
+        auto const it = brainLinks.find(player->GetGUID().GetRawValue());
+        if (it == brainLinks.end() || it->second.expires <= Clock::now() ||
+            it->second.instance != player->GetInstanceId())
+            return nullptr;
+        link = it->second;
+        // Both endpoints must still describe this pair. A new cast can replace
+        // a link; the old partner's cached entry must not follow the new pair.
+        for (auto const guid : {link.owner, link.partner})
+        {
+            auto const endpoint = brainLinks.find(guid.GetRawValue());
+            if (endpoint == brainLinks.end() || endpoint->second.owner != link.owner ||
+                endpoint->second.partner != link.partner || endpoint->second.instance != link.instance)
+                return nullptr;
+        }
+    }
+    auto* owner = ObjectAccessor::GetPlayer(*player, link.owner);
+    auto* partner = ObjectAccessor::GetPlayer(*player, link.partner);
+    if (!owner || !partner || !owner->IsAlive() || !partner->IsAlive() || !owner->HasAura(63802) ||
+        owner->GetMap() != player->GetMap() || partner->GetMap() != player->GetMap() ||
+        owner->GetGroup() != player->GetGroup() || partner->GetGroup() != player->GetGroup() ||
+        owner->IsBeingTeleported() || partner->IsBeingTeleported() || owner->IsCharmed() || partner->IsCharmed() ||
+        std::abs(owner->GetPositionZ() - partner->GetPositionZ()) > 10.0f || Below(owner) || Below(partner))
+        return nullptr;
+    return owner == player ? partner : owner;
+}
