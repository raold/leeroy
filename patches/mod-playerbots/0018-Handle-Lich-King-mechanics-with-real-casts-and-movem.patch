+#include "../src/Ai/Raid/LichKingMechanicsPolicy.h"
+#include <iostream>
+#include <limits>
+
+namespace
+{
+int checks = 0, failures = 0;
+void Check(bool result, int line)
+{
+    ++checks;
+    if (!result)
+    {
+        ++failures;
+        std::cerr << "Failed at line " << line << '\n';
+    }
+}
+}
+#define CHECK(expr) Check(static_cast<bool>(expr), __LINE__)
+
+int main()
+{
+    using namespace LichKingMechanics;
+    auto valid = [](Point) { return true; };
+    CHECK(Eligible(true, true, true, true, false, false, false, false));
+    CHECK(!Eligible(false, true, true, true, false, false, false, false));
+    CHECK(!Eligible(true, false, true, true, false, false, false, false));
+    CHECK(!Eligible(true, true, false, true, false, false, false, false));
+    CHECK(!Eligible(true, true, true, false, false, false, false, false));
+    CHECK(!Eligible(true, true, true, true, true, false, false, false));
+    CHECK(!Eligible(true, true, true, true, false, true, false, false));
+    CHECK(!Eligible(true, true, true, true, false, false, true, false));
+    CHECK(!Eligible(true, true, true, true, false, false, false, true));
+    // Both Execute and rescue allocation use this eligibility: excluded members consume no slot.
+    std::vector<bool> const available = {
+        Eligible(true, true, true, true, false, false, false, false),
+        Eligible(true, true, true, true, false, false, true, false),
+        Eligible(true, true, true, true, false, true, false, false),
+        Eligible(true, true, true, true, false, false, false, true),
+        Eligible(true, true, true, true, false, false, false, false)};
+    CHECK(std::count(available.begin(), available.end(), true) == 2);
+    CHECK(AcquireTarget(0, 10));
+    CHECK(AcquireTarget(10, 11));
+    CHECK(!AcquireTarget(10, 0));
+    unsigned acquired = 0, rotationTicks = 0;
+    std::uint64_t selected = 0;
+    for (unsigned tick = 0; tick < 50; ++tick)
+    {
+        if (AcquireTarget(selected, 10)) { selected = 10; ++acquired; }
+        else ++rotationTicks;
+    }
+    CHECK(acquired == 1);
+    CHECK(rotationTicks == 49); // Stable target must not consume every raid-priority tick.
+    CHECK(LocateRoom(false, true, true, Frostmourne, FrostmourneZ) == Room::None);
+    CHECK(LocateRoom(true, false, true, Frostmourne, FrostmourneZ) == Room::Normal);
+    CHECK(LocateRoom(true, true, true, Frostmourne, FrostmourneZ) == Room::Heroic);
+    CHECK(LocateRoom(true, false, false, Frostmourne, FrostmourneZ) == Room::Normal);
+    CHECK(LocateRoom(true, true, false, Frostmourne, FrostmourneZ) == Room::Heroic);
+    CHECK(LocateRoom(true, true, true, Platform, PlatformZ) == Room::Transit);
+    CHECK(LocateRoom(true, true, false, Platform, PlatformZ) == Room::None);
+    CHECK(LocateRoom(true, true, false, Frostmourne, PlatformZ) == Room::None);
+    CHECK(LocateRoom(true, false, false, {495.7f, -2400.0f}, FrostmourneZ) == Room::None);
+    for (Room room : {Room::None, Room::Transit, Room::Normal, Room::Heroic})
+    {
+        CHECK(ShouldHealTerenas(room, true, 50.0f) == (room == Room::Normal));
+        CHECK(!ShouldHealTerenas(room, false, 50.0f));
+        CHECK(!ShouldHealTerenas(room, true, 100.0f));
+    }
+    CHECK(RescueTarget(true, true, true));
+    CHECK(!RescueTarget(false, true, true));
+    CHECK(!RescueTarget(true, false, true)); // Heroic ejection ends rescue regardless of rounded HP.
+    CHECK(!RescueTarget(true, true, false));
+    CHECK(DefileRadius(1.0f) == 12.0f);
+    CHECK(DefileRadius(2.0f) == 22.0f);
+    CHECK(DefileRadius(0.5f) == 7.0f);
+    CHECK(DefileRadius(std::numeric_limits<float>::quiet_NaN()) == 12.0f);
+    CHECK(DefileRadius(-1.0f) == 12.0f);
+
+    std::vector<Hazard> puddles = {{{0, 0}, 5}};
+    CHECK(!SafeSegment({-10, 0}, {10, 0}, puddles)); // Safe endpoint across a lethal puddle.
+    CHECK(SafeSegment({-10, 6}, {10, 6}, puddles));
+    CHECK(!SafeSegment({2, 0}, {-8, 0}, puddles)); // Crossing the center to exit is worse.
+    CHECK(SafeSegment({2, 0}, {8, 0}, puddles));
+    CHECK(SafeSegment({0, 0}, {8, 0}, puddles));
+    CHECK(!SafeSegment({2, 0}, {3, 0}, puddles));
+    CHECK(SafeSegment({2, 0}, {3, 0}, puddles, false)); // Intermediate path vertex while exiting.
+    CHECK(!SafeSegment({3, 0}, {2, 0}, puddles, false));
+    CHECK(!SafeSegment({6, 0}, {3, 0}, puddles, false)); // A route cannot re-enter after escaping.
+    CHECK(!SafeSegment({2, 0}, {2, 0}, puddles));
+    puddles.push_back({{10, 0}, 4});
+    CHECK(!SafeSegment({2, 0}, {15, 0}, puddles)); // Escaping one must not enter another.
+    CHECK(SafeSegment({2, 0}, {2, 12}, puddles));
+
+    // Defile edge escapes must remain on the platform and clear the actual scaled radius.
+    for (unsigned n = 0; n < 32; ++n)
+    {
+        float const angle = n * 6.283185307f / 32;
+        Point const start = {Platform.x + 37 * std::cos(angle), Platform.y + 37 * std::sin(angle)};
+        std::vector<Hazard> const hazards = {{start, DefileRadius(1)}};
+        auto const escape = Escape(start, Platform, PlatformRadius, hazards, {}, false, valid);
+        CHECK(escape.has_value());
+        if (escape)
+        {
+            CHECK(Distance(*escape, Platform) <= PlatformRadius);
+            CHECK(!Threatened(*escape, hazards));
+            CHECK(SafeSegment(start, *escape, hazards));
+        }
+    }
+    auto const boxed = Escape({0, 0}, {0, 0}, 30, {{{0, 0}, 100}}, {}, false, valid);
+    CHECK(!boxed); // No unsafe fallback to the original destination.
+    CHECK(!Escape({0, 0}, {0, 0}, 30, {{{0, 0}, 5}}, {}, false, [](Point) { return false; }));
+    auto const grown = Escape(Platform, Platform, PlatformRadius,
+                               {{Platform, DefileRadius(3)}}, {}, false, valid);
+    CHECK(grown && Distance(*grown, Platform) >= 32 && Distance(*grown, Platform) <= PlatformRadius);
+    Point const edge = {Platform.x + 40, Platform.y};
+    auto const across = Escape(edge, Platform, PlatformRadius, {{edge, DefileRadius(6)}}, {}, false, valid);
+    CHECK(across && Distance(*across, edge) >= 62 && Distance(*across, Platform) <= PlatformRadius);
+    CHECK(EscapePathLimit >= MaxEscapeStep);
+    auto const roomEscape = Escape(Frostmourne, Frostmourne, RoomRadius,
+                                  {{Frostmourne, 12}}, {}, false, valid);
+    CHECK(roomEscape && Distance(*roomEscape, Frostmourne) < RoomRadius);
+    auto const drop = Escape({0, 0}, {0, 0}, 43, {}, {{0, 0}, {0, 1}, {1, 0}}, true, valid);
+    CHECK(drop && Distance(*drop, {0, 0}) >= 12);
+
+    std::cout << checks << " checks, " << failures << " failures\n";
+    return failures ? 1 : 0;
+}
