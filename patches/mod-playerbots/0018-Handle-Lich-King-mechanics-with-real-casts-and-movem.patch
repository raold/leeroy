+class IccLichKingMechanicsAction : public AttackAction
+{
+public:
+    IccLichKingMechanicsAction(PlayerbotAI* botAI) : AttackAction(botAI, "icc lich king mechanics") {}
+    bool Execute(Event event) override;
+    bool ShouldReactionInterruptCast() const override { return true; }
+    static bool Active(Player* player);
+    static LichKingMechanics::Room RoomFor(Player* player);
+    static bool Isolated(Player* player);
+    static IccLichKingMechanicsAction* For(PlayerbotAI* ai);
+    bool NeedsMovement();
+    bool OwnsTarget();
+    bool HasHazards();
+    bool SafeTarget(Unit* target);
+    bool SafeMove(Unit* target);
+
+private:
+    void Refresh(bool force = false);
+    bool MoveSafely();
+    bool CastKnown(std::initializer_list<char const*> spells, Unit* target, bool onlyMissing = false);
+    bool HealTerenas(Unit* target);
+    void Note(char const* code, bool success, uint32 entry = 0);
+    uint32 sampleMs = 0, noteMs = 0;
+    bool sampled = false, move = false, drop = false;
+    LichKingMechanics::Room room = LichKingMechanics::Room::None;
+    ObjectGuid priorityTarget, terenas;
+    std::vector<LichKingMechanics::Hazard> hazards;
+    std::vector<LichKingMechanics::Point> raid;
+};
