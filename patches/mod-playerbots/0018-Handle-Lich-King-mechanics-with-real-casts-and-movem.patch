diff --git a/src/Ai/Raid/LichKingMechanicsPolicy.h b/src/Ai/Raid/LichKingMechanicsPolicy.h
new file mode 100644
index 00000000..604ab9fc
--- /dev/null
+++ b/src/Ai/Raid/LichKingMechanicsPolicy.h
@@ -0,0 +1,147 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#ifndef PLAYERBOTS_LICHKINGMECHANICSPOLICY_H
+#define PLAYERBOTS_LICHKINGMECHANICSPOLICY_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace LichKingMechanics
+{
+struct Point
+{
+    float x, y;
+};
+struct Hazard
+{
+    Point center;
+    float radius;
+};
+inline constexpr Point Platform = {503.62f, -2124.65f};
+inline constexpr Point Frostmourne = {495.708f, -2523.76f};
+inline constexpr float PlatformZ = 840.857f;
+inline constexpr float FrostmourneZ = 1049.95f;
+inline constexpr float PlatformRadius = 43.0f; // Stay inside the central platform after Quake.
+inline constexpr float RoomRadius = 35.0f;
+inline constexpr unsigned MaxEscapeStep = 88; // Across the whole 86-yard central platform.
+inline constexpr float EscapePathLimit = 96.0f;
+
+inline bool Eligible(bool enabled, bool alive, bool inWorld, bool botAI, bool realPlayer, bool selfBot,
+                     bool stay, bool passive)
+{
+    return enabled && alive && inWorld && botAI && !realPlayer && !selfBot && !stay && !passive;
+}
+
+inline bool AcquireTarget(std::uint64_t current, std::uint64_t wanted)
+{
+    // AttackAction can report success repeatedly (for example while a ranged
+    // attacker has no auto-attack victim). Let the ordinary rotation own the next tick.
+    return wanted && current != wanted;
+}
+
+inline float Distance(Point a, Point b) { return std::hypot(a.x - b.x, a.y - b.y); }
+
+enum class Room { None, Transit, Normal, Heroic };
+inline Room LocateRoom(bool active, bool heroic, bool teleportAura, Point p, float z)
+{
+    if (!active)
+        return Room::None;
+    // Position covers the brief aura removal/arrival interval too. Never follow an outside tank.
+    if (Distance(p, Frostmourne) < 45.0f && std::abs(z - FrostmourneZ) < 15.0f)
+        return heroic ? Room::Heroic : Room::Normal;
+    return teleportAura ? Room::Transit : Room::None;
+}
+
+inline float DefileRadius(float scale)
+{
+    // boss_the_lich_king.cpp: spell_the_lich_king_defile::CorrectRange.
+    return std::isfinite(scale) && scale > 0.0f ? 10.0f * scale + 2.0f : 12.0f;
+}
+
+inline bool Contains(Hazard const& hazard, Point p) { return Distance(hazard.center, p) < hazard.radius; }
+inline bool Threatened(Point p, std::vector<Hazard> const& hazards)
+{
+    return std::any_of(hazards.begin(), hazards.end(), [&](Hazard const& h) { return Contains(h, p); });
+}
+
+// A segment may leave a hazard it already occupies, but must move monotonically away
+// from that hazard and never cross another one. Checking just the destination is unsafe.
+inline bool SafeSegment(Point start, Point end, std::vector<Hazard> const& hazards, bool requireExit = true)
+{
+    float const dx = end.x - start.x, dy = end.y - start.y;
+    float const length2 = dx * dx + dy * dy;
+    if (length2 < 0.01f)
+        return false;
+    for (Hazard const& h : hazards)
+    {
+        if (Contains(h, end) && (requireExit || !Contains(h, start)))
+            return false;
+        float const sx = start.x - h.center.x, sy = start.y - h.center.y;
+        float const projection = sx * dx + sy * dy;
+        if (Contains(h, start))
+        {
+            if (projection < -0.01f)
+                return false;
+        }
+        else
+        {
+            float const t = std::clamp(-projection / length2, 0.0f, 1.0f);
+            if (Contains(h, {start.x + t * dx, start.y + t * dy}))
+                return false;
+        }
+    }
+    return true;
+}
+
+// Return no route when boxed in; never fall back to a known unsafe destination.
+// valid() supplies map height/LOS validation without coupling this policy to the core.
+template <class Valid>
+std::optional<Point> Escape(Point start, Point center, float boundary, std::vector<Hazard> const& hazards,
+                            std::vector<Point> const& raid, bool dropDefile, Valid valid)
+{
+    std::optional<Point> best;
+    float score = -1e30f;
+    for (unsigned distance = 4; distance <= MaxEscapeStep; distance += 4)
+        for (unsigned i = 0; i < 32; ++i)
+        {
+            float const step = static_cast<float>(distance);
+            float const angle = float(i) * 6.283185307f / 32.0f;
+            Point const p = {start.x + step * std::cos(angle), start.y + step * std::sin(angle)};
+            if (Distance(p, center) > boundary || !SafeSegment(start, p, hazards))
+                continue;
+            float clearance = 20.0f;
+            for (Hazard const& h : hazards)
+                clearance = std::min(clearance, Distance(p, h.center) - h.radius);
+            float separation = 20.0f;
+            for (Point member : raid)
+                separation = std::min(separation, Distance(p, member));
+            // Short escape beats long wandering; a Defile target chooses space away from the raid.
+            float const value = std::min(clearance, 5.0f) - step * 0.7f +
+                                (dropDefile ? separation * 2.0f + Distance(p, center) * 0.15f : 0.0f);
+            if (value > score && valid(p))
+            {
+                best = p;
+                score = value;
+            }
+        }
+    return best;
+}
+
+inline bool RescueTarget(bool alive, bool passenger, bool attackable)
+{
+    // The core ejects the passenger below 50% on heroic; do not infer the carry from rounded health.
+    return alive && passenger && attackable;
+}
+
+inline bool ShouldHealTerenas(Room room, bool healer, float healthPct)
+{
+    return room == Room::Normal && healer && healthPct < 95.0f;
+}
+} // namespace LichKingMechanics
+#endif
