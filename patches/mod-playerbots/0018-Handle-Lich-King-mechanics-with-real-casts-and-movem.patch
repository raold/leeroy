+#include "ICCActions.h"
+#include "InstanceScript.h"
+#include "Log.h"
+#include "PathGenerator.h"
+#include "Spell.h"
+#include "SpellMgr.h"
+
+namespace
+{
+using namespace LichKingMechanics;
+constexpr uint32 Encounter = 12;
+constexpr uint32 TerenasNormal = 36823, SpiritWarden = 36824, TerenasHeroic = 39217;
+constexpr uint32 Defile = 38757, Valkyr = 36609, Vile = 37799, Wicked = 39190, Bomb = 39189;
+constexpr uint32 NormalTeleport = 72546, HeroicTeleport = 73655, SoulRip = 69397;
+
+Point XY(WorldObject const* object) { return {object->GetPositionX(), object->GetPositionY()}; }
+bool Heroic(Player* player)
+{
+    Difficulty const difficulty = player->GetMap()->GetDifficulty();
+    return difficulty == RAID_DIFFICULTY_10MAN_HEROIC || difficulty == RAID_DIFFICULTY_25MAN_HEROIC;
+}
+bool InRoom(Unit* unit)
+{
+    return Distance(XY(unit), Frostmourne) < 45.0f && std::abs(unit->GetPositionZ() - FrostmourneZ) < 35.0f;
+}
+}
+
+bool IccLichKingMechanicsAction::Active(Player* player)
+{
+    if (!sPlayerbotAIConfig.LichKingMechanics || !player || !player->IsInWorld() || player->GetMapId() != 631)
+        return false;
+    PlayerbotAI* ai = GET_PLAYERBOT_AI(player);
+    bool const stay = ai && (ai->HasStrategy("stay", BOT_STATE_COMBAT) || ai->HasStrategy("stay", BOT_STATE_NON_COMBAT));
+    bool const passive = ai && ai->HasStrategy("passive", BOT_STATE_COMBAT);
+    if (!Eligible(true, player->IsAlive(), player->IsInWorld(), ai != nullptr, IsRealPlayer(player), IsSelfBot(player),
+                  stay, passive))
+        return false;
+    InstanceScript* instance = player->GetInstanceScript();
+    return instance && instance->GetBossState(Encounter) == IN_PROGRESS;
+}
+
+LichKingMechanics::Room IccLichKingMechanicsAction::RoomFor(Player* player)
+{
+    if (!Active(player))
+        return Room::None;
+    return LocateRoom(true, Heroic(player), player->HasAura(NormalTeleport) || player->HasAura(HeroicTeleport),
+                      XY(player), player->GetPositionZ());
+}
+
+bool IccLichKingMechanicsAction::Isolated(Player* player)
+{
+    return Active(player) && (RoomFor(player) != Room::None || player->GetVehicleBase());
+}
+
+IccLichKingMechanicsAction* IccLichKingMechanicsAction::For(PlayerbotAI* ai)
+{
+    return dynamic_cast<IccLichKingMechanicsAction*>(ai->GetAiObjectContext()->GetAction("icc lich king mechanics"));
+}
+
+void IccLichKingMechanicsAction::Refresh(bool force)
+{
+    uint32 const now = getMSTime();
+    if (!force && sampled && getMSTimeDiff(sampleMs, now) < 200)
+        return;
+    sampled = true;
+    sampleMs = now;
+    hazards.clear();
+    raid.clear();
+    priorityTarget.Clear();
+    terenas.Clear();
+    move = drop = false;
+    room = RoomFor(bot);
+    if (!Active(bot) || bot->GetVehicleBase() || room == Room::Transit)
+        return;
+    bool const inside = room == Room::Normal || room == Room::Heroic;
+    if (!inside && std::abs(bot->GetPositionZ() - PlatformZ) > 8.0f)
+        return;
+
+    if (Group* group = bot->GetGroup())
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (member && member != bot && member->IsAlive() && member->IsInWorld() &&
+                member->GetMap() == bot->GetMap() && std::abs(member->GetPositionZ() - bot->GetPositionZ()) < 8.0f)
+                raid.push_back(XY(member));
+        }
+
+    // Include unselectable bombs/puddles: "nearest hostile npcs" omits those.
+    std::vector<Creature*> const creatures = inside ?
+        IccGetCreaturesByEntries(bot, {TerenasNormal, TerenasHeroic, SpiritWarden, Wicked, Bomb}, 90.0f) :
+        IccGetCreaturesByEntries(bot, {Defile, Valkyr, Vile}, 100.0f);
+    std::vector<Creature*> carriers;
+    Creature* spirit = nullptr;
+    float spiritDistance = 10000.0f;
+    for (Creature* creature : creatures)
+    {
+        if (!creature || !creature->IsAlive() || InRoom(creature) != inside)
+            continue;
+        uint32 const entry = creature->GetEntry(); // Core retains the normal entry on all four difficulties.
+        if ((room == Room::Normal && entry == TerenasNormal) || (room == Room::Heroic && entry == TerenasHeroic))
+            terenas = creature->GetGUID();
+        if (room == Room::Normal && entry == SpiritWarden && bot->IsValidAttackTarget(creature))
+            priorityTarget = creature->GetGUID();
+        if (!inside && entry == Defile && std::abs(creature->GetPositionZ() - bot->GetPositionZ()) < 6.0f)
+            hazards.push_back({XY(creature), DefileRadius(creature->GetObjectScale())});
+        if (room == Room::Heroic && entry == Bomb && creature->GetPositionZ() - bot->GetPositionZ() < 18.0f)
+            hazards.push_back({XY(creature), 14.0f});
+        if ((!inside && entry == Vile) || (room == Room::Heroic && entry == Wicked))
+        {
+            if (!bot->IsValidAttackTarget(creature))
+                continue;
+            // Airborne spirits can be shot. Only approaching, low spirits threaten a collision.
+            if (std::abs(creature->GetPositionZ() - bot->GetPositionZ()) < 8.0f)
+                hazards.push_back({XY(creature), 10.0f});
+            float const distance = bot->GetExactDist(creature);
+            if (distance < spiritDistance && PlayerbotAI::IsRanged(bot) && !PlayerbotAI::IsHeal(bot) &&
+                !PlayerbotAI::IsMainTank(bot))
+            {
+                spirit = creature;
+                spiritDistance = distance;
+            }
+        }
+        if (!inside && entry == Valkyr && RescueTarget(creature->IsAlive(),
+                creature->GetVehicleKit() && creature->GetVehicleKit()->GetPassenger(0),
+                bot->IsValidAttackTarget(creature)))
+            carriers.push_back(creature);
+    }
+
+    if (!inside)
+    {
+        auto const& cast = IcecrownHelpers::IccState(bot->GetInstanceId()).defileCast;
+        drop = cast.targetGuid == bot->GetGUID() && getMSTimeDiff(cast.castTime, now) < 3000;
+        if (!carriers.empty() && !PlayerbotAI::IsHeal(bot) && !PlayerbotAI::IsMainTank(bot))
+        {
+            // Deterministic split among available DPS/OT bots; healers/dead/outside members don't consume slots.
+            std::sort(carriers.begin(), carriers.end(), [](Creature* a, Creature* b) { return a->GetGUID() < b->GetGUID(); });
+            std::vector<ObjectGuid> rescuers;
+            if (Group* group = bot->GetGroup())
+                for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                {
+                    Player* member = ref->GetSource();
+                    if (Active(member) &&
+                        member->GetMap() == bot->GetMap() && !member->GetVehicleBase() &&
+                        !PlayerbotAI::IsHeal(member) && !PlayerbotAI::IsMainTank(member) &&
+                        std::abs(member->GetPositionZ() - PlatformZ) < 8.0f)
+                        rescuers.push_back(member->GetGUID());
+                }
+            std::sort(rescuers.begin(), rescuers.end());
+            auto const found = std::find(rescuers.begin(), rescuers.end(), bot->GetGUID());
+            std::size_t const slot = found == rescuers.end() ? 0 : static_cast<std::size_t>(found - rescuers.begin());
+            priorityTarget = carriers[slot % carriers.size()]->GetGUID();
+        }
+    }
+    if (priorityTarget.IsEmpty() && spirit)
+        priorityTarget = spirit->GetGUID();
+    move = drop || Threatened(XY(bot), hazards);
+}
+
+bool IccLichKingMechanicsAction::NeedsMovement() { Refresh(); return move; }
+bool IccLichKingMechanicsAction::OwnsTarget() { Refresh(); return !priorityTarget.IsEmpty(); }
+bool IccLichKingMechanicsAction::HasHazards() { Refresh(); return !hazards.empty(); }
+
+bool IccLichKingMechanicsAction::SafeTarget(Unit* target)
+{
+    if (!target || target == bot)
+        return true;
+    Refresh();
+    if (!priorityTarget.IsEmpty() && bot->IsValidAttackTarget(target) && target->GetGUID() != priorityTarget)
+        return false;
+    Room const current = RoomFor(bot);
+    return target->GetMap() == bot->GetMap() &&
+           (current == Room::Normal || current == Room::Heroic ? InRoom(target) : !InRoom(target));
+}
+
+bool IccLichKingMechanicsAction::SafeMove(Unit* target)
+{
+    Refresh();
+    if (!target || !SafeTarget(target))
+        return false;
+    bool const inside = room == Room::Normal || room == Room::Heroic;
+    return std::abs(target->GetPositionZ() - bot->GetPositionZ()) < 8.0f &&
+           Distance(XY(target), inside ? Frostmourne : Platform) < (inside ? RoomRadius : PlatformRadius) &&
+           SafeSegment(XY(bot), XY(target), hazards);
+}
+
+void IccLichKingMechanicsAction::Note(char const* code, bool success, uint32 entry)
+{
+    uint32 const now = getMSTime();
+    if (noteMs && getMSTimeDiff(noteMs, now) < 5000)
+        return;
+    noteMs = now;
+    LOG_INFO("playerbots", "lk_mechanic instance={} bot={} room={} code={} ok={} entry={}",
+             bot->GetInstanceId(), bot->GetGUID().GetCounter(), uint32(room), code, success, entry);
+}
+
+bool IccLichKingMechanicsAction::MoveSafely()
+{
+    bool const inside = room == Room::Heroic || room == Room::Normal;
+    auto const destination = Escape(XY(bot), inside ? Frostmourne : Platform, inside ? RoomRadius : PlatformRadius,
+        hazards, raid, drop, [&](Point p)
+        {
+            float z = bot->GetPositionZ();
+            bot->UpdateAllowedPositionZ(p.x, p.y, z);
+            if (std::abs(z - bot->GetPositionZ()) >= 3.0f || !bot->IsWithinLOS(p.x, p.y, z))
+                return false;
+            PathGenerator path(bot);
+            path.SetPathLengthLimit(EscapePathLimit);
+            if (!path.CalculatePath(p.x, p.y, z) || path.GetPathType() != PATHFIND_NORMAL)
+                return false;
+            Point previous = XY(bot);
+            for (auto const& vertex : path.GetPath())
+            {
+                Point const next = {vertex.x, vertex.y};
+                Point const center = inside ? Frostmourne : Platform;
+                if (Distance(next, center) > std::max(inside ? RoomRadius : PlatformRadius,
+                                                     Distance(previous, center)) + 0.1f ||
+                    std::abs(vertex.z - bot->GetPositionZ()) >= 3.0f)
+                    return false;
+                if (Distance(previous, next) > 0.1f && !SafeSegment(previous, next, hazards, false))
+                    return false;
+                previous = next;
+            }
+            return true;
+        });
+    if (!destination)
+    {
+        Note("no_safe_path", false);
+        bot->StopMoving();
+        return false;
+    }
+    float z = bot->GetPositionZ();
+    bot->UpdateAllowedPositionZ(destination->x, destination->y, z);
+    bot->CastStop();
+    bool const moved = MoveTo(bot->GetMapId(), destination->x, destination->y, z, false, false, true, true,
+                              MovementPriority::MOVEMENT_FORCED, true);
+    Note(drop ? "defile_drop" : (inside ? "frostmourne_dodge" : "platform_dodge"), moved);
+    return moved;
+}
+
+bool IccLichKingMechanicsAction::CastKnown(std::initializer_list<char const*> spells, Unit* target, bool onlyMissing)
+{
+    for (char const* name : spells)
+    {
+        uint32 const spell = context->GetValue<uint32>("spell id", name)->Get();
+        SpellInfo const* info = sSpellMgr->GetSpellInfo(spell);
+        if (!spell || !info || !bot->HasSpell(spell) || (onlyMissing && target->HasAura(spell)) ||
+            (info->PowerType < MAX_POWERS && info->CalcPowerCost(bot, info->GetSchoolMask()) >
+                static_cast<int32>(bot->GetPower(static_cast<Powers>(info->PowerType)))) || !botAI->CanCastSpell(spell, target, true))
+            continue;
+        if (botAI->CastSpell(spell, target))
+            return true;
+    }
+    return false;
+}
+
+bool IccLichKingMechanicsAction::HealTerenas(Unit* target)
+{
+    if (!target || !target->IsAlive() || !ShouldHealTerenas(room, PlayerbotAI::IsHeal(bot), target->GetHealthPct()))
+        return false;
+    if (!bot->IsWithinLOSInMap(target) || !bot->IsWithinDistInMap(target, 30.0f))
+        return SafeMove(target) && MoveNear(target, 25.0f, MovementPriority::MOVEMENT_COMBAT);
+    if (bot->isMoving())
+        bot->StopMoving();
+    bool const cast = CastKnown({"holy light", "healing wave", "greater heal", "nourish", "healing touch",
+                                "flash of light", "lesser healing wave", "flash heal", "regrowth"}, target);
+    Note("terenas_heal", cast, target->GetEntry());
+    return cast;
+}
+
+bool IccLichKingMechanicsAction::Execute(Event /*event*/)
+{
+    if (!Active(bot))
+        return false;
+    Refresh(true);
+    if (bot->GetVehicleBase() || room == Room::Transit)
+        return false; // The encounter owns transport and release; never teleport/eject the victim.
+    Unit* current = AI_VALUE(Unit*, "current target");
+    if (current && !SafeTarget(current))
+    {
+        bot->AttackStop();
+        context->GetValue<Unit*>("current target")->Set(nullptr);
+        bot->SetSelection(ObjectGuid::Empty);
+    }
+    if (move)
+        return MoveSafely();
+    Unit* target = priorityTarget.IsEmpty() ? nullptr : botAI->GetUnit(priorityTarget);
+    if (target && target->GetEntry() == SpiritWarden)
+    {
+        Spell* cast = target->GetCurrentSpell(CURRENT_CHANNELED_SPELL);
+        if (!cast)
+            cast = target->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+        if (cast && cast->GetSpellInfo()->Id == sSpellMgr->GetSpellIdForDifficulty(SoulRip, target) &&
+            CastKnown({"kick", "pummel", "shield bash", "mind freeze", "wind shear", "counterspell",
+                       "silence", "strangulate", "hammer of justice", "bash", "maim"}, target))
+        {
+            Note("soul_rip_interrupt", true, SpiritWarden);
+            return true;
+        }
+    }
+    if (HealTerenas(terenas.IsEmpty() ? nullptr : botAI->GetUnit(terenas)))
+        return true;
+    if (!target || !target->IsAlive() || !bot->IsValidAttackTarget(target) || !SafeTarget(target))
+        return false;
+    if (target->GetEntry() == Valkyr && CastKnown({"hammer of justice", "concussion blow", "shockwave",
+            "kidney shot", "bash", "maim", "shadowfury", "chains of ice", "hamstring", "frost shock",
+            "concussive shot", "slow", "curse of exhaustion"}, target, true))
+    {
+        Note("valkyr_cc", true, Valkyr);
+        return true;
+    }
+    Unit* selected = AI_VALUE(Unit*, "current target");
+    if (!AcquireTarget(selected ? selected->GetGUID().GetRawValue() : 0, target->GetGUID().GetRawValue()))
+        return false;
+    bool const attacked = Attack(target); // Acquire once, then yield to the ordinary rotation.
+    if (attacked)
+        Note(target->GetEntry() == Valkyr ? "valkyr_rescue" : "spirit_attack", true, target->GetEntry());
+    return attacked;
+}
