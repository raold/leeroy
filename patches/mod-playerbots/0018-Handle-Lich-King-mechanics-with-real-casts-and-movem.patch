+float IccLichKingMechanicsMultiplier::GetValue(Action* action)
+{
+    if (!action || !IccLichKingMechanicsAction::Active(bot))
+        return 1.0f;
+    if (dynamic_cast<IccLichKingMechanicsAction*>(action))
+        return 1.0f;
+    auto const room = IccLichKingMechanicsAction::RoomFor(bot);
+    if (bot->GetVehicleBase() || room == LichKingMechanics::Room::Transit)
+        return 0.0f;
+    auto* mechanics = IccLichKingMechanicsAction::For(botAI);
+    if (!mechanics)
+        return 0.0f;
+    // The emergency move owns this tick, including when no safe route was found.
+    if (mechanics->NeedsMovement())
+        return dynamic_cast<SetFacingTargetAction*>(action) ? 1.0f : 0.0f;
+    bool const inside = room != LichKingMechanics::Room::None;
+    if (inside && (dynamic_cast<IccLichKingAddsAction*>(action) ||
+                   dynamic_cast<IccLichKingWinterAction*>(action) ||
+                   dynamic_cast<IccLichKingShadowTrapAction*>(action) ||
+                   dynamic_cast<IccLichKingNecroticPlagueAction*>(action) ||
+                   dynamic_cast<IccLichKingSpiritBombAction*>(action)))
+        return 0.0f;
+    bool const occupied = inside || mechanics->OwnsTarget() || mechanics->HasHazards();
+    if (occupied && (dynamic_cast<IccLichKingAddsAction*>(action) || dynamic_cast<DpsAssistAction*>(action) ||
+                     dynamic_cast<TankAssistAction*>(action) || dynamic_cast<AttackRtiTargetAction*>(action) ||
+                     dynamic_cast<FollowAction*>(action) || dynamic_cast<CombatFormationMoveAction*>(action) ||
+                     dynamic_cast<FleeAction*>(action) || dynamic_cast<MoveRandomAction*>(action) ||
+                     dynamic_cast<CastBlinkBackAction*>(action) || dynamic_cast<CastDisengageAction*>(action) ||
+                     dynamic_cast<CastChargeAction*>(action) || dynamic_cast<CastFeralChargeBearAction*>(action)))
+        return 0.0f;
+    Unit* target = action->GetTarget();
+    if (!mechanics->SafeTarget(target))
+        return 0.0f;
+    if (occupied && dynamic_cast<MovementAction*>(action) && !mechanics->SafeMove(target))
+        return 0.0f;
+    // Class healing and damage remain available, including warlocks and melee in the heroic room.
+    return 1.0f;
+}
+
 float IccLichKingAddsMultiplier::GetValue(Action* action)
 {
+    if (IccLichKingMechanicsAction::Isolated(bot) ||
+        (IccLichKingMechanicsAction::Active(bot) && dynamic_cast<IccLichKingMechanicsAction*>(action)))
+        return 1.0f;
