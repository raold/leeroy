From dfac609c0506e334fcf3e11c66d4ea82a7e4f357 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 09:32:22 -0500
Subject: [PATCH 30/46] fix(Raid/Uld): Aim moving weapons and honor the Ram
 cone range

---
 src/Ai/Raid/Uld/UldActions.cpp | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/Ai/Raid/Uld/UldActions.cpp b/src/Ai/Raid/Uld/UldActions.cpp
index 096093f3..20fea91b 100644
--- a/src/Ai/Raid/Uld/UldActions.cpp
+++ b/src/Ai/Raid/Uld/UldActions.cpp
@@ -21,6 +21,8 @@
 #include "RtiValue.h"
 #include "ScriptedCreature.h"
 #include "ServerFacade.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
 #include "TankAssistStrategy.h"
 #include "UldBossHelper.h"
 #include "UldScripts.h"
@@ -42,7 +44,13 @@ bool CastLeviathanSpell(PlayerbotAI* ai, uint32 spell, Unit* target)
         // cast until the next tick can repeat forever while a driver is kiting.
         // Execute's seat checks exclude passive passengers in a human's vehicle.
         if (seat && (seat->CanControl() || (seat->m_flags & VEHICLE_SEAT_FLAG_ALLOW_TURNING)))
-            vehicle->GetBase()->SetFacingToObject(target);
+        {
+            // Unit::SetFacingToObject deliberately does nothing while moving.
+            // Face this instant weapon without replacing the driver's spline.
+            Unit* base = vehicle->GetBase();
+            base->SetOrientation(base->GetAngle(target));
+            base->SendMovementFlagUpdate();
+        }
     }
     return ai->CastVehicleSpell(spell, target);
 }
@@ -293,6 +301,15 @@ bool FlameLeviathanVehicleAction::SiegeEngineAction(Unit* target)
             }
     }
     uint32 spellId = 62345;
+    if (sPlayerbotAIConfig.RaidVehicleSupport)
+    {
+        // Ram is an area cone. CheckCast accepts an explicit target outside
+        // that cone's radius; spending energy there cannot damage it. Match
+        // the core cone range check (radius plus the target's object size).
+        auto const* info = sSpellMgr->GetSpellInfo(spellId);
+        if (!info || !target->IsWithinDist3d(vehicleBase_, info->Effects[EFFECT_0].CalcRadius(vehicleBase_)))
+            return false;
+    }
     if (vehicleBase_->GetPower(POWER_ENERGY) >= (sPlayerbotAIConfig.RaidVehicleSupport ? 60 : 80) &&
         botAI->CanCastVehicleSpell(spellId, target))
         if (CastLeviathanSpell(botAI, spellId, target))
