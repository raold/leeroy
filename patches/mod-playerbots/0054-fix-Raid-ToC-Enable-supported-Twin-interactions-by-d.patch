From da4fab0c733e7a3e207310493cdc3d3ed640c298 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Thu, 26 Nov 2026 05:50:53 -0500
Subject: [PATCH 54/63] fix(Raid/ToC): Enable supported Twin interactions by
 default

---
 conf/playerbots.conf.dist | 7 ++++---
 src/PlayerbotAIConfig.cpp | 2 +-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/conf/playerbots.conf.dist b/conf/playerbots.conf.dist
index 27a0f06c..e76af3ea 100644
--- a/conf/playerbots.conf.dist
+++ b/conf/playerbots.conf.dist
@@ -486,9 +486,10 @@ Playerbots.DropObsoleteQuests = 1
 Playerbots.ApplyInstanceStrategies = 1
 
 # Trial of the Crusader: take an essence and swap colour for Twin Val'kyr vortexes/touches.
-# Uses the real essence NPC's gossip within reach; never grants a spell or encounter credit.
-# Requires ApplyInstanceStrategies (or the toc strategy added explicitly). Default: 0.
-Playerbots.TwinValkyrInteractions = 0
+# Uses the real essence NPC's spell-click, or gossip on older cores, within reach.
+# Never grants a spell or encounter credit. Requires ApplyInstanceStrategies (or toc explicitly).
+# Set to 0 to disable the interactions. Default: 1.
+Playerbots.TwinValkyrInteractions = 1
 
 # Icecrown Citadel, Valithria Dreamwalker: every healer but one heals her (the one left keeps the
 # raid up and tops her up while the raid is healthy), healers who do not portal stay at her side and
diff --git a/src/PlayerbotAIConfig.cpp b/src/PlayerbotAIConfig.cpp
index 9cd3e0c0..04aab3e1 100644
--- a/src/PlayerbotAIConfig.cpp
+++ b/src/PlayerbotAIConfig.cpp
@@ -311,7 +311,7 @@ bool PlayerbotAIConfig::Initialize()
     //////////////////////////// ICC
 
     EnableICCBuffs = sConfigMgr->GetOption<bool>("Playerbots.EnableICCBuffs", true);
-    TwinValkyrInteractions = sConfigMgr->GetOption<bool>("Playerbots.TwinValkyrInteractions", false);
+    TwinValkyrInteractions = sConfigMgr->GetOption<bool>("Playerbots.TwinValkyrInteractions", true);
     ValithriaHealerFocus = sConfigMgr->GetOption<bool>("Playerbots.ValithriaHealerFocus", true);
     ValithriaPortals = sConfigMgr->GetOption<bool>("Playerbots.ValithriaPortals", true);
     ValithriaAdds = sConfigMgr->GetOption<bool>("Playerbots.ValithriaAdds", true);
