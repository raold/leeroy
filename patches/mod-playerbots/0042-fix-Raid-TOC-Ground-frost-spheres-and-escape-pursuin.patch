+bool AnubarakActive(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    if (!bot->IsInWorld() || bot->GetMapId() != MAP_TRIAL_OF_THE_CRUSADER || !bot->IsAlive() || IsRealPlayer(bot) ||
+        IsSelfBot(bot) || !bot->GetGroup() || !bot->GetGroup()->isRaidGroup() || bot->IsBeingTeleported() ||
+        bot->IsCharmed() || bot->GetVehicle() || bot->GetTransport() || WormHeld(ai))
+        return false;
+    auto* instance = bot->GetInstanceScript();
+    return instance && instance->GetBossState(BOSS_ANUBARAK) == IN_PROGRESS;
+}
+
+Creature* ThreateningSpike(PlayerbotAI* ai)
+{
+    if (!AnubarakActive(ai))
+        return nullptr;
+    Player* bot = ai->GetBot();
+    std::list<Creature*> spikes;
+    bot->GetCreatureListWithEntryInGrid(spikes, NPC_PURSUING_SPIKE, ANUB_SEARCH_RANGE);
+    Creature* chosen = nullptr;
+    for (Creature* spike : spikes)
+        if (spike->IsAlive() && spike->InSamePhase(bot) && spike->HasAura(SPELL_SPIKE_TRAIL) &&
+            std::abs(spike->GetPositionZ() - bot->GetPositionZ()) < 4.0f &&
+            (spike->GetVictim() == bot || bot->IsWithinDistInMap(spike, SPIKE_SEPARATION)) &&
+            (!chosen || bot->GetExactDist2d(spike) < bot->GetExactDist2d(chosen)))
+            chosen = spike;
+    return chosen;
+}
+
+Creature* FrostSphere(PlayerbotAI* ai)
+{
+    if (!AnubarakActive(ai))
+        return nullptr;
+    Player* bot = ai->GetBot();
+    if (PlayerbotAI::IsTank(bot) || PlayerbotAI::IsHeal(bot) || PlayerbotAI::IsMelee(bot) ||
+        bot->HasAura(SPELL_SPIKE_MARK))
+        return nullptr;
+    for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        PlayerbotAI* memberAI = member ? GET_PLAYERBOT_AI(member) : nullptr;
+        if (memberAI && member->GetGUID() < bot->GetGUID() && member->GetMap() == bot->GetMap() &&
+            AnubarakActive(memberAI) && !PlayerbotAI::IsTank(member) && !PlayerbotAI::IsHeal(member) &&
+            !PlayerbotAI::IsMelee(member) && !member->HasAura(SPELL_SPIKE_MARK))
+            return nullptr;
+    }
+    std::list<Creature*> spheres;
+    bot->GetCreatureListWithEntryInGrid(spheres, NPC_FROST_SPHERE, ANUB_SEARCH_RANGE);
+    unsigned grounded = 0;
+    Creature* chosen = nullptr;
+    for (Creature* sphere : spheres)
+    {
+        if (!sphere->IsAlive() || !sphere->InSamePhase(bot))
+            continue;
+        if (sphere->HasAura(SPELL_PERMAFROST_VISUAL))
+            ++grounded;
+        else if (bot->IsValidAttackTarget(sphere) &&
+                 (!chosen || bot->GetExactDist2d(sphere) < bot->GetExactDist2d(chosen)))
+            chosen = sphere;
+    }
+    // Retain a spare patch when the pursued spike consumes the first one.
+    return grounded < 2 ? chosen : nullptr;
+}
+
+bool CompleteRoute(Player* bot, Position const& point, Creature* spike = nullptr)
+{
+    PathGenerator path(bot);
+    path.SetPathLengthLimit(200.0f);
+    if (!path.CalculatePath(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ()) ||
+        path.GetPathType() != PATHFIND_NORMAL)
+        return false;
+    if (spike)
+    {
+        auto const& points = path.GetPath();
+        float const clearance = std::min(8.0f, bot->GetExactDist2d(spike) - 0.5f);
+        for (std::size_t i = 1; i < points.size(); ++i)
+        {
+            float const dx = points[i].x - points[i - 1].x;
+            float const dy = points[i].y - points[i - 1].y;
+            float const sx = spike->GetPositionX() - points[i - 1].x;
+            float const sy = spike->GetPositionY() - points[i - 1].y;
+            float const lengthSq = dx * dx + dy * dy;
+            float const fraction = lengthSq > 0.0f ? std::clamp((sx * dx + sy * dy) / lengthSq, 0.0f, 1.0f) : 0.0f;
+            if (std::hypot(sx - fraction * dx, sy - fraction * dy) < clearance)
+                return false;
+        }
+    }
+    return true;
+}
+
+class TocAnubarakMultiplier : public Multiplier
+{
+public:
+    TocAnubarakMultiplier(PlayerbotAI* ai) : Multiplier(ai, "toc anubarak") {}
+
+    float GetValue(Action* action) override
+    {
+        if (!action || !AnubarakActive(botAI) || dynamic_cast<TocSpikeEscapeAction*>(action))
+            return 1.0f;
+        auto* escape = dynamic_cast<TocSpikeEscapeAction*>(context->GetAction("toc spike escape"));
+        if (escape && escape->Escaping())
+            return 0.0f;
+        Unit* target = context->GetValue<Unit*>("current target")->Get();
+        if (target && target->GetEntry() == NPC_FROST_SPHERE && bot->IsValidAttackTarget(target) &&
+            dynamic_cast<MovementAction*>(action) && !dynamic_cast<TocFrostSphereAction*>(action))
+            return 0.0f;
+        return 1.0f;
+    }
+};
