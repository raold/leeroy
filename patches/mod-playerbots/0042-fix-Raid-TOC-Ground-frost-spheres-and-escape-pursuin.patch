+bool TocSpikeEscapeAction::isUseful() { return ThreateningSpike(botAI) != nullptr; }
+
+bool TocSpikeEscapeAction::Escaping() const { return _lastEscape && GetMSTimeDiffToNow(_lastEscape) < 1500; }
+
+bool TocSpikeEscapeAction::Execute(Event /*event*/)
+{
+    Creature* spike = ThreateningSpike(botAI);
+    if (!spike || !botAI->CanMove())
+        return false;
+    std::vector<Position> destinations;
+    if (bot->HasAura(SPELL_SPIKE_MARK))
+    {
+        std::list<Creature*> spheres;
+        bot->GetCreatureListWithEntryInGrid(spheres, NPC_FROST_SPHERE, ANUB_SEARCH_RANGE);
+        spheres.sort([this](Creature* a, Creature* b) { return bot->GetExactDist2d(a) < bot->GetExactDist2d(b); });
+        for (Creature* sphere : spheres)
+        {
+            if (!sphere->IsAlive() || !sphere->InSamePhase(bot) || !sphere->HasAura(SPELL_PERMAFROST_VISUAL))
+                continue;
+            float const angle = spike->GetAngle(sphere);
+            float const x = sphere->GetPositionX() + 6.0f * std::cos(angle);
+            float const y = sphere->GetPositionY() + 6.0f * std::sin(angle);
+            float z = bot->GetPositionZ();
+            bot->UpdateAllowedPositionZ(x, y, z);
+            destinations.emplace_back(x, y, z);
+        }
+    }
+    float const away = spike->GetAngle(bot);
+    for (float offset : {0.0f, 0.5f, -0.5f, 1.0f, -1.0f})
+    {
+        float const x = bot->GetPositionX() + SPIKE_SEPARATION * std::cos(away + offset);
+        float const y = bot->GetPositionY() + SPIKE_SEPARATION * std::sin(away + offset);
+        float z = bot->GetPositionZ();
+        bot->UpdateAllowedPositionZ(x, y, z);
+        destinations.emplace_back(x, y, z);
+    }
+    for (Position const& point : destinations)
+    {
+        // Check every navmesh leg, including corners, against the pursuing spike.
+        if (bot->GetExactDist2d(point) < 1.0f || std::abs(point.GetPositionZ() - bot->GetPositionZ()) > 4.0f ||
+            !CompleteRoute(bot, point, spike))
+            continue;
+        bot->InterruptNonMeleeSpells(false);
+        bot->AttackStop();
+        bool const moving = MoveTo(bot->GetMapId(), point.GetPositionX(), point.GetPositionY(), point.GetPositionZ(),
+                                   false, false, false, false, MovementPriority::MOVEMENT_FORCED);
+        if (moving)
+            _lastEscape = getMSTime();
+        return moving;
+    }
+    return false;
+}
+
+bool TocFrostSphereAction::isUseful()
+{
+    Creature* sphere = FrostSphere(botAI);
+    return sphere && (context->GetValue<Unit*>("current target")->Get() != sphere || bot->GetDistance(sphere) > 25.0f ||
+                      !bot->IsWithinLOSInMap(sphere));
+}
+
+bool TocFrostSphereAction::Execute(Event /*event*/)
+{
+    Creature* sphere = FrostSphere(botAI);
+    if (!sphere)
+        return false;
+    if (bot->GetDistance(sphere) > 25.0f || !bot->IsWithinLOSInMap(sphere))
+    {
+        float const angle = sphere->GetAngle(bot);
+        float const x = sphere->GetPositionX() + 18.0f * std::cos(angle);
+        float const y = sphere->GetPositionY() + 18.0f * std::sin(angle);
+        float z = bot->GetPositionZ();
+        bot->UpdateAllowedPositionZ(x, y, z);
+        Position const point(x, y, z);
+        if (std::abs(z - bot->GetPositionZ()) > 4.0f || !CompleteRoute(bot, point))
+            return false;
+        return MoveTo(bot->GetMapId(), x, y, z, false, false, false, false, MovementPriority::MOVEMENT_COMBAT);
+    }
+    return Attack(sphere);
 }
 
 bool TocEssenceTrigger::IsActive() { return NeededEssence(botAI) != Colour::None; }
