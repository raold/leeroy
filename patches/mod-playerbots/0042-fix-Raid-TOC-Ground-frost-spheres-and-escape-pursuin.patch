+constexpr uint32 BOSS_ANUBARAK = 4;
+constexpr uint32 NPC_FROST_SPHERE = 34606;
+constexpr uint32 NPC_PURSUING_SPIKE = 34660;
+constexpr uint32 SPELL_SPIKE_MARK = 67574;
+constexpr uint32 SPELL_SPIKE_TRAIL = 65921;
+constexpr uint32 SPELL_PERMAFROST_VISUAL = 65882;
