From b08fdb9761d46b5ad6fc607a83350593de192120 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Thu, 26 Nov 2026 21:20:41 -0500
Subject: [PATCH 58/58] fix(Raids/Yogg): Stop safe approaches before attacking

---
 src/Ai/Raid/Uld/YoggBrainActions.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/Ai/Raid/Uld/YoggBrainActions.cpp b/src/Ai/Raid/Uld/YoggBrainActions.cpp
index 7af18aa6..6c6432fa 100644
--- a/src/Ai/Raid/Uld/YoggBrainActions.cpp
+++ b/src/Ai/Raid/Uld/YoggBrainActions.cpp
@@ -503,9 +503,8 @@ Plan Decide(PlayerbotAI* ai)
     plan.mode = Mode::Fight;
     float const range = PlayerbotAI::IsMelee(bot) ? 3.0f : 25.0f;
     plan.needsAction = ai->GetAiObjectContext()->GetValue<Unit*>("current target")->Get() != plan.target ||
-        bot->GetVictim() != plan.target ||
-        !bot->IsWithinLOSInMap(plan.target) || bot->GetDistance(plan.target) > range ||
-        !bot->HasInArc(1.0f, plan.target);
+                       bot->GetVictim() != plan.target || !bot->IsWithinLOSInMap(plan.target) ||
+                       bot->GetDistance(plan.target) > range || !bot->HasInArc(1.0f, plan.target) || bot->isMoving();
     return plan;
 }
 void Stop(PlayerbotAI* ai)
@@ -798,6 +797,9 @@ bool YoggBrainAction::Execute(Event /*event*/)
                 return Walk(ULDUAR_YOGG_SARON_BRAIN_ROOM_MIDDLE);
             return walkToAttack(plan.target);
         }
+        // Our approach uses forced movement, which Attack deliberately preserves.
+        // Once a safe target is in range, end that approach so normal casts can start.
+        bot->StopMoving();
         bot->SetFacingToObject(plan.target);
         return Attack(plan.target);
     }
