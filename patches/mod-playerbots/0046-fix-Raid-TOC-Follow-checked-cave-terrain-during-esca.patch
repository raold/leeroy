+bool MoveAnubRoute(PlayerbotAI* ai, Movement::PointsArray& route, MovementPriority priority)
+{
+    Player* bot = ai->GetBot();
+    if (route.size() < 2 || !bot->CanFreeMove() || !ai->CanMove() || bot->HasUnitFlag(UNIT_FLAG_DISABLE_MOVE))
+        return false;
+    auto const& goal = route.back();
+    auto& last = ai->GetAiObjectContext()->GetValue<LastMovement&>("last movement")->Get();
+    if ((last.msTime + sPlayerbotAIConfig.MaxWaitForMove >= getMSTime() &&
+         last.lastMoveShort.GetExactDist(goal.x, goal.y, goal.z) <= 0.01f) ||
+        (priority <= last.priority && last.lastdelayTime + last.msTime > getMSTime()))
+        return false;
+    if (priority != MovementPriority::MOVEMENT_FORCED)
+        if (auto* guard = PlayerbotMechanicGuard::Get();
+            guard && guard->Active() && guard->MechanicRefuses(bot, goal.x, goal.y, goal.z))
+            return false;
+    float const speed = bot->GetSpeed(MOVE_RUN);
+    if (speed <= 0.0f)
+        return false;
+    if (bot->IsSitState())
+        bot->SetStandState(UNIT_STAND_STATE_STAND);
+    float length = 0.0f;
+    for (std::size_t i = 1; i < route.size(); ++i)
+        length += (route[i] - route[i - 1]).length();
+    bot->GetMotionMaster()->Clear();
+    // The generator copies the checked points and follows their terrain heights.
+    bot->GetMotionMaster()->MoveSplinePath(&route, FORCED_MOVEMENT_RUN);
+    if (bot->movespline->Finalized())
+        return false;
+    float const delay = std::min(float(sPlayerbotAIConfig.MaxWaitForMove), 1000.0f * length / speed);
+    last.Set(bot->GetMapId(), goal.x, goal.y, goal.z, bot->GetOrientation(), delay, priority);
+    return true;
+}
