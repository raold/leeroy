 }
 
+Creature* YoggBrainAction::PortalRescue()
+{
+    if (!bot->GetGroup() || Below(bot))
+        return nullptr;
+    uint32 const now = getMSTime();
+    // Triggers and rotation multipliers share this bounded, cached team lookup.
+    if (_rescueInstance != bot->GetInstanceId() || !_rescueChecked || getMSTimeDiff(_rescueChecked, now) >= 250)
+    {
+        _rescueInstance = bot->GetInstanceId();
+        _rescueChecked = now;
+        _rescueTarget.Clear();
+        std::vector<uint64> members;
+        {
+            auto const key = std::make_pair(bot->GetInstanceId(), bot->GetGroup()->GetGUID().GetRawValue());
+            std::lock_guard<std::mutex> lock(waveMutex);
+            auto const wave = waves.find(key);
+            if (wave != waves.end() && wave->second.expires > Clock::now())
+                for (auto const& [member, portal] : wave->second.portals)
+                    members.push_back(member);
+        }
+        float distance = 150.0f;
+        for (uint64 member : members)
+        {
+            Player* player = ObjectAccessor::FindConnectedPlayer(ObjectGuid(member));
+            if (!player || !player->IsInWorld() || !player->IsAlive() || player->GetMap() != bot->GetMap() ||
+                player->GetGroup() != bot->GetGroup())
+                continue;
+            Unit* vehicle = player->GetVehicleBase();
+            if (!vehicle || vehicle->GetEntry() != NPC_CONSTRICTOR_TENTACLE || !vehicle->IsAlive() ||
+                !bot->IsValidAttackTarget(vehicle))
+                continue;
+            float const candidateDistance = bot->GetExactDist(vehicle);
+            if (candidateDistance < distance)
+            {
+                distance = candidateDistance;
+                _rescueTarget = vehicle->GetGUID();
+            }
+        }
+    }
+    Creature* target = _rescueTarget ? bot->GetMap()->GetCreature(_rescueTarget) : nullptr;
+    return target && target->IsAlive() && bot->IsValidAttackTarget(target) ? target : nullptr;
+}
