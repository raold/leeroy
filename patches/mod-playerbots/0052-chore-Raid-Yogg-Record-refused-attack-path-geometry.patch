From 5f340cc48bdee70e41485b84a875155161ea771c Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Thu, 26 Nov 2026 04:38:20 -0500
Subject: [PATCH 52/63] chore(Raid/Yogg): Record refused attack path geometry

---
 src/Ai/Raid/Uld/YoggBrainActions.cpp | 39 +++++++++++++++++++++++-----
 1 file changed, 33 insertions(+), 6 deletions(-)

diff --git a/src/Ai/Raid/Uld/YoggBrainActions.cpp b/src/Ai/Raid/Uld/YoggBrainActions.cpp
index f059cc46..dc52232f 100644
--- a/src/Ai/Raid/Uld/YoggBrainActions.cpp
+++ b/src/Ai/Raid/Uld/YoggBrainActions.cpp
@@ -239,7 +239,18 @@ std::vector<float> GazesAt(Player* bot, std::vector<GazeSource> const& sources,
 }
 std::vector<float> Gazes(Player* bot, bool below) { return GazesAt(bot, Sources(bot, below), bot->GetPosition()); }
 
-bool AttackPoint(Player* bot, Unit* target, unsigned illusion, Position& best, bool requirePath = false)
+struct AttackRouteProbe
+{
+    unsigned candidates = 0;
+    unsigned paths = 0;
+    unsigned pathType = 0;
+    unsigned pathPoints = 0;
+    Position point;
+    Position endpoint;
+};
+
+bool AttackPoint(Player* bot, Unit* target, unsigned illusion, Position& best, bool requirePath = false,
+                 AttackRouteProbe* probe = nullptr)
 {
     if (illusion < 1 || illusion > 3) return false;
     auto const sources = Sources(bot, true);
@@ -273,13 +284,23 @@ bool AttackPoint(Player* bot, Unit* target, unsigned illusion, Position& best, b
         }
     if (requirePath)
     {
+        if (probe)
+            probe->candidates = candidates.size();
         std::sort(candidates.begin(), candidates.end(), [](auto const& a, auto const& b) { return a.first < b.first; });
         for (auto const& [travel, point] : candidates)
         {
             PathGenerator path(bot);
             path.SetPathLengthLimit(250.0f);
-            if (path.CalculatePath(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ()) &&
-                path.GetPathType() == PATHFIND_NORMAL)
+            bool const calculated = path.CalculatePath(point.GetPositionX(), point.GetPositionY(), point.GetPositionZ());
+            if (probe && ++probe->paths == 1)
+            {
+                probe->pathType = unsigned(path.GetPathType());
+                probe->pathPoints = path.GetPath().size();
+                probe->point = point;
+                auto const& endpoint = path.GetActualEndPosition();
+                probe->endpoint.Relocate(endpoint.x, endpoint.y, endpoint.z);
+            }
+            if (calculated && path.GetPathType() == PATHFIND_NORMAL)
             {
                 best = point;
                 return true;
@@ -611,18 +632,24 @@ bool YoggBrainAction::Execute(Event /*event*/)
         Creature* brain = bot->GetInstanceScript()->GetCreature(761);
         unsigned const illusion = brain && brain->IsAIEnabled ? brain->AI()->GetData(2) : 0;
         Position point;
+        AttackRouteProbe probe;
         // Check routes only when executing movement, not while evaluating the
         // trigger. A clear firing angle alone can select an unreachable point.
-        if (!AttackPoint(bot, target, illusion, point, true))
+        if (!AttackPoint(bot, target, illusion, point, true, &probe))
         {
             _influenceRoutes.Refused(bot->GetInstanceId(), target->GetGUID().GetRawValue(), getMSTime());
             ClaimInfluence(bot, nullptr);
             if (!lastPathLog || GetMSTimeDiffToNow(lastPathLog) >= 10000)
             {
                 lastPathLog = getMSTime();
-                LOG_WARN("playerbots", "yogg_brain attack_route_refused instance={} bot={} target={} entry={}",
+                LOG_WARN("playerbots", "yogg_brain attack_route_refused instance={} bot={} target={} entry={}"
+                         " candidates={} paths={} path={} points={} start_x={} start_y={} start_z={}"
+                         " goal_x={} goal_y={} goal_z={} end_x={} end_y={} end_z={}",
                          bot->GetInstanceId(), bot->GetGUID().GetCounter(), target->GetGUID().GetCounter(),
-                         target->GetEntry());
+                         target->GetEntry(), probe.candidates, probe.paths, probe.pathType, probe.pathPoints,
+                         bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ(),
+                         probe.point.GetPositionX(), probe.point.GetPositionY(), probe.point.GetPositionZ(),
+                         probe.endpoint.GetPositionX(), probe.endpoint.GetPositionY(), probe.endpoint.GetPositionZ());
             }
             return false;
         }
