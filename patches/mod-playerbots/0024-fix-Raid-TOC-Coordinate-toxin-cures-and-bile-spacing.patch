diff --git a/tests/toc_worm_test.cpp b/tests/toc_worm_test.cpp
new file mode 100644
index 00000000..38a9dff1
--- /dev/null
+++ b/tests/toc_worm_test.cpp
@@ -0,0 +1,54 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+#include <iostream>
+
+#include "../src/Ai/Raid/TOC/TocWormPolicy.h"
+
+int main()
+{
+    using namespace TocWorms;
+    int failures = 0;
+    auto check = [&](bool value)
+    {
+        if (!value)
+            ++failures;
+    };
+    Member tank{1, 0, 0, true, true, false, true, false};
+    Member victim{2, 40, 0, true, false, true, false, false};
+    std::vector<Member> group{tank, victim};
+    check(Contact(victim, group) == tank.guid);  // Observed 40-yard separation must not wait for paralysis.
+    check(Contact(tank, group) == 0);
+    check(Avoid(victim, group) == 0);  // The cure deliberately enters Bile's radius.
+    victim.rooted = true;
+    group[1] = victim;
+    check(Contact(victim, group) == 0);
+    check(Contact(tank, group) == victim.guid);
+    Member healer{3, 80, 0, true, false, false, true, false};
+    group.push_back(healer);
+    check(Contact(tank, group) == 0);  // Prefer a mobile non-tank carrier to moving the worm.
+    check(Contact(healer, group) == victim.guid);
+    group[2].bot = false;
+    check(Contact(tank, group) == victim.guid);  // Never elect a human to execute a bot rescue.
+    group[2].rooted = true;
+    check(Contact(tank, group) == victim.guid);
+    group[2].x = 500;
+    check(Contact(tank, group) == victim.guid);
+    victim.rooted = victim.toxin = false;
+    victim.x = 7;
+    group = {tank, victim};
+    check(Contact(victim, group) == 0);
+    check(Avoid(victim, group) == tank.guid);  // After the real cure, leave the damaging radius.
+    victim.x = 13;
+    check(Avoid(victim, group) == 0);
+    healer.x = 2;
+    group = {tank, healer};
+    check(Avoid(tank, group) == 0);
+    check(Avoid(healer, group) == tank.guid);
+    std::reverse(group.begin(), group.end());
+    check(Avoid(tank, group) == 0 && Avoid(healer, group) == tank.guid);
+    std::cout << "ToC worm policy failures: " << failures << '\n';
+    return failures ? 1 : 0;
+}
