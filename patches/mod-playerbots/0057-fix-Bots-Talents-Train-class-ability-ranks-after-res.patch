From 3e589ad9d7971b08a51a8bed6e6737e2faee57f5 Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Thu, 26 Nov 2026 19:57:46 -0500
Subject: [PATCH 57/63] fix(Bots/Talents): Train class ability ranks after
 respec

---
 src/Bot/Factory/PlayerbotFactory.cpp | 45 ++++++++++++++++++----------
 src/Bot/Factory/PlayerbotFactory.h   |  2 +-
 2 files changed, 30 insertions(+), 17 deletions(-)

diff --git a/src/Bot/Factory/PlayerbotFactory.cpp b/src/Bot/Factory/PlayerbotFactory.cpp
index 634226c6..fef933d1 100644
--- a/src/Bot/Factory/PlayerbotFactory.cpp
+++ b/src/Bot/Factory/PlayerbotFactory.cpp
@@ -42,6 +42,7 @@
 #include "Trainer.h"
 #include "World.h"
 #include <array>
+#include <mutex>
 #include <unordered_set>
 #include <utility>
 
@@ -50,6 +51,8 @@
 
 namespace
 {
+    std::mutex trainerIdCacheMutex;
+
     // WotLK Eternal Belt Buckle mechanics
     constexpr uint32 ITEM_ETERNAL_BELT_BUCKLE = 41611;  // Eternal Belt Buckle (consumable)
     constexpr uint32 ENCHANT_SOCKET_BELT = 3729;        // "Socket Belt" -> adds 1 prismatic socket
@@ -1886,6 +1889,8 @@ void PlayerbotFactory::InitTalentsBySpecNo(Player* bot, int specNo, bool reset)
         bot->SetCanDualWield(true);
     }
 
+    // Talent abilities start at rank one; train their level-appropriate ranks after the new spec is installed.
+    PlayerbotFactory(bot, bot->GetLevel()).InitAvailableSpells(true);
     bot->SendTalentsInfoData(false);
     sRandomPlayerbotMgr.SetValue(bot->GetGUID().GetCounter(), "specNo", (uint32)specNo + 1);
 }
@@ -1951,6 +1956,7 @@ void PlayerbotFactory::InitTalentsByParsedSpecLink(Player* bot, std::vector<std:
             break;
         }
     }
+    PlayerbotFactory(bot, bot->GetLevel()).InitAvailableSpells(true);
     bot->SendTalentsInfoData(false);
 }
 
@@ -3563,33 +3569,40 @@ void PlayerbotFactory::SetRandomSkill(uint16 id)
     bot->SetSkill(id, step, value, maxValue);
 }
 
-void PlayerbotFactory::InitAvailableSpells()
+void PlayerbotFactory::InitAvailableSpells(bool classOnly)
 {
-    if (trainerIdCache[bot->getClass()].empty())
+    std::vector<uint32> trainerIds;
     {
-        CreatureTemplateContainer const* creatureTemplateContainer = sObjectMgr->GetCreatureTemplates();
-        for (CreatureTemplateContainer::const_iterator i = creatureTemplateContainer->begin();
-             i != creatureTemplateContainer->end(); ++i)
+        std::lock_guard<std::mutex> lock(trainerIdCacheMutex);
+        auto& cached = trainerIdCache[bot->getClass()];
+        if (cached.empty())
         {
-            Trainer::Trainer* trainer = sObjectMgr->GetTrainer(i->first);
+            CreatureTemplateContainer const* creatureTemplateContainer = sObjectMgr->GetCreatureTemplates();
+            for (auto const& [entry, creature] : *creatureTemplateContainer)
+            {
+                Trainer::Trainer* trainer = sObjectMgr->GetTrainer(entry);
 
-            if (!trainer)
-                continue;
+                if (!trainer)
+                    continue;
 
-            if (trainer->GetTrainerType() != Trainer::Type::Tradeskill &&
-                trainer->GetTrainerType() != Trainer::Type::Class)
-                continue;
+                if (trainer->GetTrainerType() != Trainer::Type::Tradeskill &&
+                    trainer->GetTrainerType() != Trainer::Type::Class)
+                    continue;
 
-            if (trainer->GetTrainerType() == Trainer::Type::Class &&
-                !trainer->IsTrainerValidForPlayer(bot))
-                continue;
+                if (trainer->GetTrainerType() == Trainer::Type::Class && !trainer->IsTrainerValidForPlayer(bot))
+                    continue;
 
-            trainerIdCache[bot->getClass()].push_back(i->first);
+                cached.push_back(entry);
+            }
         }
+        trainerIds = cached;
     }
-    for (uint32 trainerId : trainerIdCache[bot->getClass()])
+    // Release the shared cache before learning spells or invoking player callbacks.
+    for (uint32 trainerId : trainerIds)
     {
         Trainer::Trainer* trainer = sObjectMgr->GetTrainer(trainerId);
+        if (!trainer || (classOnly && trainer->GetTrainerType() != Trainer::Type::Class))
+            continue;
 
         for (auto& spell : trainer->GetSpells())
         {
diff --git a/src/Bot/Factory/PlayerbotFactory.h b/src/Bot/Factory/PlayerbotFactory.h
index 34f01518..a7d4f993 100644
--- a/src/Bot/Factory/PlayerbotFactory.h
+++ b/src/Bot/Factory/PlayerbotFactory.h
@@ -72,7 +72,7 @@ public:
     uint32 InitTalentsTree(bool incremental = false, bool use_template = true, bool reset = false);
     static void InitTalentsBySpecNo(Player* bot, int specNo, bool reset);
     static void InitTalentsByParsedSpecLink(Player* bot, std::vector<std::vector<uint32>> parsedSpecLink, bool reset);
-    void InitAvailableSpells();
+    void InitAvailableSpells(bool classOnly = false);
     static bool IsTrainerSpellAllowedForBot(Player* bot, Trainer::Trainer const* trainer,
                                              Trainer::Spell const* trainerSpell);
     void InitClassSpells();
