diff --git a/src/Ai/Raid/TOC/TocStrategy.cpp b/src/Ai/Raid/TOC/TocStrategy.cpp
index 51c61271..2659e05a 100644
--- a/src/Ai/Raid/TOC/TocStrategy.cpp
+++ b/src/Ai/Raid/TOC/TocStrategy.cpp
@@ -8,6 +8,7 @@
 #include <cmath>
 
 #include "Creature.h"
+#include "DisableMgr.h"
 #include "Group.h"
 #include "InstanceScript.h"
 #include "Map.h"
@@ -184,6 +185,47 @@ struct TocRouteProbe
     Position actual;
 };
 
+bool AnubCollisionRoute(Player* bot, Position const& point)
+{
+    // The core deliberately disables mmap tiles for all of map 649 (including
+    // the unsupported upper arena floor). Do not treat its shortcut as a path.
+    // In Anub's lower chamber only, prove a short, level walking segment with
+    // the core's static/dynamic collision and ground checks at one-yard steps.
+    auto* instance = bot->GetInstanceScript();
+    float const length = bot->GetExactDist2d(point);
+    if (bot->GetMapId() != MAP_TRIAL_OF_THE_CRUSADER || !instance ||
+        instance->GetBossState(BOSS_ANUBARAK) != IN_PROGRESS || DisableMgr::IsPathfindingEnabled(bot->GetMap()) ||
+        !bot->GetMap()->GetMapCollisionData().GetStaticTreeSharedPtr() || !std::isfinite(length) || length <= 0.0f ||
+        length > ANUB_SEARCH_RANGE || bot->GetPositionZ() < 130.0f || bot->GetPositionZ() > 160.0f ||
+        point.GetPositionZ() < 130.0f || point.GetPositionZ() > 160.0f)
+        return false;
+    unsigned const steps = unsigned(std::ceil(length));
+    float const dx = point.GetPositionX() - bot->GetPositionX();
+    float const dy = point.GetPositionY() - bot->GetPositionY();
+    float const dz = point.GetPositionZ() - bot->GetPositionZ();
+    float const radius = bot->GetObjectSize();
+    for (float side : {-radius, 0.0f, radius})
+    {
+        Position previous(bot->GetPositionX() - side * dy / length, bot->GetPositionY() + side * dx / length,
+                          bot->GetPositionZ());
+        for (unsigned step = 1; step <= steps; ++step)
+        {
+            float const fraction = float(step) / float(steps);
+            float const expectedX = bot->GetPositionX() + fraction * dx - side * dy / length;
+            float const expectedY = bot->GetPositionY() + fraction * dy + side * dx / length;
+            float const expectedZ = bot->GetPositionZ() + fraction * dz;
+            float x = expectedX, y = expectedY, z = expectedZ;
+            if (!bot->GetMap()->CheckCollisionAndGetValidCoords(bot, previous.GetPositionX(), previous.GetPositionY(),
+                                                                previous.GetPositionZ(), x, y, z, true) ||
+                std::hypot(x - expectedX, y - expectedY) > 0.1f || std::abs(z - expectedZ) > 0.5f ||
+                std::abs(z - previous.GetPositionZ()) > 0.75f)
+                return false;
+            previous.Relocate(x, y, z);
+        }
+    }
+    return true;
+}
+
 bool CompleteRoute(Player* bot, Position const& point, Creature* spike = nullptr, TocRouteProbe* probe = nullptr)
 {
     PathGenerator path(bot);
@@ -198,7 +240,9 @@ bool CompleteRoute(Player* bot, Position const& point, Creature* spike = nullptr
         probe->actual.Relocate(end.x, end.y, end.z);
         probe->blocked = false;
     }
-    if (!calculated || path.GetPathType() != PATHFIND_NORMAL)
+    if (!calculated ||
+        (path.GetPathType() != PATHFIND_NORMAL &&
+         (path.GetPathType() != (PATHFIND_NORMAL | PATHFIND_NOT_USING_PATH) || !AnubCollisionRoute(bot, point))))
         return false;
     if (spike)
     {
