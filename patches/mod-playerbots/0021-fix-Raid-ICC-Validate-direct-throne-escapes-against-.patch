From af6365980135b98fbf8bae984e57d6ade887686f Mon Sep 17 00:00:00 2001
From: raold <868138+raold@users.noreply.github.com>
Date: Wed, 25 Nov 2026 08:55:09 -0500
Subject: [PATCH 21/21] fix(Raid/ICC): Validate direct throne escapes against
 actual ground

---
 .../ICC/Action/ICCActions_LKMechanics.cpp     | 12 +++++++++++-
 src/Ai/Raid/LichKingMechanicsPolicy.h         | 19 +++++++++++++++++++
 tests/lich_king_mechanics_test.cpp            | 15 +++++++++++++++
 3 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/src/Ai/Raid/ICC/Action/ICCActions_LKMechanics.cpp b/src/Ai/Raid/ICC/Action/ICCActions_LKMechanics.cpp
index 850fbf24..42f8b5a5 100644
--- a/src/Ai/Raid/ICC/Action/ICCActions_LKMechanics.cpp
+++ b/src/Ai/Raid/ICC/Action/ICCActions_LKMechanics.cpp
@@ -210,7 +210,14 @@ bool IccLichKingMechanicsAction::MoveSafely()
                 return false;
             PathGenerator path(bot);
             path.SetPathLengthLimit(EscapePathLimit);
-            if (!path.CalculatePath(p.x, p.y, z) || path.GetPathType() != PATHFIND_NORMAL)
+            if (!path.CalculatePath(p.x, p.y, z))
+                return false;
+            // The native throne floor can have no navmesh polygon. Accept its
+            // direct route only with ground support on every one-yard leg below.
+            // Incomplete/shortcut/far-from-poly paths and room fallbacks stay refused.
+            bool const platformDirect = !inside &&
+                path.GetPathType() == (PATHFIND_NORMAL | PATHFIND_NOT_USING_PATH);
+            if (path.GetPathType() != PATHFIND_NORMAL && !platformDirect)
                 return false;
             Point previous = XY(bot);
             for (auto const& vertex : path.GetPath())
@@ -223,6 +230,9 @@ bool IccLichKingMechanicsAction::MoveSafely()
                     return false;
                 if (Distance(previous, next) > 0.1f && !SafeSegment(previous, next, hazards, false))
                     return false;
+                if (platformDirect && !SupportedGroundSegment(previous, next, bot->GetPositionZ(), [&](Point ground)
+                    { return bot->GetMapHeight(ground.x, ground.y, bot->GetPositionZ() + 2.0f); }))
+                    return false;
                 previous = next;
             }
             return true;
diff --git a/src/Ai/Raid/LichKingMechanicsPolicy.h b/src/Ai/Raid/LichKingMechanicsPolicy.h
index 604ab9fc..fc2ae18c 100644
--- a/src/Ai/Raid/LichKingMechanicsPolicy.h
+++ b/src/Ai/Raid/LichKingMechanicsPolicy.h
@@ -47,6 +47,25 @@ inline bool AcquireTarget(std::uint64_t current, std::uint64_t wanted)
 
 inline float Distance(Point a, Point b) { return std::hypot(a.x - b.x, a.y - b.y); }
 
+// A direct path on the throne's dynamic floor needs continuous ground support,
+// not just a valid endpoint. Height() uses the core's terrain/vmap query.
+template <class Height>
+bool SupportedGroundSegment(Point start, Point end, float referenceZ, Height height)
+{
+    float const distance = Distance(start, end);
+    if (!std::isfinite(distance) || !std::isfinite(referenceZ) || distance > EscapePathLimit)
+        return false;
+    unsigned const steps = std::max(1u, static_cast<unsigned>(std::ceil(distance)));
+    for (unsigned i = 0; i <= steps; ++i)
+    {
+        float const t = static_cast<float>(i) / steps;
+        float const floorZ = height({start.x + (end.x - start.x) * t, start.y + (end.y - start.y) * t});
+        if (!std::isfinite(floorZ) || std::abs(floorZ - referenceZ) >= 3.0f)
+            return false;
+    }
+    return true;
+}
+
 enum class Room { None, Transit, Normal, Heroic };
 inline Room LocateRoom(bool active, bool heroic, bool teleportAura, Point p, float z)
 {
diff --git a/tests/lich_king_mechanics_test.cpp b/tests/lich_king_mechanics_test.cpp
index 692fc093..16256266 100644
--- a/tests/lich_king_mechanics_test.cpp
+++ b/tests/lich_king_mechanics_test.cpp
@@ -80,6 +80,21 @@ int main()
     CHECK(DefileRadius(std::numeric_limits<float>::quiet_NaN()) == 12.0f);
     CHECK(DefileRadius(-1.0f) == 12.0f);
 
+    auto floor = [](Point) { return PlatformZ; };
+    CHECK(SupportedGroundSegment({0, 0}, {16, 0}, PlatformZ, floor));
+    CHECK(!SupportedGroundSegment({0, 0}, {16, 0}, PlatformZ, [](Point p)
+        { return p.x > 7 && p.x < 9 ? -100000.0f : PlatformZ; })); // Safe endpoints, unsupported middle.
+    CHECK(!SupportedGroundSegment({0, 0}, {16, 0}, PlatformZ, [](Point p)
+        { return p.x > 12 ? PlatformZ - 4.0f : PlatformZ; }));
+    CHECK(!SupportedGroundSegment({0, 0}, {16, 0}, PlatformZ, [](Point)
+        { return std::numeric_limits<float>::quiet_NaN(); }));
+    CHECK(!SupportedGroundSegment({0, 0}, {100, 0}, PlatformZ, floor));
+    CHECK(!SupportedGroundSegment({0, 0}, {16, 0}, std::numeric_limits<float>::infinity(), floor));
+    unsigned groundSamples = 0;
+    CHECK(SupportedGroundSegment({0, 0}, {16, 0}, PlatformZ, [&](Point)
+        { ++groundSamples; return PlatformZ; }));
+    CHECK(groundSamples == 17);
+
     std::vector<Hazard> puddles = {{{0, 0}, 5}};
     CHECK(!SafeSegment({-10, 0}, {10, 0}, puddles)); // Safe endpoint across a lethal puddle.
     CHECK(SafeSegment({-10, 6}, {10, 6}, puddles));
