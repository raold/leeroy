 src/Ai/Base/Actions/MovementActions.cpp     | 27 +++++++++++++-
 src/Ai/Base/Actions/MovementActions.h       |  1 +
 src/Ai/Base/Actions/PlayerbotHazardFilter.h | 39 +++++++++++++++++++++
 4 files changed, 82 insertions(+), 1 deletion(-)
 create mode 100644 src/Ai/Base/Actions/PlayerbotHazardFilter.h

